Функция МодулиКонфигурации()

    Результат = Новый Массив;

    Описания = Новый Массив;
    Описания.Добавить(Новый Структура("Ключ, Файл, Представление",
        "managedapplication", "ManagedApplicationModule.bsl", "Модуль управляемого приложения"));
    Описания.Добавить(Новый Структура("Ключ, Файл, Представление",
        "ordinaryapplication", "OrdinaryApplicationModule.bsl", "Модуль обычного приложения"));
    Описания.Добавить(Новый Структура("Ключ, Файл, Представление",
        "session", "SessionModule.bsl", "Модуль сеанса"));
    Описания.Добавить(Новый Структура("Ключ, Файл, Представление",
        "externalconnection", "ExternalConnectionModule.bsl", "Модуль внешнего соединения"));

    Для Каждого О Из Описания Цикл
        Путь = КореньКаталога + "\Ext\" + О.Файл;
        Ф = Новый Файл(Путь);
        Если Ф.Существует() Тогда
            Результат.Добавить(Новый Структура("Ключ, Путь, Представление",
                О.Ключ, Путь, О.Представление));
        КонецЕсли;
    КонецЦикла;

    Возврат Результат;

