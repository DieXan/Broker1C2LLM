&НаКлиенте
Процедура ДобавитьТипОбъекта(Типы, Знач Папка, Знач ИмяРус, Знач Группа)

    Эл = Новый Структура("Ключ, Значение, Группа", Папка, ИмяРус, Группа);
    Типы.Добавить(Эл);

КонецПроцедуры

&НаКлиенте
Функция РусскоеИмяТипа(Знач ТипПапки)

    Для Каждого КП Из ТипыОбъектовКонфигурации() Цикл
        Если НРег(КП.Ключ) = НРег(ТипПапки) Тогда
            Возврат КП.Значение;
        КонецЕсли;
    КонецЦикла;

    Возврат ТипПапки;

КонецФункции

&НаКлиенте
Функция КлючМодуляПоПути(Знач БазовыйПуть, Знач ПутьФайла)

    Если СтрДлина(ПутьФайла) <= СтрДлина(БазовыйПуть) + 1 Тогда
        Возврат "";
    КонецЕсли;

    Отн = Сред(ПутьФайла, СтрДлина(БазовыйПуть) + 2);
    ОтнНРег = НРег(Отн);

    Если ОтнНРег = "ext\managermodule.bsl" Тогда
        Возврат "manager";
    ИначеЕсли ОтнНРег = "ext\objectmodule.bsl" Тогда
        Возврат "object";
    ИначеЕсли ОтнНРег = "ext\recordsetmodule.bsl" Тогда
        Возврат "recordset";
    ИначеЕсли ОтнНРег = "ext\module.bsl" Тогда
        Возврат "module";
    ИначеЕсли ОтнНРег = "ext\valuemanagermodule.bsl" Тогда
        Возврат "valuemanager";
    ИначеЕсли ОтнНРег = "ext\commandmodule.bsl" Тогда
        Возврат "command";
    ИначеЕсли ОтнНРег = "ext\form\module.bsl" Тогда
        Возврат "form";
    КонецЕсли;

    Сегм = СтрРазделить(Отн, "\", Ложь);
    Если Сегм.Количество() >= 2 Тогда
        Если НРег(Сегм[0]) = "forms" Тогда
            Возврат "form:" + Сегм[1];
        ИначеЕсли НРег(Сегм[0]) = "commands" Тогда
            Возврат "command:" + Сегм[1];
        КонецЕсли;
    КонецЕсли;

    Возврат "";

КонецФункции

&НаКлиенте
Функция ВхожденияВТексте(Знач Текст, Знач Образец, Знач МаксСтрок)

    // Возвращает массив структур: Номер (строки), Текст (сама строка, обрезанная).
    Найденные = Новый Массив;
    ОбразецНРег = НРег(Образец);

    СтрокиФайла = СтрРазделить(Текст, Символы.ПС, Истина);
    Для Сч = 0 По СтрокиФайла.Количество() - 1 Цикл
        Если СтрНайти(НРег(СтрокиФайла[Сч]), ОбразецНРег) > 0 Тогда
            Эл = Новый Структура("Номер, Текст", Сч + 1, СокрЛП(СтрокиФайла[Сч]));
            Найденные.Добавить(Эл);
            Если Найденные.Количество() >= МаксСтрок Тогда
                Прервать;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;

    Возврат Найденные;

КонецФункции

&НаКлиенте
Процедура ВыполнитьПоиск(Строки, Знач ТелоЗапроса)

    // ── разбор строки запроса: текст|опция|опция ──
    ЧастиЗапроса = СтрРазделить(ТелоЗапроса, "|", Ложь);
    Если ЧастиЗапроса.Количество() = 0 Тогда
        Строки.Добавить("Пустой запрос SEARCH.");
        Возврат;
    КонецЕсли;

    ТекстПоиска = СокрЛП(ЧастиЗапроса[0]);
    Если ПустаяСтрока(ТекстПоиска) Тогда
        Строки.Добавить("Не указан текст для поиска.");
        Строки.Добавить("Пример: `SEARCH:ПодобратьДоговор|code|in=CommonModules`");
        Возврат;
    КонецЕсли;

    ИскатьИмена     = Ложь;
    ИскатьСинонимы  = Ложь;
    ИскатьКод       = Ложь;
    ИскатьРеквизиты = Ложь;
    РежимЗадан      = Ложь;
    ПоказыватьФрагмент = Истина;
    МаксРезультатов = 50;
    ФильтрТипов     = Новый Соответствие;

    Для Сч = 1 По ЧастиЗапроса.Количество() - 1 Цикл

        Опц     = СокрЛП(ЧастиЗапроса[Сч]);
        ОпцНРег = НРег(Опц);

        Если ОпцНРег = "name" Тогда
            ИскатьИмена = Истина;
            РежимЗадан  = Истина;
        ИначеЕсли ОпцНРег = "syn" Тогда
            ИскатьСинонимы = Истина;
            РежимЗадан     = Истина;
        ИначеЕсли ОпцНРег = "code" Тогда
            ИскатьКод  = Истина;
            РежимЗадан = Истина;
        ИначеЕсли ОпцНРег = "attr" Тогда
            ИскатьРеквизиты = Истина;
            РежимЗадан      = Истина;
        ИначеЕсли ОпцНРег = "all" Тогда
            ИскатьИмена     = Истина;
            ИскатьСинонимы  = Истина;
            ИскатьКод       = Истина;
            ИскатьРеквизиты = Истина;
            РежимЗадан      = Истина;
        ИначеЕсли ОпцНРег = "noctx" Тогда
            ПоказыватьФрагмент = Ложь;
        ИначеЕсли СтрНачинаетсяС(ОпцНРег, "max=") Тогда
            ЗначОпц = СокрЛП(Сред(Опц, 5));
            Попытка
                МаксРезультатов = Число(ЗначОпц);
            Исключение
                Строки.Добавить("Не разобрал `max=`: " + ЗначОпц + ". Взял 50.");
                МаксРезультатов = 50;
            КонецПопытки;
            Если МаксРезультатов < 1 Тогда
                МаксРезультатов = 50;
            КонецЕсли;
        ИначеЕсли СтрНачинаетсяС(ОпцНРег, "in=") Тогда
            СписокТипов = СтрРазделить(Сред(Опц, 4), ",", Ложь);
            Для Каждого ТипЭл Из СписокТипов Цикл
                ТипЭл = СокрЛП(ТипЭл);
                Если НЕ ПустаяСтрока(ТипЭл) Тогда
                    ФильтрТипов.Вставить(НРег(ТипЭл), Истина);
                КонецЕсли;
            КонецЦикла;
        Иначе
            Строки.Добавить("Неизвестная опция: `" + Опц + "` — пропущена.");
        КонецЕсли;

    КонецЦикла;

    Если НЕ РежимЗадан Тогда
        ИскатьИмена     = Истина;
        ИскатьСинонимы  = Истина;
        ИскатьКод       = Истина;
        ИскатьРеквизиты = Истина;
    КонецЕсли;

    // ── подготовка ──
    РезИмена     = Новый Массив;
    РезСинонимы  = Новый Массив;
    РезКод       = Новый Массив;
    РезРеквизиты = Новый Массив;

    ТекстНРег           = НРег(ТекстПоиска);
    ПросмотреноОбъектов = 0;
    ПросмотреноФайлов   = 0;
    ДостигнутЛимит      = Ложь;

    ИндексСин = Неопределено;
    КэшДоступен = Ложь;
    Если ИскатьСинонимы Тогда
        ИндексСин = ИндексСинонимовИзКэша();
        КэшДоступен = (ИндексСин <> Неопределено);
    КонецЕсли;

    ТипыОбъектов = ТипыОбъектовКонфигурации();

    Для Каждого КП Из ТипыОбъектов Цикл

        Если ДостигнутЛимит Тогда
            Прервать;
        КонецЕсли;

        ТипПапки = КП.Ключ;
        ТипРус   = КП.Значение;

        Если ФильтрТипов.Количество() > 0
            И ФильтрТипов.Получить(НРег(ТипПапки)) = Неопределено Тогда
            Продолжить;
        КонецЕсли;

        ПутьПапки = КореньКаталога + "\" + ТипПапки;
        ФП = Новый Файл(ПутьПапки);
        Если НЕ ФП.Существует() Тогда
            Продолжить;
        КонецЕсли;

        Состояние("Поиск: " + ТипРус + "...");

        Объекты = ОбъектыТипа(ПутьПапки);

        Для Каждого Об Из Объекты Цикл

            Если ДостигнутЛимит Тогда
                Прервать;
            КонецЕсли;

            ПросмотреноОбъектов = ПросмотреноОбъектов + 1;
            ПолноеИмяОбъекта    = ТипПапки + "." + Об.Имя;

            // ── 1. имя объекта ──
            Если ИскатьИмена И СтрНайти(НРег(Об.Имя), ТекстНРег) > 0 Тогда
                Ш = ШапкаДляПоиска(Об, ИндексСин, ТипПапки);
                Эл = Новый Структура("Объект, Тип, Синоним",
                    ПолноеИмяОбъекта, ТипРус, Ш.Синоним);
                РезИмена.Добавить(Эл);
            КонецЕсли;

            // ── 2. синоним и подсказка объекта ──
            // Синоним бывает бесполезным ("RX"), а смысл лежит в подсказке,
            // поэтому ищем и там тоже.
            Если ИскатьСинонимы Тогда
                Ш = ШапкаДляПоиска(Об, ИндексСин, ТипПапки);
                Если (НЕ ПустаяСтрока(Ш.Синоним) И СтрНайти(НРег(Ш.Синоним), ТекстНРег) > 0)
                    ИЛИ (НЕ ПустаяСтрока(Ш.Подсказка) И СтрНайти(НРег(Ш.Подсказка), ТекстНРег) > 0) Тогда
                    Эл = Новый Структура("Объект, Тип, Синоним, Подсказка",
                        ПолноеИмяОбъекта, ТипРус, Ш.Синоним, Ш.Подсказка);
                    РезСинонимы.Добавить(Эл);
                КонецЕсли;
            КонецЕсли;

            // ── 3. код модулей ──
            Если ИскатьКод И Об.ЕстьПапка Тогда

                ФайлыBSL = НайтиФайлы(Об.ПутьПапки, "*.bsl", Истина);

                Для Каждого ФБSL Из ФайлыBSL Цикл

                    Если НЕ ФБSL.ЭтоФайл() Тогда
                        Продолжить;
                    КонецЕсли;

                    ПросмотреноФайлов = ПросмотреноФайлов + 1;

                    КодМодуля = ПрочитатьФайлБезопасно(ФБSL.ПолноеИмя);
                    Если ПустаяСтрока(КодМодуля) Тогда
                        Продолжить;
                    КонецЕсли;

                    // быстрая проверка по всему тексту, разбор на строки — только при попадании
                    Если СтрНайти(НРег(КодМодуля), ТекстНРег) = 0 Тогда
                        Продолжить;
                    КонецЕсли;

                    Вхождения  = ВхожденияВТексте(КодМодуля, ТекстПоиска, 5);
                    КлючМодуля = КлючМодуляПоПути(Об.ПутьПапки, ФБSL.ПолноеИмя);

                    Эл = Новый Структура("Объект, Модуль, Строки, Ключ, Фрагмент");
                    Эл.Объект = ПолноеИмяОбъекта;
                    Эл.Модуль = ?(ПустаяСтрока(КлючМодуля), ФБSL.Имя, КлючМодуля);
                    Эл.Ключ   = КлючМодуля;

                    ПредставлениеСтрок = Новый Массив;
                    Для Каждого В Из Вхождения Цикл
                        ПредставлениеСтрок.Добавить(Строка(В.Номер));
                    КонецЦикла;
                    Эл.Строки = СтрСоединить(ПредставлениеСтрок, ", ");

                    Если ПоказыватьФрагмент И Вхождения.Количество() > 0 Тогда
                        Эл.Фрагмент = ЭкранироватьЯчейку(Вхождения[0].Текст, 120);
                    Иначе
                        Эл.Фрагмент = "";
                    КонецЕсли;

                    РезКод.Добавить(Эл);

                    Если ВсегоНайдено(РезИмена, РезСинонимы, РезКод, РезРеквизиты)
                        >= МаксРезультатов Тогда
                        ДостигнутЛимит = Истина;
                        Прервать;
                    КонецЕсли;

                КонецЦикла;

            КонецЕсли;

            // ── 4. реквизиты и типы ──
            Если ИскатьРеквизиты И НЕ ДостигнутЛимит И Об.ЕстьXML Тогда

                Реквизиты = Неопределено;
                Попытка
                    Реквизиты = ПрочитатьСхемуОбъекта(Об.ПутьXML, ТипПапки, Об.Имя);
                Исключение
                    Реквизиты = Неопределено;
                КонецПопытки;

                Если Реквизиты <> Неопределено Тогда
                    Для Каждого Р Из Реквизиты Цикл
                        Если СтрНайти(НРег(Р.Путь), ТекстНРег) > 0
                            ИЛИ СтрНайти(НРег(Р.Тип), ТекстНРег) > 0
                            ИЛИ СтрНайти(НРег(Р.Синоним), ТекстНРег) > 0 Тогда
                            Эл = Новый Структура("Объект, Реквизит, Тип, Раздел, Синоним",
                                ПолноеИмяОбъекта, Р.Путь, Р.Тип, Р.Раздел, Р.Синоним);
                            РезРеквизиты.Добавить(Эл);

                            Если ВсегоНайдено(РезИмена, РезСинонимы, РезКод, РезРеквизиты)
                                >= МаксРезультатов Тогда
                                ДостигнутЛимит = Истина;
                                Прервать;
                            КонецЕсли;
                        КонецЕсли;
                    КонецЦикла;
                КонецЕсли;

            КонецЕсли;

            Если ВсегоНайдено(РезИмена, РезСинонимы, РезКод, РезРеквизиты)
                >= МаксРезультатов Тогда
                ДостигнутЛимит = Истина;
            КонецЕсли;

        КонецЦикла;

    КонецЦикла;

    // ── модули конфигурации (корневая папка Ext) ──
    Если ИскатьКод И НЕ ДостигнутЛимит
        И (ФильтрТипов.Количество() = 0
            ИЛИ ФильтрТипов.Получить("configuration") <> Неопределено) Тогда

        Для Каждого М Из МодулиКонфигурации() Цикл

            ПросмотреноФайлов = ПросмотреноФайлов + 1;
            КодМодуля = ПрочитатьФайлБезопасно(М.Путь);
            Если ПустаяСтрока(КодМодуля) Тогда
                Продолжить;
            КонецЕсли;
            Если СтрНайти(НРег(КодМодуля), ТекстНРег) = 0 Тогда
                Продолжить;
            КонецЕсли;

            Вхождения = ВхожденияВТексте(КодМодуля, ТекстПоиска, 5);

            Эл = Новый Структура("Объект, Модуль, Строки, Ключ, Фрагмент");
            Эл.Объект = "Configuration";
            Эл.Модуль = М.Ключ;
            Эл.Ключ   = М.Ключ;

            ПредставлениеСтрок = Новый Массив;
            Для Каждого В Из Вхождения Цикл
                ПредставлениеСтрок.Добавить(Строка(В.Номер));
            КонецЦикла;
            Эл.Строки = СтрСоединить(ПредставлениеСтрок, ", ");
            Эл.Фрагмент = ?(ПоказыватьФрагмент И Вхождения.Количество() > 0,
                ЭкранироватьЯчейку(Вхождения[0].Текст, 120), "");

            РезКод.Добавить(Эл);

            Если ВсегоНайдено(РезИмена, РезСинонимы, РезКод, РезРеквизиты)
                >= МаксРезультатов Тогда
                ДостигнутЛимит = Истина;
                Прервать;
            КонецЕсли;

        КонецЦикла;

    КонецЕсли;

    // ── вывод ──
    Строки.Добавить("---");
    Строки.Добавить("## Поиск: `" + ТекстПоиска + "`");
    Строки.Добавить("");

    ОбластиПоиска = Новый Массив;
    Если ИскатьИмена Тогда ОбластиПоиска.Добавить("имена"); КонецЕсли;
    Если ИскатьСинонимы Тогда ОбластиПоиска.Добавить("синонимы"); КонецЕсли;
    Если ИскатьКод Тогда ОбластиПоиска.Добавить("код"); КонецЕсли;
    Если ИскатьРеквизиты Тогда ОбластиПоиска.Добавить("реквизиты"); КонецЕсли;

    Строки.Добавить("> Область: " + СтрСоединить(ОбластиПоиска, ", "));
    Строки.Добавить("> Просмотрено объектов: " + ЧислоВСтроку(ПросмотреноОбъектов)
        + ", файлов кода: " + ЧислоВСтроку(ПросмотреноФайлов));
    Если ИскатьСинонимы И НЕ КэшДоступен Тогда
        Строки.Добавить("> ⚠ Кэш шапок не найден — синонимы читались из XML на лету."
            + " Нажми «Выгрузить объекты в MD», чтобы построить кэш и ускорить поиск.");
    КонецЕсли;
    Если ДостигнутЛимит Тогда
        Строки.Добавить("> ⚠ Достигнут лимит " + МаксРезультатов
            + " результатов — поиск остановлен. Уточни запрос или подними `max=`.");
    КонецЕсли;
    Строки.Добавить("");

    Если ВсегоНайдено(РезИмена, РезСинонимы, РезКод, РезРеквизиты) = 0 Тогда
        Строки.Добавить("Ничего не найдено.");
        Возврат;
    КонецЕсли;

    Если РезИмена.Количество() > 0 Тогда
        Строки.Добавить("### Имена объектов (" + РезИмена.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Объект | Вид | Синоним | Запрос |");
        Строки.Добавить("|---|---|---|---|");
        Для Каждого Э Из РезИмена Цикл
            Строки.Добавить("| `" + Э.Объект + "` | " + Э.Тип
                + " | " + ЭкранироватьЯчейку(Э.Синоним, 90)
                + " | `SCHEMA:" + Э.Объект + "` |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

    Если РезСинонимы.Количество() > 0 Тогда
        Строки.Добавить("### Синонимы и подсказки объектов (" + РезСинонимы.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Объект | Вид | Синоним | Подсказка | Запрос |");
        Строки.Добавить("|---|---|---|---|---|");
        Для Каждого Э Из РезСинонимы Цикл
            Строки.Добавить("| `" + Э.Объект + "` | " + Э.Тип
                + " | " + ЭкранироватьЯчейку(Э.Синоним, 90)
                + " | " + ЭкранироватьЯчейку(Э.Подсказка, 120)
                + " | `SCHEMA:" + Э.Объект + "` |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

    Если РезКод.Количество() > 0 Тогда
        Строки.Добавить("### Код (" + РезКод.Количество() + ")");
        Строки.Добавить("");
        Если ПоказыватьФрагмент Тогда
            Строки.Добавить("| Объект | Модуль | Строки | Фрагмент | Запрос |");
            Строки.Добавить("|---|---|---|---|---|");
        Иначе
            Строки.Добавить("| Объект | Модуль | Строки | Запрос |");
            Строки.Добавить("|---|---|---|---|");
        КонецЕсли;
        Для Каждого Э Из РезКод Цикл
            Если ПустаяСтрока(Э.Ключ) Тогда
                ЗапросТекст = "—";
            ИначеЕсли Э.Объект = "Configuration" Тогда
                ЗапросТекст = "`FETCH:Configuration." + Э.Ключ + "`";
            Иначе
                ЗапросТекст = "`FETCH:" + Э.Объект + "." + Э.Ключ + "`";
            КонецЕсли;
            Если ПоказыватьФрагмент Тогда
                Строки.Добавить("| `" + Э.Объект + "` | " + Э.Модуль
                    + " | " + Э.Строки + " | `" + Э.Фрагмент + "` | " + ЗапросТекст + " |");
            Иначе
                Строки.Добавить("| `" + Э.Объект + "` | " + Э.Модуль
                    + " | " + Э.Строки + " | " + ЗапросТекст + " |");
            КонецЕсли;
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

    Если РезРеквизиты.Количество() > 0 Тогда
        Строки.Добавить("### Реквизиты и типы (" + РезРеквизиты.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Объект | Реквизит | Тип | Синоним | Запрос |");
        Строки.Добавить("|---|---|---|---|---|");
        Для Каждого Э Из РезРеквизиты Цикл
            Строки.Добавить("| `" + Э.Объект + "` | `" + Э.Реквизит
                + "` | " + ЭкранироватьЯчейку(Э.Тип, 90)
                + " | " + ЭкранироватьЯчейку(Э.Синоним, 90)
                + " | `SCHEMA:" + Э.Объект + "` |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ВсегоНайдено(РезИмена, РезСинонимы, РезКод, РезРеквизиты)

    Возврат РезИмена.Количество() + РезСинонимы.Количество()
        + РезКод.Количество() + РезРеквизиты.Количество();

КонецФункции

&НаКлиенте
Функция ШапкаДляПоиска(Знач Об, ИндексСин, Знач ТипПапки)

    // Синоним и подсказка объекта: из кэша, если он построен,
    // иначе читаем XML на лету.
    Если ИндексСин <> Неопределено Тогда
        Найденный = ИндексСин.Получить(НРег(ТипПапки + "." + Об.Имя));
        Если Найденный <> Неопределено Тогда
            Возврат Найденный;
        КонецЕсли;
    КонецЕсли;

    Пусто = Новый Структура("Синоним, Подсказка", "", "");

    Если НЕ Об.ЕстьXML Тогда
        Возврат Пусто;
    КонецЕсли;

    Шапка = ПрочитатьШапкуОбъекта(Об.ПутьXML);
    Возврат Новый Структура("Синоним, Подсказка", Шапка.Синоним, Шапка.Подсказка);

КонецФункции

&НаКлиенте
Функция ОчиститьДляКэша(Знач Текст)

    // В кэше поля разделены табуляцией, строки — переводом строки.
    Если Текст = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Текст = СтрЗаменить(Текст, Символы.Таб, " ");
    Текст = СтрЗаменить(Текст, Символы.ВК, " ");
    Текст = СтрЗаменить(Текст, Символы.ПС, " ");
    Возврат СокрЛП(Текст);

КонецФункции

&НаКлиенте
Функция ТипСтандартногоРеквизита(Знач ИмяРеквизита, Знач ТипОбъекта, Знач ИмяОбъекта, Знач СвойстваОбъекта)

    ПрефиксыСсылок = Новый Соответствие;
    ПрефиксыСсылок.Вставить("Catalogs",                   "СправочникСсылка");
    ПрефиксыСсылок.Вставить("Documents",                  "ДокументСсылка");
    ПрефиксыСсылок.Вставить("Enums",                      "ПеречислениеСсылка");
    ПрефиксыСсылок.Вставить("ChartsOfCharacteristicTypes","ПланВидовХарактеристикСсылка");
    ПрефиксыСсылок.Вставить("ChartsOfAccounts",           "ПланСчетовСсылка");
    ПрефиксыСсылок.Вставить("ChartsOfCalculationTypes",   "ПланВидовРасчетаСсылка");
    ПрефиксыСсылок.Вставить("BusinessProcesses",          "БизнесПроцессСсылка");
    ПрефиксыСсылок.Вставить("Tasks",                      "ЗадачаСсылка");
    ПрефиксыСсылок.Вставить("ExchangePlans",              "ПланОбменаСсылка");

    Если ИмяРеквизита = "Ref" Тогда
        Префикс = ПрефиксыСсылок.Получить(ТипОбъекта);
        Если Префикс <> Неопределено И НЕ ПустаяСтрока(ИмяОбъекта) Тогда
            Возврат Префикс + "." + ИмяОбъекта;
        КонецЕсли;
        Возврат "Ссылка";

    ИначеЕсли ИмяРеквизита = "Parent" Тогда
        Префикс = ПрефиксыСсылок.Получить(ТипОбъекта);
        Если Префикс <> Неопределено И НЕ ПустаяСтрока(ИмяОбъекта) Тогда
            Возврат Префикс + "." + ИмяОбъекта;
        КонецЕсли;
        Возврат "Ссылка (родитель)";

    ИначеЕсли ИмяРеквизита = "Posted"
        ИЛИ ИмяРеквизита = "DeletionMark"
        ИЛИ ИмяРеквизита = "IsFolder"
        ИЛИ ИмяРеквизита = "Predefined"
        ИЛИ ИмяРеквизита = "Active" Тогда
        Возврат "Булево";

    ИначеЕсли ИмяРеквизита = "Date" ИЛИ ИмяРеквизита = "Period" Тогда
        Возврат "Дата(дата и время)";

    ИначеЕсли ИмяРеквизита = "LineNumber" Тогда
        Возврат "Число(9)";

    ИначеЕсли ИмяРеквизита = "Recorder" Тогда
        Возврат "ДокументСсылка (регистратор)";

    ИначеЕсли ИмяРеквизита = "RecordType" Тогда
        Возврат "ВидДвиженияНакопления";

    ИначеЕсли ИмяРеквизита = "PredefinedDataName" Тогда
        Возврат "Строка";

    ИначеЕсли ИмяРеквизита = "ValueType" Тогда
        Возврат "ОписаниеТипов";

    ИначеЕсли ИмяРеквизита = "Number" Тогда
        Возврат ТипПоДлинеРасширенно(СвойстваОбъекта,
            "NumberType", "NumberLength", "NumberAllowedLength", "Строка", "номер не используется");

    ИначеЕсли ИмяРеквизита = "Code" Тогда
        Возврат ТипПоДлинеРасширенно(СвойстваОбъекта,
            "CodeType", "CodeLength", "CodeAllowedLength", "Строка", "код не используется");

    ИначеЕсли ИмяРеквизита = "Description" Тогда
        Возврат ТипПоДлинеРасширенно(СвойстваОбъекта,
            "", "DescriptionLength", "", "Строка", "наименование не используется");

    ИначеЕсли ИмяРеквизита = "Owner" Тогда
        Возврат "СправочникСсылка (владелец)";

    КонецЕсли;

    Возврат ТипПрочегоСтандартногоРеквизита(ИмяРеквизита);

КонецФункции

&НаКлиенте
Функция ТипПрочегоСтандартногоРеквизита(Знач ИмяРеквизита)

    // Стандартные реквизиты планов обмена, бизнес-процессов, задач,
    // планов счетов и регистров расчёта — раньше выводились как "—".
    Соотв = Новый Соответствие;
    Соотв.Вставить("Order",                 "Число (порядок)");
    Соотв.Вставить("Type",                  "ВидСчета");
    Соотв.Вставить("OffBalance",            "Булево");
    Соотв.Вставить("TurnoversOnly",         "Булево");
    Соотв.Вставить("Account",               "ПланСчетовСсылка");
    Соотв.Вставить("AccountDr",             "ПланСчетовСсылка (дебет)");
    Соотв.Вставить("AccountCr",             "ПланСчетовСсылка (кредит)");
    Соотв.Вставить("ExtDimensionTypes",     "ПланВидовХарактеристикСсылка");
    Соотв.Вставить("ThisNode",              "Булево (этот узел)");
    Соотв.Вставить("SentNo",                "Число (номер отправленного)");
    Соотв.Вставить("ReceivedNo",            "Число (номер принятого)");
    Соотв.Вставить("Started",               "Булево (стартован)");
    Соотв.Вставить("Completed",             "Булево (завершён)");
    Соотв.Вставить("HeadTask",              "ЗадачаСсылка (ведущая задача)");
    Соотв.Вставить("Executed",              "Булево (выполнена)");
    Соотв.Вставить("BusinessProcess",       "БизнесПроцессСсылка");
    Соотв.Вставить("RoutePoint",            "ТочкаМаршрутаБизнесПроцессаСсылка");
    Соотв.Вставить("CalculationType",       "ПланВидовРасчетаСсылка");
    Соотв.Вставить("ExchangeDate",          "Дата(дата и время)");
    Соотв.Вставить("ActionPeriodIsBasic",   "Булево");
    Соотв.Вставить("PeriodAdjustment",      "Булево (сторно)");
    Соотв.Вставить("RegistrationPeriod",    "Дата(дата)");
    Соотв.Вставить("BegOfPeriod",           "Дата(дата и время)");
    Соотв.Вставить("EndOfPeriod",           "Дата(дата и время)");
    Соотв.Вставить("BegOfActionPeriod",     "Дата(дата и время)");
    Соотв.Вставить("EndOfActionPeriod",     "Дата(дата и время)");
    Соотв.Вставить("BegOfBasePeriod",       "Дата(дата и время)");
    Соотв.Вставить("EndOfBasePeriod",       "Дата(дата и время)");
    Соотв.Вставить("ActionPeriod",          "Дата(дата и время)");
    Соотв.Вставить("ReversingEntry",        "Булево (сторно)");
    Соотв.Вставить("SourceRecordKey",       "КлючЗаписи");
    Соотв.Вставить("PointInTime",           "МоментВремени");

    Найдено = Соотв.Получить(ИмяРеквизита);
    Если Найдено <> Неопределено Тогда
        Возврат Найдено;
    КонецЕсли;

    // ExtDimension1..3 и ExtDimensionType1..3 нумерованные
    Если СтрНачинаетсяС(ИмяРеквизита, "ExtDimensionType") Тогда
        Возврат "ПланВидовХарактеристикСсылка (вид субконто)";
    ИначеЕсли СтрНачинаетсяС(ИмяРеквизита, "ExtDimension") Тогда
        Возврат "Характеристика (субконто)";
    КонецЕсли;

    Возврат "";

КонецФункции

&НаКлиенте
Функция ТипПоДлинеРасширенно(СвойстваОбъекта, Знач КлючТипа, Знач КлючДлины,
    Знач КлючДопустимойДлины, Знач ТипПоУмолчанию, Знач ТекстОтсутствия)

    // Длина 0 означает, что реквизит выключен (например, справочник без кода),
    // и писать "Строка" было бы дезинформацией.
    ИмяТипа = ТипПоУмолчанию;
    Если НЕ ПустаяСтрока(КлючТипа) Тогда
        СыройТип = СвойстваОбъекта.Получить(КлючТипа);
        Если СыройТип <> Неопределено Тогда
            Если НРег(СыройТип) = "number" Тогда
                ИмяТипа = "Число";
            Иначе
                ИмяТипа = "Строка";
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;

    Длина = СвойстваОбъекта.Получить(КлючДлины);

    Если Длина <> Неопределено И СокрЛП(Длина) = "0" Тогда
        Возврат "— (" + ТекстОтсутствия + ")";
    КонецЕсли;

    Если Длина = Неопределено ИЛИ ПустаяСтрока(Длина) Тогда
        Возврат ИмяТипа;
    КонецЕсли;

    Квалификатор = "(" + СокрЛП(Длина);
    Если НЕ ПустаяСтрока(КлючДопустимойДлины) Тогда
        ЗначДопустимойДлины = СвойстваОбъекта.Получить(КлючДопустимойДлины);
        Если ЗначДопустимойДлины <> Неопределено И НРег(СокрЛП(ЗначДопустимойДлины)) = "fixed" Тогда
            Квалификатор = Квалификатор + ", фикс";
        КонецЕсли;
    КонецЕсли;
    Квалификатор = Квалификатор + ")";

    Возврат ИмяТипа + Квалификатор;

КонецФункции

&НаКлиенте
Функция ПрочитатьСхемуОбъекта(ПутьXML, Знач ТипОбъекта = "", Знач ИмяОбъекта = "")

    Результат = Новый Массив;

    ЧтениеXML = Новый ЧтениеXML;
    ЧтениеXML.ОткрытьФайл(ПутьXML);

    Стек = Новый Массив;

    СвойстваОбъекта = Новый Соответствие;
    СвойстваВерхнегоУровня = Новый Соответствие;
    СвойстваВерхнегоУровня.Вставить("NumberLength",        Истина);
    СвойстваВерхнегоУровня.Вставить("NumberType",          Истина);
    СвойстваВерхнегоУровня.Вставить("NumberAllowedLength", Истина);
    СвойстваВерхнегоУровня.Вставить("CodeLength",          Истина);
    СвойстваВерхнегоУровня.Вставить("CodeType",            Истина);
    СвойстваВерхнегоУровня.Вставить("CodeAllowedLength",   Истина);
    СвойстваВерхнегоУровня.Вставить("DescriptionLength",   Истина);

    КонтейнерыРеквизитов = Новый Соответствие;
    КонтейнерыРеквизитов.Вставить("Attribute",         "Attribute");
    КонтейнерыРеквизитов.Вставить("Dimension",         "Dimension");
    КонтейнерыРеквизитов.Вставить("Resource",          "Resource");
    КонтейнерыРеквизитов.Вставить("StandardAttribute", "StandardAttribute");
    КонтейнерыРеквизитов.Вставить("TabularSection",    "TabularSection");
    КонтейнерыРеквизитов.Вставить("StandardTabularSection", "StandardTabularSection");
    КонтейнерыРеквизитов.Вставить("CommonAttribute",   "CommonAttribute");
    КонтейнерыРеквизитов.Вставить("Operation",         "Operation");
    КонтейнерыРеквизитов.Вставить("Parameter",         "Parameter");
    КонтейнерыРеквизитов.Вставить("URLTemplate",       "URLTemplate");
    КонтейнерыРеквизитов.Вставить("Method",            "Method");
    КонтейнерыРеквизитов.Вставить("Form",              "Form");
    КонтейнерыРеквизитов.Вставить("Command",           "Command");
    КонтейнерыРеквизитов.Вставить("EnumValue",         "EnumValue");
    КонтейнерыРеквизитов.Вставить("AccountingFlag",    "AccountingFlag");
    КонтейнерыРеквизитов.Вставить("ExtDimensionAccountingFlag", "ExtDimensionAccountingFlag");
    КонтейнерыРеквизитов.Вставить("Recalculation",     "Recalculation");
    КонтейнерыРеквизитов.Вставить("AddressingAttribute", "AddressingAttribute");
    КонтейнерыРеквизитов.Вставить("Template",          "Template");

    // Глубину считаем по стеку ИМЁН открытых элементов, а не счётчиком:
    // у пустого элемента (<Comment/>) закрывающего тега может не быть,
    // и обычный счётчик после первого же такого элемента уезжает навсегда.
    СтекИмен     = Новый Массив;
    ОбщаяГлубина = 0;

    Пока ЧтениеXML.Прочитать() Цикл

        Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда

            ЛокИмя = ЧтениеXML.ЛокальноеИмя;

            СтекИмен.Добавить(ЛокИмя);
            ОбщаяГлубина = СтекИмен.Количество();

            Если Стек.Количество() = 0 И СвойстваВерхнегоУровня.Получить(ЛокИмя) <> Неопределено Тогда
                СвойстваОбъекта.Вставить(ЛокИмя, ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен));
                Продолжить;
            КонецЕсли;

            Если КонтейнерыРеквизитов.Получить(ЛокИмя) <> Неопределено Тогда
                Блок = Новый Структура;
                Блок.Вставить("Раздел", ЛокИмя);
                Блок.Вставить("ГлубинаОткрытия", ОбщаяГлубина);
                Блок.Вставить("Имя", "");
                Блок.Вставить("Синоним", "");
                Блок.Вставить("ТипыЧасти", Новый Массив);
                Блок.Вставить("СейчасВнутриТипа", Ложь);
                Блок.Вставить("ГлубинаТипа", 0);
                Блок.Вставить("СейчасВСинониме", Ложь);
                Блок.Вставить("ГлубинаСинонима", 0);
                Блок.Вставить("ДлинаСтроки", "");
                Блок.Вставить("ДопустимаяДлина", "");
                Блок.Вставить("ЦифрыЧисла", "");
                Блок.Вставить("ДробьЧисла", "");
                Блок.Вставить("ЧастиДаты", "");
                Блок.Вставить("Направление", "");
                Блок.Вставить("ИмяПроцедуры", "");
                Блок.Вставить("ИндексВставки", Результат.Количество());
                Стек.Добавить(Блок);

                Если ЧтениеXML.КоличествоАтрибутов() > 0 Тогда
                    Для Сч = 0 По ЧтениеXML.КоличествоАтрибутов() - 1 Цикл
                        Если ЧтениеXML.ИмяАтрибута(Сч) = "name" Тогда
                            Блок.Имя = ЧтениеXML.ЗначениеАтрибута(Сч);
                            Прервать;
                        КонецЕсли;
                    КонецЦикла;
                КонецЕсли;

                Продолжить;
            КонецЕсли;

            Если Стек.Количество() > 0 Тогда
                ТекБлок = Стек[Стек.Количество() - 1];

                Если ЛокИмя = "Synonym" И НЕ ТекБлок.СейчасВнутриТипа Тогда
                    ТекБлок.СейчасВСинониме = Истина;
                    ТекБлок.ГлубинаСинонима = ОбщаяГлубина;
                    Продолжить;
                КонецЕсли;

                Если ТекБлок.СейчасВСинониме Тогда
                    Если ЛокИмя = "content" И ПустаяСтрока(ТекБлок.Синоним) Тогда
                        ТекБлок.Синоним = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                    КонецЕсли;
                    Продолжить;
                КонецЕсли;

                Если ЛокИмя = "Name" И НЕ ТекБлок.СейчасВнутриТипа И ПустаяСтрока(ТекБлок.Имя) Тогда
                    ТекБлок.Имя = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                    Продолжить;
                КонецЕсли;

                Если ЛокИмя = "Type" И НЕ ТекБлок.СейчасВнутриТипа Тогда
                    ТекБлок.СейчасВнутриТипа = Истина;
                    ТекБлок.ГлубинаТипа = ОбщаяГлубина;
                    Продолжить;
                КонецЕсли;

                Если НЕ ТекБлок.СейчасВнутриТипа Тогда

                    Если ЛокИмя = "XDTOValueType" ИЛИ ЛокИмя = "XDTOReturningValueType" Тогда
                        ЧастьТипа = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                        Если НЕ ПустаяСтрока(ЧастьТипа) Тогда
                            ТекБлок.ТипыЧасти.Добавить(ЧастьТипа);
                        КонецЕсли;
                        Продолжить;

                    ИначеЕсли ЛокИмя = "TransferDirection" Тогда
                        ТекБлок.Направление = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                        Продолжить;

                    ИначеЕсли ЛокИмя = "ProcedureName" Тогда
                        ТекБлок.ИмяПроцедуры = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                        Продолжить;

                    КонецЕсли;

                КонецЕсли;

                Если ТекБлок.СейчасВнутриТипа Тогда

                    Если ЛокИмя = "Type" Тогда
                        ЧастьТипа = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                        Если НЕ ПустаяСтрока(ЧастьТипа) Тогда
                            ТекБлок.ТипыЧасти.Добавить(ЧастьТипа);
                        КонецЕсли;
                        Продолжить;

                    ИначеЕсли ЛокИмя = "TypeSet" Тогда
                        ЧастьТипа = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                        Если НЕ ПустаяСтрока(ЧастьТипа) Тогда
                            ТекБлок.ТипыЧасти.Добавить(ЧастьТипа);
                        КонецЕсли;
                        Продолжить;

                    ИначеЕсли ЛокИмя = "Length" Тогда
                        ТекБлок.ДлинаСтроки = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                        Продолжить;

                    ИначеЕсли ЛокИмя = "AllowedLength" Тогда
                        ТекБлок.ДопустимаяДлина = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                        Продолжить;

                    ИначеЕсли ЛокИмя = "Digits" Тогда
                        ТекБлок.ЦифрыЧисла = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                        Продолжить;

                    ИначеЕсли ЛокИмя = "FractionDigits" Тогда
                        ТекБлок.ДробьЧисла = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                        Продолжить;

                    ИначеЕсли ЛокИмя = "DateFractions" Тогда
                        ТекБлок.ЧастиДаты = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                        Продолжить;

                    КонецЕсли;

                КонецЕсли;
            КонецЕсли;

        ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда

            ЛокИмя = ЧтениеXML.ЛокальноеИмя;

            // Если верх стека не совпал с именем — это закрытие пустого элемента,
            // который мы намеренно не клали в стек. Пропускаем.
            Если СтекИмен.Количество() = 0
                ИЛИ СтекИмен[СтекИмен.Количество() - 1] <> ЛокИмя Тогда
                Продолжить;
            КонецЕсли;

            ОбщаяГлубина = СтекИмен.Количество();

            Если Стек.Количество() > 0 Тогда
                ТекБлок = Стек[Стек.Количество() - 1];
                Если ТекБлок.СейчасВнутриТипа И ЛокИмя = "Type" И ОбщаяГлубина = ТекБлок.ГлубинаТипа Тогда
                    ТекБлок.СейчасВнутриТипа = Ложь;
                КонецЕсли;
                Если ТекБлок.СейчасВСинониме И ЛокИмя = "Synonym" И ОбщаяГлубина = ТекБлок.ГлубинаСинонима Тогда
                    ТекБлок.СейчасВСинониме = Ложь;
                КонецЕсли;
            КонецЕсли;

            Если Стек.Количество() > 0 Тогда
                ТекБлок = Стек[Стек.Количество() - 1];
                Если ЛокИмя = ТекБлок.Раздел И ОбщаяГлубина = ТекБлок.ГлубинаОткрытия Тогда
                    Если НЕ ПустаяСтрока(ТекБлок.Имя) Тогда

                        ПрефиксПути = "";
                        ВнутриШаблонаURL = Ложь;
                        Если Стек.Количество() >= 2 Тогда
                            ИменаПредков = Новый Массив;
                            Для Инд = 0 По Стек.Количество() - 2 Цикл
                                Предок = Стек[Инд];
                                Если Предок.Раздел = "URLTemplate" Тогда
                                    ВнутриШаблонаURL = Истина;
                                КонецЕсли;
                                Если (Предок.Раздел = "TabularSection"
                                        ИЛИ Предок.Раздел = "StandardTabularSection"
                                        ИЛИ Предок.Раздел = "URLTemplate"
                                        ИЛИ Предок.Раздел = "Operation"
                                        ИЛИ Предок.Раздел = "Recalculation")
                                    И НЕ ПустаяСтрока(Предок.Имя) Тогда
                                    ИменаПредков.Добавить(Предок.Имя);
                                КонецЕсли;
                            КонецЦикла;
                            Если ИменаПредков.Количество() > 0 Тогда
                                ПрефиксПути = СтрСоединить(ИменаПредков, ".") + ".";
                            КонецЕсли;
                        КонецЕсли;

                        // <Template> внутри <URLTemplate> — это путь шаблона
                        // HTTP-сервиса, а не макет объекта.
                        РазделДляВывода = ТекБлок.Раздел;
                        Если ТекБлок.Раздел = "Template" И ВнутриШаблонаURL Тогда
                            РазделДляВывода = "URLPattern";
                        КонецЕсли;

                        ТипДляВывода = СобратьТипДляВывода(ТекБлок);
                        Если ПустаяСтрока(ТипДляВывода) Тогда
                            Если ТекБлок.Раздел = "TabularSection" Тогда
                                ТипДляВывода = "ТабличнаяЧасть";
                            ИначеЕсли ТекБлок.Раздел = "StandardTabularSection" Тогда
                                ТипДляВывода = "ТабличнаяЧасть (стандартная)";
                            ИначеЕсли ТекБлок.Раздел = "Form" Тогда
                                ТипДляВывода = "Форма";
                            ИначеЕсли ТекБлок.Раздел = "Command" Тогда
                                ТипДляВывода = "Команда";
                            ИначеЕсли ТекБлок.Раздел = "Template" Тогда
                                ТипДляВывода = ?(ВнутриШаблонаURL, "Путь шаблона", "Макет");
                            ИначеЕсли ТекБлок.Раздел = "EnumValue" Тогда
                                ТипДляВывода = "Значение";
                            ИначеЕсли ТекБлок.Раздел = "Recalculation" Тогда
                                ТипДляВывода = "Перерасчет";
                            ИначеЕсли ТекБлок.Раздел = "AccountingFlag" Тогда
                                ТипДляВывода = "Булево";
                            ИначеЕсли ТекБлок.Раздел = "ExtDimensionAccountingFlag" Тогда
                                ТипДляВывода = "Булево";
                            ИначеЕсли ТекБлок.Раздел = "Operation" Тогда
                                ТипДляВывода = "Операция веб-сервиса";
                            ИначеЕсли ТекБлок.Раздел = "URLTemplate" Тогда
                                ТипДляВывода = "Шаблон URL";
                            ИначеЕсли ТекБлок.Раздел = "Method" Тогда
                                ТипДляВывода = "Метод";
                            ИначеЕсли ТекБлок.Раздел = "StandardAttribute" Тогда
                                ТипДляВывода = "@СТАНД@";
                            Иначе
                                ТипДляВывода = "—";
                            КонецЕсли;
                        КонецЕсли;

                        Если ТекБлок.Раздел = "Operation" И НЕ ПустаяСтрока(ТекБлок.ИмяПроцедуры) Тогда
                            ТипДляВывода = ТипДляВывода + " → " + ТекБлок.ИмяПроцедуры;
                        КонецЕсли;
                        Если ТекБлок.Раздел = "Parameter" И НЕ ПустаяСтрока(ТекБлок.Направление) Тогда
                            ТипДляВывода = ТипДляВывода + " ["
                                + НаправлениеПараметра(ТекБлок.Направление) + "]";
                        КонецЕсли;

                        Эл = Новый Структура("Путь, Тип, Раздел, Синоним",
                            ПрефиксПути + ТекБлок.Имя,
                            ТипДляВывода,
                            РазделДляВывода,
                            ТекБлок.Синоним);
                        Если ТекБлок.ИндексВставки <= Результат.Количество() Тогда
                            Результат.Вставить(ТекБлок.ИндексВставки, Эл);
                        Иначе
                            Результат.Добавить(Эл);
                        КонецЕсли;
                    КонецЕсли;
                    Стек.Удалить(Стек.Количество() - 1);
                КонецЕсли;
            КонецЕсли;

            СтекИмен.Удалить(СтекИмен.Количество() - 1);
            ОбщаяГлубина = СтекИмен.Количество();

        ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда

            Если Стек.Количество() > 0 Тогда
                ТекБлок = Стек[Стек.Количество() - 1];
                Если ПустаяСтрока(ТекБлок.Имя)
                    И НЕ ТекБлок.СейчасВнутриТипа
                    И НЕ ТекБлок.СейчасВСинониме
                    И СтекИмен.Количество() = ТекБлок.ГлубинаОткрытия Тогда
                    ТекстУзла = СокрЛП(ЧтениеXML.Значение);
                    Если НЕ ПустаяСтрока(ТекстУзла) Тогда
                        ТекБлок.Имя = ТекстУзла;
                    КонецЕсли;
                КонецЕсли;
            КонецЕсли;

        КонецЕсли;

    КонецЦикла;

    ЧтениеXML.Закрыть();

    // ── второй проход: типы стандартных реквизитов ──
    // Свойства объекта (длины кода/номера) в XML идут до блока StandardAttributes,
    // но полагаться на порядок не будем — доразрешаем типы здесь.
    Для Сч = 0 По Результат.Количество() - 1 Цикл
        Эл = Результат[Сч];
        Если Эл.Тип = "@СТАНД@" Тогда
            ИмяСтанд = Эл.Путь;
            ТочкаПоз = СтрНайти(ИмяСтанд, ".");
            Пока ТочкаПоз > 0 Цикл
                ИмяСтанд = Сред(ИмяСтанд, ТочкаПоз + 1);
                ТочкаПоз = СтрНайти(ИмяСтанд, ".");
            КонецЦикла;
            НовыйТип = ТипСтандартногоРеквизита(ИмяСтанд, ТипОбъекта, ИмяОбъекта, СвойстваОбъекта);
            Эл.Тип = ?(ПустаяСтрока(НовыйТип), "—", НовыйТип);
        КонецЕсли;
    КонецЦикла;

    Возврат Результат;

КонецФункции

&НаКлиенте
Функция НаправлениеПараметра(Знач Сырое)

    Н = НРег(СокрЛП(Сырое));
    Если Н = "in" Тогда
        Возврат "вх";
    ИначеЕсли Н = "out" Тогда
        Возврат "исх";
    ИначеЕсли Н = "inout" Тогда
        Возврат "вх-исх";
    КонецЕсли;
    Возврат Сырое;

КонецФункции

&НаКлиенте
Функция СформироватьИмяПоЗапросу(Части)

    Если Части = Неопределено ИЛИ Части.Количество() = 0 Тогда
        Возврат "ОтветНаЗапрос";
    КонецЕсли;

    // Метки типов запроса. Хочешь "Scheme"/"Fetch" — поменяй значения справа.
    МеткиТипов = Новый Соответствие;
    МеткиТипов.Вставить("FETCH",  "FETCH");
    МеткиТипов.Вставить("SCHEMA", "SCHEMA");
    МеткиТипов.Вставить("SEARCH", "SEARCH");
    МеткиТипов.Вставить("DEPENDENCIES", "DEPS");
    МеткиТипов.Вставить("PROC",    "PROC");
    МеткиТипов.Вставить("REGION",  "REGION");
    МеткиТипов.Вставить("LINES",   "LINES");
    МеткиТипов.Вставить("OUTLINE", "OUTLINE");
    МеткиТипов.Вставить("FORM",    "FORM");
    МеткиТипов.Вставить("EVENTS",  "EVENTS");
    МеткиТипов.Вставить("SUBSYS",  "SUBSYS");

    ТипыВПорядке  = Новый Массив; // уникальные типы запроса в порядке появления
    ИменаВПорядке = Новый Массив; // уникальные имена объектов в порядке появления
    ВидетьТип = Новый Соответствие;
    ВидетьИмя = Новый Соответствие;

    Для Каждого ЗапросЭл Из Части Цикл

        ТипЗапр = ВРег(СокрЛП(ЗапросЭл.ТипЗапроса));
        Метка   = МеткиТипов.Получить(ТипЗапр);
        Если Метка = Неопределено Тогда
            Метка = ТипЗапр;
        КонецЕсли;
        Если НЕ ПустаяСтрока(Метка) И ВидетьТип.Получить(Метка) = Неопределено Тогда
            ВидетьТип.Вставить(Метка, Истина);
            ТипыВПорядке.Добавить(Метка);
        КонецЕсли;

        ЧастиОпций   = СтрРазделить(СокрЛП(ЗапросЭл.Часть), "|", Ложь);
        РабочаяЧасть = ?(ЧастиОпций.Количество() > 0, СокрЛП(ЧастиОпций[0]), "");

        СыроеИмя = "";

        Если ТипЗапр = "SEARCH" ИЛИ ТипЗапр = "SUBSYS" Тогда

            // у SUBSYS в запросе нет типа объекта — всё тело и есть имя
            СыроеИмя = РабочаяЧасть;

        ИначеЕсли ТипЗапр = "FORM" Тогда

            // имя формы информативнее имени объекта
            Сегменты = СтрРазделить(РабочаяЧасть, ".", Ложь);
            Если Сегменты.Количество() >= 1 Тогда
                СыроеИмя = СокрЛП(Сегменты[Сегменты.Количество() - 1]);
            КонецЕсли;

        ИначеЕсли ТипЗапр = "PROC" ИЛИ ТипЗапр = "REGION" Тогда

            // имя процедуры или области информативнее имени объекта
            ПозМетки = СтрНайти(РабочаяЧасть, "#");
            Если ПозМетки > 0 Тогда
                СыроеИмя = СокрЛП(Сред(РабочаяЧасть, ПозМетки + 1));
            Иначе
                Сегменты = СтрРазделить(РабочаяЧасть, ".", Ложь);
                Если Сегменты.Количество() >= 3 Тогда
                    СыроеИмя = СокрЛП(Сегменты[Сегменты.Количество() - 1]);
                ИначеЕсли Сегменты.Количество() >= 2 Тогда
                    СыроеИмя = СокрЛП(Сегменты[1]);
                КонецЕсли;
            КонецЕсли;

        ИначеЕсли ТипЗапр = "LINES" Тогда

            Сегменты = СтрРазделить(РабочаяЧасть, ".", Ложь);
            Если Сегменты.Количество() >= 2 Тогда
                СыроеИмя = СокрЛП(Сегменты[1]);
            КонецЕсли;

            ПозМетки = СтрНайти(РабочаяЧасть, "#", НаправлениеПоиска.СКонца);
            Если ПозМетки = 0 Тогда
                ПозМетки = СтрНайти(РабочаяЧасть, ":", НаправлениеПоиска.СКонца);
            КонецЕсли;
            Если ПозМетки > 0 Тогда
                СыроеИмя = СыроеИмя + "_" + СокрЛП(Сред(РабочаяЧасть, ПозМетки + 1));
            КонецЕсли;

        Иначе

            Сегменты = СтрРазделить(РабочаяЧасть, ".", Ложь);
            Если Сегменты.Количество() >= 2 Тогда
                СыроеИмя = СокрЛП(Сегменты[1]);
            КонецЕсли;

        КонецЕсли;

        Если НЕ ПустаяСтрока(СыроеИмя) Тогда
            ИмяОбъ = ОчиститьИмяФайла(СыроеИмя);
            Если НЕ ПустаяСтрока(ИмяОбъ) И ВидетьИмя.Получить(ИмяОбъ) = Неопределено Тогда
                ВидетьИмя.Вставить(ИмяОбъ, Истина);
                ИменаВПорядке.Добавить(ИмяОбъ);
            КонецЕсли;
        КонецЕсли;

    КонецЦикла;

    // Тип(ы): SCHEMA / FETCH / FETCH-SCHEMA
    ЧастьТипов = СтрСоединить(ТипыВПорядке, "-");

    // Имена объектов: не более 3, остальные сворачиваем в "_и_ещё_N"
    ЧастьИмён = "";
    Если ИменаВПорядке.Количество() > 0 Тогда
        Предел = 3;
        КолВыводимых = ИменаВПорядке.Количество();
        Если КолВыводимых > Предел Тогда
            КолВыводимых = Предел;
        КонецЕсли;
        ВыбранныеИмена = Новый Массив;
        Для Сч = 0 По КолВыводимых - 1 Цикл
            ВыбранныеИмена.Добавить(ИменаВПорядке[Сч]);
        КонецЦикла;
        ЧастьИмён = СтрСоединить(ВыбранныеИмена, "_");
        Если ИменаВПорядке.Количество() > Предел Тогда
            ЧастьИмён = ЧастьИмён + "_и_ещё_" + (ИменаВПорядке.Количество() - Предел);
        КонецЕсли;
    КонецЕсли;

    Если ПустаяСтрока(ЧастьТипов) И ПустаяСтрока(ЧастьИмён) Тогда
        Возврат "ОтветНаЗапрос";
    КонецЕсли;

    Сегм = Новый Массив;
    Сегм.Добавить("Запрос");
    Если НЕ ПустаяСтрока(ЧастьТипов) Тогда Сегм.Добавить(ЧастьТипов); КонецЕсли;
    Если НЕ ПустаяСтрока(ЧастьИмён) Тогда Сегм.Добавить(ЧастьИмён); КонецЕсли;

    Имя = СтрСоединить(Сегм, "_");

    Если СтрДлина(Имя) > 120 Тогда
        Имя = Лев(Имя, 120);
    КонецЕсли;

    Возврат Имя;

КонецФункции

&НаКлиенте
Функция ОчиститьИмяФайла(Знач Текст)

    Текст = СокрЛП(Текст);
    // Недопустимые в имени файла Windows + пробельные
    Запрещённые = "\/:*?" + """" + "<>|" + Символы.ПС + Символы.ВК + Символы.Таб;

    Результат = "";
    Для Сч = 1 По СтрДлина(Текст) Цикл
        С = Сред(Текст, Сч, 1);
        Если С = " " ИЛИ СтрНайти(Запрещённые, С) > 0 Тогда
            Результат = Результат + "_";
        Иначе
            Результат = Результат + С;
        КонецЕсли;
    КонецЦикла;

    Возврат Результат;

КонецФункции

&НаКлиенте
Функция СохранитьРезультатВФайл(ТекстМД, ИмяПоУмолчанию = "Результат", ДобавлятьМеткуВремени = Истина)

    // Возвращает полный путь сохранённого файла или пустую строку, если отменили.
    Если ПустаяСтрока(ТекстМД) Тогда
        Сообщить("Нет данных для сохранения.");
        Возврат "";
    КонецЕсли;

    Если ДобавлятьМеткуВремени Тогда
        ИмяФайла = ИмяПоУмолчанию + "_"
            + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd_HH-mm-ss")
            + ".md";
    Иначе
        ИмяФайла = ИмяПоУмолчанию + ".md";
    КонецЕсли;

    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
    Диалог.ПолноеИмяФайла = ИмяФайла;
    Диалог.Фильтр          = "Markdown файлы (*.md)|*.md|Текстовые файлы (*.txt)|*.txt|Все файлы (*.*)|*.*";
    Диалог.МножественныйВыбор = Ложь;
    Диалог.Заголовок       = "Сохранить результат";

    Если НЕ Диалог.Выбрать() Тогда
        Возврат "";
    КонецЕсли;

    ПутьСохранения = Диалог.ПолноеИмяФайла;

    Если НЕ ЗаписатьТекстВФайл(ПутьСохранения, ТекстМД) Тогда
        Возврат "";
    КонецЕсли;

    Сообщить("Файл сохранён: " + ПутьСохранения);
    Возврат ПутьСохранения;

КонецФункции

&НаКлиенте
Процедура КаталогНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;

    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
    Диалог.Заголовок          = "Укажите корневой каталог выгруженной конфигурации";
    Диалог.МножественныйВыбор  = Ложь;

    Если НЕ ПустаяСтрока(КореньКаталога) Тогда
        ФТек = Новый Файл(КореньКаталога);
        Если ФТек.Существует() Тогда
            Диалог.Каталог = КореньКаталога;
        КонецЕсли;
    КонецЕсли;

    Если НЕ Диалог.Выбрать() Тогда
        Возврат;
    КонецЕсли;

    ВыбранныйПуть = Диалог.Каталог;

    // Мягкая проверка: похоже ли на корень выгрузки конфигурации
    КонтрольныеПапки = Новый Массив;
    КонтрольныеПапки.Добавить("CommonModules");
    КонтрольныеПапки.Добавить("Catalogs");
    КонтрольныеПапки.Добавить("Documents");

    ПохожеНаКонфигурацию = Ложь;
    Для Каждого ИмяП Из КонтрольныеПапки Цикл
        ФП = Новый Файл(ВыбранныйПуть + "\" + ИмяП);
        Если ФП.Существует() Тогда
            ПохожеНаКонфигурацию = Истина;
            Прервать;
        КонецЕсли;
    КонецЦикла;

    КореньКаталога = ВыбранныйПуть;

    Если НЕ ПохожеНаКонфигурацию Тогда
        Сообщить("⚠️ В выбранной папке не найдены типовые каталоги (CommonModules / Catalogs / Documents). Проверь, что это корень выгрузки.");
    КонецЕсли;

КонецПроцедуры

