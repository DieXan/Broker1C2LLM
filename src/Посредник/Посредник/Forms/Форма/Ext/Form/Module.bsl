&НаКлиенте
Процедура ВыполнитьАнализЗависимостей(Строки, Знач ТелоЗапроса)

    // ── разбор запроса ──
    ЧастиЗапроса = СтрРазделить(ТелоЗапроса, "|", Ложь);
    Если ЧастиЗапроса.Количество() = 0 Тогда
        Строки.Добавить("Пустой запрос DEPENDENCIES.");
        Возврат;
    КонецЕсли;

    ЦельПолная = СокрЛП(ЧастиЗапроса[0]);
    Сегменты   = СтрРазделить(ЦельПолная, ".", Ложь);
    Если Сегменты.Количество() < 2 Тогда
        Строки.Добавить("Ожидается `DEPENDENCIES:Тип.ИмяОбъекта`, получено: `" + ЦельПолная + "`");
        Возврат;
    КонецЕсли;

    ТипОбъекта = СокрЛП(Сегменты[0]);
    ИмяОбъекта = СокрЛП(Сегменты[1]);

    ИскатьИсходящие = Ложь;
    ИскатьВходящие  = Ложь;
    НаправлениеЗадано = Ложь;
    МаксРезультатов = 100;
    ФильтрТипов = Новый Соответствие;

    Для Сч = 1 По ЧастиЗапроса.Количество() - 1 Цикл

        Опц     = СокрЛП(ЧастиЗапроса[Сч]);
        ОпцНРег = НРег(Опц);

        Если ОпцНРег = "out" Тогда
            ИскатьИсходящие   = Истина;
            НаправлениеЗадано = Истина;
        ИначеЕсли ОпцНРег = "rev" Тогда
            ИскатьВходящие    = Истина;
            НаправлениеЗадано = Истина;
        ИначеЕсли ОпцНРег = "all" Тогда
            ИскатьИсходящие   = Истина;
            ИскатьВходящие    = Истина;
            НаправлениеЗадано = Истина;
        ИначеЕсли СтрНачинаетсяС(ОпцНРег, "max=") Тогда
            Попытка
                МаксРезультатов = Число(СокрЛП(Сред(Опц, 5)));
            Исключение
                Строки.Добавить("Не разобрал `max=` — взял 100.");
                МаксРезультатов = 100;
            КонецПопытки;
            Если МаксРезультатов < 1 Тогда
                МаксРезультатов = 100;
            КонецЕсли;
        ИначеЕсли СтрНачинаетсяС(ОпцНРег, "in=") Тогда
            СписокТипов = СтрРазделить(Сред(Опц, 4), ",", Ложь);
            Для Каждого ТипЭл Из СписокТипов Цикл
                ТипЭл = СокрЛП(ТипЭл);
                Если НЕ ПустаяСтрока(ТипЭл) Тогда
                    ФильтрТипов.Вставить(НРег(ТипЭл), Истина);
                КонецЕсли;
            КонецЦикла;
        Иначе
            Строки.Добавить("Неизвестная опция: `" + Опц + "` — пропущена.");
        КонецЕсли;

    КонецЦикла;

    Если НЕ НаправлениеЗадано Тогда
        ИскатьИсходящие = Истина;
        ИскатьВходящие  = Истина;
    КонецЕсли;

    ПутьОбъекта = КореньКаталога + "\" + ТипОбъекта + "\" + ИмяОбъекта;
    ФОб = Новый Файл(ПутьОбъекта);
    Если НЕ ФОб.Существует() Тогда
        Строки.Добавить("Не найден объект: `" + ЦельПолная + "`");
        Строки.Добавить("Ожидался каталог: " + ПутьОбъекта);
        Возврат;
    КонецЕсли;

    КоллекцииРус  = КоллекцииМенеджеров();
    СсылочныеТипы = СсылочныеТипыВПапки();

    // ── 1. исходящие ──
    ОбщиеМодулиНайдены = Новый Соответствие;
    МенеджерыНайдены   = Новый Соответствие;
    ТипыРеквизитов     = Новый Соответствие;
    ФайловПрочитано    = 0;

    Если ИскатьИсходящие Тогда

        Состояние("Анализ: код объекта...");

        ИмЕнаОМ = ИменаОбщихМодулей();
        ФайлыМод = ФайлыМодулейОбъекта(ПутьОбъекта);

        Для Каждого ФМ Из ФайлыМод Цикл

            КодМод = ПрочитатьФайлБезопасно(ФМ.ПолноеИмя);
            Если ПустаяСтрока(КодМод) Тогда
                Продолжить;
            КонецЕсли;
            ФайловПрочитано = ФайловПрочитано + 1;

            КодМод       = КодБезКомментариев(КодМод);
            КускиПоТочке = СтрРазделить(КодМод, ".", Истина);

            Для Инд = 0 По КускиПоТочке.Количество() - 2 Цикл

                Слева = ИдентификаторСКонца(КускиПоТочке[Инд]);
                Если ПустаяСтрока(Слева) Тогда
                    Продолжить;
                КонецЕсли;

                // общий модуль?
                ОригИмя = ИмЕнаОМ.Получить(НРег(Слева));
                Если ОригИмя <> Неопределено Тогда
                    ОбщиеМодулиНайдены.Вставить(ОригИмя, Истина);
                    Продолжить;
                КонецЕсли;

                // менеджер коллекции?
                ПапкаКолл = КоллекцииРус.Получить(Слева);
                Если ПапкаКолл <> Неопределено Тогда
                    Справа = ИдентификаторСНачала(КускиПоТочке[Инд + 1]);
                    Если НЕ ПустаяСтрока(Справа)
                        И НЕ (ПапкаКолл = ТипОбъекта И Справа = ИмяОбъекта) Тогда
                        МенеджерыНайдены.Вставить(ПапкаКолл + "." + Справа, Истина);
                    КонецЕсли;
                КонецЕсли;

            КонецЦикла;

        КонецЦикла;

        // типы реквизитов
        Состояние("Анализ: типы реквизитов...");
        ПутьXMLЦели = КореньКаталога + "\" + ТипОбъекта + "\" + ИмяОбъекта + ".xml";
        ФXMLЦ = Новый Файл(ПутьXMLЦели);
        Если ФXMLЦ.Существует() Тогда
            РеквизитыЦели = Неопределено;
            Попытка
                РеквизитыЦели = ПрочитатьСхемуОбъекта(ПутьXMLЦели, ТипОбъекта, ИмяОбъекта);
            Исключение
                РеквизитыЦели = Неопределено;
            КонецПопытки;

            Если РеквизитыЦели <> Неопределено Тогда
                Для Каждого Р Из РеквизитыЦели Цикл
                    ЧастиТипа = СтрРазделить(Р.Тип, ",", Ложь);
                    Для Каждого ОдинТип Из ЧастиТипа Цикл
                        ОдинТип = СокрЛП(ОдинТип);
                        ТочкаП  = СтрНайти(ОдинТип, ".");
                        Если ТочкаП = 0 Тогда
                            Продолжить;
                        КонецЕсли;
                        ВидСсылки = Лев(ОдинТип, ТочкаП - 1);
                        ИмяЦели   = Сред(ОдинТип, ТочкаП + 1);
                        ПапкаЦели = СсылочныеТипы.Получить(ВидСсылки);
                        Если ПапкаЦели = Неопределено ИЛИ ПустаяСтрока(ИмяЦели) Тогда
                            Продолжить;
                        КонецЕсли;
                        Если ПапкаЦели = ТипОбъекта И ИмяЦели = ИмяОбъекта Тогда
                            Продолжить;
                        КонецЕсли;
                        КлючТ = ПапкаЦели + "." + ИмяЦели;
                        СписокРекв = ТипыРеквизитов.Получить(КлючТ);
                        Если СписокРекв = Неопределено Тогда
                            СписокРекв = Новый Массив;
                            ТипыРеквизитов.Вставить(КлючТ, СписокРекв);
                        КонецЕсли;
                        Если СписокРекв.Количество() < 5 Тогда
                            СписокРекв.Добавить(Р.Путь);
                        КонецЕсли;
                    КонецЦикла;
                КонецЦикла;
            КонецЕсли;
        КонецЕсли;

    КонецЕсли;

    // ── 2. входящие ──
    ВходящиеКод  = Новый Массив;
    ВходящиеТипы = Новый Массив;
    ПросмотреноОбъектов = 0;
    ПросмотреноФайлов   = 0;
    ДостигнутЛимит      = Ложь;

    Если ИскатьВходящие Тогда

        // шаблоны, по которым узнаём обращение к цели
        Шаблоны = Новый Массив;
        Если ТипОбъекта = "CommonModules" Тогда
            Шаблоны.Добавить(ИмяОбъекта + ".");
        Иначе
            Для Каждого КПК Из КоллекцииРус Цикл
                Если КПК.Значение = ТипОбъекта Тогда
                    Шаблоны.Добавить(КПК.Ключ + "." + ИмяОбъекта);
                КонецЕсли;
            КонецЦикла;
            Для Каждого КПС Из СсылочныеТипы Цикл
                Если КПС.Значение = ТипОбъекта Тогда
                    Шаблоны.Добавить(КПС.Ключ + "." + ИмяОбъекта);
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;

        ИскомыйТипРеквизита = "";
        Для Каждого КПС Из СсылочныеТипы Цикл
            Если КПС.Значение = ТипОбъекта Тогда
                ИскомыйТипРеквизита = КПС.Ключ + "." + ИмяОбъекта;
                Прервать;
            КонецЕсли;
        КонецЦикла;

        ПропускатьПрефиксы = Новый Массив;
        ПропускатьПрефиксы.Добавить("Удалить");

        ТипыОбъектов = ТипыОбъектовКонфигурации();

        Для Каждого КП Из ТипыОбъектов Цикл

            Если ДостигнутЛимит Тогда
                Прервать;
            КонецЕсли;

            ТипПапкиТек = КП.Ключ;

            Если ФильтрТипов.Количество() > 0
                И ФильтрТипов.Получить(НРег(ТипПапкиТек)) = Неопределено Тогда
                Продолжить;
            КонецЕсли;

            ПутьПапкиТек = КореньКаталога + "\" + ТипПапкиТек;
            ФПТ = Новый Файл(ПутьПапкиТек);
            Если НЕ ФПТ.Существует() Тогда
                Продолжить;
            КонецЕсли;

            Состояние("Анализ: кто ссылается — " + КП.Значение + "...");

            ПапкиОбъектов = ОбъектыТипа(ПутьПапкиТек);

            Для Каждого ПапкаОб Из ПапкиОбъектов Цикл

                Если ДостигнутЛимит Тогда
                    Прервать;
                КонецЕсли;

                Если ТипПапкиТек = ТипОбъекта И ПапкаОб.Имя = ИмяОбъекта Тогда
                    Продолжить;
                КонецЕсли;

                ПросмотреноОбъектов = ПросмотреноОбъектов + 1;
                ИмяТек = ТипПапкиТек + "." + ПапкаОб.Имя;

                // код
                ФайлыТек = Новый Массив;
                Если ПапкаОб.ЕстьПапка Тогда
                    ФайлыТек = НайтиФайлы(ПапкаОб.ПутьПапки, "*.bsl", Истина);
                КонецЕсли;
                Для Каждого ФТ Из ФайлыТек Цикл

                    Если НЕ ФТ.ЭтоФайл() Тогда
                        Продолжить;
                    КонецЕсли;

                    ПросмотреноФайлов = ПросмотреноФайлов + 1;
                    КодТек = ПрочитатьФайлБезопасно(ФТ.ПолноеИмя);
                    Если ПустаяСтрока(КодТек) Тогда
                        Продолжить;
                    КонецЕсли;

                    КодТекНРег = НРег(КодТек);
                    НашлиШаблон = "";
                    Для Каждого Ш Из Шаблоны Цикл
                        Если СтрНайти(КодТекНРег, НРег(Ш)) > 0 Тогда
                            НашлиШаблон = Ш;
                            Прервать;
                        КонецЕсли;
                    КонецЦикла;

                    Если ПустаяСтрока(НашлиШаблон) Тогда
                        Продолжить;
                    КонецЕсли;

                    КлючМ = КлючМодуляПоПути(ПапкаОб.ПутьПапки, ФТ.ПолноеИмя);
                    Эл = Новый Структура("Объект, Модуль, Ключ, Шаблон");
                    Эл.Объект  = ИмяТек;
                    Эл.Модуль  = ?(ПустаяСтрока(КлючМ), ФТ.Имя, КлючМ);
                    Эл.Ключ    = КлючМ;
                    Эл.Шаблон  = НашлиШаблон;
                    ВходящиеКод.Добавить(Эл);

                    Если ВходящиеКод.Количество() + ВходящиеТипы.Количество() >= МаксРезультатов Тогда
                        ДостигнутЛимит = Истина;
                        Прервать;
                    КонецЕсли;

                КонецЦикла;

                // реквизиты, ссылающиеся на цель
                Если НЕ ДостигнутЛимит И НЕ ПустаяСтрока(ИскомыйТипРеквизита) Тогда

                    ПутьXMLТек = ПапкаОб.ПутьXML;
                    Если ПапкаОб.ЕстьXML Тогда

                        РеквТек = Неопределено;
                        Попытка
                            РеквТек = ПрочитатьСхемуОбъекта(ПутьXMLТек, ТипПапкиТек, ПапкаОб.Имя);
                        Исключение
                            РеквТек = Неопределено;
                        КонецПопытки;

                        Если РеквТек <> Неопределено Тогда
                            Для Каждого РТ Из РеквТек Цикл
                                Если СтрНайти(НРег(РТ.Тип), НРег(ИскомыйТипРеквизита)) > 0 Тогда
                                    Эл2 = Новый Структура("Объект, Реквизит, Тип",
                                        ИмяТек, РТ.Путь, РТ.Тип);
                                    ВходящиеТипы.Добавить(Эл2);
                                    Если ВходящиеКод.Количество() + ВходящиеТипы.Количество()
                                        >= МаксРезультатов Тогда
                                        ДостигнутЛимит = Истина;
                                        Прервать;
                                    КонецЕсли;
                                КонецЕсли;
                            КонецЦикла;
                        КонецЕсли;

                    КонецЕсли;

                КонецЕсли;

            КонецЦикла;

        КонецЦикла;

    КонецЕсли;

    // ── вывод ──
    Строки.Добавить("---");
    Строки.Добавить("## Зависимости: `" + ТипОбъекта + "." + ИмяОбъекта + "`");
    Строки.Добавить("");

    Направления = Новый Массив;
    Если ИскатьИсходящие Тогда Направления.Добавить("исходящие"); КонецЕсли;
    Если ИскатьВходящие Тогда Направления.Добавить("входящие"); КонецЕсли;
    Строки.Добавить("> Направление: " + СтрСоединить(Направления, ", "));
    Если ИскатьИсходящие Тогда
        Строки.Добавить("> Прочитано модулей объекта: " + ФайловПрочитано);
    КонецЕсли;
    Если ИскатьВходящие Тогда
        Строки.Добавить("> Просмотрено объектов: " + ПросмотреноОбъектов
            + ", файлов кода: " + ПросмотреноФайлов);
    КонецЕсли;
    Если ДостигнутЛимит Тогда
        Строки.Добавить("> ⚠ Достигнут лимит " + МаксРезультатов
            + " входящих связей — обход остановлен. Сузь `in=` или подними `max=`.");
    КонецЕсли;
    Строки.Добавить("");

    Если ИскатьИсходящие Тогда

        Строки.Добавить("### → Вызываемые общие модули (" + ОбщиеМодулиНайдены.Количество() + ")");
        Строки.Добавить("");
        Если ОбщиеМодулиНайдены.Количество() = 0 Тогда
            Строки.Добавить("Не найдено.");
        Иначе
            Строки.Добавить("| Общий модуль | Запрос |");
            Строки.Добавить("|---|---|");
            Для Каждого КПМ Из ОбщиеМодулиНайдены Цикл
                Строки.Добавить("| `CommonModules." + КПМ.Ключ
                    + "` | `FETCH:CommonModules." + КПМ.Ключ + ".module` |");
            КонецЦикла;
        КонецЕсли;
        Строки.Добавить("");

        Строки.Добавить("### → Объекты в реквизитах (" + ТипыРеквизитов.Количество() + ")");
        Строки.Добавить("");
        Если ТипыРеквизитов.Количество() = 0 Тогда
            Строки.Добавить("Не найдено.");
        Иначе
            Строки.Добавить("| Объект | Через реквизиты | Запрос |");
            Строки.Добавить("|---|---|---|");
            Для Каждого КПТ Из ТипыРеквизитов Цикл
                Строки.Добавить("| `" + КПТ.Ключ + "` | " + СтрСоединить(КПТ.Значение, ", ")
                    + " | `SCHEMA:" + КПТ.Ключ + "` |");
            КонецЦикла;
        КонецЕсли;
        Строки.Добавить("");

        Строки.Добавить("### → Обращения к менеджерам в коде (" + МенеджерыНайдены.Количество() + ")");
        Строки.Добавить("");
        Если МенеджерыНайдены.Количество() = 0 Тогда
            Строки.Добавить("Не найдено.");
        Иначе
            Строки.Добавить("| Объект | Запрос |");
            Строки.Добавить("|---|---|");
            Для Каждого КПН Из МенеджерыНайдены Цикл
                Строки.Добавить("| `" + КПН.Ключ + "` | `SCHEMA:" + КПН.Ключ + "` |");
            КонецЦикла;
        КонецЕсли;
        Строки.Добавить("");

    КонецЕсли;

    Если ИскатьВходящие Тогда

        Строки.Добавить("### ← Ссылаются в коде (" + ВходящиеКод.Количество() + ")");
        Строки.Добавить("");
        Если ВходящиеКод.Количество() = 0 Тогда
            Строки.Добавить("Не найдено.");
        Иначе
            Строки.Добавить("| Объект | Модуль | По шаблону | Запрос |");
            Строки.Добавить("|---|---|---|---|");
            Для Каждого ЭВ Из ВходящиеКод Цикл
                Если ПустаяСтрока(ЭВ.Ключ) Тогда
                    ЗапрТ = "—";
                Иначе
                    ЗапрТ = "`FETCH:" + ЭВ.Объект + "." + ЭВ.Ключ + "`";
                КонецЕсли;
                Строки.Добавить("| `" + ЭВ.Объект + "` | " + ЭВ.Модуль
                    + " | `" + ЭВ.Шаблон + "` | " + ЗапрТ + " |");
            КонецЦикла;
        КонецЕсли;
        Строки.Добавить("");

        Строки.Добавить("### ← Ссылаются реквизитами (" + ВходящиеТипы.Количество() + ")");
        Строки.Добавить("");
        Если ВходящиеТипы.Количество() = 0 Тогда
            Строки.Добавить("Не найдено.");
        Иначе
            Строки.Добавить("| Объект | Реквизит | Тип | Запрос |");
            Строки.Добавить("|---|---|---|---|");
            Для Каждого ЭТ Из ВходящиеТипы Цикл
                Строки.Добавить("| `" + ЭТ.Объект + "` | `" + ЭТ.Реквизит
                    + "` | " + ЭТ.Тип + " | `SCHEMA:" + ЭТ.Объект + "` |");
            КонецЦикла;
        КонецЕсли;
        Строки.Добавить("");

    КонецЕсли;

    // ── граф ──
    Строки.Добавить("### Граф зависимостей");
    Строки.Добавить("");
    Строки.Добавить("```mermaid");
    Строки.Добавить("graph LR");

    УзлыКарта = Новый Соответствие;
    КлючЦели  = ТипОбъекта + "." + ИмяОбъекта;
    ИдЦели    = ИдентификаторУзла(КлючЦели, УзлыКарта);

    Строки.Добавить("    " + ИдЦели + "[""" + КлючЦели + """]");

    МаксУзловНаГруппу = 12;
    ОписанияУзлов = Новый Массив;
    Связи         = Новый Массив;

    Если ИскатьИсходящие Тогда
        Сч2 = 0;
        Для Каждого КПМ Из ОбщиеМодулиНайдены Цикл
            Если Сч2 >= МаксУзловНаГруппу Тогда Прервать; КонецЕсли;
            КлючУ = "CommonModules." + КПМ.Ключ;
            ИдУ   = ИдентификаторУзла(КлючУ, УзлыКарта);
            ОписанияУзлов.Добавить("    " + ИдУ + "[""" + КлючУ + """]");
            Связи.Добавить("    " + ИдЦели + " -->|вызов| " + ИдУ);
            Сч2 = Сч2 + 1;
        КонецЦикла;

        Сч2 = 0;
        Для Каждого КПТ Из ТипыРеквизитов Цикл
            Если Сч2 >= МаксУзловНаГруппу Тогда Прервать; КонецЕсли;
            ИдУ = ИдентификаторУзла(КПТ.Ключ, УзлыКарта);
            ОписанияУзлов.Добавить("    " + ИдУ + "[""" + КПТ.Ключ + """]");
            Связи.Добавить("    " + ИдЦели + " -->|реквизит| " + ИдУ);
            Сч2 = Сч2 + 1;
        КонецЦикла;

        Сч2 = 0;
        Для Каждого КПН Из МенеджерыНайдены Цикл
            Если Сч2 >= МаксУзловНаГруппу Тогда Прервать; КонецЕсли;
            // объект уже показан как реквизит — второе ребро не рисуем
            Если ТипыРеквизитов.Получить(КПН.Ключ) <> Неопределено Тогда
                Продолжить;
            КонецЕсли;
            ИдУ = ИдентификаторУзла(КПН.Ключ, УзлыКарта);
            ОписанияУзлов.Добавить("    " + ИдУ + "[""" + КПН.Ключ + """]");
            Связи.Добавить("    " + ИдЦели + " -->|менеджер| " + ИдУ);
            Сч2 = Сч2 + 1;
        КонецЦикла;
    КонецЕсли;

    Если ИскатьВходящие Тогда
        ВходящиеУникальные = Новый Соответствие;
        Для Каждого ЭВ Из ВходящиеКод Цикл
            ВходящиеУникальные.Вставить(ЭВ.Объект, "код");
        КонецЦикла;
        Для Каждого ЭТ Из ВходящиеТипы Цикл
            МеткаТек = ВходящиеУникальные.Получить(ЭТ.Объект);
            Если МеткаТек = Неопределено Тогда
                ВходящиеУникальные.Вставить(ЭТ.Объект, "реквизит");
            ИначеЕсли МеткаТек = "код" Тогда
                ВходящиеУникальные.Вставить(ЭТ.Объект, "код + реквизит");
            КонецЕсли;
        КонецЦикла;

        Сч2 = 0;
        Для Каждого КПВ Из ВходящиеУникальные Цикл
            Если Сч2 >= МаксУзловНаГруппу Тогда Прервать; КонецЕсли;
            ИдУ = ИдентификаторУзла(КПВ.Ключ, УзлыКарта);
            ОписанияУзлов.Добавить("    " + ИдУ + "[""" + КПВ.Ключ + """]");
            Связи.Добавить("    " + ИдУ + " -->|" + КПВ.Значение + "| " + ИдЦели);
            Сч2 = Сч2 + 1;
        КонецЦикла;
    КонецЕсли;

    Для Каждого ОУ Из ОписанияУзлов Цикл
        Строки.Добавить(ОУ);
    КонецЦикла;
    Для Каждого СВ Из Связи Цикл
        Строки.Добавить(СВ);
    КонецЦикла;

    Строки.Добавить("    style " + ИдЦели + " fill:#ffe0b2,stroke:#e65100,stroke-width:2px");
    Строки.Добавить("```");
    Строки.Добавить("");

КонецПроцедуры

