// Папка объекта; у модулей конфигурации — корень выгрузки (там лежит Ext).
&НаКлиенте
Функция БазовыйПутьПоАдресу(Адрес)

    Если НРег(Адрес.ТипОбъекта) = "configuration" Тогда
        Корень = КореньКаталога;
        Пока СтрЗаканчиваетсяНа(Корень, "\") Цикл
            Корень = Лев(Корень, СтрДлина(Корень) - 1);
        КонецЦикла;
        Возврат Корень;
    КонецЕсли;
    Возврат КореньКаталога + "\" + Адрес.ТипОбъекта + "\" + Адрес.ИмяОбъекта;

КонецФункции

&НаКлиенте
Функция РазобратьАдресОбъекта(Знач Адрес)

    Рез = Новый Структура("ТипОбъекта,ИмяОбъекта,КлючМодуля,Ошибка", "", "", "", "");

    Сегм = СтрРазделить(СокрЛП(Адрес), ".", Ложь);

    // модули конфигурации: Configuration.managedapplication — имени объекта нет,
    // второй сегмент сразу ключ модуля (корневая папка Ext выгрузки)
    Если Сегм.Количество() > 0 И НРег(СокрЛП(Сегм[0])) = "configuration" Тогда
        Рез.ТипОбъекта = "Configuration";
        Если Сегм.Количество() > 1 Тогда
            Рез.КлючМодуля = СокрЛП(Сегм[1]);
        КонецЕсли;
        Возврат Рез;
    КонецЕсли;

    Если Сегм.Количество() < 2 Тогда
        Рез.Ошибка = "Ожидается `Тип.ИмяОбъекта` или `Тип.ИмяОбъекта.модуль`";
        Возврат Рез;
    КонецЕсли;

    Рез.ТипОбъекта = СокрЛП(Сегм[0]);
    Рез.ИмяОбъекта = СокрЛП(Сегм[1]);

    Если Сегм.Количество() > 2 Тогда
        ХвостАдреса = Новый Массив;
        Для Сч = 2 По Сегм.Количество() - 1 Цикл
            ХвостАдреса.Добавить(СокрЛП(Сегм[Сч]));
        КонецЦикла;
        Рез.КлючМодуля = СтрСоединить(ХвостАдреса, ".");
    КонецЕсли;

    Возврат Рез;

