&НаКлиенте
Функция СсылкаНаОбъектМетаданных(Знач СыраяСсылка)

    // "Catalog.Контрагенты" → Структура(Папка, Имя, Запрос)
    Рез = Новый Структура("Папка, Имя, Запрос, Исходная");
    Рез.Папка    = "";
    Рез.Имя      = "";
    Рез.Запрос   = "";
    Рез.Исходная = СыраяСсылка;

    ТочкаПоз = СтрНайти(СыраяСсылка, ".");
    Если ТочкаПоз = 0 Тогда
        Возврат Рез;
    КонецЕсли;

    Класс = Лев(СыраяСсылка, ТочкаПоз - 1);
    Имя   = Сред(СыраяСсылка, ТочкаПоз + 1);

    // У ссылок на объект-тип бывают суффиксы: DocumentObject, CatalogRef и т.п.
    Для Каждого Суффикс Из СуффиксыКлассовМетаданных() Цикл
        Если СтрЗаканчиваетсяНа(НРег(Класс), НРег(Суффикс)) Тогда
            Класс = Лев(Класс, СтрДлина(Класс) - СтрДлина(Суффикс));
            Прервать;
        КонецЕсли;
    КонецЦикла;

    Папка = ПапкаПоКлассуМетаданных(Класс);
    Если ПустаяСтрока(Папка) Тогда
        Возврат Рез;
    КонецЕсли;

    Рез.Папка  = Папка;
    Рез.Имя    = Имя;
    Рез.Запрос = "SCHEMA:" + Папка + "." + Имя;

    Возврат Рез;

КонецФункции

