&НаКлиенте
Процедура СформироватьМД(Команда)

    Если ПустаяСтрока(КореньКаталога) Тогда
        Сообщить("Укажи путь к конфигурации");
        Возврат;
    КонецЕсли;

    ФКорень = Новый Файл(КореньКаталога);
    Если НЕ ФКорень.Существует() Тогда
        Сообщить("Каталог не найден: " + КореньКаталога);
        Возврат;
    КонецЕсли;

    ШапкаКонф = ПрочитатьШапкуКонфигурации();

    СтрокиОсн = Новый Массив;
    СтрокиДоп = Новый Массив;

    // Кэш шапок и связей — пишется в каталог временных файлов,
    // исходная выгрузка конфигурации не трогается.
    СтрокиКэша = Новый Массив;
    СтрокиКэша.Добавить("#ROOT" + Символы.Таб + КореньКаталога + Символы.Таб
        + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd HH:mm:ss"));

    ТипыОбъектов = ТипыОбъектовКонфигурации();

    ВсегоОсн    = 0;
    ВсегоДоп    = 0;
    ВсегоСКодом = 0;

    СводкаОсн = Новый Массив;
    СводкаДоп = Новый Массив;

    ТелоОсн = Новый Массив;
    ТелоДоп = Новый Массив;

    Для Каждого КП Из ТипыОбъектов Цикл

        ТипПапки = КП.Ключ;
        ТипРус   = КП.Значение;
        ЭтоДоп   = (КП.Группа = "Доп");

        ПутьПапки = КореньКаталога + "\" + ТипПапки;
        ФП = Новый Файл(ПутьПапки);
        Если НЕ ФП.Существует() Тогда
            Продолжить;
        КонецЕсли;

        Состояние("Карта: " + ТипРус + "...");

        Объекты = ОбъектыТипа(ПутьПапки);
        Если Объекты.Количество() = 0 Тогда
            Продолжить;
        КонецЕсли;

        СтрокиТаблицы = Новый Массив;

        Для Каждого Об Из Объекты Цикл

            Синоним = "";
            Если Об.ЕстьXML Тогда
                Шапка = ПрочитатьШапкуОбъекта(Об.ПутьXML);
                Если СинонимОтличается(Об.Имя, Шапка.Синоним) Тогда
                    Синоним = Шапка.Синоним;
                КонецЕсли;
                СтрокиКэша.Добавить("H" + Символы.Таб + ТипПапки + Символы.Таб
                    + Об.Имя + Символы.Таб + ОчиститьДляКэша(Шапка.Синоним)
                    + Символы.Таб + ОчиститьДляКэша(Шапка.Подсказка));
            КонецЕсли;

            Признаки = ПризнакиКодаОбъекта(Об.ПутьПапки);
            Если Признаки.ЕстьКод Тогда
                ВсегоСКодом = ВсегоСКодом + 1;
            КонецЕсли;

            СтрокиТаблицы.Добавить("| " + Об.Имя
                + " | " + ЭкранироватьЯчейку(Синоним, 120)
                + " | " + Признаки.Флаги + " |");

        КонецЦикла;

        Если ЭтоДоп Тогда
            Приёмник = ТелоДоп;
            ВсегоДоп = ВсегоДоп + Объекты.Количество();
            СводкаДоп.Добавить("| " + ТипРус + " | `" + ТипПапки + "` | "
                + ЧислоВСтроку(Объекты.Количество()) + " |");
        Иначе
            Приёмник = ТелоОсн;
            ВсегоОсн = ВсегоОсн + Объекты.Количество();
            СводкаОсн.Добавить("| " + ТипРус + " | `" + ТипПапки + "` | "
                + ЧислоВСтроку(Объекты.Количество()) + " |");
        КонецЕсли;

        Приёмник.Добавить("---");
        Приёмник.Добавить("## " + ТипРус + " · `" + ТипПапки + "` ("
            + ЧислоВСтроку(Объекты.Количество()) + ")");
        Приёмник.Добавить("");
        Приёмник.Добавить("| Объект | Синоним | Код |");
        Приёмник.Добавить("|---|---|---|");
        Для Каждого С Из СтрокиТаблицы Цикл
            Приёмник.Добавить(С);
        КонецЦикла;
        Приёмник.Добавить("");

    КонецЦикла;

    // ── модули конфигурации (корневая папка Ext) ──
    МодулиКонф = МодулиКонфигурации();
    Если МодулиКонф.Количество() > 0 Тогда
        ВсегоОсн = ВсегоОсн + МодулиКонф.Количество();
        ВсегоСКодом = ВсегоСКодом + МодулиКонф.Количество();
        СводкаОсн.Добавить("| МодулиКонфигурации | `Configuration` | "
            + ЧислоВСтроку(МодулиКонф.Количество()) + " |");
        ТелоОсн.Добавить("---");
        ТелоОсн.Добавить("## МодулиКонфигурации · `Configuration` ("
            + ЧислоВСтроку(МодулиКонф.Количество()) + ")");
        ТелоОсн.Добавить("");
        ТелоОсн.Добавить("| Объект | Синоним | Код |");
        ТелоОсн.Добавить("|---|---|---|");
        Для Каждого М Из МодулиКонф Цикл
            ТелоОсн.Добавить("| " + М.Ключ + " | " + М.Представление + " | Мод |");
        КонецЦикла;
        ТелоОсн.Добавить("");
    КонецЕсли;

    // ── кэш подписок на события и регистраторов ──
    Состояние("Кэш: подписки на события...");
    Для Каждого П Из ВсеПодпискиНаСобытия() Цикл
        СтрокиКэша.Добавить("S" + Символы.Таб + П.Имя + Символы.Таб
            + СтрСоединить(П.Источники, ",") + Символы.Таб
            + П.Событие + Символы.Таб + П.Обработчик);
    КонецЦикла;

    Состояние("Кэш: регистраторы...");
    Для Каждого Р Из ВсеРегистраторы() Цикл
        СтрокиКэша.Добавить("R" + Символы.Таб + Р.Ключ + Символы.Таб
            + СтрСоединить(Р.Значение, ","));
    КонецЦикла;

    // ── сборка файлов ──
    ЗаголовокКарты(СтрокиОсн, "Основная", ШапкаКонф, ВсегоОсн, ВсегоСКодом, СводкаОсн);
    Для Каждого С Из ТелоОсн Цикл
        СтрокиОсн.Добавить(С);
    КонецЦикла;
    СтрокиОсн.Добавить("---");
    СтрокиОсн.Добавить("**Объектов в этом файле: " + ЧислоВСтроку(ВсегоОсн)
        + "** · из них с кодом: " + ЧислоВСтроку(ВсегоСКодом));

    ЗаголовокКарты(СтрокиДоп, "Дополнительная", ШапкаКонф, ВсегоДоп, 0, СводкаДоп);
    Для Каждого С Из ТелоДоп Цикл
        СтрокиДоп.Добавить(С);
    КонецЦикла;
    СтрокиДоп.Добавить("---");
    СтрокиДоп.Добавить("**Объектов в этом файле: " + ЧислоВСтроку(ВсегоДоп) + "**");

    ПутьОсн = СохранитьРезультатВФайл(СтрСоединить(СтрокиОсн, Символы.ПС),
        "ОсновнаяКонфигурация");
    Если ПустаяСтрока(ПутьОсн) Тогда
        Сообщить("Сохранение отменено.");
        Возврат;
    КонецЕсли;

    ФОсн = Новый Файл(ПутьОсн);
    ПутьДоп = ФОсн.Путь + "ДополнительныеДанные_"
        + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd_HH-mm-ss") + ".md";
    Если ЗаписатьТекстВФайл(ПутьДоп, СтрСоединить(СтрокиДоп, Символы.ПС)) Тогда
        Сообщить("Файл сохранён: " + ПутьДоп);
    КонецЕсли;

    ПутьКэша = ПутьФайлаКэша();
    Если ЗаписатьТекстВФайл(ПутьКэша, СтрСоединить(СтрокиКэша, Символы.ПС)) Тогда
        Сообщить("Кэш шапок обновлён: " + ПутьКэша);
    КонецЕсли;

    Сообщить("Готово — " + ЧислоВСтроку(ВсегоОсн + ВсегоДоп) + " объектов ("
        + ЧислоВСтроку(ВсегоОсн) + " в основной карте, "
        + ЧислоВСтроку(ВсегоДоп) + " в дополнительной).");

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗапрос(Команда)
    Если ПустаяСтрока(КореньКаталога) Тогда
        Сообщить("Укажи путь к конфигурации");
        Возврат;
    КонецЕсли;

    Если ПустаяСтрока(СтрокаЗапроса) Тогда
        Сообщить("Вставь строку запроса: FETCH:, SCHEMA:, SEARCH:, DEPS:, PROC:, REGION:, LINES:, OUTLINE:, FORM:, EVENTS: или SUBSYS:");
        Возврат;
    КонецЕсли;

    Строки = Новый Массив;
    Строки.Добавить("# Ответ на запрос");
    Строки.Добавить("> " + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy ЧЧ:мм:сс"));
    Строки.Добавить("");

    ВсеЧасти = Новый Массив;

    СтрокиЗапроса = СтрРазделить(СтрокаЗапроса, Символы.ПС, Ложь);

    Для Каждого СтрЗапр Из СтрокиЗапроса Цикл

        СтрЗапр = СокрЛП(СтрЗапр);
        Если ПустаяСтрока(СтрЗапр) Тогда Продолжить; КонецЕсли;

        ТипЗапроса = "";
        Тело        = "";

        Если СтрНачинаетсяС(СтрЗапр, "FETCH:") Тогда
            ТипЗапроса = "FETCH";
            Тело = Сред(СтрЗапр, 7);
        ИначеЕсли СтрНачинаетсяС(СтрЗапр, "SCHEMA:") Тогда
            ТипЗапроса = "SCHEMA";
            Тело = Сред(СтрЗапр, 8);
        ИначеЕсли СтрНачинаетсяС(СтрЗапр, "SEARCH:") Тогда
            ТипЗапроса = "SEARCH";
            Тело = Сред(СтрЗапр, 8);
        ИначеЕсли СтрНачинаетсяС(СтрЗапр, "DEPENDENCIES:") Тогда
            ТипЗапроса = "DEPENDENCIES";
            Тело = Сред(СтрЗапр, 14);
        ИначеЕсли СтрНачинаетсяС(СтрЗапр, "DEPS:") Тогда
            ТипЗапроса = "DEPENDENCIES";
            Тело = Сред(СтрЗапр, 6);
        ИначеЕсли СтрНачинаетсяС(СтрЗапр, "PROC:") Тогда
            ТипЗапроса = "PROC";
            Тело = Сред(СтрЗапр, 6);
        ИначеЕсли СтрНачинаетсяС(СтрЗапр, "REGION:") Тогда
            ТипЗапроса = "REGION";
            Тело = Сред(СтрЗапр, 8);
        ИначеЕсли СтрНачинаетсяС(СтрЗапр, "LINES:") Тогда
            ТипЗапроса = "LINES";
            Тело = Сред(СтрЗапр, 7);
        ИначеЕсли СтрНачинаетсяС(СтрЗапр, "OUTLINE:") Тогда
            ТипЗапроса = "OUTLINE";
            Тело = Сред(СтрЗапр, 9);
        ИначеЕсли СтрНачинаетсяС(СтрЗапр, "FORM:") Тогда
            ТипЗапроса = "FORM";
            Тело = Сред(СтрЗапр, 6);
        ИначеЕсли СтрНачинаетсяС(СтрЗапр, "EVENTS:") Тогда
            ТипЗапроса = "EVENTS";
            Тело = Сред(СтрЗапр, 8);
        ИначеЕсли СтрНачинаетсяС(СтрЗапр, "SUBSYS:") Тогда
            ТипЗапроса = "SUBSYS";
            Тело = Сред(СтрЗапр, 8);
        Иначе
            Строки.Добавить("❌ Не распознана строка: `" + СтрЗапр + "`");
            Строки.Добавить("Ожидается начало с FETCH:, SCHEMA:, SEARCH:, DEPENDENCIES:, PROC:, REGION:, LINES:, OUTLINE:, FORM:, EVENTS: или SUBSYS:");
            Продолжить;
        КонецЕсли;

        // SEARCH и DEPENDENCIES не режем по ";" — опции отделяются через "|"
        Если ТипЗапроса = "SEARCH" ИЛИ ТипЗапроса = "DEPENDENCIES" Тогда
            ЗапросЧасть = Новый Структура("ТипЗапроса,Часть", ТипЗапроса, СокрЛП(Тело));
            ВсеЧасти.Добавить(ЗапросЧасть);
            Продолжить;
        КонецЕсли;

        ЧастиСтроки = СтрРазделить(Тело, ";", Ложь);
        Для Каждого ЧастьСтр Из ЧастиСтроки Цикл
            ЗапросЧасть = Новый Структура("ТипЗапроса,Часть", ТипЗапроса, СокрЛП(ЧастьСтр));
            ВсеЧасти.Добавить(ЗапросЧасть);
        КонецЦикла;

    КонецЦикла;

    Части = ВсеЧасти;

    ОшибокЗапросов = 0;

    Для Каждого ЗапросЭл Из Части Цикл

        // Каждый запрос изолирован: падение одного не отменяет остальные
        // и не съедает уже собранный результат.
        Попытка
            ВыполнитьОдинЗапрос(Строки, ЗапросЭл.ТипЗапроса, ЗапросЭл.Часть);
        Исключение
            ОшибокЗапросов = ОшибокЗапросов + 1;
            Строки.Добавить("---");
            Строки.Добавить("## ❌ Запрос не выполнен: `" + ЗапросЭл.ТипЗапроса
                + ":" + ЗапросЭл.Часть + "`");
            Строки.Добавить("");
            Строки.Добавить("```");
            Строки.Добавить(ОписаниеОшибки());
            Строки.Добавить("```");
            Строки.Добавить("");
        КонецПопытки;

    КонецЦикла;

    Если ОшибокЗапросов > 0 Тогда
        Строки.Добавить("---");
        Строки.Добавить("> ⚠ Запросов с ошибкой: " + ОшибокЗапросов
            + " из " + Части.Количество() + ". Остальные выполнены, результат ниже сохранён.");
        Строки.Добавить("");
    КонецЕсли;

    РезультатМД = СтрСоединить(Строки, Символы.ПС);
    Сообщить("Готово");

    БазовоеИмяФайла = СформироватьИмяПоЗапросу(ВсеЧасти);
    СохранитьРезультатВФайл(РезультатМД, БазовоеИмяФайла, Ложь);

КонецПроцедуры


&НаКлиенте
Функция Тип1С(Знач СыройТип)

    СыройТип = СокрЛП(СыройТип);
    Если ПустаяСтрока(СыройТип) Тогда
        Возврат "";
    КонецЕсли;

    Соотв = Новый Соответствие;
    Соотв.Вставить("xs:string",       "Строка");
    Соотв.Вставить("xs:decimal",      "Число");
    Соотв.Вставить("xs:dateTime",     "Дата");
    Соотв.Вставить("xs:boolean",      "Булево");
    Соотв.Вставить("xs:base64Binary", "ДвоичныеДанные");
    Соотв.Вставить("v8:ValueStorage", "ХранилищеЗначения");
    Соотв.Вставить("v8:UUID",         "УникальныйИдентификатор");

    Готовый = Соотв.Получить(СыройТип);
    Если Готовый <> Неопределено Тогда
        Возврат Готовый;
    КонецЕсли;

    Если СтрНачинаетсяС(СыройТип, "cfg:") Тогда
        Остаток  = Сред(СыройТип, 5);
        ТочкаПоз = СтрНайти(Остаток, ".");
        Если ТочкаПоз > 0 Тогда
            Вид = Лев(Остаток, ТочкаПоз - 1);
            Имя = Сред(Остаток, ТочкаПоз + 1);
        Иначе
            Вид = Остаток;
            Имя = "";
        КонецЕсли;

        ВидыСсылок = Новый Соответствие;
        ВидыСсылок.Вставить("CatalogRef",                    "СправочникСсылка");
        ВидыСсылок.Вставить("DocumentRef",                   "ДокументСсылка");
        ВидыСсылок.Вставить("EnumRef",                       "ПеречислениеСсылка");
        ВидыСсылок.Вставить("ChartOfCharacteristicTypesRef", "ПланВидовХарактеристикСсылка");
        ВидыСсылок.Вставить("ChartOfAccountsRef",            "ПланСчетовСсылка");
        ВидыСсылок.Вставить("ChartOfCalculationTypesRef",    "ПланВидовРасчетаСсылка");
        ВидыСсылок.Вставить("BusinessProcessRef",            "БизнесПроцессСсылка");
        ВидыСсылок.Вставить("TaskRef",                       "ЗадачаСсылка");
        ВидыСсылок.Вставить("ExchangePlanRef",               "ПланОбменаСсылка");
        ВидыСсылок.Вставить("DefinedType",                   "ОпределяемыйТип");
        ВидыСсылок.Вставить("AnyRef",                        "ЛюбаяСсылка");
        ВидыСсылок.Вставить("Characteristic",                "Характеристика");

        ВидРус = ВидыСсылок.Получить(Вид);
        Если ВидРус = Неопределено Тогда
            ВидРус = Вид;
        КонецЕсли;

        Если ПустаяСтрока(Имя) Тогда
            Возврат ВидРус;
        Иначе
            Возврат ВидРус + "." + Имя;
        КонецЕсли;
    КонецЕсли;

    Если СтрНачинаетсяС(СыройТип, "xs:") Тогда
        Возврат Сред(СыройТип, 4);
    КонецЕсли;
    Если СтрНачинаетсяС(СыройТип, "v8:") Тогда
        Возврат Сред(СыройТип, 4);
    КонецЕсли;

    Возврат СыройТип;

КонецФункции

&НаКлиенте
Функция СобратьТипДляВывода(ТекБлок)

    КвалСтр = "";
    Если НЕ ПустаяСтрока(ТекБлок.ДлинаСтроки) И ТекБлок.ДлинаСтроки <> "0" Тогда
        КвалСтр = "(" + ТекБлок.ДлинаСтроки;
        Если НРег(ТекБлок.ДопустимаяДлина) = "fixed" Тогда
            КвалСтр = КвалСтр + ", фикс";
        КонецЕсли;
        КвалСтр = КвалСтр + ")";
    КонецЕсли;

    КвалЧис = "";
    Если НЕ ПустаяСтрока(ТекБлок.ЦифрыЧисла) Тогда
        КвалЧис = "(" + ТекБлок.ЦифрыЧисла;
        Если НЕ ПустаяСтрока(ТекБлок.ДробьЧисла) И ТекБлок.ДробьЧисла <> "0" Тогда
            КвалЧис = КвалЧис + "," + ТекБлок.ДробьЧисла;
        КонецЕсли;
        КвалЧис = КвалЧис + ")";
    КонецЕсли;

    КвалДат = "";
    Если НЕ ПустаяСтрока(ТекБлок.ЧастиДаты) Тогда
        ЧД = НРег(ТекБлок.ЧастиДаты);
        Если ЧД = "date" Тогда
            КвалДат = "(дата)";
        ИначеЕсли ЧД = "time" Тогда
            КвалДат = "(время)";
        ИначеЕсли ЧД = "datetime" Тогда
            КвалДат = "(дата и время)";
        КонецЕсли;
    КонецЕсли;

    Если ТекБлок.ТипыЧасти.Количество() = 0 Тогда
        Возврат "";
    КонецЕсли;

    Части = Новый Массив;
    Для Каждого СыройТип Из ТекБлок.ТипыЧасти Цикл
        Имя1С = Тип1С(СыройТип);
        Доп = "";
        Если Имя1С = "Строка" Тогда
            Доп = КвалСтр;
        ИначеЕсли Имя1С = "Число" Тогда
            Доп = КвалЧис;
        ИначеЕсли Имя1С = "Дата" Тогда
            Доп = КвалДат;
        КонецЕсли;
        Части.Добавить(Имя1С + Доп);
    КонецЦикла;

