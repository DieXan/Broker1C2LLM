&НаКлиенте
Процедура ДобавитьТипОбъекта(Типы, Знач Папка, Знач ИмяРус, Знач Группа)

    Эл = Новый Структура("Ключ, Значение, Группа", Папка, ИмяРус, Группа);
    Типы.Добавить(Эл);

КонецПроцедуры

&НаКлиенте
Функция РусскоеИмяТипа(Знач ТипПапки)

    Для Каждого КП Из ТипыОбъектовКонфигурации() Цикл
        Если НРег(КП.Ключ) = НРег(ТипПапки) Тогда
            Возврат КП.Значение;
        КонецЕсли;
    КонецЦикла;

    Возврат ТипПапки;

КонецФункции

&НаКлиенте
Функция КлючМодуляПоПути(Знач БазовыйПуть, Знач ПутьФайла)

    Если СтрДлина(ПутьФайла) <= СтрДлина(БазовыйПуть) + 1 Тогда
        Возврат "";
    КонецЕсли;

    Отн = Сред(ПутьФайла, СтрДлина(БазовыйПуть) + 2);
    ОтнНРег = НРег(Отн);

    Если ОтнНРег = "ext\managermodule.bsl" Тогда
        Возврат "manager";
    ИначеЕсли ОтнНРег = "ext\objectmodule.bsl" Тогда
        Возврат "object";
    ИначеЕсли ОтнНРег = "ext\recordsetmodule.bsl" Тогда
        Возврат "recordset";
    ИначеЕсли ОтнНРег = "ext\module.bsl" Тогда
        Возврат "module";
    ИначеЕсли ОтнНРег = "ext\valuemanagermodule.bsl" Тогда
        Возврат "valuemanager";
    ИначеЕсли ОтнНРег = "ext\commandmodule.bsl" Тогда
        Возврат "command";
    ИначеЕсли ОтнНРег = "ext\form\module.bsl" Тогда
        Возврат "form";
    КонецЕсли;

    Сегм = СтрРазделить(Отн, "\", Ложь);
    Если Сегм.Количество() >= 2 Тогда
        Если НРег(Сегм[0]) = "forms" Тогда
            Возврат "form:" + Сегм[1];
        ИначеЕсли НРег(Сегм[0]) = "commands" Тогда
            Возврат "command:" + Сегм[1];
        КонецЕсли;
    КонецЕсли;

    Возврат "";

КонецФункции

// ══════════════════════════════════════════════════════════════
// Поиск по коду: попадания построчно, с методом и видом места
// (код / запрос / строка / комментарий). Общий движок для SEARCH и CALLERS.
// ══════════════════════════════════════════════════════════════

&НаКлиенте
Функция НовыеУсловияПоискаКода(Знач Образец)

    Условия = Новый Структура;
    Условия.Вставить("ОбразецНРег",        НРег(Образец));
    Условия.Вставить("Лимит",              5);     // попаданий на файл в выводе
    Условия.Вставить("ТолькоЗапросы",      Ложь);
    Условия.Вставить("ОбъектНРег",         "");    // obj= — имя в тексте запроса
    Условия.Вставить("БезКомментариев",    Ложь);
    Условия.Вставить("ТолькоМаркеры",      Ложь);
    Условия.Вставить("РежимВызова",        Ложь);  // CALLERS: только вызовы Образец(
    Условия.Вставить("ЛокальныйМетодНРег", "");    // CALLERS: вызовы без квалификатора в модуле цели
    Условия.Вставить("АдресЦелиНРег",      "");    // CALLERS: Тип.Объект.модуль цели
    Условия.Вставить("ИмяМодуляНРег",      "");    // CALLERS: имя общего модуля цели — для колбэков
    Условия.Вставить("ГлобальныйМодуль",   Ложь);  // CALLERS: методы цели вызываются без имени модуля
    Условия.Вставить("Склейка",            Ложь);  // повторный поиск со склейкой литералов

    Возврат Условия;

КонецФункции

&НаКлиенте
Функция НовыйИтогПоискаКода()

    Возврат Новый Структура("Файлы, ПросмотреноФайлов, ДостигнутЛимит, ВсегоПопаданий",
        Новый Массив, 0, Ложь, 0);

КонецФункции

// Обходит BSL-файлы выбранных типов (и модули конфигурации), в каждый
// заглядывает ПроверитьФайлКода. Останавливается на МаксФайлов файлах с попаданиями.
&НаКлиенте
Процедура ПоискПоКоду(Условия, Знач ФильтрТипов, Знач МаксФайлов, Итог)

    Если МаксФайлов < 1 Тогда
        Итог.ДостигнутЛимит = Истина;
        Возврат;
    КонецЕсли;

    Для Каждого КП Из ТипыОбъектовКонфигурации() Цикл

        Если Итог.ДостигнутЛимит Тогда
            Прервать;
        КонецЕсли;

        ТипПапки = КП.Ключ;
        Если ФильтрТипов.Количество() > 0
            И ФильтрТипов.Получить(НРег(ТипПапки)) = Неопределено Тогда
            Продолжить;
        КонецЕсли;

        // без двойного слэша: пути файлов режутся по длине пути папки
        Корень = КореньКаталога;
        Пока СтрЗаканчиваетсяНа(Корень, "\") Цикл
            Корень = Лев(Корень, СтрДлина(Корень) - 1);
        КонецЦикла;
        ПутьПапки = Корень + "\" + ТипПапки;
        ФП = Новый Файл(ПутьПапки);
        Если НЕ ФП.Существует() Тогда
            Продолжить;
        КонецЕсли;

        Состояние("Поиск в коде: " + КП.Значение + "...");

        // Весь тип целиком — один рекурсивный НайтиФайлы на папку типа вместо
        // отдельного вызова на каждый из тысяч объектов; файлы раскладываются
        // по объектам, а обход идёт в прежнем порядке объектов. Отбор по
        // конкретным объектам (in=Тип.Объект) — по-прежнему по папке объекта.
        ФайлыПоОбъектам = Неопределено;
        Если ФильтрТипов.Получить(НРег(ТипПапки)) = Истина ИЛИ ФильтрТипов.Количество() = 0 Тогда
            ФайлыПоОбъектам = ФайлыКодаПоОбъектам(ПутьПапки);
        КонецЕсли;

        Для Каждого Об Из ОбъектыТипа(ПутьПапки) Цикл

            Если Итог.ДостигнутЛимит Тогда
                Прервать;
            КонецЕсли;
            Если НЕ Об.ЕстьПапка ИЛИ НЕ ОбъектВФильтре(ФильтрТипов, ТипПапки, Об.Имя) Тогда
                Продолжить;
            КонецЕсли;

            Если ФайлыПоОбъектам = Неопределено Тогда
                ФайлыОбъекта = НайтиФайлы(Об.ПутьПапки, "*.bsl", Истина);
            Иначе
                ФайлыОбъекта = ФайлыПоОбъектам.Получить(НРег(Об.Имя));
                Если ФайлыОбъекта = Неопределено Тогда
                    Продолжить;
                КонецЕсли;
            КонецЕсли;

            Для Каждого ФБSL Из ФайлыОбъекта Цикл
                Если НЕ ФБSL.ЭтоФайл() Тогда
                    Продолжить;
                КонецЕсли;
                ПроверитьФайлКода(Условия, ТипПапки + "." + Об.Имя, ФБSL.ПолноеИмя,
                    КлючМодуляПоПути(Об.ПутьПапки, ФБSL.ПолноеИмя), ФБSL.Имя, МаксФайлов, Итог);
                Если Итог.ДостигнутЛимит Тогда
                    Прервать;
                КонецЕсли;
            КонецЦикла;

        КонецЦикла;

    КонецЦикла;

    // ── модули конфигурации (корневая папка Ext) ──
    Если НЕ Итог.ДостигнутЛимит
        И (ФильтрТипов.Количество() = 0
            ИЛИ ФильтрТипов.Получить("configuration") <> Неопределено) Тогда
        Для Каждого М Из МодулиКонфигурации() Цикл
            ПроверитьФайлКода(Условия, "Configuration", М.Путь, М.Ключ, М.Ключ, МаксФайлов, Итог);
            Если Итог.ДостигнутЛимит Тогда
                Прервать;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

КонецПроцедуры

// Все BSL-файлы папки типа одним рекурсивным поиском, разложенные по объектам:
// имя объекта (НРег) → массив файлов. Относительный порядок файлов внутри
// объекта тот же, что дал бы НайтиФайлы по папке самого объекта.
&НаКлиенте
Функция ФайлыКодаПоОбъектам(Знач ПутьПапки)

    Результат  = Новый Соответствие;

    // Длину префикса берём из того, как НайтиФайлы сам пишет пути,
    // а не из строки ПутьПапки (на случай двойного слэша и т.п.)
    ВерхнийУровень = НайтиФайлы(ПутьПапки, "*", Ложь);
    Если ВерхнийУровень.Количество() = 0 Тогда
        Возврат Результат;
    КонецЕсли;
    ДлинаКорня = СтрДлина(ВерхнийУровень[0].ПолноеИмя) - СтрДлина(ВерхнийУровень[0].Имя) - 1;

    Для Каждого Ф Из НайтиФайлы(ПутьПапки, "*.bsl", Истина) Цикл

        Отн = Сред(Ф.ПолноеИмя, ДлинаКорня + 2);
        ПозРазделителя = СтрНайти(Отн, "\");
        Если ПозРазделителя = 0 Тогда
            Продолжить; // файл прямо в папке типа — объекту не принадлежит
        КонецЕсли;

        ИмяОбНРег = НРег(Лев(Отн, ПозРазделителя - 1));
        Список = Результат.Получить(ИмяОбНРег);
        Если Список = Неопределено Тогда
            Список = Новый Массив;
            Результат.Вставить(ИмяОбНРег, Список);
        КонецЕсли;
        Список.Добавить(Ф);

    КонецЦикла;

    Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ПроверитьФайлКода(Условия, Знач Объект, Знач ПутьФайла, Знач КлючМодуля,
    Знач ИмяФайла, Знач МаксФайлов, Итог)

    Итог.ПросмотреноФайлов = Итог.ПросмотреноФайлов + 1;

    КодМодуля = ПрочитатьФайлБезопасно(ПутьФайла);
    Если ПустаяСтрока(КодМодуля) Тогда
        Возврат;
    КонецЕсли;

    ТекстНРег = НРег(КодМодуля);

    // вызовы без квалификатора ищем только в модуле самой цели CALLERS
    // (у глобального общего модуля — во всём коде)
    ЛокальныйМетод = "";
    Если НЕ ПустаяСтрока(Условия.ЛокальныйМетодНРег)
        И (Условия.ГлобальныйМодуль ИЛИ НРег(Объект + "." + КлючМодуля) = Условия.АдресЦелиНРег) Тогда
        ЛокальныйМетод = Условия.ЛокальныйМетодНРег;
    КонецЕсли;

    // ── быстрая проверка по всему тексту: разбор модуля — только при попадании ──
    Если Условия.Склейка Тогда
        ПервоеСлово = СтрРазделить(Условия.ОбразецНРег, " ", Ложь);
        Если ПервоеСлово.Количество() = 0 ИЛИ СтрНайти(ТекстНРег, ПервоеСлово[0]) = 0 Тогда
            Возврат;
        КонецЕсли;
    Иначе
        ЕстьОбразец = НЕ ПустаяСтрока(Условия.ОбразецНРег)
            И СтрНайти(ТекстНРег, Условия.ОбразецНРег) > 0;
        ЕстьЛокальный = НЕ ПустаяСтрока(ЛокальныйМетод)
            И СтрНайти(ТекстНРег, ЛокальныйМетод) > 0;
        // колбэк общего модуля: ОписаниеОповещения("Метод", ИмяМодуля)
        ЕстьКолбэк = НЕ ПустаяСтрока(Условия.ИмяМодуляНРег)
            И СтрНайти(ТекстНРег, """" + Условия.ЛокальныйМетодНРег + """") > 0;
        Если НЕ ЕстьОбразец И НЕ ЕстьЛокальный И НЕ ЕстьКолбэк Тогда
            Возврат;
        КонецЕсли;
    КонецЕсли;
    Если НЕ ПустаяСтрока(Условия.ОбъектНРег) И СтрНайти(ТекстНРег, Условия.ОбъектНРег) = 0 Тогда
        Возврат;
    КонецЕсли;

    Если Условия.Склейка Тогда
        Найдено = ПопаданияСоСклейкой(КодМодуля, Условия);
    Иначе
        Найдено = ПопаданияВМодуле(КодМодуля, ТекстНРег, Условия, ЛокальныйМетод);
    КонецЕсли;

    Если Найдено.Всего = 0 Тогда
        Возврат;
    КонецЕсли;

    Эл = Новый Структура("Объект, Модуль, Ключ, Всего, Попадания");
    Эл.Объект    = Объект;
    Эл.Модуль    = ?(ПустаяСтрока(КлючМодуля), ИмяФайла, КлючМодуля);
    Эл.Ключ      = КлючМодуля;
    Эл.Всего     = Найдено.Всего;
    Эл.Попадания = Найдено.Попадания;

    Итог.Файлы.Добавить(Эл);
    Итог.ВсегоПопаданий = Итог.ВсегоПопаданий + Найдено.Всего;

    Если Итог.Файлы.Количество() >= МаксФайлов Тогда
        Итог.ДостигнутЛимит = Истина;
    КонецЕсли;

КонецПроцедуры

// Все попадания в модуле с учётом отборов. Возвращает Всего (после отборов)
// и Попадания — первые Условия.Лимит структур Строка, Текст, Где, Метод.
//
// Скорость: текст приводится к нижнему регистру один раз целиком (а не
// построчно); вид места (код/запрос/…) и состояния литералов считаются только
// когда нужны — для отбора или для выводимых строк; разбор модуля на методы —
// только когда есть что выводить.
&НаКлиенте
Функция ПопаданияВМодуле(Знач КодМодуля, Знач ТекстНРег, Условия, Знач ЛокальныйМетод)

    Рез = Новый Структура("Всего, Попадания", 0, Новый Массив);

    СтрокиМод  = СтрРазделить(КодМодуля, Символы.ПС, Истина);
    СтрокиНРег = СтрРазделить(ТекстНРег, Символы.ПС, Истина);
    Разбор     = Неопределено;
    Состояния  = Неопределено;
    ВидыБлоков = Новый Соответствие; // начало литерала → Структура(ЭтоЗапрос, ТекстНРег)

    // вид места нужен для отбора — тогда считаем его для каждого попадания;
    // иначе — только для строк, которые попадут в таблицу
    МестоДляОтбора = Условия.РежимВызова ИЛИ Условия.БезКомментариев ИЛИ Условия.ТолькоЗапросы;

    Для Сч = 0 По СтрокиМод.Количество() - 1 Цикл

        Поз = ПозицияСовпадения(СтрокиНРег[Сч], Условия, ЛокальныйМетод);
        ЭтоКолбэк = Ложь;
        Если Поз = 0 И Условия.РежимВызова Тогда
            Поз = ПозицияКолбэка(СтрокиНРег[Сч], Условия, ЛокальныйМетод);
            ЭтоКолбэк = (Поз > 0);
        КонецЕсли;
        Если Поз = 0 Тогда
            Продолжить;
        КонецЕсли;

        Л = СтрокиМод[Сч];

        // только открывающие маркеры: закрывающий дублировал бы ту же доработку
        Если Условия.ТолькоМаркеры И ВидМаркераДоработки(Л) <> 1 Тогда
            Продолжить;
        КонецЕсли;

        БудетВыведено = Рез.Попадания.Количество() < Условия.Лимит;

        Если Условия.ТолькоМаркеры Тогда
            Место = Новый Структура("Вид, ТекстБлока", "маркер", "");
        ИначеЕсли МестоДляОтбора ИЛИ БудетВыведено Тогда
            Если Состояния = Неопределено Тогда
                Состояния = НовыеСостоянияЛитералов();
            КонецЕсли;
            Место = МестоВСтроке(СтрокиМод, Сч, Поз, Состояния, ВидыБлоков);
        Иначе
            Место = Неопределено;
        КонецЕсли;

        Если МестоДляОтбора Тогда
            Если Условия.РежимВызова Тогда
                Если ЭтоКолбэк Тогда
                    // имя метода — в настоящем строковом литерале, не в комментарии
                    Если Место.Вид <> "строка" Тогда
                        Продолжить;
                    КонецЕсли;
                    Место.Вид = "колбэк";
                ИначеЕсли Место.Вид <> "код" Тогда
                    Продолжить;
                КонецЕсли;
            КонецЕсли;
            Если Условия.БезКомментариев И Место.Вид = "комм" Тогда
                Продолжить;
            КонецЕсли;
            Если Условия.ТолькоЗапросы Тогда
                Если Место.Вид <> "запрос" Тогда
                    Продолжить;
                КонецЕсли;
                Если НЕ ПустаяСтрока(Условия.ОбъектНРег)
                    И СтрНайти(Место.ТекстБлока, Условия.ОбъектНРег) = 0 Тогда
                    Продолжить;
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;

        Рез.Всего = Рез.Всего + 1;

        Если БудетВыведено Тогда
            Если Разбор = Неопределено Тогда
                Разбор = РазобратьМодульBSL(КодМодуля);
            КонецЕсли;
            Метод = МетодПоСтроке(Разбор, Сч + 1);
            Рез.Попадания.Добавить(Новый Структура("Строка, Текст, Где, Метод",
                Сч + 1, СокрЛП(Л), Место.Вид, ?(Метод = Неопределено, "", Метод.Имя)));
        КонецЕсли;

    КонецЦикла;

    Возврат Рез;

КонецФункции

// Повторный поиск для фразы, разорванной по строкам многострочного литерала:
// строки, начинающиеся с «|», приклеиваются к предыдущей, пробелы сжимаются.
&НаКлиенте
Функция ПопаданияСоСклейкой(Знач КодМодуля, Условия)

    Рез = Новый Структура("Всего, Попадания", 0, Новый Массив);

    ОбразецНорм = СжатьПробелы(Условия.ОбразецНРег);
    СтрокиМод   = СтрРазделить(КодМодуля, Символы.ПС, Истина);
    Склеенные   = Новый Массив;

    Для Сч = 0 По СтрокиМод.Количество() - 1 Цикл
        ЛС = СокрЛП(СтрЗаменить(СтрЗаменить(СтрокиМод[Сч], Символы.Таб, " "), Символы.ВК, ""));
        Если СтрНачинаетсяС(ЛС, "|") И Склеенные.Количество() > 0 Тогда
            Последняя = Склеенные[Склеенные.Количество() - 1];
            Последняя.Текст = Последняя.Текст + " " + Сред(ЛС, 2);
            Последняя.Склеено = Истина;
        Иначе
            Склеенные.Добавить(Новый Структура("Строка, Текст, Склеено", Сч + 1, ЛС, Ложь));
        КонецЕсли;
    КонецЦикла;

    Разбор = Неопределено;

    Для Каждого С Из Склеенные Цикл
        Если НЕ С.Склеено Тогда
            Продолжить;
        КонецЕсли;
        Если СтрНайти(СжатьПробелы(НРег(С.Текст)), ОбразецНорм) = 0 Тогда
            Продолжить;
        КонецЕсли;

        Рез.Всего = Рез.Всего + 1;
        Если Рез.Попадания.Количество() < Условия.Лимит Тогда
            Если Разбор = Неопределено Тогда
                Разбор = РазобратьМодульBSL(КодМодуля);
            КонецЕсли;
            Метод = МетодПоСтроке(Разбор, С.Строка);
            Рез.Попадания.Добавить(Новый Структура("Строка, Текст, Где, Метод",
                С.Строка, С.Текст, "литерал", ?(Метод = Неопределено, "", Метод.Имя)));
        КонецЕсли;
    КонецЦикла;

    Возврат Рез;

КонецФункции

&НаКлиенте
Функция СжатьПробелы(Знач Текст)

    Текст = СтрЗаменить(Текст, Символы.Таб, " ");
    Пока СтрНайти(Текст, "  ") > 0 Цикл
        Текст = СтрЗаменить(Текст, "  ", " ");
    КонецЦикла;
    Возврат СокрЛП(Текст);

КонецФункции

&НаКлиенте
Функция ПозицияСовпадения(Знач ЛНРег, Условия, Знач ЛокальныйМетод)

    Если НЕ Условия.РежимВызова Тогда
        Возврат СтрНайти(ЛНРег, Условия.ОбразецНРег);
    КонецЕсли;

    Если НЕ ПустаяСтрока(Условия.ОбразецНРег) Тогда
        Поз = ПозицияВызова(ЛНРег, Условия.ОбразецНРег);
        Если Поз > 0 Тогда
            Возврат Поз;
        КонецЕсли;
    КонецЕсли;

    Если НЕ ПустаяСтрока(ЛокальныйМетод) Тогда
        // объявление самого метода вызовом не считается
        Если ЭтоНачалоМетода(СокрЛ(СтрЗаменить(ЛНРег, Символы.Таб, " "))) Тогда
            Возврат 0;
        КонецЕсли;
        Возврат ПозицияВызова(ЛНРег, ЛокальныйМетод);
    КонецЕсли;

    Возврат 0;

КонецФункции

// CALLERS: имя метода строкой — Новый ОписаниеОповещения("Метод", …),
// ПодключитьОбработчикОжидания("Метод", …). Засчитывается в модуле самого
// метода и везде для глобального модуля; для прочих общих модулей — если
// в той же строке есть имя модуля. Возвращает позицию внутри литерала.
&НаКлиенте
Функция ПозицияКолбэка(Знач ЛНРег, Условия, Знач ЛокальныйМетод)

    Если ПустаяСтрока(Условия.ЛокальныйМетодНРег) Тогда
        Возврат 0;
    КонецЕсли;

    Поз = СтрНайти(ЛНРег, """" + Условия.ЛокальныйМетодНРег + """");
    Если Поз = 0 Тогда
        Возврат 0;
    КонецЕсли;

    Если НЕ ПустаяСтрока(ЛокальныйМетод) Тогда
        Возврат Поз + 1;
    КонецЕсли;

    Если НЕ ПустаяСтрока(Условия.ИмяМодуляНРег)
        И ЕстьВхождениеЦелымИменем(ЛНРег, Условия.ИмяМодуляНРег) Тогда
        Возврат Поз + 1;
    КонецЕсли;

    Возврат 0;

КонецФункции

// Позиция вызова «Имя(»: слева не идентификатор и не точка, справа
// (после пробелов) открывающая скобка. 0 — вызова в строке нет.
&НаКлиенте
Функция ПозицияВызова(Знач ЛНРег, Знач ИмяНРег)

    Длина = СтрДлина(ЛНРег);
    Нач = 1;

    Пока Нач <= Длина Цикл

        Поз = СтрНайти(ЛНРег, ИмяНРег, НаправлениеПоиска.СНачала, Нач);
        Если Поз = 0 Тогда
            Возврат 0;
        КонецЕсли;

        СимволДо = ?(Поз > 1, Сред(ЛНРег, Поз - 1, 1), "");
        ПозПосле = Поз + СтрДлина(ИмяНРег);
        Пока Сред(ЛНРег, ПозПосле, 1) = " " ИЛИ Сред(ЛНРег, ПозПосле, 1) = Символы.Таб Цикл
            ПозПосле = ПозПосле + 1;
        КонецЦикла;

        Если (СимволДо = "" ИЛИ (НЕ ЭтоСимволИдентификатора(СимволДо) И СимволДо <> "."))
            И Сред(ЛНРег, ПозПосле, 1) = "(" Тогда
            Возврат Поз;
        КонецЕсли;

        Нач = Поз + 1;

    КонецЦикла;

    Возврат 0;

КонецФункции

// Состояние после разбора фрагмента строки кода с учётом того, был ли
// открыт литерал в начале: 0 — вне литерала, 1 — внутри литерала,
// 2 — внутри комментария (после «//» вне литерала).
&НаКлиенте
Функция СостояниеПослеТекста(Знач Текст, Знач ВнутриЛитерала)

    // строка-комментарий посреди многострочного литерала литерал не закрывает
    Если ВнутриЛитерала
        И СтрНачинаетсяС(СокрЛ(СтрЗаменить(Текст, Символы.Таб, " ")), "//") Тогда
        Возврат 1;
    КонецЕсли;

    Длина = СтрДлина(Текст);
    Поз = 1;

    Пока Поз <= Длина Цикл

        ПозКавычки = СтрНайти(Текст, """", НаправлениеПоиска.СНачала, Поз);

        Если ВнутриЛитерала Тогда
            Если ПозКавычки = 0 Тогда
                Возврат 1;
            КонецЕсли;
            ВнутриЛитерала = Ложь;
            Поз = ПозКавычки + 1;
        Иначе
            ПозКомментария = СтрНайти(Текст, "//", НаправлениеПоиска.СНачала, Поз);
            Если ПозКомментария > 0 И (ПозКавычки = 0 ИЛИ ПозКомментария < ПозКавычки) Тогда
                Возврат 2;
            КонецЕсли;
            Если ПозКавычки = 0 Тогда
                Возврат 0;
            КонецЕсли;
            ВнутриЛитерала = Истина;
            Поз = ПозКавычки + 1;
        КонецЕсли;

    КонецЦикла;

    Возврат ?(ВнутриЛитерала, 1, 0);

КонецФункции

// Для каждой строки модуля: открыт ли литерал в её начале и в её конце.
// Считается лениво — только до строки, которая понадобилась (ОбеспечитьСостояния):
// в модуле на 100 тыс. строк с попаданием в начале остаток файла не разбираем.
&НаКлиенте
Функция НовыеСостоянияЛитералов()

    Возврат Новый Структура("НаНачале, НаКонце, Внутри", Новый Массив, Новый Массив, Ложь);

КонецФункции

&НаКлиенте
Процедура ОбеспечитьСостояния(Состояния, СтрокиМод, Знач ДоИндекса)

    Последний = СтрокиМод.Количество() - 1;
    Если ДоИндекса > Последний Тогда
        ДоИндекса = Последний;
    КонецЕсли;

    Сч     = Состояния.НаНачале.Количество();
    Внутри = Состояния.Внутри;

    Пока Сч <= ДоИндекса Цикл
        Л = СтрокиМод[Сч];
        Состояния.НаНачале.Добавить(Внутри);
        Если СтрНайти(Л, """") > 0 Тогда
            Внутри = (СостояниеПослеТекста(Л, Внутри) = 1);
        КонецЕсли;
        Состояния.НаКонце.Добавить(Внутри);
        Сч = Сч + 1;
    КонецЦикла;

    Состояния.Внутри = Внутри;

КонецПроцедуры

// Состояния по всему модулю сразу (для QUERIES — нужны все литералы).
&НаКлиенте
Функция СостоянияЛитералов(СтрокиМод)

    Рез = НовыеСостоянияЛитералов();
    ОбеспечитьСостояния(Рез, СтрокиМод, СтрокиМод.Количество() - 1);
    Возврат Рез;

КонецФункции

// Вид места попадания: «код», «комм», «запрос» (внутри литерала с текстом
// запроса) или «строка» (внутри прочего литерала). Для литерала — ещё и
// текст всего литерала в нижнем регистре (для отбора obj=).
&НаКлиенте
Функция МестоВСтроке(СтрокиМод, Знач Индекс, Знач Поз, Состояния, ВидыБлоков)

    Рез = Новый Структура("Вид, ТекстБлока", "код", "");

    Л = СтрокиМод[Индекс];
    Если СтрНачинаетсяС(СокрЛ(СтрЗаменить(Л, Символы.Таб, " ")), "//") Тогда
        Рез.Вид = "комм";
        Возврат Рез;
    КонецЕсли;

    ОбеспечитьСостояния(Состояния, СтрокиМод, Индекс);
    Сост = СостояниеПослеТекста(Лев(Л, Поз - 1), Состояния.НаНачале[Индекс]);
    Если Сост = 2 Тогда
        Рез.Вид = "комм";
        Возврат Рез;
    ИначеЕсли Сост = 0 Тогда
        Возврат Рез;
    КонецЕсли;

    // внутри литерала: границы литерала по состояниям соседних строк
    Нач = Индекс;
    Пока Нач > 0 И Состояния.НаНачале[Нач] И Индекс - Нач < 3000 Цикл
        Нач = Нач - 1;
    КонецЦикла;

    Блок = ВидыБлоков.Получить(Нач);
    Если Блок = Неопределено Тогда
        Кон = Индекс;
        Последний = СтрокиМод.Количество() - 1;
        Пока Кон < Последний И Кон - Индекс < 3000 Цикл
            ОбеспечитьСостояния(Состояния, СтрокиМод, Кон);
            Если НЕ Состояния.НаКонце[Кон] Тогда
                Прервать;
            КонецЕсли;
            Кон = Кон + 1;
        КонецЦикла;
        ТекстБлока = НРег(ФрагментМодуля(СтрокиМод, Нач + 1, Кон + 1));
        Блок = Новый Структура("ЭтоЗапрос, ТекстНРег", ЭтоТекстЗапроса(ТекстБлока), ТекстБлока);
        ВидыБлоков.Вставить(Нач, Блок);
    КонецЕсли;

    Рез.Вид        = ?(Блок.ЭтоЗапрос, "запрос", "строка");
    Рез.ТекстБлока = Блок.ТекстНРег;

    Возврат Рез;

КонецФункции

// Похож ли текст литерала (в нижнем регистре) на текст запроса.
&НаКлиенте
Функция ЭтоТекстЗапроса(Знач ТекстНРег)

    ЕстьВыбор = СтрНайти(ТекстНРег, "выбрать") > 0 ИЛИ СтрНайти(ТекстНРег, "select") > 0;
    Если НЕ ЕстьВыбор Тогда
        Возврат Ложь;
    КонецЕсли;

    Возврат СтрНайти(ТекстНРег, " из") > 0 ИЛИ СтрНайти(ТекстНРег, "|из") > 0
        ИЛИ СтрНайти(ТекстНРег, "поместить") > 0 ИЛИ СтрНайти(ТекстНРег, "from") > 0;

КонецФункции

&НаКлиенте
Функция МетодПоСтроке(Разбор, Знач НомерСтроки)

    Для Каждого Метод Из Разбор.Методы Цикл
        Если Метод.Начало <= НомерСтроки И Метод.Конец >= НомерСтроки Тогда
            Возврат Метод;
        КонецЕсли;
    КонецЦикла;

    Возврат Неопределено;

КонецФункции

// Таблица попаданий: строка на каждое попадание, объект пишется один раз
// на файл. В колонке «Запрос» — PROC метода или LINES вокруг строки;
// повтор того же метода в файле — «↑». ЗапросЕщё — запрос без |in= и |hits=:
// для строки «показано N из K» к нему дописываются объект и число попаданий
// (не через СтрШаблон: в тексте поиска может быть свой «%1»).
&НаКлиенте
Процедура ВывестиТаблицуПопаданий(Строки, Знач Файлы, Знач ПоказыватьТекст, Знач ЗапросЕщё)

    Если ЛегендаПоискаВыведена <> Истина Тогда
        Строки.Добавить("> Где: код / запрос (внутри текста запроса) / строка (прочий литерал)"
            + " / комм (комментарий) / маркер / литерал (найдено со склейкой)"
            + " / колбэк (имя метода строкой: ОписаниеОповещения, ПодключитьОбработчикОжидания).");
        Строки.Добавить("");
        ЛегендаПоискаВыведена = Истина;
    КонецЕсли;

    Если ПоказыватьТекст Тогда
        Строки.Добавить("| Объект · модуль | Стр. | Метод | Где | Текст строки | Запрос |");
        Строки.Добавить("|---|---|---|---|---|---|");
    Иначе
        Строки.Добавить("| Объект · модуль | Стр. | Метод | Где | Запрос |");
        Строки.Добавить("|---|---|---|---|---|");
    КонецЕсли;

    Для Каждого Ф Из Файлы Цикл

        ПерваяСтрока = Истина;
        ПрошлыйМетод = Неопределено;
        АдресМодуля  = Ф.Объект + "." + Ф.Ключ;

        Для Каждого П Из Ф.Попадания Цикл

            ЯчейкаОбъекта = ?(ПерваяСтрока, "`" + Ф.Объект + "` · " + Ф.Модуль, "");
            ПерваяСтрока  = Ложь;

            Если ПустаяСтрока(Ф.Ключ) Тогда
                ЗапросТекст = "—";
            ИначеЕсли НЕ ПустаяСтрока(П.Метод) Тогда
                Если П.Метод = ПрошлыйМетод Тогда
                    ЗапросТекст = "↑";
                Иначе
                    ЗапросТекст = "`PROC:" + АдресМодуля + "#" + П.Метод + "`";
                КонецЕсли;
            Иначе
                ЗапросТекст = "`LINES:" + АдресМодуля + ":" + ЧислоВСтроку(Макс(1, П.Строка - 15))
                    + "-" + ЧислоВСтроку(П.Строка + 15) + "`";
            КонецЕсли;
            ПрошлыйМетод = П.Метод;

            ЯчейкаМетода = ?(ПустаяСтрока(П.Метод), "—", "`" + П.Метод + "`");

            Если ПоказыватьТекст Тогда
                Строки.Добавить("| " + ЯчейкаОбъекта + " | " + ЧислоВСтроку(П.Строка)
                    + " | " + ЯчейкаМетода + " | " + П.Где
                    + " | `" + ЭкранироватьЯчейку(П.Текст, 120) + "` | " + ЗапросТекст + " |");
            Иначе
                Строки.Добавить("| " + ЯчейкаОбъекта + " | " + ЧислоВСтроку(П.Строка)
                    + " | " + ЯчейкаМетода + " | " + П.Где + " | " + ЗапросТекст + " |");
            КонецЕсли;

        КонецЦикла;

        Если Ф.Всего > Ф.Попадания.Количество() Тогда
            // запрос «показать все» — по одному этому объекту, а не по всему типу
            Ещё = "показано " + ЧислоВСтроку(Ф.Попадания.Количество()) + " из " + ЧислоВСтроку(Ф.Всего);
            Если ПустаяСтрока(ЗапросЕщё) Тогда
                ЯчейкаЕщё = "";
            Иначе
                ЯчейкаЕщё = "`" + ЗапросЕщё + "|in=" + Ф.Объект + "|hits=" + ЧислоВСтроку(Ф.Всего) + "`";
            КонецЕсли;
            Если ПоказыватьТекст Тогда
                Строки.Добавить("|  | … | " + Ещё + " |  |  | " + ЯчейкаЕщё + " |");
            Иначе
                Строки.Добавить("|  | … | " + Ещё + " |  | " + ЯчейкаЕщё + " |");
            КонецЕсли;
        КонецЕсли;

    КонецЦикла;

    Строки.Добавить("");

КонецПроцедуры

&НаКлиенте
Функция ЧислоИзОпции(Знач Текст, Знач ПоУмолчанию, Строки, Знач ИмяОпции)

    Попытка
        Результат = Число(СокрЛП(Текст));
    Исключение
        Строки.Добавить("Не разобрал `" + ИмяОпции + "`: " + Текст + ". Взял " + ПоУмолчанию + ".");
        Возврат ПоУмолчанию;
    КонецПопытки;

    Если Результат < 1 Тогда
        Возврат ПоУмолчанию;
    КонецЕсли;

    Возврат Результат;

КонецФункции

// Разбор опции in=: элемент — тип (CommonModules) или конкретный объект
// (CommonModules.арсОбщийМодульСервер). ФильтрТипов: тип (НРег) → Истина
// (весь тип) или Соответствие имён объектов (НРег) → Истина.
&НаКлиенте
Процедура ДобавитьВФильтрIn(ФильтрТипов, Знач ТекстОпции)

    Для Каждого Эл Из СтрРазделить(ТекстОпции, ",", Ложь) Цикл

        Эл = СокрЛП(Эл);
        Если ПустаяСтрока(Эл) Тогда
            Продолжить;
        КонецЕсли;

        ПозТочки = СтрНайти(Эл, ".");
        Если ПозТочки = 0 Тогда
            ФильтрТипов.Вставить(НРег(Эл), Истина);
            Продолжить;
        КонецЕсли;

        ТипНРег = НРег(СокрЛП(Лев(Эл, ПозТочки - 1)));
        ИмяНРег = НРег(СокрЛП(Сред(Эл, ПозТочки + 1)));
        Текущее = ФильтрТипов.Получить(ТипНРег);
        Если Текущее = Истина Тогда
            Продолжить; // уже весь тип
        КонецЕсли;
        Если Текущее = Неопределено Тогда
            Текущее = Новый Соответствие;
            ФильтрТипов.Вставить(ТипНРег, Текущее);
        КонецЕсли;
        Текущее.Вставить(ИмяНРег, Истина);

    КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ОбъектВФильтре(ФильтрТипов, Знач ТипПапки, Знач ИмяОбъекта)

    Если ФильтрТипов.Количество() = 0 Тогда
        Возврат Истина;
    КонецЕсли;

    Значение = ФильтрТипов.Получить(НРег(ТипПапки));
    Если Значение = Неопределено Тогда
        Возврат Ложь;
    ИначеЕсли Значение = Истина Тогда
        Возврат Истина;
    КонецЕсли;

    Возврат Значение.Получить(НРег(ИмяОбъекта)) <> Неопределено;

КонецФункции

&НаКлиенте
Функция ОписаниеОбластиТипов(Знач ФильтрТипов)

    Если ФильтрТипов.Количество() = 0 Тогда
        Возврат "все";
    КонецЕсли;

    Имена = Новый Массив;
    Для Каждого КП Из ТипыОбъектовКонфигурации() Цикл
        Значение = ФильтрТипов.Получить(НРег(КП.Ключ));
        Если Значение = Истина Тогда
            Имена.Добавить(КП.Ключ);
        ИначеЕсли Значение <> Неопределено Тогда
            Для Каждого КПОб Из Значение Цикл
                Имена.Добавить(КП.Ключ + "." + КПОб.Ключ);
            КонецЦикла;
        КонецЕсли;
    КонецЦикла;
    Если ФильтрТипов.Получить("configuration") <> Неопределено Тогда
        Имена.Добавить("Configuration");
    КонецЕсли;
    Если Имена.Количество() < ФильтрТипов.Количество() Тогда
        Имена.Добавить("⚠ часть типов из `in=` не распознана");
    КонецЕсли;

    Возврат СтрСоединить(Имена, ", ");

КонецФункции

&НаКлиенте
Процедура ВыполнитьПоиск(Строки, Знач ТелоЗапроса)

    // ── разбор строки запроса: текст|опция|опция ──
    ЧастиЗапроса = СтрРазделить(ТелоЗапроса, "|", Ложь);
    Если ЧастиЗапроса.Количество() = 0 Тогда
        Строки.Добавить("Пустой запрос SEARCH.");
        Возврат;
    КонецЕсли;

    ТекстПоиска = СокрЛП(ЧастиЗапроса[0]);
    Если ПустаяСтрока(ТекстПоиска) Тогда
        Строки.Добавить("Не указан текст для поиска.");
        Строки.Добавить("Пример: `SEARCH:ПодобратьДоговор|code|in=CommonModules`");
        Возврат;
    КонецЕсли;

    ИскатьИмена     = Ложь;
    ИскатьСинонимы  = Ложь;
    ИскатьКод       = Ложь;
    ИскатьРеквизиты = Ложь;
    РежимЗадан      = Ложь;
    ПоказыватьФрагмент = Истина;
    МаксРезультатов = 50;
    ФильтрТипов     = Новый Соответствие;

    Условия = НовыеУсловияПоискаКода(ТекстПоиска);
    ОпцииПовтора = Новый Массив; // сохраняются в подсказке «показать все попадания»
    // сообщения об опциях — под заголовком блока: строка вплотную
    // к «---» в Markdown превратилась бы в заголовок
    СообщенияОпций = Новый Массив;

    Для Сч = 1 По ЧастиЗапроса.Количество() - 1 Цикл

        Опц     = СокрЛП(ЧастиЗапроса[Сч]);
        ОпцНРег = НРег(Опц);

        Если ОпцНРег = "name" Тогда
            ИскатьИмена = Истина;
            РежимЗадан  = Истина;
        ИначеЕсли ОпцНРег = "syn" Тогда
            ИскатьСинонимы = Истина;
            РежимЗадан     = Истина;
        ИначеЕсли ОпцНРег = "code" Тогда
            ИскатьКод  = Истина;
            РежимЗадан = Истина;
        ИначеЕсли ОпцНРег = "attr" Тогда
            ИскатьРеквизиты = Истина;
            РежимЗадан      = Истина;
        ИначеЕсли ОпцНРег = "all" Тогда
            ИскатьИмена     = Истина;
            ИскатьСинонимы  = Истина;
            ИскатьКод       = Истина;
            ИскатьРеквизиты = Истина;
            РежимЗадан      = Истина;
        ИначеЕсли ОпцНРег = "noctx" Тогда
            ПоказыватьФрагмент = Ложь;
            ОпцииПовтора.Добавить(Опц);
        ИначеЕсли ОпцНРег = "query" Тогда
            Условия.ТолькоЗапросы = Истина;
            ИскатьКод  = Истина;
            РежимЗадан = Истина;
            ОпцииПовтора.Добавить(Опц);
        ИначеЕсли СтрНачинаетсяС(ОпцНРег, "obj=") Тогда
            Условия.ОбъектНРег    = НРег(СокрЛП(Сред(Опц, 5)));
            Условия.ТолькоЗапросы = Истина;
            ИскатьКод  = Истина;
            РежимЗадан = Истина;
            ОпцииПовтора.Добавить(Опц);
        ИначеЕсли ОпцНРег = "nocomm" Тогда
            Условия.БезКомментариев = Истина;
            ОпцииПовтора.Добавить(Опц);
        ИначеЕсли ОпцНРег = "marks" Тогда
            Условия.ТолькоМаркеры = Истина;
            ИскатьКод  = Истина;
            РежимЗадан = Истина;
            ОпцииПовтора.Добавить(Опц);
        ИначеЕсли СтрНачинаетсяС(ОпцНРег, "hits=") Тогда
            Условия.Лимит = ЧислоИзОпции(Сред(Опц, 6), 5, СообщенияОпций, "hits=");
        ИначеЕсли СтрНачинаетсяС(ОпцНРег, "max=") Тогда
            МаксРезультатов = ЧислоИзОпции(Сред(Опц, 5), 50, СообщенияОпций, "max=");
        ИначеЕсли СтрНачинаетсяС(ОпцНРег, "in=") Тогда
            ДобавитьВФильтрIn(ФильтрТипов, Сред(Опц, 4));
        ИначеЕсли НЕ ПустаяСтрока(Опц) Тогда
            СообщенияОпций.Добавить("Неизвестная опция: `" + Опц + "` — пропущена.");
        КонецЕсли;

    КонецЦикла;

    Если НЕ РежимЗадан Тогда
        ИскатьИмена     = Истина;
        ИскатьСинонимы  = Истина;
        ИскатьКод       = Истина;
        ИскатьРеквизиты = Истина;
    КонецЕсли;

    // ── подготовка ──
    РезИмена     = Новый Массив;
    РезСинонимы  = Новый Массив;
    РезКод       = Новый Массив;
    РезРеквизиты = Новый Массив;

    ТекстНРег           = НРег(ТекстПоиска);
    ПросмотреноОбъектов = 0;
    ДостигнутЛимит      = Ложь;
    СклейкаПрименена    = Ложь;

    ИндексСин = Неопределено;
    КэшДоступен = Ложь;
    Если ИскатьСинонимы Тогда
        ИндексСин = ИндексСинонимовИзКэша();
        КэшДоступен = (ИндексСин <> Неопределено);
    КонецЕсли;

    // ── 1. имена, синонимы, реквизиты: обход объектов ──
    Если ИскатьИмена ИЛИ ИскатьСинонимы ИЛИ ИскатьРеквизиты Тогда

        Для Каждого КП Из ТипыОбъектовКонфигурации() Цикл

            Если ДостигнутЛимит Тогда
                Прервать;
            КонецЕсли;

            ТипПапки = КП.Ключ;
            ТипРус   = КП.Значение;

            Если ФильтрТипов.Количество() > 0
                И ФильтрТипов.Получить(НРег(ТипПапки)) = Неопределено Тогда
                Продолжить;
            КонецЕсли;

            ПутьПапки = КореньКаталога + "\" + ТипПапки;
            ФП = Новый Файл(ПутьПапки);
            Если НЕ ФП.Существует() Тогда
                Продолжить;
            КонецЕсли;

            Состояние("Поиск: " + ТипРус + "...");

            Для Каждого Об Из ОбъектыТипа(ПутьПапки) Цикл

                Если ДостигнутЛимит Тогда
                    Прервать;
                КонецЕсли;
                Если НЕ ОбъектВФильтре(ФильтрТипов, ТипПапки, Об.Имя) Тогда
                    Продолжить;
                КонецЕсли;

                ПросмотреноОбъектов = ПросмотреноОбъектов + 1;
                ПолноеИмяОбъекта    = ТипПапки + "." + Об.Имя;

                // ── имя объекта ──
                Если ИскатьИмена И СтрНайти(НРег(Об.Имя), ТекстНРег) > 0 Тогда
                    Ш = ШапкаДляПоиска(Об, ИндексСин, ТипПапки);
                    Эл = Новый Структура("Объект, Тип, Синоним",
                        ПолноеИмяОбъекта, ТипРус, Ш.Синоним);
                    РезИмена.Добавить(Эл);
                КонецЕсли;

                // ── синоним и подсказка объекта ──
                // Синоним бывает бесполезным ("RX"), а смысл лежит в подсказке,
                // поэтому ищем и там тоже.
                Если ИскатьСинонимы Тогда
                    Ш = ШапкаДляПоиска(Об, ИндексСин, ТипПапки);
                    Если (НЕ ПустаяСтрока(Ш.Синоним) И СтрНайти(НРег(Ш.Синоним), ТекстНРег) > 0)
                        ИЛИ (НЕ ПустаяСтрока(Ш.Подсказка) И СтрНайти(НРег(Ш.Подсказка), ТекстНРег) > 0) Тогда
                        Эл = Новый Структура("Объект, Тип, Синоним, Подсказка",
                            ПолноеИмяОбъекта, ТипРус, Ш.Синоним, Ш.Подсказка);
                        РезСинонимы.Добавить(Эл);
                    КонецЕсли;
                КонецЕсли;

                // ── реквизиты и типы ──
                Если ИскатьРеквизиты И Об.ЕстьXML Тогда

                    Реквизиты = Неопределено;
                    Попытка
                        Реквизиты = ПрочитатьСхемуОбъекта(Об.ПутьXML, ТипПапки, Об.Имя);
                    Исключение
                        Реквизиты = Неопределено;
                    КонецПопытки;

                    Если Реквизиты <> Неопределено Тогда
                        Для Каждого Р Из Реквизиты Цикл
                            Если СтрНайти(НРег(Р.Путь), ТекстНРег) > 0
                                ИЛИ СтрНайти(НРег(Р.Тип), ТекстНРег) > 0
                                ИЛИ СтрНайти(НРег(Р.Синоним), ТекстНРег) > 0 Тогда
                                Эл = Новый Структура("Объект, Реквизит, Тип, Раздел, Синоним",
                                    ПолноеИмяОбъекта, Р.Путь, Р.Тип, Р.Раздел, Р.Синоним);
                                РезРеквизиты.Добавить(Эл);

                                Если ВсегоНайдено(РезИмена, РезСинонимы, РезКод, РезРеквизиты)
                                    >= МаксРезультатов Тогда
                                    ДостигнутЛимит = Истина;
                                    Прервать;
                                КонецЕсли;
                            КонецЕсли;
                        КонецЦикла;
                    КонецЕсли;

                КонецЕсли;

                Если ВсегоНайдено(РезИмена, РезСинонимы, РезКод, РезРеквизиты)
                    >= МаксРезультатов Тогда
                    ДостигнутЛимит = Истина;
                КонецЕсли;

            КонецЦикла;

        КонецЦикла;

    КонецЕсли;

    // ── 2. код: построчно, с методом и видом места ──
    ИтогКода = НовыйИтогПоискаКода();

    Если ИскатьКод И НЕ ДостигнутЛимит Тогда

        ОстатокЛимита = МаксРезультатов - ВсегоНайдено(РезИмена, РезСинонимы, РезКод, РезРеквизиты);
        ПоискПоКоду(Условия, ФильтрТипов, ОстатокЛимита, ИтогКода);

        // Фраза могла разорваться по строкам многострочного литерала
        // («…без проекта» / «|договора…») — ищем ещё раз со склейкой.
        Если ИтогКода.Файлы.Количество() = 0 И СтрНайти(ТекстПоиска, " ") > 0
            И НЕ Условия.ТолькоМаркеры Тогда
            Условия.Склейка = Истина;
            ИтогКода = НовыйИтогПоискаКода();
            ПоискПоКоду(Условия, ФильтрТипов, ОстатокЛимита, ИтогКода);
            СклейкаПрименена = Истина;
        КонецЕсли;

        РезКод = ИтогКода.Файлы;
        Если ИтогКода.ДостигнутЛимит Тогда
            ДостигнутЛимит = Истина;
        КонецЕсли;

    КонецЕсли;

    // ── вывод ──
    Строки.Добавить("---");
    Строки.Добавить("## Поиск: `" + ТекстПоиска + "`");
    Строки.Добавить("");
    Для Каждого Сообщ Из СообщенияОпций Цикл
        Строки.Добавить(Сообщ);
        Строки.Добавить("");
    КонецЦикла;

    ОбластиПоиска = Новый Массив;
    Если ИскатьИмена Тогда ОбластиПоиска.Добавить("имена"); КонецЕсли;
    Если ИскатьСинонимы Тогда ОбластиПоиска.Добавить("синонимы"); КонецЕсли;
    Если ИскатьКод Тогда
        ОписаниеКода = "код";
        Если Условия.ТолькоМаркеры Тогда
            ОписаниеКода = "код (только маркеры доработок)";
        ИначеЕсли Условия.ТолькоЗапросы Тогда
            ОписаниеКода = "код (только тексты запросов"
                + ?(ПустаяСтрока(Условия.ОбъектНРег), "", ", где есть `" + Условия.ОбъектНРег + "`") + ")";
        КонецЕсли;
        ОбластиПоиска.Добавить(ОписаниеКода);
    КонецЕсли;
    Если ИскатьРеквизиты Тогда ОбластиПоиска.Добавить("реквизиты"); КонецЕсли;

    Строки.Добавить("> Область: " + СтрСоединить(ОбластиПоиска, ", "));
    Строки.Добавить("> Типы объектов: " + ОписаниеОбластиТипов(ФильтрТипов)
        + ". Расширения (.cfe) не просматриваются — только основная выгрузка.");

    Просмотрено = Новый Массив;
    Если ПросмотреноОбъектов > 0 Тогда
        Просмотрено.Добавить("объектов: " + ЧислоВСтроку(ПросмотреноОбъектов));
    КонецЕсли;
    Если ИскатьКод Тогда
        Просмотрено.Добавить("файлов кода: " + ЧислоВСтроку(ИтогКода.ПросмотреноФайлов));
    КонецЕсли;
    Если Просмотрено.Количество() > 0 Тогда
        Строки.Добавить("> Просмотрено " + СтрСоединить(Просмотрено, ", "));
    КонецЕсли;

    Если СклейкаПрименена Тогда
        Строки.Добавить("> ℹ Прямых совпадений в коде нет — искал повторно, склеив строки"
            + " многострочных литералов (продолжения с «|»).");
    КонецЕсли;
    Если ИскатьСинонимы И НЕ КэшДоступен Тогда
        Строки.Добавить("> ⚠ Кэш шапок не найден — синонимы читались из XML на лету."
            + " Нажми «Выгрузить объекты в MD», чтобы построить кэш и ускорить поиск.");
    КонецЕсли;
    Если ДостигнутЛимит Тогда
        Строки.Добавить("> ⚠ Достигнут лимит " + МаксРезультатов
            + " результатов (для кода — файлов) — поиск остановлен. Уточни запрос, сузь `in=` или подними `max=`.");
    КонецЕсли;
    Строки.Добавить("");

    Если ВсегоНайдено(РезИмена, РезСинонимы, РезКод, РезРеквизиты) = 0 Тогда
        Строки.Добавить("Ничего не найдено.");
        Возврат;
    КонецЕсли;

    Если РезИмена.Количество() > 0 Тогда
        Строки.Добавить("### Имена объектов (" + РезИмена.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Объект | Вид | Синоним | Запрос |");
        Строки.Добавить("|---|---|---|---|");
        Для Каждого Э Из РезИмена Цикл
            Строки.Добавить("| `" + Э.Объект + "` | " + Э.Тип
                + " | " + ЭкранироватьЯчейку(Э.Синоним, 90)
                + " | `SCHEMA:" + Э.Объект + "` |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

    Если РезСинонимы.Количество() > 0 Тогда
        Строки.Добавить("### Синонимы и подсказки объектов (" + РезСинонимы.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Объект | Вид | Синоним | Подсказка | Запрос |");
        Строки.Добавить("|---|---|---|---|---|");
        Для Каждого Э Из РезСинонимы Цикл
            Строки.Добавить("| `" + Э.Объект + "` | " + Э.Тип
                + " | " + ЭкранироватьЯчейку(Э.Синоним, 90)
                + " | " + ЭкранироватьЯчейку(Э.Подсказка, 120)
                + " | `SCHEMA:" + Э.Объект + "` |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

    Если РезКод.Количество() > 0 Тогда
        Строки.Добавить("### Код (файлов: " + ЧислоВСтроку(РезКод.Количество())
            + ", попаданий: " + ЧислоВСтроку(ИтогКода.ВсегоПопаданий) + ")");
        Строки.Добавить("");
        ХвостОпций = ?(ОпцииПовтора.Количество() = 0, "", "|" + СтрСоединить(ОпцииПовтора, "|"));
        ВывестиТаблицуПопаданий(Строки, РезКод, ПоказыватьФрагмент,
            "SEARCH:" + ТекстПоиска + "|code" + ХвостОпций);
    КонецЕсли;

    Если РезРеквизиты.Количество() > 0 Тогда
        Строки.Добавить("### Реквизиты и типы (" + РезРеквизиты.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Объект | Реквизит | Тип | Синоним | Запрос |");
        Строки.Добавить("|---|---|---|---|---|");
        Для Каждого Э Из РезРеквизиты Цикл
            Строки.Добавить("| `" + Э.Объект + "` | `" + Э.Реквизит
                + "` | " + ЭкранироватьЯчейку(Э.Тип, 90)
                + " | " + ЭкранироватьЯчейку(Э.Синоним, 90)
                + " | `SCHEMA:" + Э.Объект + "` |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ВсегоНайдено(РезИмена, РезСинонимы, РезКод, РезРеквизиты)

    Возврат РезИмена.Количество() + РезСинонимы.Количество()
        + РезКод.Количество() + РезРеквизиты.Количество();

КонецФункции

&НаКлиенте
Функция ШапкаДляПоиска(Знач Об, ИндексСин, Знач ТипПапки)

    // Синоним и подсказка объекта: из кэша, если он построен,
    // иначе читаем XML на лету.
    Если ИндексСин <> Неопределено Тогда
        Найденный = ИндексСин.Получить(НРег(ТипПапки + "." + Об.Имя));
        Если Найденный <> Неопределено Тогда
            Возврат Найденный;
        КонецЕсли;
    КонецЕсли;

    Пусто = Новый Структура("Синоним, Подсказка", "", "");

    Если НЕ Об.ЕстьXML Тогда
        Возврат Пусто;
    КонецЕсли;

    Шапка = ПрочитатьШапкуОбъекта(Об.ПутьXML);
    Возврат Новый Структура("Синоним, Подсказка", Шапка.Синоним, Шапка.Подсказка);

КонецФункции

&НаКлиенте
Функция ОчиститьДляКэша(Знач Текст)

    // В кэше поля разделены табуляцией, строки — переводом строки.
    Если Текст = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Текст = СтрЗаменить(Текст, Символы.Таб, " ");
    Текст = СтрЗаменить(Текст, Символы.ВК, " ");
    Текст = СтрЗаменить(Текст, Символы.ПС, " ");
    Возврат СокрЛП(Текст);

КонецФункции

&НаКлиенте
Функция ТипСтандартногоРеквизита(Знач ИмяРеквизита, Знач ТипОбъекта, Знач ИмяОбъекта, Знач СвойстваОбъекта)

    ПрефиксыСсылок = Новый Соответствие;
    ПрефиксыСсылок.Вставить("Catalogs",                   "СправочникСсылка");
    ПрефиксыСсылок.Вставить("Documents",                  "ДокументСсылка");
    ПрефиксыСсылок.Вставить("Enums",                      "ПеречислениеСсылка");
    ПрефиксыСсылок.Вставить("ChartsOfCharacteristicTypes","ПланВидовХарактеристикСсылка");
    ПрефиксыСсылок.Вставить("ChartsOfAccounts",           "ПланСчетовСсылка");
    ПрефиксыСсылок.Вставить("ChartsOfCalculationTypes",   "ПланВидовРасчетаСсылка");
    ПрефиксыСсылок.Вставить("BusinessProcesses",          "БизнесПроцессСсылка");
    ПрефиксыСсылок.Вставить("Tasks",                      "ЗадачаСсылка");
    ПрефиксыСсылок.Вставить("ExchangePlans",              "ПланОбменаСсылка");

    // у журнала документов «Ссылка» — на один из документов журнала,
    // «Тип» — тип этого документа (не вид счёта)
    Если НРег(ТипОбъекта) = "documentjournals" Тогда
        Если ИмяРеквизита = "Ref" Тогда
            Возврат "ДокументСсылка (документ журнала)";
        ИначеЕсли ИмяРеквизита = "Type" Тогда
            Возврат "Тип (тип документа)";
        КонецЕсли;
    КонецЕсли;

    Если ИмяРеквизита = "Ref" Тогда
        Префикс = ПрефиксыСсылок.Получить(ТипОбъекта);
        Если Префикс <> Неопределено И НЕ ПустаяСтрока(ИмяОбъекта) Тогда
            Возврат Префикс + "." + ИмяОбъекта;
        КонецЕсли;
        Возврат "Ссылка";

    ИначеЕсли ИмяРеквизита = "Parent" Тогда
        Префикс = ПрефиксыСсылок.Получить(ТипОбъекта);
        Если Префикс <> Неопределено И НЕ ПустаяСтрока(ИмяОбъекта) Тогда
            Возврат Префикс + "." + ИмяОбъекта;
        КонецЕсли;
        Возврат "Ссылка (родитель)";

    ИначеЕсли ИмяРеквизита = "Posted"
        ИЛИ ИмяРеквизита = "DeletionMark"
        ИЛИ ИмяРеквизита = "IsFolder"
        ИЛИ ИмяРеквизита = "Predefined"
        ИЛИ ИмяРеквизита = "Active" Тогда
        Возврат "Булево";

    ИначеЕсли ИмяРеквизита = "Date" ИЛИ ИмяРеквизита = "Period" Тогда
        Возврат "Дата(дата и время)";

    ИначеЕсли ИмяРеквизита = "LineNumber" Тогда
        Возврат "Число(9)";

    ИначеЕсли ИмяРеквизита = "Recorder" Тогда
        Возврат "ДокументСсылка (регистратор)";

    ИначеЕсли ИмяРеквизита = "RecordType" Тогда
        Возврат "ВидДвиженияНакопления";

    ИначеЕсли ИмяРеквизита = "PredefinedDataName" Тогда
        Возврат "Строка";

    ИначеЕсли ИмяРеквизита = "ValueType" Тогда
        Возврат "ОписаниеТипов";

    ИначеЕсли ИмяРеквизита = "Number" Тогда
        Возврат ТипПоДлинеРасширенно(СвойстваОбъекта,
            "NumberType", "NumberLength", "NumberAllowedLength", "Строка", "номер не используется");

    ИначеЕсли ИмяРеквизита = "Code" Тогда
        Возврат ТипПоДлинеРасширенно(СвойстваОбъекта,
            "CodeType", "CodeLength", "CodeAllowedLength", "Строка", "код не используется");

    ИначеЕсли ИмяРеквизита = "Description" Тогда
        Возврат ТипПоДлинеРасширенно(СвойстваОбъекта,
            "", "DescriptionLength", "", "Строка", "наименование не используется");

    ИначеЕсли ИмяРеквизита = "Owner" Тогда
        Возврат "СправочникСсылка (владелец)";

    КонецЕсли;

    Возврат ТипПрочегоСтандартногоРеквизита(ИмяРеквизита);

КонецФункции

&НаКлиенте
Функция ТипПрочегоСтандартногоРеквизита(Знач ИмяРеквизита)

    // Стандартные реквизиты планов обмена, бизнес-процессов, задач,
    // планов счетов и регистров расчёта — раньше выводились как "—".
    Соотв = Новый Соответствие;
    Соотв.Вставить("Order",                 "Число (порядок)");
    Соотв.Вставить("Type",                  "ВидСчета");
    Соотв.Вставить("OffBalance",            "Булево");
    Соотв.Вставить("TurnoversOnly",         "Булево");
    Соотв.Вставить("Account",               "ПланСчетовСсылка");
    Соотв.Вставить("AccountDr",             "ПланСчетовСсылка (дебет)");
    Соотв.Вставить("AccountCr",             "ПланСчетовСсылка (кредит)");
    Соотв.Вставить("ExtDimensionTypes",     "ПланВидовХарактеристикСсылка");
    Соотв.Вставить("ThisNode",              "Булево (этот узел)");
    Соотв.Вставить("SentNo",                "Число (номер отправленного)");
    Соотв.Вставить("ReceivedNo",            "Число (номер принятого)");
    Соотв.Вставить("Started",               "Булево (стартован)");
    Соотв.Вставить("Completed",             "Булево (завершён)");
    Соотв.Вставить("HeadTask",              "ЗадачаСсылка (ведущая задача)");
    Соотв.Вставить("Executed",              "Булево (выполнена)");
    Соотв.Вставить("BusinessProcess",       "БизнесПроцессСсылка");
    Соотв.Вставить("RoutePoint",            "ТочкаМаршрутаБизнесПроцессаСсылка");
    Соотв.Вставить("CalculationType",       "ПланВидовРасчетаСсылка");
    Соотв.Вставить("ExchangeDate",          "Дата(дата и время)");
    Соотв.Вставить("ActionPeriodIsBasic",   "Булево");
    Соотв.Вставить("PeriodAdjustment",      "Булево (сторно)");
    Соотв.Вставить("RegistrationPeriod",    "Дата(дата)");
    Соотв.Вставить("BegOfPeriod",           "Дата(дата и время)");
    Соотв.Вставить("EndOfPeriod",           "Дата(дата и время)");
    Соотв.Вставить("BegOfActionPeriod",     "Дата(дата и время)");
    Соотв.Вставить("EndOfActionPeriod",     "Дата(дата и время)");
    Соотв.Вставить("BegOfBasePeriod",       "Дата(дата и время)");
    Соотв.Вставить("EndOfBasePeriod",       "Дата(дата и время)");
    Соотв.Вставить("ActionPeriod",          "Дата(дата и время)");
    Соотв.Вставить("ReversingEntry",        "Булево (сторно)");
    Соотв.Вставить("SourceRecordKey",       "КлючЗаписи");
    Соотв.Вставить("PointInTime",           "МоментВремени");

    Найдено = Соотв.Получить(ИмяРеквизита);
    Если Найдено <> Неопределено Тогда
        Возврат Найдено;
    КонецЕсли;

    // ExtDimension1..3 и ExtDimensionType1..3 нумерованные
    Если СтрНачинаетсяС(ИмяРеквизита, "ExtDimensionType") Тогда
        Возврат "ПланВидовХарактеристикСсылка (вид субконто)";
    ИначеЕсли СтрНачинаетсяС(ИмяРеквизита, "ExtDimension") Тогда
        Возврат "Характеристика (субконто)";
    КонецЕсли;

    Возврат "";

КонецФункции

&НаКлиенте
Функция ТипПоДлинеРасширенно(СвойстваОбъекта, Знач КлючТипа, Знач КлючДлины,
    Знач КлючДопустимойДлины, Знач ТипПоУмолчанию, Знач ТекстОтсутствия)

    // Длина 0 означает, что реквизит выключен (например, справочник без кода),
    // и писать "Строка" было бы дезинформацией.
    ИмяТипа = ТипПоУмолчанию;
    Если НЕ ПустаяСтрока(КлючТипа) Тогда
        СыройТип = СвойстваОбъекта.Получить(КлючТипа);
        Если СыройТип <> Неопределено Тогда
            Если НРег(СыройТип) = "number" Тогда
                ИмяТипа = "Число";
            Иначе
                ИмяТипа = "Строка";
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;

    Длина = СвойстваОбъекта.Получить(КлючДлины);

    Если Длина <> Неопределено И СокрЛП(Длина) = "0" Тогда
        Возврат "— (" + ТекстОтсутствия + ")";
    КонецЕсли;

    Если Длина = Неопределено ИЛИ ПустаяСтрока(Длина) Тогда
        Возврат ИмяТипа;
    КонецЕсли;

    Квалификатор = "(" + СокрЛП(Длина);
    Если НЕ ПустаяСтрока(КлючДопустимойДлины) Тогда
        ЗначДопустимойДлины = СвойстваОбъекта.Получить(КлючДопустимойДлины);
        Если ЗначДопустимойДлины <> Неопределено И НРег(СокрЛП(ЗначДопустимойДлины)) = "fixed" Тогда
            Квалификатор = Квалификатор + ", фикс";
        КонецЕсли;
    КонецЕсли;
    Квалификатор = Квалификатор + ")";

    Возврат ИмяТипа + Квалификатор;

КонецФункции

&НаКлиенте
Функция ПрочитатьСхемуОбъекта(ПутьXML, Знач ТипОбъекта = "", Знач ИмяОбъекта = "")

    Результат = Новый Массив;

    ЧтениеXML = Новый ЧтениеXML;
    ЧтениеXML.ОткрытьФайл(ПутьXML);

    Стек = Новый Массив;

    СвойстваОбъекта = Новый Соответствие;
    СвойстваВерхнегоУровня = Новый Соответствие;
    СвойстваВерхнегоУровня.Вставить("NumberLength",        Истина);
    СвойстваВерхнегоУровня.Вставить("NumberType",          Истина);
    СвойстваВерхнегоУровня.Вставить("NumberAllowedLength", Истина);
    СвойстваВерхнегоУровня.Вставить("CodeLength",          Истина);
    СвойстваВерхнегоУровня.Вставить("CodeType",            Истина);
    СвойстваВерхнегоУровня.Вставить("CodeAllowedLength",   Истина);
    СвойстваВерхнегоУровня.Вставить("DescriptionLength",   Истина);

    КонтейнерыРеквизитов = Новый Соответствие;
    КонтейнерыРеквизитов.Вставить("Attribute",         "Attribute");
    КонтейнерыРеквизитов.Вставить("Dimension",         "Dimension");
    КонтейнерыРеквизитов.Вставить("Resource",          "Resource");
    КонтейнерыРеквизитов.Вставить("StandardAttribute", "StandardAttribute");
    КонтейнерыРеквизитов.Вставить("TabularSection",    "TabularSection");
    КонтейнерыРеквизитов.Вставить("StandardTabularSection", "StandardTabularSection");
    КонтейнерыРеквизитов.Вставить("CommonAttribute",   "CommonAttribute");
    КонтейнерыРеквизитов.Вставить("Operation",         "Operation");
    КонтейнерыРеквизитов.Вставить("Parameter",         "Parameter");
    КонтейнерыРеквизитов.Вставить("URLTemplate",       "URLTemplate");
    КонтейнерыРеквизитов.Вставить("Method",            "Method");
    КонтейнерыРеквизитов.Вставить("Form",              "Form");
    КонтейнерыРеквизитов.Вставить("Command",           "Command");
    КонтейнерыРеквизитов.Вставить("EnumValue",         "EnumValue");
    КонтейнерыРеквизитов.Вставить("AccountingFlag",    "AccountingFlag");
    КонтейнерыРеквизитов.Вставить("ExtDimensionAccountingFlag", "ExtDimensionAccountingFlag");
    КонтейнерыРеквизитов.Вставить("Recalculation",     "Recalculation");
    КонтейнерыРеквизитов.Вставить("AddressingAttribute", "AddressingAttribute");
    КонтейнерыРеквизитов.Вставить("Template",          "Template");
    КонтейнерыРеквизитов.Вставить("Column",            "Column");   // графа журнала документов

    // <Column> — дочерний объект только у журнала документов
    ЭтоЖурнал = (НРег(ТипОбъекта) = "documentjournals");

    // Глубину считаем по стеку ИМЁН открытых элементов, а не счётчиком:
    // у пустого элемента (<Comment/>) закрывающего тега может не быть,
    // и обычный счётчик после первого же такого элемента уезжает навсегда.
    СтекИмен     = Новый Массив;
    ОбщаяГлубина = 0;

    Пока ЧтениеXML.Прочитать() Цикл

        Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда

            ЛокИмя = ЧтениеXML.ЛокальноеИмя;

            СтекИмен.Добавить(ЛокИмя);
            ОбщаяГлубина = СтекИмен.Количество();

            Если Стек.Количество() = 0 И СвойстваВерхнегоУровня.Получить(ЛокИмя) <> Неопределено Тогда
                СвойстваОбъекта.Вставить(ЛокИмя, ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен));
                Продолжить;
            КонецЕсли;

            Если КонтейнерыРеквизитов.Получить(ЛокИмя) <> Неопределено
                И (ЛокИмя <> "Column" ИЛИ ЭтоЖурнал) Тогда
                Блок = Новый Структура;
                Блок.Вставить("Раздел", ЛокИмя);
                Блок.Вставить("ГлубинаОткрытия", ОбщаяГлубина);
                Блок.Вставить("Имя", "");
                Блок.Вставить("Синоним", "");
                Блок.Вставить("ТипыЧасти", Новый Массив);
                Блок.Вставить("СейчасВнутриТипа", Ложь);
                Блок.Вставить("ГлубинаТипа", 0);
                Блок.Вставить("СейчасВСинониме", Ложь);
                Блок.Вставить("ГлубинаСинонима", 0);
                Блок.Вставить("ДлинаСтроки", "");
                Блок.Вставить("ДопустимаяДлина", "");
                Блок.Вставить("ЦифрыЧисла", "");
                Блок.Вставить("ДробьЧисла", "");
                Блок.Вставить("ЧастиДаты", "");
                Блок.Вставить("Направление", "");
                Блок.Вставить("ИмяПроцедуры", "");
                Блок.Вставить("Индексирование", "");
                Блок.Вставить("ОсновнойОтбор", "");
                Блок.Вставить("Ссылки", Новый Массив); // графа журнала: реквизиты документов
                Блок.Вставить("ИндексВставки", Результат.Количество());
                Стек.Добавить(Блок);

                Если ЧтениеXML.КоличествоАтрибутов() > 0 Тогда
                    Для Сч = 0 По ЧтениеXML.КоличествоАтрибутов() - 1 Цикл
                        Если ЧтениеXML.ИмяАтрибута(Сч) = "name" Тогда
                            Блок.Имя = ЧтениеXML.ЗначениеАтрибута(Сч);
                            Прервать;
                        КонецЕсли;
                    КонецЦикла;
                КонецЕсли;

                Продолжить;
            КонецЕсли;

            Если Стек.Количество() > 0 Тогда
                ТекБлок = Стек[Стек.Количество() - 1];

                Если ЛокИмя = "Synonym" И НЕ ТекБлок.СейчасВнутриТипа Тогда
                    ТекБлок.СейчасВСинониме = Истина;
                    ТекБлок.ГлубинаСинонима = ОбщаяГлубина;
                    Продолжить;
                КонецЕсли;

                Если ТекБлок.СейчасВСинониме Тогда
                    Если ЛокИмя = "content" И ПустаяСтрока(ТекБлок.Синоним) Тогда
                        ТекБлок.Синоним = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                    КонецЕсли;
                    Продолжить;
                КонецЕсли;

                Если ЛокИмя = "Name" И НЕ ТекБлок.СейчасВнутриТипа И ПустаяСтрока(ТекБлок.Имя) Тогда
                    ТекБлок.Имя = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                    Продолжить;
                КонецЕсли;

                Если ЛокИмя = "Type" И НЕ ТекБлок.СейчасВнутриТипа Тогда
                    ТекБлок.СейчасВнутриТипа = Истина;
                    ТекБлок.ГлубинаТипа = ОбщаяГлубина;
                    Продолжить;
                КонецЕсли;

                Если НЕ ТекБлок.СейчасВнутриТипа Тогда

                    Если ЛокИмя = "XDTOValueType" ИЛИ ЛокИмя = "XDTOReturningValueType" Тогда
                        ЧастьТипа = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                        Если НЕ ПустаяСтрока(ЧастьТипа) Тогда
                            ТекБлок.ТипыЧасти.Добавить(ЧастьТипа);
                        КонецЕсли;
                        Продолжить;

                    ИначеЕсли ЛокИмя = "TransferDirection" Тогда
                        ТекБлок.Направление = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                        Продолжить;

                    ИначеЕсли ЛокИмя = "ProcedureName" Тогда
                        ТекБлок.ИмяПроцедуры = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                        Продолжить;

                    ИначеЕсли ЛокИмя = "Handler" И ТекБлок.Раздел = "Method" Тогда
                        // обработчик метода HTTP-сервиса (GET, POST…)
                        ТекБлок.ИмяПроцедуры = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                        Продолжить;

                    ИначеЕсли ЛокИмя = "References" И ТекБлок.Раздел = "Column" Тогда
                        Тексты = ТекстыПоддерева(ЧтениеXML);
                        Если СтекИмен.Количество() > 0 Тогда
                            СтекИмен.Удалить(СтекИмен.Количество() - 1);
                        КонецЕсли;
                        ТекБлок.Ссылки = ?(Тексты.Айтемы.Количество() > 0, Тексты.Айтемы, Тексты.Все);
                        Продолжить;

                    ИначеЕсли ЛокИмя = "Indexing" Тогда
                        ТекБлок.Индексирование = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                        Продолжить;

                    ИначеЕсли ЛокИмя = "MainFilter" Тогда
                        ТекБлок.ОсновнойОтбор = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                        Продолжить;

                    КонецЕсли;

                КонецЕсли;

                Если ТекБлок.СейчасВнутриТипа Тогда

                    Если ЛокИмя = "Type" Тогда
                        ЧастьТипа = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                        Если НЕ ПустаяСтрока(ЧастьТипа) Тогда
                            ТекБлок.ТипыЧасти.Добавить(ЧастьТипа);
                        КонецЕсли;
                        Продолжить;

                    ИначеЕсли ЛокИмя = "TypeSet" Тогда
                        ЧастьТипа = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                        Если НЕ ПустаяСтрока(ЧастьТипа) Тогда
                            ТекБлок.ТипыЧасти.Добавить(ЧастьТипа);
                        КонецЕсли;
                        Продолжить;

                    ИначеЕсли ЛокИмя = "Length" Тогда
                        ТекБлок.ДлинаСтроки = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                        Продолжить;

                    ИначеЕсли ЛокИмя = "AllowedLength" Тогда
                        ТекБлок.ДопустимаяДлина = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                        Продолжить;

                    ИначеЕсли ЛокИмя = "Digits" Тогда
                        ТекБлок.ЦифрыЧисла = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                        Продолжить;

                    ИначеЕсли ЛокИмя = "FractionDigits" Тогда
                        ТекБлок.ДробьЧисла = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                        Продолжить;

                    ИначеЕсли ЛокИмя = "DateFractions" Тогда
                        ТекБлок.ЧастиДаты = ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                        Продолжить;

                    КонецЕсли;

                КонецЕсли;
            КонецЕсли;

        ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда

            ЛокИмя = ЧтениеXML.ЛокальноеИмя;

            // Если верх стека не совпал с именем — это закрытие пустого элемента,
            // который мы намеренно не клали в стек. Пропускаем.
            Если СтекИмен.Количество() = 0
                ИЛИ СтекИмен[СтекИмен.Количество() - 1] <> ЛокИмя Тогда
                Продолжить;
            КонецЕсли;

            ОбщаяГлубина = СтекИмен.Количество();

            Если Стек.Количество() > 0 Тогда
                ТекБлок = Стек[Стек.Количество() - 1];
                Если ТекБлок.СейчасВнутриТипа И ЛокИмя = "Type" И ОбщаяГлубина = ТекБлок.ГлубинаТипа Тогда
                    ТекБлок.СейчасВнутриТипа = Ложь;
                КонецЕсли;
                Если ТекБлок.СейчасВСинониме И ЛокИмя = "Synonym" И ОбщаяГлубина = ТекБлок.ГлубинаСинонима Тогда
                    ТекБлок.СейчасВСинониме = Ложь;
                КонецЕсли;
            КонецЕсли;

            Если Стек.Количество() > 0 Тогда
                ТекБлок = Стек[Стек.Количество() - 1];
                Если ЛокИмя = ТекБлок.Раздел И ОбщаяГлубина = ТекБлок.ГлубинаОткрытия Тогда
                    Если НЕ ПустаяСтрока(ТекБлок.Имя) Тогда

                        ПрефиксПути = "";
                        ВнутриШаблонаURL = Ложь;
                        Если Стек.Количество() >= 2 Тогда
                            ИменаПредков = Новый Массив;
                            Для Инд = 0 По Стек.Количество() - 2 Цикл
                                Предок = Стек[Инд];
                                Если Предок.Раздел = "URLTemplate" Тогда
                                    ВнутриШаблонаURL = Истина;
                                КонецЕсли;
                                Если (Предок.Раздел = "TabularSection"
                                        ИЛИ Предок.Раздел = "StandardTabularSection"
                                        ИЛИ Предок.Раздел = "URLTemplate"
                                        ИЛИ Предок.Раздел = "Operation"
                                        ИЛИ Предок.Раздел = "Recalculation")
                                    И НЕ ПустаяСтрока(Предок.Имя) Тогда
                                    ИменаПредков.Добавить(Предок.Имя);
                                КонецЕсли;
                            КонецЦикла;
                            Если ИменаПредков.Количество() > 0 Тогда
                                ПрефиксПути = СтрСоединить(ИменаПредков, ".") + ".";
                            КонецЕсли;
                        КонецЕсли;

                        // <Template> внутри <URLTemplate> — это путь шаблона
                        // HTTP-сервиса, а не макет объекта.
                        РазделДляВывода = ТекБлок.Раздел;
                        Если ТекБлок.Раздел = "Template" И ВнутриШаблонаURL Тогда
                            РазделДляВывода = "URLPattern";
                        КонецЕсли;

                        ТипДляВывода = СобратьТипДляВывода(ТекБлок);
                        Если ПустаяСтрока(ТипДляВывода) Тогда
                            Если ТекБлок.Раздел = "TabularSection" Тогда
                                ТипДляВывода = "ТабличнаяЧасть";
                            ИначеЕсли ТекБлок.Раздел = "StandardTabularSection" Тогда
                                ТипДляВывода = "ТабличнаяЧасть (стандартная)";
                            ИначеЕсли ТекБлок.Раздел = "Form" Тогда
                                ТипДляВывода = "Форма";
                            ИначеЕсли ТекБлок.Раздел = "Command" Тогда
                                ТипДляВывода = "Команда";
                            ИначеЕсли ТекБлок.Раздел = "Template" Тогда
                                ТипДляВывода = ?(ВнутриШаблонаURL, "Путь шаблона", "Макет");
                            ИначеЕсли ТекБлок.Раздел = "EnumValue" Тогда
                                ТипДляВывода = "Значение";
                            ИначеЕсли ТекБлок.Раздел = "Recalculation" Тогда
                                ТипДляВывода = "Перерасчет";
                            ИначеЕсли ТекБлок.Раздел = "AccountingFlag" Тогда
                                ТипДляВывода = "Булево";
                            ИначеЕсли ТекБлок.Раздел = "ExtDimensionAccountingFlag" Тогда
                                ТипДляВывода = "Булево";
                            ИначеЕсли ТекБлок.Раздел = "Operation" Тогда
                                ТипДляВывода = "Операция веб-сервиса";
                            ИначеЕсли ТекБлок.Раздел = "URLTemplate" Тогда
                                ТипДляВывода = "Шаблон URL";
                            ИначеЕсли ТекБлок.Раздел = "Method" Тогда
                                ТипДляВывода = "Метод";
                            ИначеЕсли ТекБлок.Раздел = "Column" Тогда
                                ТипДляВывода = ОписаниеГрафыЖурнала(ТекБлок.Ссылки);
                            ИначеЕсли ТекБлок.Раздел = "StandardAttribute" Тогда
                                ТипДляВывода = "@СТАНД@";
                            Иначе
                                ТипДляВывода = "—";
                            КонецЕсли;
                        КонецЕсли;

                        Если (ТекБлок.Раздел = "Operation" ИЛИ ТекБлок.Раздел = "Method")
                            И НЕ ПустаяСтрока(ТекБлок.ИмяПроцедуры) Тогда
                            ТипДляВывода = ТипДляВывода + " → " + ТекБлок.ИмяПроцедуры;
                        КонецЕсли;
                        Если ТекБлок.Раздел = "Parameter" И НЕ ПустаяСтрока(ТекБлок.Направление) Тогда
                            ТипДляВывода = ТипДляВывода + " ["
                                + НаправлениеПараметра(ТекБлок.Направление) + "]";
                        КонецЕсли;

                        Эл = Новый Структура("Путь, Тип, Раздел, Синоним, Индекс, Обработчик",
                            ПрефиксПути + ТекБлок.Имя,
                            ТипДляВывода,
                            РазделДляВывода,
                            ТекБлок.Синоним,
                            ПредставлениеИндексирования(ТекБлок.Индексирование, ТекБлок.ОсновнойОтбор),
                            ?(ТекБлок.Раздел = "Operation" ИЛИ ТекБлок.Раздел = "Method",
                                ТекБлок.ИмяПроцедуры, ""));
                        Если ТекБлок.ИндексВставки <= Результат.Количество() Тогда
                            Результат.Вставить(ТекБлок.ИндексВставки, Эл);
                        Иначе
                            Результат.Добавить(Эл);
                        КонецЕсли;
                    КонецЕсли;
                    Стек.Удалить(Стек.Количество() - 1);
                КонецЕсли;
            КонецЕсли;

            СтекИмен.Удалить(СтекИмен.Количество() - 1);
            ОбщаяГлубина = СтекИмен.Количество();

        ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда

            Если Стек.Количество() > 0 Тогда
                ТекБлок = Стек[Стек.Количество() - 1];
                Если ПустаяСтрока(ТекБлок.Имя)
                    И НЕ ТекБлок.СейчасВнутриТипа
                    И НЕ ТекБлок.СейчасВСинониме
                    И СтекИмен.Количество() = ТекБлок.ГлубинаОткрытия Тогда
                    ТекстУзла = СокрЛП(ЧтениеXML.Значение);
                    Если НЕ ПустаяСтрока(ТекстУзла) Тогда
                        ТекБлок.Имя = ТекстУзла;
                    КонецЕсли;
                КонецЕсли;
            КонецЕсли;

        КонецЕсли;

    КонецЦикла;

    ЧтениеXML.Закрыть();

    // ── второй проход: типы стандартных реквизитов ──
    // Свойства объекта (длины кода/номера) в XML идут до блока StandardAttributes,
    // но полагаться на порядок не будем — доразрешаем типы здесь.
    Для Сч = 0 По Результат.Количество() - 1 Цикл
        Эл = Результат[Сч];
        Если Эл.Тип = "@СТАНД@" Тогда
            ИмяСтанд = Эл.Путь;
            ТочкаПоз = СтрНайти(ИмяСтанд, ".");
            Пока ТочкаПоз > 0 Цикл
                ИмяСтанд = Сред(ИмяСтанд, ТочкаПоз + 1);
                ТочкаПоз = СтрНайти(ИмяСтанд, ".");
            КонецЦикла;
            НовыйТип = ТипСтандартногоРеквизита(ИмяСтанд, ТипОбъекта, ИмяОбъекта, СвойстваОбъекта);
            Эл.Тип = ?(ПустаяСтрока(НовыйТип), "—", НовыйТип);
        КонецЕсли;
    КонецЦикла;

    Возврат Результат;

КонецФункции

// Колонка «Индекс» в SCHEMA: ✓ — индексировать, ✓+доп — с доп. упорядочиванием,
// «отбор» — основной отбор (MainFilter). "" — ничего из этого.
&НаКлиенте
Функция ПредставлениеИндексирования(Знач Индексирование, Знач ОсновнойОтбор)

    Части = Новый Массив;

    ИндНРег = НРег(СокрЛП(Индексирование));
    Если ИндНРег = "index" Тогда
        Части.Добавить("✓");
    ИначеЕсли ИндНРег = "indexwithadditionalorder" Тогда
        Части.Добавить("✓+доп");
    КонецЕсли;

    Если НРег(СокрЛП(ОсновнойОтбор)) = "true" Тогда
        Части.Добавить("отбор");
    КонецЕсли;

    Возврат СтрСоединить(Части, " ");

КонецФункции

&НаКлиенте
Функция НаправлениеПараметра(Знач Сырое)

    Н = НРег(СокрЛП(Сырое));
    Если Н = "in" Тогда
        Возврат "вх";
    ИначеЕсли Н = "out" Тогда
        Возврат "исх";
    ИначеЕсли Н = "inout" Тогда
        Возврат "вх-исх";
    КонецЕсли;
    Возврат Сырое;

КонецФункции

&НаКлиенте
Функция СформироватьИмяПоЗапросу(Части)

    Если Части = Неопределено ИЛИ Части.Количество() = 0 Тогда
        Возврат "ОтветНаЗапрос";
    КонецЕсли;

    // Метки типов запроса. Хочешь "Scheme"/"Fetch" — поменяй значения справа.
    МеткиТипов = Новый Соответствие;
    МеткиТипов.Вставить("FETCH",  "FETCH");
    МеткиТипов.Вставить("SCHEMA", "SCHEMA");
    МеткиТипов.Вставить("SEARCH", "SEARCH");
    МеткиТипов.Вставить("DEPENDENCIES", "DEPS");
    МеткиТипов.Вставить("PROC",    "PROC");
    МеткиТипов.Вставить("REGION",  "REGION");
    МеткиТипов.Вставить("LINES",   "LINES");
    МеткиТипов.Вставить("OUTLINE", "OUTLINE");
    МеткиТипов.Вставить("FORM",    "FORM");
    МеткиТипов.Вставить("EVENTS",  "EVENTS");
    МеткиТипов.Вставить("SUBSYS",  "SUBSYS");
    МеткиТипов.Вставить("CALLERS", "CALLERS");
    МеткиТипов.Вставить("QUERIES", "QUERIES");

    ТипыВПорядке  = Новый Массив; // уникальные типы запроса в порядке появления
    ИменаВПорядке = Новый Массив; // уникальные имена объектов в порядке появления
    ВидетьТип = Новый Соответствие;
    ВидетьИмя = Новый Соответствие;

    Для Каждого ЗапросЭл Из Части Цикл

        ТипЗапр = ВРег(СокрЛП(ЗапросЭл.ТипЗапроса));
        Метка   = МеткиТипов.Получить(ТипЗапр);
        Если Метка = Неопределено Тогда
            Метка = ТипЗапр;
        КонецЕсли;
        Если НЕ ПустаяСтрока(Метка) И ВидетьТип.Получить(Метка) = Неопределено Тогда
            ВидетьТип.Вставить(Метка, Истина);
            ТипыВПорядке.Добавить(Метка);
        КонецЕсли;

        ЧастиОпций   = СтрРазделить(СокрЛП(ЗапросЭл.Часть), "|", Ложь);
        РабочаяЧасть = ?(ЧастиОпций.Количество() > 0, СокрЛП(ЧастиОпций[0]), "");

        СыроеИмя = "";

        Если ТипЗапр = "SEARCH" ИЛИ ТипЗапр = "SUBSYS" Тогда

            // у SUBSYS в запросе нет типа объекта — всё тело и есть имя
            СыроеИмя = РабочаяЧасть;

        ИначеЕсли ТипЗапр = "FORM" Тогда

            // имя формы информативнее имени объекта
            Сегменты = СтрРазделить(РабочаяЧасть, ".", Ложь);
            Если Сегменты.Количество() >= 1 Тогда
                СыроеИмя = СокрЛП(Сегменты[Сегменты.Количество() - 1]);
            КонецЕсли;

        ИначеЕсли ТипЗапр = "QUERIES" И СтрНайти(РабочаяЧасть, "#") = 0 Тогда

            Сегменты = СтрРазделить(РабочаяЧасть, ".", Ложь);
            Если Сегменты.Количество() >= 2 Тогда
                СыроеИмя = СокрЛП(Сегменты[1]);
            КонецЕсли;

        ИначеЕсли ТипЗапр = "PROC" ИЛИ ТипЗапр = "REGION" ИЛИ ТипЗапр = "CALLERS" ИЛИ ТипЗапр = "QUERIES" Тогда

            // имя процедуры или области информативнее имени объекта
            ПозМетки = СтрНайти(РабочаяЧасть, "#");
            Если ПозМетки > 0 Тогда
                СыроеИмя = СокрЛП(Сред(РабочаяЧасть, ПозМетки + 1));
            Иначе
                Сегменты = СтрРазделить(РабочаяЧасть, ".", Ложь);
                Если Сегменты.Количество() >= 3 Тогда
                    СыроеИмя = СокрЛП(Сегменты[Сегменты.Количество() - 1]);
                ИначеЕсли Сегменты.Количество() >= 2 Тогда
                    СыроеИмя = СокрЛП(Сегменты[1]);
                КонецЕсли;
            КонецЕсли;

        ИначеЕсли ТипЗапр = "LINES" Тогда

            Сегменты = СтрРазделить(РабочаяЧасть, ".", Ложь);
            Если Сегменты.Количество() >= 2 Тогда
                СыроеИмя = СокрЛП(Сегменты[1]);
            КонецЕсли;

            ПозМетки = СтрНайти(РабочаяЧасть, "#", НаправлениеПоиска.СКонца);
            Если ПозМетки = 0 Тогда
                ПозМетки = СтрНайти(РабочаяЧасть, ":", НаправлениеПоиска.СКонца);
            КонецЕсли;
            Если ПозМетки > 0 Тогда
                СыроеИмя = СыроеИмя + "_" + СокрЛП(Сред(РабочаяЧасть, ПозМетки + 1));
            КонецЕсли;

        Иначе

            Сегменты = СтрРазделить(РабочаяЧасть, ".", Ложь);
            Если Сегменты.Количество() >= 2 Тогда
                СыроеИмя = СокрЛП(Сегменты[1]);
            КонецЕсли;

        КонецЕсли;

        Если НЕ ПустаяСтрока(СыроеИмя) Тогда
            ИмяОбъ = ОчиститьИмяФайла(СыроеИмя);
            Если НЕ ПустаяСтрока(ИмяОбъ) И ВидетьИмя.Получить(ИмяОбъ) = Неопределено Тогда
                ВидетьИмя.Вставить(ИмяОбъ, Истина);
                ИменаВПорядке.Добавить(ИмяОбъ);
            КонецЕсли;
        КонецЕсли;

    КонецЦикла;

    // Тип(ы): SCHEMA / FETCH / FETCH-SCHEMA
    ЧастьТипов = СтрСоединить(ТипыВПорядке, "-");

    // Имена объектов: не более 3, остальные сворачиваем в "_и_ещё_N"
    ЧастьИмён = "";
    Если ИменаВПорядке.Количество() > 0 Тогда
        Предел = 3;
        КолВыводимых = ИменаВПорядке.Количество();
        Если КолВыводимых > Предел Тогда
            КолВыводимых = Предел;
        КонецЕсли;
        ВыбранныеИмена = Новый Массив;
        Для Сч = 0 По КолВыводимых - 1 Цикл
            ВыбранныеИмена.Добавить(ИменаВПорядке[Сч]);
        КонецЦикла;
        ЧастьИмён = СтрСоединить(ВыбранныеИмена, "_");
        Если ИменаВПорядке.Количество() > Предел Тогда
            ЧастьИмён = ЧастьИмён + "_и_ещё_" + (ИменаВПорядке.Количество() - Предел);
        КонецЕсли;
    КонецЕсли;

    Если ПустаяСтрока(ЧастьТипов) И ПустаяСтрока(ЧастьИмён) Тогда
        Возврат "ОтветНаЗапрос";
    КонецЕсли;

    Сегм = Новый Массив;
    Сегм.Добавить("Запрос");
    Если НЕ ПустаяСтрока(ЧастьТипов) Тогда Сегм.Добавить(ЧастьТипов); КонецЕсли;
    Если НЕ ПустаяСтрока(ЧастьИмён) Тогда Сегм.Добавить(ЧастьИмён); КонецЕсли;

    Имя = СтрСоединить(Сегм, "_");

    Если СтрДлина(Имя) > 120 Тогда
        Имя = Лев(Имя, 120);
    КонецЕсли;

    Возврат Имя;

КонецФункции

&НаКлиенте
Функция ОчиститьИмяФайла(Знач Текст)

    Текст = СокрЛП(Текст);
    // Недопустимые в имени файла Windows + пробельные
    Запрещённые = "\/:*?" + """" + "<>|" + Символы.ПС + Символы.ВК + Символы.Таб;

    Результат = "";
    Для Сч = 1 По СтрДлина(Текст) Цикл
        С = Сред(Текст, Сч, 1);
        Если С = " " ИЛИ СтрНайти(Запрещённые, С) > 0 Тогда
            Результат = Результат + "_";
        Иначе
            Результат = Результат + С;
        КонецЕсли;
    КонецЦикла;

    Возврат Результат;

КонецФункции

&НаКлиенте
Функция СохранитьРезультатВФайл(ТекстМД, ИмяПоУмолчанию = "Результат", ДобавлятьМеткуВремени = Истина)

    // Возвращает полный путь сохранённого файла или пустую строку, если отменили.
    Если ПустаяСтрока(ТекстМД) Тогда
        Сообщить("Нет данных для сохранения.");
        Возврат "";
    КонецЕсли;

    Если ДобавлятьМеткуВремени Тогда
        ИмяФайла = ИмяПоУмолчанию + "_"
            + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd_HH-mm-ss")
            + ".md";
    Иначе
        ИмяФайла = ИмяПоУмолчанию + ".md";
    КонецЕсли;

    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
    Диалог.ПолноеИмяФайла = ИмяФайла;
    Диалог.Фильтр          = "Markdown файлы (*.md)|*.md|Текстовые файлы (*.txt)|*.txt|Все файлы (*.*)|*.*";
    Диалог.МножественныйВыбор = Ложь;
    Диалог.Заголовок       = "Сохранить результат";

    Если НЕ Диалог.Выбрать() Тогда
        Возврат "";
    КонецЕсли;

    ПутьСохранения = Диалог.ПолноеИмяФайла;

    Если НЕ ЗаписатьТекстВФайл(ПутьСохранения, ТекстМД) Тогда
        Возврат "";
    КонецЕсли;

    Сообщить("Файл сохранён: " + ПутьСохранения);
    Возврат ПутьСохранения;

КонецФункции

&НаКлиенте
Процедура КаталогНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;

    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
    Диалог.Заголовок          = "Укажите корневой каталог выгруженной конфигурации";
    Диалог.МножественныйВыбор  = Ложь;

    Если НЕ ПустаяСтрока(КореньКаталога) Тогда
        ФТек = Новый Файл(КореньКаталога);
        Если ФТек.Существует() Тогда
            Диалог.Каталог = КореньКаталога;
        КонецЕсли;
    КонецЕсли;

    Если НЕ Диалог.Выбрать() Тогда
        Возврат;
    КонецЕсли;

    ВыбранныйПуть = Диалог.Каталог;

    // Мягкая проверка: похоже ли на корень выгрузки конфигурации
    КонтрольныеПапки = Новый Массив;
    КонтрольныеПапки.Добавить("CommonModules");
    КонтрольныеПапки.Добавить("Catalogs");
    КонтрольныеПапки.Добавить("Documents");

    ПохожеНаКонфигурацию = Ложь;
    Для Каждого ИмяП Из КонтрольныеПапки Цикл
        ФП = Новый Файл(ВыбранныйПуть + "\" + ИмяП);
        Если ФП.Существует() Тогда
            ПохожеНаКонфигурацию = Истина;
            Прервать;
        КонецЕсли;
    КонецЦикла;

    КореньКаталога = ВыбранныйПуть;

    Если НЕ ПохожеНаКонфигурацию Тогда
        Сообщить("⚠️ В выбранной папке не найдены типовые каталоги (CommonModules / Catalogs / Documents). Проверь, что это корень выгрузки.");
    КонецЕсли;

КонецПроцедуры

