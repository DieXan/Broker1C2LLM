Функция ПрочитатьПредопределенные(Знач ПутьПапкиОбъекта)

    Результат = Новый Массив;

    ПутьXML = ПутьПапкиОбъекта + "\Ext\Predefined.xml";
    ФX = Новый Файл(ПутьXML);
    Если НЕ ФX.Существует() Тогда
        Возврат Результат;
    КонецЕсли;

    ЧтениеXML = Новый ЧтениеXML;
    Попытка
        ЧтениеXML.ОткрытьФайл(ПутьXML);
    Исключение
        Возврат Результат;
    КонецПопытки;

    Попытка

        ТекЭлемент = Неопределено;
        ТекПоле    = "";

        Пока ЧтениеXML.Прочитать() Цикл

            Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда

                ЛокИмя = ЧтениеXML.ЛокальноеИмя;

                Если ЛокИмя = "Item" Тогда
                    ТекЭлемент = Новый Структура("Имя, Код, Наименование, Папка, Доп");
                    ТекЭлемент.Имя          = "";
                    ТекЭлемент.Код          = "";
                    ТекЭлемент.Наименование = "";
                    ТекЭлемент.Папка        = "";
                    ТекЭлемент.Доп          = "";
                    ТекПоле = "";
                ИначеЕсли ТекЭлемент <> Неопределено Тогда
                    ТекПоле = ЛокИмя;
                КонецЕсли;

            ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда

                Если ТекЭлемент <> Неопределено И НЕ ПустаяСтрока(ТекПоле) Тогда
                    Знч = СокрЛП(ЧтениеXML.Значение);
                    Если ТекПоле = "Name" Тогда
                        ТекЭлемент.Имя = Знч;
                    ИначеЕсли ТекПоле = "Code" Тогда
                        ТекЭлемент.Код = Знч;
                    ИначеЕсли ТекПоле = "Description" Тогда
                        ТекЭлемент.Наименование = Знч;
                    ИначеЕсли ТекПоле = "IsFolder" Тогда
                        ТекЭлемент.Папка = ?(НРег(Знч) = "true", "да", "");
                    ИначеЕсли ТекПоле = "AccountType" Тогда
                        ТекЭлемент.Доп = "вид счёта: " + Знч;
                    КонецЕсли;
                КонецЕсли;

            ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда

                Если ЧтениеXML.ЛокальноеИмя = "Item" И ТекЭлемент <> Неопределено Тогда
                    Если НЕ ПустаяСтрока(ТекЭлемент.Имя) Тогда
                        Результат.Добавить(ТекЭлемент);
                    КонецЕсли;
                    ТекЭлемент = Неопределено;
                КонецЕсли;
                ТекПоле = "";

            КонецЕсли;

        КонецЦикла;

    Исключение
    КонецПопытки;

    Попытка
        ЧтениеXML.Закрыть();
    Исключение
    КонецПопытки;

    Возврат Результат;

КонецФункции

