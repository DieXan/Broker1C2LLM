&НаКлиенте
Процедура ЗавершитьЗаголовокМетода(Метод, Знач ТекстЗаголовка)

    Если Метод = Неопределено Тогда
        Возврат;
    КонецЕсли;

    ПозОткр = СтрНайти(ТекстЗаголовка, "(");
    ПозЗакр = СтрНайти(ТекстЗаголовка, ")", НаправлениеПоиска.СКонца);

    Если ПозОткр > 0 И ПозЗакр > ПозОткр Тогда
        Метод.Параметры = СокрЛП(Сред(ТекстЗаголовка, ПозОткр + 1, ПозЗакр - ПозОткр - 1));
        ХвостЗаголовка  = НРег(Сред(ТекстЗаголовка, ПозЗакр + 1));
    Иначе
        ХвостЗаголовка = НРег(ТекстЗаголовка);
    КонецЕсли;

    Метод.Экспорт = (СтрНайти(ХвостЗаголовка, "экспорт") > 0) ИЛИ (СтрНайти(ХвостЗаголовка, "export") > 0);

КонецПроцедуры

// Слова, по которым комментарий считается маркером доработки
// независимо от написания: «//+Арсансофт», «// + Арсансофт», «// #Арсансофт»,
// «////++АрсанСофт» и т.п.
&НаКлиенте
Функция КлючевыеСловаМаркеров()

    Если КэшКлючевыхСловМаркеров = Неопределено Тогда
        КэшКлючевыхСловМаркеров = Новый Массив;
        КэшКлючевыхСловМаркеров.Добавить("арсансофт");
        КэшКлючевыхСловМаркеров.Добавить("arsansoft");
    КонецЕсли;
    Возврат КэшКлючевыхСловМаркеров;

КонецФункции

// 1 — открывающий маркер доработки, -1 — закрывающий, 0 — не маркер.
// Маркер — строка-комментарий, где есть ключевое слово (без учёта регистра),
// либо старый формат «//+» без ключевого слова. Закрывающий — если после
// слэшей и пробелов первым идёт «-».
&НаКлиенте
Функция ВидМаркераДоработки(Знач СтрокаКода)

    Если СтрНайти(СтрокаКода, "//") = 0 Тогда
        Возврат 0;
    КонецЕсли;

    Л = СокрЛП(СтрЗаменить(СтрокаКода, Символы.Таб, " "));
    Если НЕ СтрНачинаетсяС(Л, "//") Тогда
        Возврат 0;
    КонецЕсли;

    ЛНРег = НРег(Л);
    ЕстьКлюч = Ложь;
    Для Каждого Слово Из КлючевыеСловаМаркеров() Цикл
        Если СтрНайти(ЛНРег, Слово) > 0 Тогда
            ЕстьКлюч = Истина;
            Прервать;
        КонецЕсли;
    КонецЦикла;

    // посимвольный разбор хвоста — только для строк с ключевым словом
    Если ЕстьКлюч Тогда
        Хвост = ХвостКомментария(Л);
        Возврат ?(Лев(Хвост, 1) = "-", -1, 1);
    КонецЕсли;

    // старый формат без ключевого слова: «//+ ФИО дата номер»
    Если СтрНачинаетсяС(Л, "//+") Тогда
        Возврат 1;
    КонецЕсли;

    Возврат 0;

КонецФункции

// Текст комментария без ведущих слэшей, пробелов и табуляций.
&НаКлиенте
Функция ХвостКомментария(Знач Л)

    Поз = 1;
    Длина = СтрДлина(Л);
    Пока Поз <= Длина Цикл
        С = Сред(Л, Поз, 1);
        Если С <> "/" И С <> " " И С <> Символы.Таб Тогда
            Прервать;
        КонецЕсли;
        Поз = Поз + 1;
    КонецЦикла;

    Возврат Сред(Л, Поз);

КонецФункции

// Текст маркера для таблиц: без слэшей и знаков «+ - #» в начале.
&НаКлиенте
Функция ТекстМаркераДоработки(Знач СтрокаКода)

    Хвост = ХвостКомментария(СокрЛП(СтрЗаменить(СтрокаКода, Символы.Таб, " ")));

    Поз = 1;
    Длина = СтрДлина(Хвост);
    Пока Поз <= Длина Цикл
        С = Сред(Хвост, Поз, 1);
        Если С <> "+" И С <> "-" И С <> "#" И С <> " " И С <> "/" Тогда
            Прервать;
        КонецЕсли;
        Поз = Поз + 1;
    КонецЦикла;

    Возврат СокрЛП(Сред(Хвост, Поз));

КонецФункции

&НаКлиенте
Функция РазобратьМодульBSL(Знач Текст)

    Итог = Новый Структура("Строки,Области,Методы,Элементы,ВсегоЭкспортных,ВсегоСтрок");

    СтрокиМод = СтрРазделить(Текст, Символы.ПС, Истина);
    Всего     = СтрокиМод.Количество();

    Области  = Новый Массив;
    Методы   = Новый Массив;
    ЭлементыМодуля = Новый Массив;
    СтекОбластей = Новый Массив;

    ТекМетод       = Неопределено;
    СборЗаголовка  = Ложь;
    ТекстЗаголовка = "";
    ЭкспортныхВсего = 0;

    Для Сч = 0 По Всего - 1 Цикл

        Номер    = Сч + 1;
        Оригинал = СтрокиМод[Сч];
        БезКомм  = ОбрезатьКомментарийСтроки(Оригинал);
        Л        = СокрЛП(СтрЗаменить(СтрЗаменить(БезКомм, Символы.Таб, " "), Символы.ВК, ""));
        ЛНРег    = НРег(Л);

        // ── продолжение многострочного заголовка метода ──
        Если СборЗаголовка Тогда
            ТекстЗаголовка = ТекстЗаголовка + " " + Л;
            Если СтрНайти(Л, ")") > 0 Тогда
                СборЗаголовка = Ложь;
                ЗавершитьЗаголовокМетода(ТекМетод, ТекстЗаголовка);
                Если ТекМетод <> Неопределено И ТекМетод.Экспорт Тогда
                    ЭкспортныхВсего = ЭкспортныхВсего + 1;
                КонецЕсли;
            КонецЕсли;
            Продолжить;
        КонецЕсли;

        Если ПустаяСтрока(Л) Тогда
            Продолжить;
        КонецЕсли;

        // ── области ──
        Если СтрНачинаетсяС(ЛНРег, "#область") ИЛИ СтрНачинаетсяС(ЛНРег, "#region") Тогда

            Если СтрНачинаетсяС(ЛНРег, "#область") Тогда
                ИмяОбласти = СокрЛП(Сред(Л, 9));
            Иначе
                ИмяОбласти = СокрЛП(Сред(Л, 8));
            КонецЕсли;

            Обл = Новый Структура("Имя,Начало,Конец,Уровень", ИмяОбласти, Номер, 0, СтекОбластей.Количество());
            Области.Добавить(Обл);
            ЭлементыМодуля.Добавить(Новый Структура("Вид,Данные", "Область", Обл));
            СтекОбластей.Добавить(Обл);
            Продолжить;

        КонецЕсли;

        Если СтрНачинаетсяС(ЛНРег, "#конецобласти") ИЛИ СтрНачинаетсяС(ЛНРег, "#endregion") Тогда
            Если СтекОбластей.Количество() > 0 Тогда
                ПоследняяОбласть = СтекОбластей[СтекОбластей.Количество() - 1];
                ПоследняяОбласть.Конец = Номер;
                СтекОбластей.Удалить(СтекОбластей.Количество() - 1);
            КонецЕсли;
            Продолжить;
        КонецЕсли;

        // ── конец процедуры или функции ──
        Если ЭтоКонецМетода(ЛНРег) Тогда
            Если ТекМетод <> Неопределено Тогда
                ТекМетод.Конец = Номер;
                ТекМетод = Неопределено;
            КонецЕсли;
            Продолжить;
        КонецЕсли;

        // ── начало процедуры или функции ──
        Если НЕ ЭтоНачалоМетода(ЛНРег) Тогда
            Продолжить;
        КонецЕсли;

        // «Асинх Процедура Имя(» — объявление без префикса для разбора имени
        ДлинаАсинх  = ДлинаПрефиксаАсинх(ЛНРег);
        Объявление  = ?(ДлинаАсинх > 0, СокрЛ(Сред(Л, ДлинаАсинх + 1)), Л);
        ОбъявлНРег  = НРег(Объявление);

        Если СтрНачинаетсяС(ОбъявлНРег, "процедура ") ИЛИ СтрНачинаетсяС(ОбъявлНРег, "procedure ") Тогда
            ВидМетода = "Процедура";
        Иначе
            ВидМетода = "Функция";
        КонецЕсли;
        Если ДлинаАсинх > 0 Тогда
            ВидМетода = "Асинх " + ВидМетода;
        КонецЕсли;

        ПозПробела = СтрНайти(Объявление, " ");
        ИмяМетода  = ИдентификаторСНачала(СокрЛП(Сред(Объявление, ПозПробела + 1)));
        Если ПустаяСтрока(ИмяМетода) Тогда
            Продолжить;
        КонецЕсли;

        // шапка: директивы компиляции, аннотации расширения и комментарии над методом
        НачалоШапки = Сч;
        Директивы   = Новый Массив;
        ИндексВверх = Сч - 1;

        Пока ИндексВверх >= 0 Цикл

            ПредСтрока = СокрЛП(СтрЗаменить(СтрЗаменить(СтрокиМод[ИндексВверх], Символы.Таб, " "), Символы.ВК, ""));

            Если ПустаяСтрока(ПредСтрока) Тогда
                Прервать;
            КонецЕсли;

            Если СтрНачинаетсяС(ПредСтрока, "&") Тогда
                Директивы.Вставить(0, ПредСтрока);
                НачалоШапки = ИндексВверх;
                ИндексВверх = ИндексВверх - 1;
                Продолжить;
            КонецЕсли;

            Если СтрНачинаетсяС(ПредСтрока, "//") Тогда
                НачалоШапки = ИндексВверх;
                ИндексВверх = ИндексВверх - 1;
                Продолжить;
            КонецЕсли;

            Прервать;

        КонецЦикла;

        Если СтекОбластей.Количество() > 0 Тогда
            ОбластьМетода = СтекОбластей[СтекОбластей.Количество() - 1].Имя;
        Иначе
            ОбластьМетода = "";
        КонецЕсли;

        Метод = Новый Структура("Имя,Вид,Экспорт,Директива,Параметры,Начало,Объявление,Конец,Область,Уровень,Маркеры",
            ИмяМетода, ВидМетода, Ложь, СтрСоединить(Директивы, " "), "",
            НачалоШапки + 1, Номер, 0, ОбластьМетода, СтекОбластей.Количество(), Новый Массив);

        Методы.Добавить(Метод);
        ЭлементыМодуля.Добавить(Новый Структура("Вид,Данные", "Метод", Метод));
        ТекМетод = Метод;

        ТекстЗаголовка = Л;
        Если СтрНайти(Л, ")") > 0 Тогда
            ЗавершитьЗаголовокМетода(Метод, ТекстЗаголовка);
            Если Метод.Экспорт Тогда
                ЭкспортныхВсего = ЭкспортныхВсего + 1;
            КонецЕсли;
        Иначе
            СборЗаголовка = Истина;
        КонецЕсли;

    КонецЦикла;

    // ── незакрытые границы и маркеры доработок ──
    Для Каждого Обл Из Области Цикл
        Если Обл.Конец = 0 Тогда
            Обл.Конец = Всего;
        КонецЕсли;
    КонецЦикла;

    Для Каждого Метод Из Методы Цикл

        Если Метод.Конец = 0 Тогда
            Метод.Конец = Всего;
        КонецЕсли;

        НайденныеМаркеры = Новый Массив;
        Для НомСтр = Метод.Начало По Метод.Конец Цикл
            Если НомСтр < 1 ИЛИ НомСтр > Всего Тогда
                Продолжить;
            КонецЕсли;
            СтрокаМаркера = СтрокиМод[НомСтр - 1];
            Если ВидМаркераДоработки(СтрокаМаркера) = 1 Тогда
                НайденныеМаркеры.Добавить(Новый Структура("Строка,Текст", НомСтр, ТекстМаркераДоработки(СтрокаМаркера)));
            КонецЕсли;
        КонецЦикла;
        Метод.Маркеры = НайденныеМаркеры;

    КонецЦикла;

    Итог.Строки          = СтрокиМод;
    Итог.Области         = Области;
    Итог.Методы          = Методы;
    Итог.Элементы        = ЭлементыМодуля;
    Итог.ВсегоЭкспортных = ЭкспортныхВсего;
    Итог.ВсегоСтрок      = Всего;

    Возврат Итог;

КонецФункции

&НаКлиенте
Функция ФрагментМодуля(Знач СтрокиМод, Знач НачСтр, Знач КонСтр)

    Фрагмент = Новый Массив;

    Для НомСтр = НачСтр По КонСтр Цикл
        Если НомСтр < 1 ИЛИ НомСтр > СтрокиМод.Количество() Тогда
            Продолжить;
        КонецЕсли;
        Фрагмент.Добавить(СтрокиМод[НомСтр - 1]);
    КонецЦикла;

    Возврат СтрСоединить(Фрагмент, Символы.ПС);

КонецФункции

&НаКлиенте
Процедура ВыполнитьИзвлечениеФрагмента(Строки, Знач ВидКоманды, Знач ТелоЗапроса)

    ЧастиЗапроса = СтрРазделить(ТелоЗапроса, "|", Ложь);
    Если ЧастиЗапроса.Количество() = 0 Тогда
        Строки.Добавить("Пустой запрос " + ВидКоманды + ".");
        Возврат;
    КонецЕсли;

    Основа      = СокрЛП(ЧастиЗапроса[0]);
    ПоказатьВсе = Ложь;
    ПоказатьВызовы = Ложь;
    ЛимитВызовов   = 400;

    Строки.Добавить("---");
    Строки.Добавить("## " + ВидКоманды + ": `" + Основа + "`");
    Строки.Добавить("");

    Для Сч = 1 По ЧастиЗапроса.Количество() - 1 Цикл
        Опц = НРег(СокрЛП(ЧастиЗапроса[Сч]));
        Если Опц = "all" Тогда
            ПоказатьВсе = Истина;
        ИначеЕсли Опц = "calls" И ВидКоманды = "PROC" Тогда
            ПоказатьВызовы = Истина;
        ИначеЕсли СтрНачинаетсяС(Опц, "calls=") И ВидКоманды = "PROC" Тогда
            ПоказатьВызовы = Истина;
            ЛимитВызовов   = ЧислоИзОпции(Сред(Опц, 7), 400, Строки, "calls=");
        ИначеЕсли НЕ ПустаяСтрока(Опц) Тогда
            Строки.Добавить("Неизвестная опция: `" + СокрЛП(ЧастиЗапроса[Сч]) + "` — пропущена.");
        КонецЕсли;
    КонецЦикла;

    АдресТекст   = Основа;
    ЦельПоиска   = "";
    ЗапрошенНач  = 0;
    ЗапрошенКон  = 0;

    // ── разбор хвоста запроса ──
    Если ВидКоманды = "LINES" Тогда

        ПозРазделителя = СтрНайти(Основа, "#", НаправлениеПоиска.СКонца);
        Если ПозРазделителя = 0 Тогда
            ПозРазделителя = СтрНайти(Основа, ":", НаправлениеПоиска.СКонца);
        КонецЕсли;

        Если ПозРазделителя = 0 Тогда
            Строки.Добавить("❌ Не указан диапазон строк.");
            Строки.Добавить("Пример: `LINES:CommonModules.ОбщийМодуль.module:20180-20240`");
            Возврат;
        КонецЕсли;

        АдресТекст = СокрЛП(Лев(Основа, ПозРазделителя - 1));
        Диапазон   = СокрЛП(Сред(Основа, ПозРазделителя + 1));
        ЧастиД     = СтрРазделить(Диапазон, "-", Ложь);

        Попытка
            ЗапрошенНач = Число(СокрЛП(ЧастиД[0]));
            Если ЧастиД.Количество() > 1 Тогда
                ЗапрошенКон = Число(СокрЛП(ЧастиД[1]));
            Иначе
                ЗапрошенКон = ЗапрошенНач;
            КонецЕсли;
        Исключение
            Строки.Добавить("❌ Не разобрал диапазон: `" + Диапазон + "`");
            Строки.Добавить("Ожидается `нач-кон`, например `20180-20240`.");
            Возврат;
        КонецПопытки;

        Если ЗапрошенНач < 1 Тогда
            ЗапрошенНач = 1;
        КонецЕсли;
        Если ЗапрошенКон < ЗапрошенНач Тогда
            ЗапрошенКон = ЗапрошенНач;
        КонецЕсли;

        ЦельПоиска = ЧислоВСтроку(ЗапрошенНач) + "-" + ЧислоВСтроку(ЗапрошенКон);

    ИначеЕсли ВидКоманды = "REGION" Тогда

        ПозРазделителя = СтрНайти(Основа, "#");
        Если ПозРазделителя = 0 Тогда
            Строки.Добавить("❌ Не указано имя области.");
            Строки.Добавить("Пример: `REGION:Documents.ПоступлениеТоваровУслуг.object#ОбработчикиСобытий`");
            Возврат;
        КонецЕсли;

        АдресТекст = СокрЛП(Лев(Основа, ПозРазделителя - 1));
        ЦельПоиска = СокрЛП(Сред(Основа, ПозРазделителя + 1));

    Иначе // PROC

        ПозРазделителя = СтрНайти(Основа, "#");
        Если ПозРазделителя > 0 Тогда
            АдресТекст = СокрЛП(Лев(Основа, ПозРазделителя - 1));
            ЦельПоиска = СокрЛП(Сред(Основа, ПозРазделителя + 1));
        Иначе
            Сегм = СтрРазделить(Основа, ".", Ложь);
            Если Сегм.Количество() < 3 Тогда
                Строки.Добавить("❌ Не указано имя процедуры.");
                Строки.Добавить("Пример: `PROC:CommonModules.ОбщийМодуль.ИмяПроцедуры`");
                Строки.Добавить("или с указанием модуля: `PROC:Documents.Реализация.object#ОбработкаПроведения`");
                Возврат;
            КонецЕсли;
            ЦельПоиска  = СокрЛП(Сегм[Сегм.Количество() - 1]);
            ЧастиАдреса = Новый Массив;
            Для Сч = 0 По Сегм.Количество() - 2 Цикл
                ЧастиАдреса.Добавить(СокрЛП(Сегм[Сч]));
            КонецЦикла;
            АдресТекст = СтрСоединить(ЧастиАдреса, ".");
        КонецЕсли;

    КонецЕсли;

    Если ПустаяСтрока(ЦельПоиска) Тогда
        Строки.Добавить("❌ Пустой запрос " + ВидКоманды + ".");
        Возврат;
    КонецЕсли;

    Адрес = РазобратьАдресОбъекта(АдресТекст);
    Если НЕ ПустаяСтрока(Адрес.Ошибка) Тогда
        Строки.Добавить("❌ Неверный формат: `" + АдресТекст + "`");
        Строки.Добавить(Адрес.Ошибка);
        Возврат;
    КонецЕсли;

    ПолноеИмяОбъекта = ПолноеИмяПоАдресу(Адрес);
    БазовыйПуть      = БазовыйПутьПоАдресу(Адрес);

    // Стандартный обработчик события (ОбработкаПроведения, ПередЗаписью…)
    // часто живёт не в модуле объекта, а на подписке — тогда сразу её и показываем.
    ИскатьВПодписках = (ВидКоманды = "PROC");

    ФБаза = Новый Файл(БазовыйПуть);
    Если НЕ ФБаза.Существует() ИЛИ ФБаза.ЭтоФайл() Тогда
        Строки.Добавить("❌ Не найден объект с модулями: `" + ПолноеИмяОбъекта + "`");
        Строки.Добавить("> Папка: `" + БазовыйПуть + "`");
        Если ИскатьВПодписках Тогда
            ВывестиПодпискиДляОбработчика(Строки, Адрес.ТипОбъекта, Адрес.ИмяОбъекта, ЦельПоиска);
        КонецЕсли;
        Возврат;
    КонецЕсли;

    // ── модули-кандидаты ──
    Кандидаты = Новый Массив;

    Если НЕ ПустаяСтрока(Адрес.КлючМодуля) Тогда

        Опис = ОписаниеМодуляПоКлючу(БазовыйПуть, Адрес.КлючМодуля);
        Если ПустаяСтрока(Опис.Путь) Тогда
            Строки.Добавить("❌ Неизвестный ключ модуля: `" + Адрес.КлючМодуля + "`");
            Строки.Добавить("Доступны: `manager`, `object`, `recordset`, `module`, `form:Имя`, `command:Имя`");
            ВывестиСписокМодулейОбъекта(Строки, ПолноеИмяОбъекта, МодулиОбъекта(БазовыйПуть),
                ВидКоманды, ЦельПоиска);
            Возврат;
        КонецЕсли;

        ФМодуля = Новый Файл(Опис.Путь);
        Если НЕ ФМодуля.Существует() Тогда
            Строки.Добавить("❌ У объекта `" + ПолноеИмяОбъекта + "` нет модуля `" + Опис.Ключ + "`.");
            ВывестиСписокМодулейОбъекта(Строки, ПолноеИмяОбъекта, МодулиОбъекта(БазовыйПуть),
                ВидКоманды, ЦельПоиска);
            Если ИскатьВПодписках Тогда
                ВывестиПодпискиДляОбработчика(Строки, Адрес.ТипОбъекта, Адрес.ИмяОбъекта, ЦельПоиска);
            КонецЕсли;
            Возврат;
        КонецЕсли;

        Кандидаты.Добавить(Опис);

    Иначе
        Кандидаты = МодулиОбъекта(БазовыйПуть);
    КонецЕсли;

    Если Кандидаты.Количество() = 0 Тогда
        Строки.Добавить("ℹ У объекта `" + ПолноеИмяОбъекта + "` нет модулей с кодом.");
        Если ИскатьВПодписках Тогда
            ВывестиПодпискиДляОбработчика(Строки, Адрес.ТипОбъекта, Адрес.ИмяОбъекта, ЦельПоиска);
        КонецЕсли;
        Возврат;
    КонецЕсли;

    // LINES без указания модуля работает, только если модуль один
    Если ВидКоманды = "LINES" И Кандидаты.Количество() > 1 Тогда
        Строки.Добавить("⚠ У объекта несколько модулей — укажи, из какого брать строки:");
        ВывестиСписокМодулейОбъекта(Строки, ПолноеИмяОбъекта, Кандидаты, ВидКоманды, ЦельПоиска);
        Возврат;
    КонецЕсли;

    // ── поиск совпадений ──
    Совпадения = Новый Массив;

    Для Каждого Опис Из Кандидаты Цикл

        Разбор = РазборФайлаМодуля(Опис.Путь);
        Если Разбор = Неопределено Тогда
            Продолжить;
        КонецЕсли;

        Если ВидКоманды = "LINES" Тогда

            НачФакт = ЗапрошенНач;
            КонФакт = ЗапрошенКон;
            Если НачФакт > Разбор.ВсегоСтрок Тогда
                Строки.Добавить("❌ В модуле всего " + ЧислоВСтроку(Разбор.ВсегоСтрок)
                    + " строк, запрошено с " + ЧислоВСтроку(НачФакт) + ".");
                Возврат;
            КонецЕсли;
            Если КонФакт > Разбор.ВсегоСтрок Тогда
                КонФакт = Разбор.ВсегоСтрок;
            КонецЕсли;

            ИмяОбластиФрагмента = "";
            Для Каждого Обл Из Разбор.Области Цикл
                Если Обл.Начало <= НачФакт И Обл.Конец >= НачФакт Тогда
                    ИмяОбластиФрагмента = Обл.Имя;
                КонецЕсли;
            КонецЦикла;

            ИмяМетодаФрагмента = "";
            Для Каждого Метод Из Разбор.Методы Цикл
                Если Метод.Начало <= НачФакт И Метод.Конец >= НачФакт Тогда
                    ИмяМетодаФрагмента = Метод.Имя;
                    Прервать;
                КонецЕсли;
            КонецЦикла;

            Совпадения.Добавить(Новый Структура("Опис,Разбор,Начало,Конец,Область,Заголовок,Метод",
                Опис, Разбор, НачФакт, КонФакт, ИмяОбластиФрагмента,
                "строки " + ЧислоВСтроку(НачФакт) + "-" + ЧислоВСтроку(КонФакт), ИмяМетодаФрагмента));

        ИначеЕсли ВидКоманды = "REGION" Тогда

            Для Каждого Обл Из Разбор.Области Цикл
                Если НРег(Обл.Имя) = НРег(ЦельПоиска) Тогда
                    Совпадения.Добавить(Новый Структура("Опис,Разбор,Начало,Конец,Область,Заголовок,Метод",
                        Опис, Разбор, Обл.Начало, Обл.Конец, Обл.Имя, "#Область " + Обл.Имя, ""));
                КонецЕсли;
            КонецЦикла;

        Иначе // PROC

            Для Каждого Метод Из Разбор.Методы Цикл
                Если НРег(Метод.Имя) = НРег(ЦельПоиска) Тогда
                    Совпадения.Добавить(Новый Структура("Опис,Разбор,Начало,Конец,Область,Заголовок,Метод",
                        Опис, Разбор, Метод.Начало, Метод.Конец, Метод.Область,
                        Метод.Вид + " " + Метод.Имя, Метод.Имя));
                КонецЕсли;
            КонецЦикла;

        КонецЕсли;

    КонецЦикла;

    Если Совпадения.Количество() = 0 Тогда
        Если ВидКоманды = "REGION" Тогда
            Строки.Добавить("❌ Область `" + ЦельПоиска + "` не найдена в объекте `" + ПолноеИмяОбъекта + "`.");
        ИначеЕсли ВидКоманды = "LINES" Тогда
            Строки.Добавить("❌ Не удалось прочитать модуль объекта `" + ПолноеИмяОбъекта + "` — файл пуст или недоступен.");
        Иначе
            Строки.Добавить("❌ Процедура или функция `" + ЦельПоиска + "` не найдена в объекте `" + ПолноеИмяОбъекта + "`.");
        КонецЕсли;
        Строки.Добавить("Посмотри оглавление: `OUTLINE:" + ПолноеИмяОбъекта + "`");
        Строки.Добавить("");
        Если ИскатьВПодписках Тогда
            ВывестиПодпискиДляОбработчика(Строки, Адрес.ТипОбъекта, Адрес.ИмяОбъекта, ЦельПоиска);
        КонецЕсли;
        Возврат;
    КонецЕсли;

    // ── несколько совпадений: предлагаем выбор, а не первое попавшееся ──
    Если Совпадения.Количество() > 1 И НЕ ПоказатьВсе Тогда

        // несколько совпадений в одном модуле (ветки #Если, повторяющиеся
        // области «ТекстЗапроса»): запрос по модулю дал бы те же совпадения —
        // для них предлагаем LINES по строкам
        СовпаденийВМодуле = Новый Соответствие;
        Для Каждого Совп Из Совпадения Цикл
            КлючСовп = НРег(Совп.Опис.Ключ);
            Кол = СовпаденийВМодуле.Получить(КлючСовп);
            СовпаденийВМодуле.Вставить(КлючСовп, ?(Кол = Неопределено, 1, Кол + 1));
        КонецЦикла;

        Если СовпаденийВМодуле.Количество() = 1 Тогда
            // все в одном модуле — уточнять модуль бесполезно
            Строки.Добавить("⚠ В модуле `" + Совпадения[0].Опис.Ключ + "` одноимённых "
                + ?(ВидКоманды = "REGION", "областей", "методов") + ": "
                + ЧислоВСтроку(Совпадения.Количество())
                + " — бери нужную по строкам (`LINES:` из таблицы) или все сразу опцией `|all`.");
        Иначе
            Строки.Добавить("⚠ Найдено совпадений: " + ЧислоВСтроку(Совпадения.Количество())
                + " — уточни модуль или добавь опцию `|all`, чтобы получить все.");
        КонецЕсли;
        Строки.Добавить("");
        Строки.Добавить("| Модуль | Область | Строки | Запрос |");
        Строки.Добавить("|---|---|---|---|");

        Для Каждого Совп Из Совпадения Цикл
            Если СовпаденийВМодуле.Получить(НРег(Совп.Опис.Ключ)) > 1 Тогда
                ТекстЗапроса = "`LINES:" + ПолноеИмяОбъекта + "." + Совп.Опис.Ключ + ":"
                    + ЧислоВСтроку(Совп.Начало) + "-" + ЧислоВСтроку(Совп.Конец) + "`";
            ИначеЕсли ВидКоманды = "REGION" Тогда
                ТекстЗапроса = "`REGION:" + ПолноеИмяОбъекта + "." + Совп.Опис.Ключ + "#" + ЦельПоиска + "`";
            Иначе
                ТекстЗапроса = "`PROC:" + ПолноеИмяОбъекта + "." + Совп.Опис.Ключ + "#" + ЦельПоиска + "`";
            КонецЕсли;
            Строки.Добавить("| `" + Совп.Опис.Ключ + "` | "
                + ?(ПустаяСтрока(Совп.Область), "—", "`" + Совп.Область + "`") + " | "
                + ЧислоВСтроку(Совп.Начало) + "-" + ЧислоВСтроку(Совп.Конец) + " | "
                + ТекстЗапроса + " |");
        КонецЦикла;

        Строки.Добавить("");
        Возврат;

    КонецЕсли;

    // ── вывод фрагментов ──
    Для Каждого Совп Из Совпадения Цикл

        АдресМодуля = ПолноеИмяОбъекта + "." + Совп.Опис.Ключ;

        Строки.Добавить("### " + Совп.Заголовок);
        Строки.Добавить("");
        Строки.Добавить("> Объект: `" + ПолноеИмяОбъекта + "`"
            + " / Модуль: `" + Совп.Опис.Ключ + "` (" + Совп.Опис.Метка + ")"
            + " / Область: " + ?(ПустаяСтрока(Совп.Область), "—", "`" + Совп.Область + "`")
            + " / Строки: " + ЧислоВСтроку(Совп.Начало) + "-" + ЧислоВСтроку(Совп.Конец)
            + " из " + ЧислоВСтроку(Совп.Разбор.ВсегоСтрок));

        Если ВидКоманды = "LINES" И НЕ ПустаяСтрока(Совп.Метод) Тогда
            Строки.Добавить("> Внутри: `" + Совп.Метод + "` — целиком можно взять запросом `PROC:"
                + АдресМодуля + "#" + Совп.Метод + "`");
        КонецЕсли;

        // ── код, уже выданный выше в этом же пакете, не повторяем ──
        Покрытие = ПокрывающаяВыдача(АдресМодуля, Совп.Начало, Совп.Конец);
        Если Покрытие <> Неопределено Тогда
            Строки.Добавить("> ↑ Эти строки уже выданы выше в этом файле: " + Покрытие.Описание
                + " (строки " + ЧислоВСтроку(Покрытие.Начало) + "-" + ЧислоВСтроку(Покрытие.Конец)
                + ") — код не повторяю.");
            Строки.Добавить("");
            // сам метод уже есть, но |calls мог попросить ещё не выданные вызываемые
            Если ВидКоманды = "PROC" И ПоказатьВызовы Тогда
                ВывестиВызовыМетода(Строки, ПолноеИмяОбъекта, Совп.Опис, Совп.Разбор,
                    Совп.Начало, ПоказатьВызовы, ЛимитВызовов);
            КонецЕсли;
            Продолжить;
        КонецЕсли;

        Если ВидКоманды = "LINES" Тогда
            Отрезки = НевыданныеОтрезки(АдресМодуля, Совп.Начало, Совп.Конец);
            // диапазон закрыт несколькими выданными фрагментами вместе
            Если Отрезки.Количество() = 0 Тогда
                Строки.Добавить("> ↑ Все эти строки уже выданы выше в этом файле: "
                    + ВыдачиВДиапазоне(АдресМодуля, Совп.Начало, Совп.Конец) + " — код не повторяю.");
                Строки.Добавить("");
                Продолжить;
            КонецЕсли;
        Иначе
            Отрезки = Новый Массив;
            Отрезки.Добавить(Новый Структура("Начало, Конец", Совп.Начало, Совп.Конец));
        КонецЕсли;

        Если Отрезки.Количество() = 1
            И Отрезки[0].Начало = Совп.Начало И Отрезки[0].Конец = Совп.Конец Тогда

            Строки.Добавить("");
            Строки.Добавить("```bsl");
            Строки.Добавить(ФрагментМодуля(Совп.Разбор.Строки, Совп.Начало, Совп.Конец));
            Строки.Добавить("```");
            Строки.Добавить("");

        Иначе

            Представления = Новый Массив;
            Для Каждого Отр Из Отрезки Цикл
                Представления.Добавить(ЧислоВСтроку(Отр.Начало) + "-" + ЧислоВСтроку(Отр.Конец));
            КонецЦикла;
            Строки.Добавить("> Часть строк уже выдана выше в этом файле — вывожу только недостающие: "
                + СтрСоединить(Представления, ", "));
            Строки.Добавить("");
            Для Каждого Отр Из Отрезки Цикл
                Строки.Добавить("Строки " + ЧислоВСтроку(Отр.Начало) + "-" + ЧислоВСтроку(Отр.Конец) + ":");
                Строки.Добавить("");
                Строки.Добавить("```bsl");
                Строки.Добавить(ФрагментМодуля(Совп.Разбор.Строки, Отр.Начало, Отр.Конец));
                Строки.Добавить("```");
                Строки.Добавить("");
            КонецЦикла;

        КонецЕсли;

        Если ВидКоманды = "PROC" Тогда
            ОписаниеВыдачи = "PROC `" + Совп.Метод + "`";
        ИначеЕсли ВидКоманды = "REGION" Тогда
            ОписаниеВыдачи = "REGION `" + Совп.Область + "`";
        Иначе
            ОписаниеВыдачи = "LINES";
        КонецЕсли;
        ЗарегистрироватьВыдачу(АдресМодуля, Совп.Начало, Совп.Конец, ОписаниеВыдачи);

        // ── какие методы вызывает процедура ──
        Если ВидКоманды = "PROC" Тогда
            ВывестиВызовыМетода(Строки, ПолноеИмяОбъекта, Совп.Опис, Совп.Разбор,
                Совп.Начало, ПоказатьВызовы, ЛимитВызовов);
            ВывестиПодпискиНаТоЖеСобытие(Строки, Адрес.ТипОбъекта, Адрес.ИмяОбъекта,
                Совп.Опис.Ключ, Совп.Метод);
        КонецЕсли;

    КонецЦикла;

КонецПроцедуры

// ══════════════════════════════════════════════════════════════
// Выданное в текущем пакете: чтобы LINES / PROC не повторяли код
// ══════════════════════════════════════════════════════════════

&НаКлиенте
Процедура ЗарегистрироватьВыдачу(Знач АдресМодуля, Знач Начало, Знач Конец, Знач Описание)

    Если ВыданныеФрагменты = Неопределено Тогда
        ВыданныеФрагменты = Новый Соответствие;
    КонецЕсли;

    Ключ   = НРег(АдресМодуля);
    Список = ВыданныеФрагменты.Получить(Ключ);
    Если Список = Неопределено Тогда
        Список = Новый Массив;
        ВыданныеФрагменты.Вставить(Ключ, Список);
    КонецЕсли;

    Список.Добавить(Новый Структура("Начало, Конец, Описание", Начало, Конец, Описание));

КонецПроцедуры

// Выданный ранее фрагмент, целиком покрывающий диапазон, или Неопределено.
&НаКлиенте
Функция ПокрывающаяВыдача(Знач АдресМодуля, Знач Начало, Знач Конец)

    Если ВыданныеФрагменты = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    Список = ВыданныеФрагменты.Получить(НРег(АдресМодуля));
    Если Список = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    Для Каждого В Из Список Цикл
        Если В.Начало <= Начало И В.Конец >= Конец Тогда
            Возврат В;
        КонецЕсли;
    КонецЦикла;

    Возврат Неопределено;

КонецФункции

// Выданные фрагменты, пересекающие диапазон, — строкой для сообщения:
// «PROC `X` (строки 10-20), LINES (строки 21-30)».
&НаКлиенте
Функция ВыдачиВДиапазоне(Знач АдресМодуля, Знач Начало, Знач Конец)

    Части = Новый Массив;
    Если ВыданныеФрагменты <> Неопределено Тогда
        Список = ВыданныеФрагменты.Получить(НРег(АдресМодуля));
        Если Список <> Неопределено Тогда
            Для Каждого В Из Список Цикл
                Если В.Начало <= Конец И В.Конец >= Начало Тогда
                    Части.Добавить(В.Описание + " (строки " + ЧислоВСтроку(В.Начало)
                        + "-" + ЧислоВСтроку(В.Конец) + ")");
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
    КонецЕсли;

    Возврат СтрСоединить(Части, ", ");

КонецФункции

// Части диапазона, которые ещё не выдавались, — массив структур Начало, Конец.
&НаКлиенте
Функция НевыданныеОтрезки(Знач АдресМодуля, Знач Начало, Знач Конец)

    Отрезки = Новый Массив;

    Список = Неопределено;
    Если ВыданныеФрагменты <> Неопределено Тогда
        Список = ВыданныеФрагменты.Получить(НРег(АдресМодуля));
    КонецЕсли;
    Если Список = Неопределено Тогда
        Отрезки.Добавить(Новый Структура("Начало, Конец", Начало, Конец));
        Возврат Отрезки;
    КонецЕсли;

    НачалоОтрезка = 0;
    Для НомСтр = Начало По Конец Цикл

        Выдана = Ложь;
        Для Каждого В Из Список Цикл
            Если В.Начало <= НомСтр И В.Конец >= НомСтр Тогда
                Выдана = Истина;
                Прервать;
            КонецЕсли;
        КонецЦикла;

        Если НЕ Выдана И НачалоОтрезка = 0 Тогда
            НачалоОтрезка = НомСтр;
        ИначеЕсли Выдана И НачалоОтрезка > 0 Тогда
            Отрезки.Добавить(Новый Структура("Начало, Конец", НачалоОтрезка, НомСтр - 1));
            НачалоОтрезка = 0;
        КонецЕсли;

    КонецЦикла;

    Если НачалоОтрезка > 0 Тогда
        Отрезки.Добавить(Новый Структура("Начало, Конец", НачалоОтрезка, Конец));
    КонецЕсли;

    Возврат Отрезки;

КонецФункции

// ══════════════════════════════════════════════════════════════
// PROC: какие методы вызывает процедура
// ══════════════════════════════════════════════════════════════

&НаКлиенте
Функция ИменаОбщихМодулейПакета()

    Если КэшИменОбщихМодулей = Неопределено Тогда
        КэшИменОбщихМодулей = ИменаОбщихМодулей();
    КонецЕсли;

    Возврат КэшИменОбщихМодулей;

КонецФункции

// Под фрагментом PROC — строка «Вызывает…» с методами этого модуля и
// общих модулей. С опцией |calls — ещё и тела вызываемых методов этого
// модуля (глубина 1, не больше ПределСтрок строк; крупные — первыми:
// основная логика обычно в них, а мелкие обёртки вроде Ответ/Ошибка
// не должны съедать лимит).
&НаКлиенте
Процедура ВывестиВызовыМетода(Строки, Знач ПолноеИмяОбъекта, Знач Опис, Знач Разбор,
    Знач НачалоМетода, Знач ПоказатьТела, Знач ПределСтрок = 400)

    АдресМодуля = ПолноеИмяОбъекта + "." + Опис.Ключ;

    Метод = Неопределено;
    ИндексМетодов = Новый Соответствие;
    Для Каждого М Из Разбор.Методы Цикл
        Если ИндексМетодов.Получить(НРег(М.Имя)) = Неопределено Тогда
            ИндексМетодов.Вставить(НРег(М.Имя), М);
        КонецЕсли;
        Если М.Начало = НачалоМетода Тогда
            Метод = М;
        КонецЕсли;
    КонецЦикла;

    Если Метод = Неопределено Тогда
        Возврат;
    КонецЕсли;

    ИменаОМ = ИменаОбщихМодулейПакета();

    Локальные  = Новый Массив;
    ВидетьЛок  = Новый Соответствие;
    Внешние    = Новый Массив;
    ВидетьВнеш = Новый Соответствие;

    Для НомСтр = Метод.Объявление + 1 По Метод.Конец Цикл

        Если НомСтр > Разбор.Строки.Количество() Тогда
            Прервать;
        КонецЕсли;

        Л = ОбрезатьКомментарийСтроки(Разбор.Строки[НомСтр - 1]);
        Если СтрНайти(Л, "(") = 0 Тогда
            Продолжить;
        КонецЕсли;

        Длина = СтрДлина(Л);
        Поз   = 1;

        Пока Поз <= Длина Цикл

            ПозСкобки = СтрНайти(Л, "(", НаправлениеПоиска.СНачала, Поз);
            Если ПозСкобки = 0 Тогда
                Прервать;
            КонецЕсли;
            Поз = ПозСкобки + 1;

            ДоСкобки = СокрП(Лев(Л, ПозСкобки - 1));
            Имя = ИдентификаторСКонца(ДоСкобки);
            Если ПустаяСтрока(Имя) Тогда
                Продолжить;
            КонецЕсли;

            ПередИменем = Лев(ДоСкобки, СтрДлина(ДоСкобки) - СтрДлина(Имя));

            Если Прав(ПередИменем, 1) = "." Тогда

                // Модуль.Метод( — интересны только общие модули
                БезТочки    = Лев(ПередИменем, СтрДлина(ПередИменем) - 1);
                Квалификатор = ИдентификаторСКонца(БезТочки);
                ПередКвал    = Лев(БезТочки, СтрДлина(БезТочки) - СтрДлина(Квалификатор));
                ИмяОМ = ИменаОМ.Получить(НРег(Квалификатор));
                Если ИмяОМ <> Неопределено И Прав(ПередКвал, 1) <> "." Тогда
                    КлючВнеш = НРег(ИмяОМ + "." + Имя);
                    Если ВидетьВнеш.Получить(КлючВнеш) = Неопределено Тогда
                        ВидетьВнеш.Вставить(КлючВнеш, Истина);
                        Внешние.Добавить(ИмяОМ + "." + Имя);
                    КонецЕсли;
                КонецЕсли;

            Иначе

                Вызываемый = ИндексМетодов.Получить(НРег(Имя));
                Если Вызываемый <> Неопределено И Вызываемый.Начало <> Метод.Начало
                    И ВидетьЛок.Получить(НРег(Имя)) = Неопределено Тогда
                    ВидетьЛок.Вставить(НРег(Имя), Истина);
                    Локальные.Добавить(Вызываемый);
                КонецЕсли;

            КонецЕсли;

        КонецЦикла;

    КонецЦикла;

    Если Локальные.Количество() = 0 И Внешние.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    Если Локальные.Количество() > 0 Тогда
        Части = Новый Массив;
        Для Каждого М Из Локальные Цикл
            Части.Добавить("`" + М.Имя + "` (" + ЧислоВСтроку(М.Конец - М.Начало + 1) + " стр.)");
        КонецЦикла;
        Строки.Добавить("> Вызывает в этом модуле: " + СтрСоединить(Части, ", ")
            + " — `PROC:" + АдресМодуля + "#Имя`"
            + ?(ПоказатьТела, "", "; все сразу — опция `|calls`"));
    КонецЕсли;

    Если Внешние.Количество() > 0 Тогда
        Части = Новый Массив;
        Для Каждого В Из Внешние Цикл
            Части.Добавить("`" + В + "`");
        КонецЦикла;
        Строки.Добавить("> Вызывает общие модули: " + СтрСоединить(Части, ", ")
            + " — `PROC:CommonModules.Модуль.Метод`");
    КонецЕсли;

    Строки.Добавить("");

    Если НЕ ПоказатьТела ИЛИ Локальные.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    Строки.Добавить("#### Вызываемые методы этого модуля (глубина 1, крупные первыми)");
    Строки.Добавить("");

    // сортировка по убыванию длины — вставками, на клиенте ТаблицыЗначений нет
    ПоРазмеру = Новый Массив;
    Для Каждого М Из Локальные Цикл
        ДлинаМ = М.Конец - М.Начало;
        Позиция = ПоРазмеру.Количество();
        Для Инд = 0 По ПоРазмеру.Количество() - 1 Цикл
            Если ПоРазмеру[Инд].Конец - ПоРазмеру[Инд].Начало < ДлинаМ Тогда
                Позиция = Инд;
                Прервать;
            КонецЕсли;
        КонецЦикла;
        ПоРазмеру.Вставить(Позиция, М);
    КонецЦикла;

    Выведено    = 0;
    Пропущенные = Новый Массив;

    Для Каждого М Из ПоРазмеру Цикл

        ДлинаМетода = М.Конец - М.Начало + 1;

        Покрытие = ПокрывающаяВыдача(АдресМодуля, М.Начало, М.Конец);
        Если Покрытие <> Неопределено Тогда
            Строки.Добавить("##### " + М.Вид + " " + М.Имя);
            Строки.Добавить("> ↑ Уже выдано выше в этом файле: " + Покрытие.Описание + ".");
            Строки.Добавить("");
            Продолжить;
        КонецЕсли;

        Если Выведено > 0 И Выведено + ДлинаМетода > ПределСтрок Тогда
            Пропущенные.Добавить("`" + М.Имя + "`");
            Продолжить;
        КонецЕсли;

        Строки.Добавить("##### " + М.Вид + " " + М.Имя);
        Строки.Добавить("> Строки: " + ЧислоВСтроку(М.Начало) + "-" + ЧислоВСтроку(М.Конец)
            + ?(ПустаяСтрока(М.Область), "", " / Область: `" + М.Область + "`"));
        Строки.Добавить("");
        Строки.Добавить("```bsl");
        Строки.Добавить(ФрагментМодуля(Разбор.Строки, М.Начало, М.Конец));
        Строки.Добавить("```");
        Строки.Добавить("");

        ЗарегистрироватьВыдачу(АдресМодуля, М.Начало, М.Конец, "PROC `" + М.Имя + "` (|calls)");
        Выведено = Выведено + ДлинаМетода;

    КонецЦикла;

    Если Пропущенные.Количество() > 0 Тогда
        Строки.Добавить("> Не вошли в лимит " + ЧислоВСтроку(ПределСтрок) + " строк: "
            + СтрСоединить(Пропущенные, ", ") + " — бери `PROC:" + АдресМодуля + "#Имя` по одному"
            + " или подними лимит опцией `|calls=N`.");
        Строки.Добавить("");
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВывестиСписокМодулейОбъекта(Строки, Знач ПолноеИмяОбъекта, Знач Кандидаты,
    Знач ВидКоманды, Знач ЦельПоиска)

    Если Кандидаты.Количество() = 0 Тогда
        Строки.Добавить("ℹ У объекта `" + ПолноеИмяОбъекта + "` нет модулей с кодом.");
        Возврат;
    КонецЕсли;

    Строки.Добавить("");
    Строки.Добавить("Модули объекта `" + ПолноеИмяОбъекта + "`:");
    Строки.Добавить("");
    Строки.Добавить("| Модуль | Файл | Запрос |");
    Строки.Добавить("|---|---|---|");

    Для Каждого Опис Из Кандидаты Цикл
        Если ВидКоманды = "LINES" Тогда
            ТекстЗапроса = "`LINES:" + ПолноеИмяОбъекта + "." + Опис.Ключ + ":" + ЦельПоиска + "`";
        ИначеЕсли ВидКоманды = "OUTLINE" Тогда
            ТекстЗапроса = "`OUTLINE:" + ПолноеИмяОбъекта + "." + Опис.Ключ + "`";
        Иначе
            ТекстЗапроса = "`" + ВидКоманды + ":" + ПолноеИмяОбъекта + "." + Опис.Ключ + "#" + ЦельПоиска + "`";
        КонецЕсли;
        Строки.Добавить("| `" + Опис.Ключ + "` | " + Опис.Метка + " | " + ТекстЗапроса + " |");
    КонецЦикла;

    Строки.Добавить("");

КонецПроцедуры

&НаКлиенте
Функция МетодПодходитПодОтбор(Знач Метод, Знач Опции)

    Если Опции.ТолькоЭкспортные И НЕ Метод.Экспорт Тогда
        Возврат Ложь;
    КонецЕсли;

    Если Опции.ТолькоСМаркерами И Метод.Маркеры.Количество() = 0 Тогда
        Возврат Ложь;
    КонецЕсли;

    Если Опции.ТолькоВнеОбластей И Метод.Уровень > 0 Тогда
        Возврат Ложь;
    КонецЕсли;

    Если НЕ ПустаяСтрока(Опции.Подстрока)
        И ПустаяСтрока(ГдеСовпалМетод(Метод, Опции.Подстрока)) Тогда
        Возврат Ложь;
    КонецЕсли;

    Возврат Истина;

КонецФункции

// Для |find=: где подстрока нашлась — «имя», «параметры», «маркер» или "".
// Поиск по маркерам позволяет найти доработки по номеру задачи.
&НаКлиенте
Функция ГдеСовпалМетод(Знач Метод, Знач Подстрока)

    ПодстрокаНРег = НРег(Подстрока);

    Если СтрНайти(НРег(Метод.Имя), ПодстрокаНРег) > 0 Тогда
        Возврат "имя";
    КонецЕсли;
    Если СтрНайти(НРег(Метод.Параметры), ПодстрокаНРег) > 0 Тогда
        Возврат "параметры";
    КонецЕсли;
    Для Каждого Маркер Из Метод.Маркеры Цикл
        Если СтрНайти(НРег(Маркер.Текст), ПодстрокаНРег) > 0 Тогда
            Возврат "маркер";
        КонецЕсли;
    КонецЦикла;

    Возврат "";

КонецФункции

&НаКлиенте
Процедура ВывестиСводкуПоОбластямМодуля(Строки, Знач АдресМодуля, Знач Разбор)

    Строки.Добавить("| Строки | Область | Процедур | Экспортных | Маркеров | Запрос |");
    Строки.Добавить("|---|---|---|---|---|---|");

    ВнеОбластей    = 0;
    ЭкспортныхВне  = 0;
    МаркеровВне    = 0;
    ПустыхОбластей = 0;

    Для Каждого Метод Из Разбор.Методы Цикл
        Метод.Вставить("СчиталсяВСводке", Ложь);
    КонецЦикла;

    Для Каждого Обл Из Разбор.Области Цикл

        Если Обл.Уровень <> 0 Тогда
            Продолжить;
        КонецЕсли;

        КолМетодов    = 0;
        КолЭкспортных = 0;
        КолМаркеров   = 0;

        Для Каждого Метод Из Разбор.Методы Цикл
            Если Метод.Начало >= Обл.Начало И Метод.Начало <= Обл.Конец Тогда
                Метод.СчиталсяВСводке = Истина;
                КолМетодов = КолМетодов + 1;
                Если Метод.Экспорт Тогда
                    КолЭкспортных = КолЭкспортных + 1;
                КонецЕсли;
                КолМаркеров = КолМаркеров + Метод.Маркеры.Количество();
            КонецЕсли;
        КонецЦикла;

        // Области без методов и маркеров — обычно #Область внутри процедуры
        // (десятки «ТекстЗапроса»): для навигации бесполезны, только считаем.
        Если КолМетодов = 0 И КолМаркеров = 0 Тогда
            ПустыхОбластей = ПустыхОбластей + 1;
            Продолжить;
        КонецЕсли;

        Строки.Добавить("| " + ЧислоВСтроку(Обл.Начало) + "-" + ЧислоВСтроку(Обл.Конец)
            + " | **" + ЭкранироватьДляТаблицы(Обл.Имя) + "**"
            + " | " + ЧислоВСтроку(КолМетодов)
            + " | " + ЧислоВСтроку(КолЭкспортных)
            + " | " + ЧислоВСтроку(КолМаркеров)
            + " | `OUTLINE:" + АдресМодуля + "#" + Обл.Имя + "` |");

    КонецЦикла;

    Для Каждого Метод Из Разбор.Методы Цикл
        Если НЕ Метод.СчиталсяВСводке Тогда
            ВнеОбластей = ВнеОбластей + 1;
            Если Метод.Экспорт Тогда
                ЭкспортныхВне = ЭкспортныхВне + 1;
            КонецЕсли;
            МаркеровВне = МаркеровВне + Метод.Маркеры.Количество();
        КонецЕсли;
    КонецЦикла;

    Если ВнеОбластей > 0 Тогда
        Строки.Добавить("| — | *вне областей* | " + ЧислоВСтроку(ВнеОбластей)
            + " | " + ЧислоВСтроку(ЭкспортныхВне)
            + " | " + ЧислоВСтроку(МаркеровВне)
            + " | `OUTLINE:" + АдресМодуля + "|noregion` |");
    КонецЕсли;

    Если ПустыхОбластей > 0 Тогда
        Строки.Добавить("| — | *ещё " + ЧислоВСтроку(ПустыхОбластей)
            + " областей без процедур и маркеров* | 0 | 0 | 0 | — |");
    КонецЕсли;

    Строки.Добавить("");

КонецПроцедуры

&НаКлиенте
Процедура ВывестиОглавлениеОдногоМодуля(Строки, Знач ПолноеИмяОбъекта, Знач Опис, Знач Разбор, Знач Опции)

    ПределСтрок   = 250;
    ПределМаркеров = 300;
    АвтоПоказМаркеров = 60;

    АдресМодуля = ПолноеИмяОбъекта + "." + Опис.Ключ;

    Строки.Добавить("### " + Опис.Метка + " — `" + АдресМодуля + "`");
    Строки.Добавить("");
    Строки.Добавить("> Строк: " + ЧислоВСтроку(Разбор.ВсегоСтрок)
        + " / областей: " + ЧислоВСтроку(Разбор.Области.Количество())
        + " / процедур и функций: " + ЧислоВСтроку(Разбор.Методы.Количество())
        + " (экспортных: " + ЧислоВСтроку(Разбор.ВсегоЭкспортных) + ")");
    Строки.Добавить("");

    // ── границы отбора по области ──
    ГраницаНач = 0;
    ГраницаКон = 0;

    Если НЕ ПустаяСтрока(Опции.ОбластьОтбора) Тогда

        НайденаОбласть = Ложь;
        Для Каждого Обл Из Разбор.Области Цикл
            Если НРег(Обл.Имя) = НРег(Опции.ОбластьОтбора) Тогда
                ГраницаНач     = Обл.Начало;
                ГраницаКон     = Обл.Конец;
                НайденаОбласть = Истина;
                Прервать;
            КонецЕсли;
        КонецЦикла;

        Если НЕ НайденаОбласть Тогда
            Строки.Добавить("❌ Область `" + Опции.ОбластьОтбора + "` в этом модуле не найдена.");
            Строки.Добавить("Сводка по областям модуля:");
            Строки.Добавить("");
            ВывестиСводкуПоОбластямМодуля(Строки, АдресМодуля, Разбор);
            Возврат;
        КонецЕсли;

        Строки.Добавить("> Отбор по области `" + Опции.ОбластьОтбора + "`: строки "
            + ЧислоВСтроку(ГраницаНач) + "-" + ЧислоВСтроку(ГраницаКон));
        Строки.Добавить("");

    КонецЕсли;

    ЕстьОтборПоМетодам = Опции.ТолькоЭкспортные ИЛИ Опции.ТолькоСМаркерами
        ИЛИ Опции.ТолькоВнеОбластей ИЛИ НЕ ПустаяСтрока(Опции.Подстрока);
    ЕстьЛюбойОтбор = ЕстьОтборПоМетодам ИЛИ (ГраницаНач > 0);

    // ── отбор элементов ──
    Отобранные      = Новый Массив;
    ОтобранныеМетоды = Новый Массив;

    Для Каждого Эл Из Разбор.Элементы Цикл

        Данные = Эл.Данные;

        Если ГраницаНач > 0 И (Данные.Начало < ГраницаНач ИЛИ Данные.Начало > ГраницаКон) Тогда
            Продолжить;
        КонецЕсли;

        Если Эл.Вид = "Область" Тогда
            Если ЕстьОтборПоМетодам Тогда
                Продолжить;
            КонецЕсли;
        Иначе
            Если НЕ МетодПодходитПодОтбор(Данные, Опции) Тогда
                Продолжить;
            КонецЕсли;
            ОтобранныеМетоды.Добавить(Данные);
        КонецЕсли;

        Отобранные.Добавить(Эл);

    КонецЦикла;

    // ── слишком большой модуль: сначала сводка по областям ──
    Если Отобранные.Количество() > ПределСтрок И НЕ ЕстьЛюбойОтбор И НЕ Опции.БезОграничений Тогда

        Строки.Добавить("⚠ В модуле " + ЧислоВСтроку(Разбор.Методы.Количество())
            + " процедур и функций — полная таблица заняла бы "
            + ЧислоВСтроку(Отобранные.Количество()) + " строк. Ниже сводка по областям.");
        Строки.Добавить("");
        Строки.Добавить("Как сузить: `#ИмяОбласти` в адресе (запрос из последней колонки),"
            + " `|find=подстрока` по имени, параметрам или тексту маркера (номер задачи), `|export` — только экспортные,"
            + " `|marks` — только доработанные. Полная таблица — `|all`.");
        Строки.Добавить("");
        ВывестиСводкуПоОбластямМодуля(Строки, АдресМодуля, Разбор);
        Возврат;

    КонецЕсли;

    АдресДляУточнения = АдресМодуля + Опции.ХвостЗапроса;

    // ── основная таблица (в режиме |marks интересны сами маркеры, а не список методов) ──
    Если НЕ Опции.ТолькоСМаркерами Тогда

        ВсегоСтраниц         = 1;
        НомерСтраницы        = 1;
        ПерваяСтрокаСтраницы = 0;

        Если НЕ Опции.БезОграничений И Отобранные.Количество() > ПределСтрок Тогда

            ВсегоСтраниц = Цел((Отобранные.Количество() - 1) / ПределСтрок) + 1;

            Если Опции.Страница > 0 Тогда
                НомерСтраницы = Цел(Опции.Страница);
            КонецЕсли;
            Если НомерСтраницы < 1 Тогда
                НомерСтраницы = 1;
            КонецЕсли;
            Если НомерСтраницы > ВсегоСтраниц Тогда
                НомерСтраницы = ВсегоСтраниц;
            КонецЕсли;

            ПерваяСтрокаСтраницы = (НомерСтраницы - 1) * ПределСтрок;

        КонецЕсли;

        Если ЕстьЛюбойОтбор Тогда
            Строки.Добавить("> Отобрано процедур и функций: " + ЧислоВСтроку(ОтобранныеМетоды.Количество())
                + " из " + ЧислоВСтроку(Разбор.Методы.Количество()));
            Строки.Добавить("");
        КонецЕсли;

        Строки.Добавить("| Строки | Элемент | Вид | Директива | Параметры | Марк. | Запрос |");
        Строки.Добавить("|---|---|---|---|---|---|---|");

        Выведено  = 0;
        Пропущено = 0;
        Индекс    = -1;

        Для Каждого Эл Из Отобранные Цикл

            Индекс = Индекс + 1;

            Если НЕ Опции.БезОграничений
                И (Индекс < ПерваяСтрокаСтраницы ИЛИ Выведено >= ПределСтрок) Тогда
                Пропущено = Пропущено + 1;
                Продолжить;
            КонецЕсли;

            Если Эл.Вид = "Область" Тогда

                Обл = Эл.Данные;
                Строки.Добавить("| " + ЧислоВСтроку(Обл.Начало) + "-" + ЧислоВСтроку(Обл.Конец)
                    + " | " + ОтступУровня(Обл.Уровень) + "**#Область " + ЭкранироватьДляТаблицы(Обл.Имя) + "**"
                    + " | Область |  |  |  | `LINES:" + АдресМодуля + ":"
                    + ЧислоВСтроку(Обл.Начало) + "-" + ЧислоВСтроку(Обл.Конец) + "` |");

            Иначе

                Метод = Эл.Данные;

                ВидТекст = Метод.Вид;
                Если Метод.Экспорт Тогда
                    ВидТекст = ВидТекст + " ✓экспорт";
                КонецЕсли;
                Если НЕ ПустаяСтрока(Опции.Подстрока) Тогда
                    ГдеСовпало = ГдеСовпалМетод(Метод, Опции.Подстрока);
                    Если ГдеСовпало <> "имя" Тогда
                        ВидТекст = ВидТекст + " (find: " + ГдеСовпало + ")";
                    КонецЕсли;
                КонецЕсли;

                Если Метод.Маркеры.Количество() > 0 Тогда
                    МаркерТекст = ЧислоВСтроку(Метод.Маркеры.Количество());
                Иначе
                    МаркерТекст = "";
                КонецЕсли;

                Строки.Добавить("| " + ЧислоВСтроку(Метод.Начало) + "-" + ЧислоВСтроку(Метод.Конец)
                    + " | " + ОтступУровня(Метод.Уровень) + "`" + Метод.Имя + "`"
                    + " | " + ВидТекст
                    + " | " + ЭкранироватьДляТаблицы(Метод.Директива, 40)
                    + " | " + ЭкранироватьДляТаблицы(Метод.Параметры, 70)
                    + " | " + МаркерТекст
                    + " | `PROC:" + АдресМодуля + "#" + Метод.Имя + "` |");

            КонецЕсли;

            Выведено = Выведено + 1;

        КонецЦикла;

        Если Выведено = 0 Тогда
            Строки.Добавить("| — | ничего не подошло под отбор | | | | | |");
        КонецЕсли;

        Строки.Добавить("");

        Если Пропущено > 0 Тогда

            Строки.Добавить("⚠ Страница " + ЧислоВСтроку(НомерСтраницы) + " из "
                + ЧислоВСтроку(ВсегоСтраниц) + ": строки таблицы "
                + ЧислоВСтроку(ПерваяСтрокаСтраницы + 1) + "-" + ЧислоВСтроку(ПерваяСтрокаСтраницы + Выведено)
                + " из " + ЧислоВСтроку(Отобранные.Количество()) + ".");

            Если НомерСтраницы < ВсегоСтраниц Тогда
                Строки.Добавить("Дальше: `OUTLINE:" + АдресДляУточнения
                    + "|page=" + ЧислоВСтроку(НомерСтраницы + 1) + "`");
            КонецЕсли;

            Строки.Добавить("Либо сузь отбор (`#ИмяОбласти`, `|find=`, `|export`),"
                + " либо сними ограничение опцией `|all`.");
            Строки.Добавить("");

        КонецЕсли;

    КонецЕсли;

    // ── маркеры доработок ──
    Если ЕстьЛюбойОтбор Тогда
        МетодыДляМаркеров = ОтобранныеМетоды;
    Иначе
        МетодыДляМаркеров = Разбор.Методы;
    КонецЕсли;

    ВсеМаркеры = Новый Массив;
    Для Каждого Метод Из МетодыДляМаркеров Цикл
        // метод отобран по тексту маркера (|find=номер задачи) — показываем
        // только совпавшие маркеры, а не всю историю доработок метода
        ТолькоСовпавшие = НЕ ПустаяСтрока(Опции.Подстрока)
            И ГдеСовпалМетод(Метод, Опции.Подстрока) = "маркер";
        Для Каждого Маркер Из Метод.Маркеры Цикл
            Если ТолькоСовпавшие
                И СтрНайти(НРег(Маркер.Текст), НРег(Опции.Подстрока)) = 0 Тогда
                Продолжить;
            КонецЕсли;
            ВсеМаркеры.Добавить(Новый Структура("Строка,Текст,Метод",
                Маркер.Строка, Маркер.Текст, Метод.Имя));
        КонецЦикла;
    КонецЦикла;

    Если ВсеМаркеры.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    // длинный список печатаем только по запросу |marks
    Если НЕ Опции.ТолькоСМаркерами И НЕ Опции.БезОграничений
        И ВсеМаркеры.Количество() > АвтоПоказМаркеров Тогда
        Строки.Добавить("> Маркеров доработок: " + ЧислоВСтроку(ВсеМаркеры.Количество())
            + " — список с привязкой к процедурам: `OUTLINE:" + АдресДляУточнения + "|marks`");
        Строки.Добавить("");
        Возврат;
    КонецЕсли;

    Если Опции.ТолькоСМаркерами Тогда
        Строки.Добавить("> Процедур и функций с маркерами: " + ЧислоВСтроку(ОтобранныеМетоды.Количество())
            + " из " + ЧислоВСтроку(Разбор.Методы.Количество()));
        Строки.Добавить("");
    КонецЕсли;

    СтраницМаркеров   = 1;
    СтраницаМаркеров  = 1;
    ПервыйМаркер      = 0;

    Если НЕ Опции.БезОграничений И ВсеМаркеры.Количество() > ПределМаркеров Тогда

        СтраницМаркеров = Цел((ВсеМаркеры.Количество() - 1) / ПределМаркеров) + 1;

        Если Опции.Страница > 0 Тогда
            СтраницаМаркеров = Цел(Опции.Страница);
        КонецЕсли;
        Если СтраницаМаркеров < 1 Тогда
            СтраницаМаркеров = 1;
        КонецЕсли;
        Если СтраницаМаркеров > СтраницМаркеров Тогда
            СтраницаМаркеров = СтраницМаркеров;
        КонецЕсли;

        ПервыйМаркер = (СтраницаМаркеров - 1) * ПределМаркеров;

    КонецЕсли;

    Строки.Добавить("#### Маркеры доработок (" + ЧислоВСтроку(ВсеМаркеры.Количество()) + ")");
    Строки.Добавить("");
    Строки.Добавить("| Строка | Процедура | Маркер |");
    Строки.Добавить("|---|---|---|");

    ВыведеноМаркеров = 0;
    ИндексМаркера    = -1;

    Для Каждого Маркер Из ВсеМаркеры Цикл

        ИндексМаркера = ИндексМаркера + 1;

        Если НЕ Опции.БезОграничений
            И (ИндексМаркера < ПервыйМаркер ИЛИ ВыведеноМаркеров >= ПределМаркеров) Тогда
            Продолжить;
        КонецЕсли;

        Строки.Добавить("| " + ЧислоВСтроку(Маркер.Строка)
            + " | `" + Маркер.Метод + "`"
            + " | " + ЭкранироватьДляТаблицы(Маркер.Текст, 90) + " |");

        ВыведеноМаркеров = ВыведеноМаркеров + 1;

    КонецЦикла;

    Строки.Добавить("");

    Если СтраницМаркеров > 1 Тогда

        Строки.Добавить("⚠ Страница " + ЧислоВСтроку(СтраницаМаркеров) + " из "
            + ЧислоВСтроку(СтраницМаркеров) + ": маркеры "
            + ЧислоВСтроку(ПервыйМаркер + 1) + "-" + ЧислоВСтроку(ПервыйМаркер + ВыведеноМаркеров)
            + " из " + ЧислоВСтроку(ВсеМаркеры.Количество()) + ".");

        Если СтраницаМаркеров < СтраницМаркеров Тогда
            Строки.Добавить("Дальше: `OUTLINE:" + АдресДляУточнения
                + "|page=" + ЧислоВСтроку(СтраницаМаркеров + 1) + "`");
        КонецЕсли;

        Строки.Добавить("Либо сузь отбор по области (`#ИмяОбласти`) или по имени (`|find=`).");
        Строки.Добавить("");

    КонецЕсли;

КонецПроцедуры

