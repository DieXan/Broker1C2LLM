&НаКлиенте
Функция ОписаниеМодуляПоКлючу(Знач БазовыйПуть, Знач Ключ)

    Рез = Новый Структура("Ключ,Метка,Путь", "", "", "");

    КлючОчищ = СокрЛП(Ключ);
    КлючНРег = НРег(КлючОчищ);

    Если КлючНРег = "manager" Тогда
        Рез.Ключ  = "manager";
        Рез.Метка = "ManagerModule";
        Рез.Путь  = БазовыйПуть + "\Ext\ManagerModule.bsl";
    ИначеЕсли КлючНРег = "object" Тогда
        Рез.Ключ  = "object";
        Рез.Метка = "ObjectModule";
        Рез.Путь  = БазовыйПуть + "\Ext\ObjectModule.bsl";
    ИначеЕсли КлючНРег = "recordset" Тогда
        Рез.Ключ  = "recordset";
        Рез.Метка = "RecordSetModule";
        Рез.Путь  = БазовыйПуть + "\Ext\RecordSetModule.bsl";
    ИначеЕсли КлючНРег = "module" Тогда
        Рез.Ключ  = "module";
        Рез.Метка = "Module";
        Рез.Путь  = БазовыйПуть + "\Ext\Module.bsl";
    ИначеЕсли КлючНРег = "valuemanager" Тогда
        Рез.Ключ  = "valuemanager";
        Рез.Метка = "ValueManagerModule";
        Рез.Путь  = БазовыйПуть + "\Ext\ValueManagerModule.bsl";
    ИначеЕсли КлючНРег = "command" Тогда
        Рез.Ключ  = "command";
        Рез.Метка = "CommandModule";
        Рез.Путь  = БазовыйПуть + "\Ext\CommandModule.bsl";
    ИначеЕсли КлючНРег = "form" Тогда
        Рез.Ключ  = "form";
        Рез.Метка = "Form.Module";
        Рез.Путь  = БазовыйПуть + "\Ext\Form\Module.bsl";
    ИначеЕсли КлючНРег = "managedapplication" ИЛИ КлючНРег = "ordinaryapplication"
        ИЛИ КлючНРег = "session" ИЛИ КлючНРег = "externalconnection" Тогда
        // модули конфигурации: корень выгрузки\Ext\<Имя>Module.bsl
        Для Каждого М Из МодулиКонфигурации() Цикл
            Если М.Ключ = КлючНРег Тогда
                Рез.Ключ  = М.Ключ;
                Рез.Метка = М.Представление;
                Рез.Путь  = М.Путь;
            КонецЕсли;
        КонецЦикла;
        Если ПустаяСтрока(Рез.Путь) Тогда
            // файла нет — путь всё равно нужен, чтобы сказать «модуля нет»
            Рез.Ключ  = КлючНРег;
            Рез.Метка = КлючНРег;
            Рез.Путь  = БазовыйПуть + "\Ext\" + КлючНРег + ".bsl";
        КонецЕсли;
    ИначеЕсли СтрНачинаетсяС(КлючНРег, "form:") Тогда
        ИмяЭлемента = СокрЛП(Сред(КлючОчищ, 6));
        Рез.Ключ    = "form:" + ИмяЭлемента;
        Рез.Метка   = "Form." + ИмяЭлемента;
        Рез.Путь    = БазовыйПуть + "\Forms\" + ИмяЭлемента + "\Ext\Form\Module.bsl";
    ИначеЕсли СтрНачинаетсяС(КлючНРег, "command:") Тогда
        ИмяЭлемента = СокрЛП(Сред(КлючОчищ, 9));
        Рез.Ключ    = "command:" + ИмяЭлемента;
        Рез.Метка   = "Command." + ИмяЭлемента;
        Рез.Путь    = БазовыйПуть + "\Commands\" + ИмяЭлемента + "\Ext\CommandModule.bsl";
    КонецЕсли;

    Возврат Рез;

КонецФункции

&НаКлиенте
Функция МодулиОбъекта(Знач БазовыйПуть)

    Найденные = Новый Массив;

    БазовыеКлючи = Новый Массив;
    БазовыеКлючи.Добавить("module");
    БазовыеКлючи.Добавить("manager");
    БазовыеКлючи.Добавить("object");
    БазовыеКлючи.Добавить("recordset");
    БазовыеКлючи.Добавить("valuemanager");
    БазовыеКлючи.Добавить("command");
    БазовыеКлючи.Добавить("form");

    Для Каждого КлючМод Из БазовыеКлючи Цикл
        Опис = ОписаниеМодуляПоКлючу(БазовыйПуть, КлючМод);
        ФМод = Новый Файл(Опис.Путь);
        Если ФМод.Существует() Тогда
            Найденные.Добавить(Опис);
        КонецЕсли;
    КонецЦикла;

    // корень выгрузки (рядом Configuration.xml) — модули конфигурации
    ФКонф = Новый Файл(БазовыйПуть + "\Configuration.xml");
    Если ФКонф.Существует() Тогда
        Для Каждого М Из МодулиКонфигурации() Цикл
            Найденные.Добавить(ОписаниеМодуляПоКлючу(БазовыйПуть, М.Ключ));
        КонецЦикла;
        Возврат Найденные;
    КонецЕсли;

    ФФормы = Новый Файл(БазовыйПуть + "\Forms");
    Если ФФормы.Существует() Тогда
        ПапкиФорм = НайтиФайлы(БазовыйПуть + "\Forms", "*", Ложь);
        Для Каждого ПапкаФ Из ПапкиФорм Цикл
            Если ПапкаФ.ЭтоФайл() Тогда
                Продолжить;
            КонецЕсли;
            Опис = ОписаниеМодуляПоКлючу(БазовыйПуть, "form:" + ПапкаФ.Имя);
            ФМод = Новый Файл(Опис.Путь);
            Если ФМод.Существует() Тогда
                Найденные.Добавить(Опис);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    ФКоманды = Новый Файл(БазовыйПуть + "\Commands");
    Если ФКоманды.Существует() Тогда
        ПапкиКоманд = НайтиФайлы(БазовыйПуть + "\Commands", "*", Ложь);
        Для Каждого ПапкаК Из ПапкиКоманд Цикл
            Если ПапкаК.ЭтоФайл() Тогда
                Продолжить;
            КонецЕсли;
            Опис = ОписаниеМодуляПоКлючу(БазовыйПуть, "command:" + ПапкаК.Имя);
            ФМод = Новый Файл(Опис.Путь);
            Если ФМод.Существует() Тогда
                Найденные.Добавить(Опис);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    Возврат Найденные;

КонецФункции

// Полное имя объекта для адресов и запросов: «Тип.Имя», у модулей
