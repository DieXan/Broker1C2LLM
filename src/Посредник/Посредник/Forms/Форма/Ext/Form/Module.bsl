&НаКлиенте
Функция ПутьФайлаКэша()

    Ключ = КореньКаталога;
    Ключ = СтрЗаменить(Ключ, ":", "");
    Ключ = СтрЗаменить(Ключ, "\", "_");
    Ключ = СтрЗаменить(Ключ, "/", "_");
    Ключ = СтрЗаменить(Ключ, " ", "_");

    Если СтрДлина(Ключ) > 80 Тогда
        Ключ = Прав(Ключ, 80);
    КонецЕсли;

    Возврат КаталогВременныхФайлов() + "Посредник_Кэш_" + Ключ + ".txt";

КонецФункции

&НаКлиенте
Функция ЗаписатьТекстВФайл(Знач ПутьФайла, Знач Текст)

    Попытка
        ЗаписьТекста = Новый ЗаписьТекста(ПутьФайла, КодировкаТекста.UTF8);
        ЗаписьТекста.Записать(Текст);
        ЗаписьТекста.Закрыть();
    Исключение
        Сообщить("❌ Не удалось записать `" + ПутьФайла + "`: " + ОписаниеОшибки());
        Возврат Ложь;
    КонецПопытки;

    Возврат Истина;

КонецФункции

&НаКлиенте
Функция ПрочитатьКэш()

    ПутьКэша = ПутьФайлаКэша();
    ФК = Новый Файл(ПутьКэша);
    Если НЕ ФК.Существует() Тогда
        Возврат Неопределено;
    КонецЕсли;

    Содержимое = ПрочитатьФайлБезопасно(ПутьКэша);
    Если ПустаяСтрока(Содержимое) Тогда
        Возврат Неопределено;
    КонецЕсли;

    Рез = Новый Структура("Синонимы, Подписки, Регистраторы");
    Рез.Синонимы     = Новый Соответствие;
    Рез.Подписки     = Новый Массив;
    Рез.Регистраторы = Новый Соответствие;

    СтрокиКэша = СтрРазделить(Содержимое, Символы.ПС, Ложь);
    Для Каждого С Из СтрокиКэша Цикл

        С = СтрЗаменить(С, Символы.ВК, "");
        Если ПустаяСтрока(С) Тогда
            Продолжить;
        КонецЕсли;

        Поля = СтрРазделить(С, Символы.Таб, Истина);
        Если Поля.Количество() = 0 Тогда
            Продолжить;
        КонецЕсли;

        Если Поля[0] = "H" И Поля.Количество() >= 4 Тогда
            Ш = Новый Структура("Синоним, Подсказка", Поля[3], "");
            Если Поля.Количество() >= 5 Тогда
                Ш.Подсказка = Поля[4];
            КонецЕсли;
            Рез.Синонимы.Вставить(НРег(Поля[1] + "." + Поля[2]), Ш);

        ИначеЕсли Поля[0] = "S" И Поля.Количество() >= 5 Тогда
            П = Новый Структура("Имя, Источники, Событие, Обработчик");
            П.Имя        = Поля[1];
            П.Источники  = СтрРазделить(Поля[2], ",", Ложь);
            П.Событие    = Поля[3];
            П.Обработчик = Поля[4];
            Рез.Подписки.Добавить(П);

        ИначеЕсли Поля[0] = "R" И Поля.Количество() >= 3 Тогда
            Рез.Регистраторы.Вставить(НРег(Поля[1]), СтрРазделить(Поля[2], ",", Ложь));

        КонецЕсли;

    КонецЦикла;

    Возврат Рез;

КонецФункции

&НаКлиенте
Функция ИндексСинонимовИзКэша()

    Кэш = ПрочитатьКэш();
    Если Кэш = Неопределено ИЛИ Кэш.Синонимы.Количество() = 0 Тогда
        Возврат Неопределено;
    КонецЕсли;

    Возврат Кэш.Синонимы;

КонецФункции

&НаКлиенте
Функция ВсеПодпискиНаСобытия()

    Результат = Новый Массив;

    ПутьПапки = КореньКаталога + "\EventSubscriptions";
    ФП = Новый Файл(ПутьПапки);
    Если НЕ ФП.Существует() Тогда
        Возврат Результат;
    КонецЕсли;

    Ключи = Новый Соответствие;
    Ключи.Вставить("Name",    Истина);
    Ключи.Вставить("Synonym", Истина);
    Ключи.Вставить("Source",  Истина);
    Ключи.Вставить("Event",   Истина);
    Ключи.Вставить("Handler", Истина);

    Для Каждого Об Из ОбъектыТипа(ПутьПапки) Цикл

        Если НЕ Об.ЕстьXML Тогда
            Продолжить;
        КонецЕсли;

        Шапка = ШапкаИзXML(Об.ПутьXML, Ключи);

        П = Новый Структура("Имя, Синоним, Источники, Событие, Обработчик");
        П.Имя        = Об.Имя;
        П.Синоним    = ЗначениеШапки(Шапка, "Synonym");
        П.Источники  = СписокШапки(Шапка, "Source");
        П.Событие    = ЗначениеШапки(Шапка, "Event");
        П.Обработчик = ЗначениеШапки(Шапка, "Handler");

        Результат.Добавить(П);

    КонецЦикла;

    Возврат Результат;

КонецФункции

&НаКлиенте
Функция ВсеРегистраторы()

    // Возвращает массив структур Ключ (полное имя регистра, как в XML:
    // AccumulationRegister.Имя) / Значение (массив имён документов).
    Накопитель = Новый Соответствие;

    ПутьПапки = КореньКаталога + "\Documents";
    ФП = Новый Файл(ПутьПапки);
    Если НЕ ФП.Существует() Тогда
        Возврат Новый Массив;
    КонецЕсли;

    Ключи = Новый Соответствие;
    Ключи.Вставить("RegisterRecords", Истина);

    Для Каждого Об Из ОбъектыТипа(ПутьПапки) Цикл

        Если НЕ Об.ЕстьXML Тогда
            Продолжить;
        КонецЕсли;

        Шапка = ШапкаИзXML(Об.ПутьXML, Ключи);
        Для Каждого Рег Из СписокШапки(Шапка, "RegisterRecords") Цикл
            Список = Накопитель.Получить(Рег);
            Если Список = Неопределено Тогда
                Список = Новый Массив;
                Накопитель.Вставить(Рег, Список);
            КонецЕсли;
            Список.Добавить(Об.Имя);
        КонецЦикла;

    КонецЦикла;

    Результат = Новый Массив;
    Для Каждого КП Из Накопитель Цикл
        Результат.Добавить(Новый Структура("Ключ, Значение", КП.Ключ, КП.Значение));
    КонецЦикла;

    Возврат Результат;

КонецФункции

