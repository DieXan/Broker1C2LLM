&НаКлиенте
Процедура ВыполнитьЧтениеМодулейКонфигурации(Строки, Знач Ключ)

    Модули = МодулиКонфигурации();

    Строки.Добавить("---");
    Строки.Добавить("## Configuration → **модули конфигурации**");
    Строки.Добавить("");

    Если Модули.Количество() = 0 Тогда
        Строки.Добавить("ℹ️ В папке `Ext` корня выгрузки модулей конфигурации нет.");
        Возврат;
    КонецЕсли;

    КлючНРег = НРег(СокрЛП(Ключ));
    Найдено  = 0;

    Для Каждого М Из Модули Цикл

        Если КлючНРег <> "all" И КлючНРег <> М.Ключ Тогда
            Продолжить;
        КонецЕсли;

        Код = ПрочитатьФайлБезопасно(М.Путь);
        Если ПустаяСтрока(Код) Тогда
            Продолжить;
        КонецЕсли;

        Найдено = Найдено + 1;
        Строки.Добавить("### " + М.Представление + " (" + СтрЧислоСтрок(Код) + " строк)");
        Строки.Добавить("");
        Строки.Добавить("```bsl");
        Строки.Добавить(Код);
        Строки.Добавить("```");
        Строки.Добавить("");

    КонецЦикла;

    Если Найдено = 0 Тогда
        Строки.Добавить("❌ Не нашёл модуль `" + Ключ + "`. Доступные ключи:");
        Строки.Добавить("");
        Строки.Добавить("| Ключ | Модуль | Запрос |");
        Строки.Добавить("|---|---|---|");
        Для Каждого М Из Модули Цикл
            Строки.Добавить("| `" + М.Ключ + "` | " + М.Представление
                + " | `FETCH:Configuration." + М.Ключ + "` |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ВсеКлючиМодулейОбъекта(Знач БазовыйПуть)

    Ключи = Новый Массив;

    ФО = Новый Файл(БазовыйПуть);
    Если НЕ ФО.Существует() Тогда
        Возврат Ключи;
    КонецЕсли;

    ФExt = Новый Файл(БазовыйПуть + "\Ext");
    Если ФExt.Существует() Тогда
        ИменаExt = Новый Соответствие;
        Для Каждого Ф Из НайтиФайлы(БазовыйПуть + "\Ext", "*", Ложь) Цикл
            ИменаExt.Вставить(НРег(Ф.Имя), Истина);
        КонецЦикла;

        Если ИменаExt.Получить("managermodule.bsl")      <> Неопределено Тогда Ключи.Добавить("manager");      КонецЕсли;
        Если ИменаExt.Получить("objectmodule.bsl")       <> Неопределено Тогда Ключи.Добавить("object");       КонецЕсли;
        Если ИменаExt.Получить("recordsetmodule.bsl")    <> Неопределено Тогда Ключи.Добавить("recordset");    КонецЕсли;
        Если ИменаExt.Получить("module.bsl")             <> Неопределено Тогда Ключи.Добавить("module");       КонецЕсли;
        Если ИменаExt.Получить("valuemanagermodule.bsl") <> Неопределено Тогда Ключи.Добавить("valuemanager"); КонецЕсли;
        Если ИменаExt.Получить("commandmodule.bsl")      <> Неопределено Тогда Ключи.Добавить("command");      КонецЕсли;

        ФФормаМод = Новый Файл(БазовыйПуть + "\Ext\Form\Module.bsl");
        Если ФФормаМод.Существует() Тогда
            Ключи.Добавить("form");
        КонецЕсли;
    КонецЕсли;

    ФФормы = Новый Файл(БазовыйПуть + "\Forms");
    Если ФФормы.Существует() Тогда
        Для Каждого ПФ Из НайтиФайлы(БазовыйПуть + "\Forms", "*", Ложь) Цикл
            Если НЕ ПФ.ЭтоФайл() Тогда
                Ключи.Добавить("form:" + ПФ.Имя);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    ФКоманды = Новый Файл(БазовыйПуть + "\Commands");
    Если ФКоманды.Существует() Тогда
        Для Каждого ПК Из НайтиФайлы(БазовыйПуть + "\Commands", "*", Ложь) Цикл
            Если НЕ ПК.ЭтоФайл() Тогда
                Ключи.Добавить("command:" + ПК.Имя);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    Возврат Ключи;

КонецФункции

&НаКлиенте
Процедура ВывестиДоступныеМодули(Строки, Знач ТипОбъекта, Знач ИмяОбъекта, Знач БазовыйПуть)

    Ключи = ВсеКлючиМодулейОбъекта(БазовыйПуть);

    Если Ключи.Количество() = 0 Тогда
        Строки.Добавить("> У объекта нет ни одного BSL-модуля.");
        Возврат;
    КонецЕсли;

    Строки.Добавить("");
    Строки.Добавить("Доступные модули объекта:");
    Строки.Добавить("");
    Строки.Добавить("| Ключ | Запрос |");
    Строки.Добавить("|---|---|");
    Для Каждого К Из Ключи Цикл
        Строки.Добавить("| `" + К + "` | `FETCH:" + ТипОбъекта + "." + ИмяОбъекта
            + "." + К + "` |");
    КонецЦикла;
    Строки.Добавить("");

КонецПроцедуры

&НаКлиенте
Процедура ЗаголовокКарты(Строки, Знач ВидКарты, Знач ШапкаКонф,
    Знач ВсегоОбъектов, Знач ВсегоСКодом, Знач Сводка)

    Строки.Добавить("# Карта конфигурации — " + ВидКарты);

    Если НЕ ПустаяСтрока(ШапкаКонф.Имя) Тогда
        Описание = "`" + ШапкаКонф.Имя + "`";
        Если НЕ ПустаяСтрока(ШапкаКонф.Синоним) Тогда
            Описание = Описание + " — " + ШапкаКонф.Синоним;
        КонецЕсли;
        Строки.Добавить("> Конфигурация: " + Описание);
    КонецЕсли;

    ТехЧасти = Новый Массив;
    Если НЕ ПустаяСтрока(ШапкаКонф.Версия) Тогда
        ТехЧасти.Добавить("версия " + ШапкаКонф.Версия);
    КонецЕсли;
    Если НЕ ПустаяСтрока(ШапкаКонф.Поставщик) Тогда
        ТехЧасти.Добавить("поставщик " + ШапкаКонф.Поставщик);
    КонецЕсли;
    Если НЕ ПустаяСтрока(ШапкаКонф.Совместимость) Тогда
        ТехЧасти.Добавить("режим совместимости " + ШапкаКонф.Совместимость);
    КонецЕсли;
    Если ТехЧасти.Количество() > 0 Тогда
        Строки.Добавить("> " + СтрСоединить(ТехЧасти, " · "));
    КонецЕсли;

    Строки.Добавить("> Путь: `" + КореньКаталога + "`");
    Строки.Добавить("> " + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy ЧЧ:мм:сс"));
    Строки.Добавить("");

    Если ВидКарты = "Основная" Тогда
        Строки.Добавить("> В этом файле — прикладные объекты конфигурации.");
        Строки.Добавить("> Служебные (роли, картинки, общие макеты, элементы стиля, XDTO-пакеты,");
        Строки.Добавить("> языки) вынесены в файл `ДополнительныеДанные_*.md` — запроси его,");
        Строки.Добавить("> если нужного объекта здесь нет.");
    Иначе
        Строки.Добавить("> В этом файле — служебные объекты конфигурации.");
        Строки.Добавить("> Прикладные объекты — в файле `ОсновнаяКонфигурация_*.md`.");
    КонецЕсли;
    Строки.Добавить("");

    Строки.Добавить("**Колонка «Синоним»** заполнена только там, где синоним отличается");
    Строки.Добавить("от имени объекта. Пусто — значит синоним совпадает с именем.");
    Строки.Добавить("");
    Строки.Добавить("**Колонка «Код»** — какие модули есть у объекта; значение метки");
    Строки.Добавить("совпадает с ключом для `FETCH:`:");
    Строки.Добавить("");
    Строки.Добавить("| Метка | Что это | Ключ FETCH |");
    Строки.Добавить("|---|---|---|");
    Строки.Добавить("| `Мнж` | модуль менеджера | `manager` |");
    Строки.Добавить("| `Об` | модуль объекта | `object` |");
    Строки.Добавить("| `Наб` | модуль набора записей | `recordset` |");
    Строки.Добавить("| `Мод` | модуль (общие модули, модули конфигурации) | `module` |");
    Строки.Добавить("| `Знч` | модуль менеджера значения константы | `valuemanager` |");
    Строки.Добавить("| `Ком` | модуль общей команды | `command` |");
    Строки.Добавить("| `Фрм` | модуль общей формы | `form` |");
    Строки.Добавить("| `Ф5` | 5 форм — имена смотри в `SCHEMA:` | `form:ИмяФормы` |");
    Строки.Добавить("| `К2` | 2 команды — имена смотри в `SCHEMA:` | `command:ИмяКоманды` |");
    Строки.Добавить("| `П` | есть предопределённые элементы (видны в `SCHEMA:`) | — |");
    Строки.Добавить("");

    Если Сводка <> Неопределено И Сводка.Количество() > 0 Тогда
        Строки.Добавить("## Состав файла");
        Строки.Добавить("");
        Строки.Добавить("| Вид объектов | Папка выгрузки | Кол-во |");
        Строки.Добавить("|---|---|---:|");
        Для Каждого С Из Сводка Цикл
            Строки.Добавить(С);
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

КонецПроцедуры

