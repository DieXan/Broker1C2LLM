&НаКлиенте
Процедура ВыполнитьОглавлениеМодуля(Строки, Знач ТелоЗапроса)

    ЧастиЗапроса = СтрРазделить(ТелоЗапроса, "|", Ложь);
    Если ЧастиЗапроса.Количество() = 0 Тогда
        Строки.Добавить("Пустой запрос OUTLINE.");
        Возврат;
    КонецЕсли;

    Основа = СокрЛП(ЧастиЗапроса[0]);

    Строки.Добавить("---");
    Строки.Добавить("## OUTLINE: `" + Основа + "`");
    Строки.Добавить("");

    Опции = ОпцииОглавленияПоУмолчанию();

    СохраненныеОпции = Новый Массив;

    Для Сч = 1 По ЧастиЗапроса.Количество() - 1 Цикл

        Опц     = СокрЛП(ЧастиЗапроса[Сч]);
        ОпцНРег = НРег(Опц);

        Если ОпцНРег = "export" Тогда
            Опции.ТолькоЭкспортные = Истина;
            СохраненныеОпции.Добавить(Опц);
        ИначеЕсли ОпцНРег = "marks" Тогда
            Опции.ТолькоСМаркерами = Истина;
            СохраненныеОпции.Добавить(Опц);
        ИначеЕсли ОпцНРег = "noregion" Тогда
            Опции.ТолькоВнеОбластей = Истина;
            СохраненныеОпции.Добавить(Опц);
        ИначеЕсли ОпцНРег = "all" Тогда
            Опции.БезОграничений = Истина;
        ИначеЕсли СтрНачинаетсяС(ОпцНРег, "find=") Тогда
            Опции.Подстрока = СокрЛП(Сред(Опц, 6));
            СохраненныеОпции.Добавить(Опц);
        ИначеЕсли СтрНачинаетсяС(ОпцНРег, "page=") Тогда
            Попытка
                Опции.Страница = Число(СокрЛП(Сред(Опц, 6)));
            Исключение
                Строки.Добавить("Не разобрал номер страницы: `" + Опц + "` — беру первую.");
            КонецПопытки;
        ИначеЕсли НЕ ПустаяСтрока(Опц) Тогда
            Строки.Добавить("Неизвестная опция: `" + Опц + "` — пропущена.");
        КонецЕсли;

    КонецЦикла;

    // область прямо в адресе: OUTLINE:Тип.Объект.модуль#ИмяОбласти
    ПозМетки = СтрНайти(Основа, "#");
    Если ПозМетки > 0 Тогда
        Опции.ОбластьОтбора = СокрЛП(Сред(Основа, ПозМетки + 1));
        Основа              = СокрЛП(Лев(Основа, ПозМетки - 1));
    КонецЕсли;

    // хвост дописывается к адресу модуля, когда нужно предложить уточняющий запрос
    Опции.ХвостЗапроса = ?(ПустаяСтрока(Опции.ОбластьОтбора), "", "#" + Опции.ОбластьОтбора)
        + ?(СохраненныеОпции.Количество() = 0, "", "|" + СтрСоединить(СохраненныеОпции, "|"));

    Адрес = РазобратьАдресОбъекта(Основа);
    Если НЕ ПустаяСтрока(Адрес.Ошибка) Тогда
        Строки.Добавить("❌ Неверный формат: `" + Основа + "`");
        Строки.Добавить(Адрес.Ошибка);
        Возврат;
    КонецЕсли;

    ПолноеИмяОбъекта = ПолноеИмяПоАдресу(Адрес);
    БазовыйПуть      = БазовыйПутьПоАдресу(Адрес);

    ФБаза = Новый Файл(БазовыйПуть);
    Если НЕ ФБаза.Существует() ИЛИ ФБаза.ЭтоФайл() Тогда
        Строки.Добавить("❌ Не найден объект с модулями: `" + ПолноеИмяОбъекта + "`");
        Строки.Добавить("> Папка: `" + БазовыйПуть + "`");
        Возврат;
    КонецЕсли;

    Кандидаты = Новый Массив;

    Если НЕ ПустаяСтрока(Адрес.КлючМодуля) Тогда

        Опис = ОписаниеМодуляПоКлючу(БазовыйПуть, Адрес.КлючМодуля);
        Если ПустаяСтрока(Опис.Путь) Тогда
            Строки.Добавить("❌ Неизвестный ключ модуля: `" + Адрес.КлючМодуля + "`");
            Строки.Добавить("Доступны: `manager`, `object`, `recordset`, `module`, `form:Имя`, `command:Имя`");
            ВывестиСписокМодулейОбъекта(Строки, ПолноеИмяОбъекта, МодулиОбъекта(БазовыйПуть), "OUTLINE", "");
            Возврат;
        КонецЕсли;

        ФМодуля = Новый Файл(Опис.Путь);
        Если НЕ ФМодуля.Существует() Тогда
            Строки.Добавить("❌ У объекта `" + ПолноеИмяОбъекта + "` нет модуля `" + Опис.Ключ + "`.");
            ВывестиСписокМодулейОбъекта(Строки, ПолноеИмяОбъекта, МодулиОбъекта(БазовыйПуть), "OUTLINE", "");
            Возврат;
        КонецЕсли;

        Кандидаты.Добавить(Опис);

    Иначе
        Кандидаты = МодулиОбъекта(БазовыйПуть);
    КонецЕсли;

    Если Кандидаты.Количество() = 0 Тогда
        Строки.Добавить("ℹ У объекта нет модулей с кодом.");
        Строки.Добавить("");
        Возврат;
    КонецЕсли;

    // Модулей много — сначала сводка, чтобы не вываливать всё сразу
    Если Кандидаты.Количество() > 2 И НЕ Опции.БезОграничений Тогда

        Строки.Добавить("У объекта " + ЧислоВСтроку(Кандидаты.Количество())
            + " модулей — вот сводка. Оглавление конкретного модуля бери запросом из последней колонки,"
            + " все сразу — опцией `|all`.");
        Строки.Добавить("");
        Строки.Добавить("| Модуль | Файл | Строк | Областей | Процедур | Экспортных | Запрос |");
        Строки.Добавить("|---|---|---|---|---|---|---|");

        Для Каждого Опис Из Кандидаты Цикл

            Разбор = РазборФайлаМодуля(Опис.Путь);
            Если Разбор = Неопределено Тогда
                Разбор = РазобратьМодульBSL("");
            КонецЕсли;

            Строки.Добавить("| `" + Опис.Ключ + "` | " + Опис.Метка
                + " | " + ЧислоВСтроку(Разбор.ВсегоСтрок)
                + " | " + ЧислоВСтроку(Разбор.Области.Количество())
                + " | " + ЧислоВСтроку(Разбор.Методы.Количество())
                + " | " + ЧислоВСтроку(Разбор.ВсегоЭкспортных)
                + " | `OUTLINE:" + ПолноеИмяОбъекта + "." + Опис.Ключ + "` |");

        КонецЦикла;

        Строки.Добавить("");
        Возврат;

    КонецЕсли;

    Для Каждого Опис Из Кандидаты Цикл

        Разбор = РазборФайлаМодуля(Опис.Путь);
        Если Разбор = Неопределено Тогда
            Строки.Добавить("### " + Опис.Метка + " — пустой или нечитаемый файл");
            Строки.Добавить("");
            Продолжить;
        КонецЕсли;

        ВывестиОглавлениеОдногоМодуля(Строки, ПолноеИмяОбъекта, Опис, Разбор, Опции);

    КонецЦикла;

КонецПроцедуры

