    Шапка = ШапкаИзXML(ПутьXML, КлючиДляЧтения);

    // Порядок вывода — как в Ключи, поэтому собираем вручную.
    Порядок = Новый Массив;
    Порядок.Добавить("Synonym");
    Порядок.Добавить("ToolTip");
    Порядок.Добавить("Comment");
    Порядок.Добавить("Type");
    Порядок.Добавить("ValueType");
    Порядок.Добавить("Source");
    Порядок.Добавить("Event");
    Порядок.Добавить("Handler");
    Порядок.Добавить("MethodName");
    Порядок.Добавить("CommandParameterType");
    Порядок.Добавить("ParameterUseMode");
    Порядок.Добавить("ModifiesData");
    Порядок.Добавить("Group");
    Порядок.Добавить("Representation");
    Порядок.Добавить("Hierarchical");
    Порядок.Добавить("HierarchyType");
    Порядок.Добавить("Owners");
    Порядок.Добавить("CodeLength");
    Порядок.Добавить("CodeType");
    Порядок.Добавить("CodeAllowedLength");
    Порядок.Добавить("CodeSeries");
    Порядок.Добавить("DescriptionLength");
    Порядок.Добавить("Autonumbering");
    Порядок.Добавить("CheckUnique");
    Порядок.Добавить("NumberLength");
    Порядок.Добавить("NumberType");
    Порядок.Добавить("NumberAllowedLength");
    Порядок.Добавить("NumberPeriodicity");
    Порядок.Добавить("Posting");
    Порядок.Добавить("RegisterType");
    Порядок.Добавить("InformationRegisterPeriodicity");
    Порядок.Добавить("WriteMode");
    Порядок.Добавить("Namespace");
    Порядок.Добавить("RootURL");
    Порядок.Добавить("ReuseSessions");

    Результат = Новый Массив;
    Для Каждого К Из Порядок Цикл
        Значение = ЗначениеШапки(Шапка, К);
        Если ПустаяСтрока(Значение) Тогда
            Продолжить;
        КонецЕсли;
        Если К = "Type" ИЛИ К = "ValueType" ИЛИ К = "Source" ИЛИ К = "CommandParameterType" Тогда
            Части = Новый Массив;
            Для Каждого Т Из СписокШапки(Шапка, К) Цикл
                Части.Добавить(Тип1С(Т));
            КонецЦикла;
            Если Части.Количество() > 0 Тогда
                Значение = СтрСоединить(Части, ", ");
            КонецЕсли;
        ИначеЕсли К = "ParameterUseMode" Тогда
            Значение = ?(НРег(Значение) = "multiple", "Множественный (массив ссылок)",
                ?(НРег(Значение) = "single", "Одиночный", Значение));
        ИначеЕсли К = "ModifiesData" Тогда
            Значение = ?(НРег(Значение) = "true", "Да", ?(НРег(Значение) = "false", "Нет", Значение));
        ИначеЕсли К = "Event" Тогда
            // Posting → «Posting (ОбработкаПроведения)»: так называется обработчик в модуле
            ИмяРус = РусскоеИмяСобытия(Значение);
            Если ИмяРус <> Значение Тогда
                Значение = Значение + " (" + ИмяРус + ")";
            КонецЕсли;
        КонецЕсли;
        Результат.Добавить(Новый Структура("Имя, Значение", Ключи.Получить(К), Значение));
    КонецЦикла;

    Возврат Результат;

КонецФункции

&НаКлиенте
Функция ПрочитатьПредопределенные(Знач ПутьПапкиОбъекта)

    Результат = Новый Массив;

    ПутьXML = ПутьПапкиОбъекта + "\Ext\Predefined.xml";
    ФX = Новый Файл(ПутьXML);
    Если НЕ ФX.Существует() Тогда
        Возврат Результат;
    КонецЕсли;

    ЧтениеXML = Новый ЧтениеXML;
    Попытка
        ЧтениеXML.ОткрытьФайл(ПутьXML);
    Исключение
        Возврат Результат;
    КонецПопытки;

    Попытка

        ТекЭлемент = Неопределено;
        ТекПоле    = "";

        Пока ЧтениеXML.Прочитать() Цикл

            Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда

                ЛокИмя = ЧтениеXML.ЛокальноеИмя;

                Если ЛокИмя = "Item" Тогда
                    ТекЭлемент = Новый Структура("Имя, Код, Наименование, Папка, Доп");
                    ТекЭлемент.Имя          = "";
                    ТекЭлемент.Код          = "";
                    ТекЭлемент.Наименование = "";
                    ТекЭлемент.Папка        = "";
                    ТекЭлемент.Доп          = "";
                    ТекПоле = "";
                ИначеЕсли ТекЭлемент <> Неопределено Тогда
                    ТекПоле = ЛокИмя;
                КонецЕсли;

            ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда

                Если ТекЭлемент <> Неопределено И НЕ ПустаяСтрока(ТекПоле) Тогда
                    Знч = СокрЛП(ЧтениеXML.Значение);
                    Если ТекПоле = "Name" Тогда
                        ТекЭлемент.Имя = Знч;
                    ИначеЕсли ТекПоле = "Code" Тогда
                        ТекЭлемент.Код = Знч;
                    ИначеЕсли ТекПоле = "Description" Тогда
                        ТекЭлемент.Наименование = Знч;
                    ИначеЕсли ТекПоле = "IsFolder" Тогда
                        ТекЭлемент.Папка = ?(НРег(Знч) = "true", "да", "");
                    ИначеЕсли ТекПоле = "AccountType" Тогда
                        ТекЭлемент.Доп = "вид счёта: " + Знч;
                    КонецЕсли;
                КонецЕсли;

            ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда

                Если ЧтениеXML.ЛокальноеИмя = "Item" И ТекЭлемент <> Неопределено Тогда
                    Если НЕ ПустаяСтрока(ТекЭлемент.Имя) Тогда
                        Результат.Добавить(ТекЭлемент);
                    КонецЕсли;
                    ТекЭлемент = Неопределено;
                КонецЕсли;
                ТекПоле = "";

            КонецЕсли;

        КонецЦикла;

    Исключение
    КонецПопытки;

    Попытка
        ЧтениеXML.Закрыть();
    Исключение
    КонецПопытки;

    Возврат Результат;

КонецФункции

&НаКлиенте
Функция ОбщиеРеквизитыОбъекта(Знач ТипОбъекта, Знач ИмяОбъекта)

    Результат = Новый Массив;

    ПутьПапки = КореньКаталога + "\CommonAttributes";
    ФП = Новый Файл(ПутьПапки);
    Если НЕ ФП.Существует() Тогда
        Возврат Результат;
    КонецЕсли;

    ИскомыеСсылки = Новый Соответствие;
    Для Каждого КП Из ПапкиВКлассыМетаданных() Цикл
        Если НРег(КП.Значение) = НРег(ТипОбъекта) Тогда
            ИскомыеСсылки.Вставить(НРег(КП.Ключ + "." + ИмяОбъекта), Истина);
        КонецЕсли;
    КонецЦикла;

    Если ИскомыеСсылки.Количество() = 0 Тогда
        Возврат Результат;
    КонецЕсли;

    Для Каждого Об Из ОбъектыТипа(ПутьПапки) Цикл

        Если НЕ Об.ЕстьXML Тогда
            Продолжить;
        КонецЕсли;

        // XML общего реквизита — список всех объектов конфигурации,
        // разбираем его один раз за пакет, а не на каждый SCHEMA
        Если КэшСоставовОбщихРеквизитов = Неопределено Тогда
            КэшСоставовОбщихРеквизитов = Новый Соответствие;
        КонецЕсли;
        Состав = КэшСоставовОбщихРеквизитов.Получить(НРег(Об.ПутьXML));
        Если Состав = Неопределено Тогда
            Состав = СоставОбщегоРеквизита(Об.ПутьXML);
            КэшСоставовОбщихРеквизитов.Вставить(НРег(Об.ПутьXML), Состав);
        КонецЕсли;
        Использование = "";
        Для Каждого Э Из Состав.Элементы Цикл
            Если ИскомыеСсылки.Получить(НРег(Э.Объект)) <> Неопределено Тогда
                Использование = Э.Использование;
                Прервать;
            КонецЕсли;
        КонецЦикла;

        Если ПустаяСтрока(Использование) Тогда
            Использование = Состав.АвтоИспользование;
        КонецЕсли;

        Если НРег(Использование) = "dontuse" ИЛИ ПустаяСтрока(Использование) Тогда
            Продолжить;
        КонецЕсли;

        Результат.Добавить(Новый Структура("Имя, Синоним, Тип, Использование",
            Об.Имя, Состав.Синоним, Состав.Тип, Использование));

    КонецЦикла;

    Возврат Результат;

КонецФункции

