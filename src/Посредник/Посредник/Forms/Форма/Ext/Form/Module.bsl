// Что уже выдано в текущем пакете запросов: адрес модуля (НРег) → массив
// структур Начало, Конец, Описание. Нужно, чтобы LINES и повторный PROC
// не дублировали код, уже выданный выше в том же файле результата.
&НаКлиенте
Перем ВыданныеФрагменты;

// Имена общих модулей — читаются один раз за пакет (папка на 4 000 элементов).
&НаКлиенте
Перем КэшИменОбщихМодулей;

// Легенда колонки «Где» печатается один раз на файл результата.
&НаКлиенте
Перем ЛегендаПоискаВыведена;

// Кэши на время одного пакета запросов — чтобы в пакете из нескольких
// строк не читать и не разбирать одно и то же повторно:
// файл кэша шапок/подписок, разобранные модули, составы общих реквизитов.
&НаКлиенте
Перем КэшФайлаКэша;

&НаКлиенте
Перем КэшФайлаКэшаПрочитан;

&НаКлиенте
Перем КэшРазборовМодулей;

&НаКлиенте
Перем КэшСоставовОбщихРеквизитов;

// Ключевые слова маркеров — массив создаётся один раз, а не на каждую строку.
&НаКлиенте
Перем КэшКлючевыхСловМаркеров;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    Если ПустаяСтрока(РежимБуфера) Тогда
        РежимБуфера = "Файл";
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СформироватьМД(Команда)

    Если ПустаяСтрока(КореньКаталога) Тогда
        Сообщить("Укажи путь к конфигурации");
        Возврат;
    КонецЕсли;

    ФКорень = Новый Файл(КореньКаталога);
    Если НЕ ФКорень.Существует() Тогда
        Сообщить("Каталог не найден: " + КореньКаталога);
        Возврат;
    КонецЕсли;

    // Выгрузка идёт несколько минут — случайное нажатие не должно её запускать.
    ТекстВопроса = "Выгрузить объекты конфигурации в MD?" + Символы.ПС
        + "Полный обход выгрузки займёт несколько минут.";
    ДатаКэша = ДатаПоследнейВыгрузки();
    Если НЕ ПустаяСтрока(ДатаКэша) Тогда
        ТекстВопроса = ТекстВопроса + Символы.ПС + "Предыдущая выгрузка: " + ДатаКэша + ".";
    КонецЕсли;
    Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет,
        "Выгрузка объектов в MD") <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;

    // файл кэша сейчас будет переписан
    СброситьКэшиПакета();

    ШапкаКонф = ПрочитатьШапкуКонфигурации();

    СтрокиОсн = Новый Массив;
    СтрокиДоп = Новый Массив;

    // Кэш шапок и связей — пишется в каталог временных файлов,
    // исходная выгрузка конфигурации не трогается.
    СтрокиКэша = Новый Массив;
    СтрокиКэша.Добавить("#ROOT" + Символы.Таб + КореньКаталога + Символы.Таб
        + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd HH:mm:ss"));

    ТипыОбъектов = ТипыОбъектовКонфигурации();

    ВсегоОсн    = 0;
    ВсегоДоп    = 0;
    ВсегоСКодом = 0;

    СводкаОсн = Новый Массив;
    СводкаДоп = Новый Массив;

    ТелоОсн = Новый Массив;
    ТелоДоп = Новый Массив;

    Для Каждого КП Из ТипыОбъектов Цикл

        ТипПапки = КП.Ключ;
        ТипРус   = КП.Значение;
        ЭтоДоп   = (КП.Группа = "Доп");

        ПутьПапки = КореньКаталога + "\" + ТипПапки;
        ФП = Новый Файл(ПутьПапки);
        Если НЕ ФП.Существует() Тогда
            Продолжить;
        КонецЕсли;

        Состояние("Карта: " + ТипРус + "...");

        Объекты = ОбъектыТипа(ПутьПапки);
        Если Объекты.Количество() = 0 Тогда
            Продолжить;
        КонецЕсли;

        СтрокиТаблицы = Новый Массив;

        Для Каждого Об Из Объекты Цикл

            Синоним = "";
            Если Об.ЕстьXML Тогда
                Шапка = ПрочитатьШапкуОбъекта(Об.ПутьXML);
                Если СинонимОтличается(Об.Имя, Шапка.Синоним) Тогда
                    Синоним = Шапка.Синоним;
                КонецЕсли;
                СтрокиКэша.Добавить("H" + Символы.Таб + ТипПапки + Символы.Таб
                    + Об.Имя + Символы.Таб + ОчиститьДляКэша(Шапка.Синоним)
                    + Символы.Таб + ОчиститьДляКэша(Шапка.Подсказка));
            КонецЕсли;

            Признаки = ПризнакиКодаОбъекта(Об.ПутьПапки);
            Если Признаки.ЕстьКод Тогда
                ВсегоСКодом = ВсегоСКодом + 1;
            КонецЕсли;

            СтрокиТаблицы.Добавить("| " + Об.Имя
                + " | " + ЭкранироватьЯчейку(Синоним, 120)
                + " | " + Признаки.Флаги + " |");

        КонецЦикла;

        Если ЭтоДоп Тогда
            Приёмник = ТелоДоп;
            ВсегоДоп = ВсегоДоп + Объекты.Количество();
            СводкаДоп.Добавить("| " + ТипРус + " | `" + ТипПапки + "` | "
                + ЧислоВСтроку(Объекты.Количество()) + " |");
        Иначе
            Приёмник = ТелоОсн;
            ВсегоОсн = ВсегоОсн + Объекты.Количество();
            СводкаОсн.Добавить("| " + ТипРус + " | `" + ТипПапки + "` | "
                + ЧислоВСтроку(Объекты.Количество()) + " |");
        КонецЕсли;

        Приёмник.Добавить("---");
        Приёмник.Добавить("## " + ТипРус + " · `" + ТипПапки + "` ("
            + ЧислоВСтроку(Объекты.Количество()) + ")");
        Приёмник.Добавить("");
        Приёмник.Добавить("| Объект | Синоним | Код |");
        Приёмник.Добавить("|---|---|---|");
        Для Каждого С Из СтрокиТаблицы Цикл
            Приёмник.Добавить(С);
        КонецЦикла;
        Приёмник.Добавить("");

    КонецЦикла;

    // ── модули конфигурации (корневая папка Ext) ──
    МодулиКонф = МодулиКонфигурации();
    Если МодулиКонф.Количество() > 0 Тогда
        ВсегоОсн = ВсегоОсн + МодулиКонф.Количество();
        ВсегоСКодом = ВсегоСКодом + МодулиКонф.Количество();
        СводкаОсн.Добавить("| МодулиКонфигурации | `Configuration` | "
            + ЧислоВСтроку(МодулиКонф.Количество()) + " |");
        ТелоОсн.Добавить("---");
        ТелоОсн.Добавить("## МодулиКонфигурации · `Configuration` ("
            + ЧислоВСтроку(МодулиКонф.Количество()) + ")");
        ТелоОсн.Добавить("");
        ТелоОсн.Добавить("| Объект | Синоним | Код |");
        ТелоОсн.Добавить("|---|---|---|");
        Для Каждого М Из МодулиКонф Цикл
            ТелоОсн.Добавить("| " + М.Ключ + " | " + М.Представление + " | Мод |");
        КонецЦикла;
        ТелоОсн.Добавить("");
    КонецЕсли;

    // ── кэш подписок на события и регистраторов ──
    Состояние("Кэш: подписки на события...");
    Для Каждого П Из ВсеПодпискиНаСобытия() Цикл
        СтрокиКэша.Добавить("S" + Символы.Таб + П.Имя + Символы.Таб
            + СтрСоединить(П.Источники, ",") + Символы.Таб
            + П.Событие + Символы.Таб + П.Обработчик);
    КонецЦикла;

    Состояние("Кэш: регистраторы...");
    Для Каждого Р Из ВсеРегистраторы() Цикл
        СтрокиКэша.Добавить("R" + Символы.Таб + Р.Ключ + Символы.Таб
            + СтрСоединить(Р.Значение, ","));
    КонецЦикла;

    // ── сборка файлов ──
    ЗаголовокКарты(СтрокиОсн, "Основная", ШапкаКонф, ВсегоОсн, ВсегоСКодом, СводкаОсн);
    Для Каждого С Из ТелоОсн Цикл
        СтрокиОсн.Добавить(С);
    КонецЦикла;
    СтрокиОсн.Добавить("---");
    СтрокиОсн.Добавить("**Объектов в этом файле: " + ЧислоВСтроку(ВсегоОсн)
        + "** · из них с кодом: " + ЧислоВСтроку(ВсегоСКодом));

    ЗаголовокКарты(СтрокиДоп, "Дополнительная", ШапкаКонф, ВсегоДоп, 0, СводкаДоп);
    Для Каждого С Из ТелоДоп Цикл
        СтрокиДоп.Добавить(С);
    КонецЦикла;
    СтрокиДоп.Добавить("---");
    СтрокиДоп.Добавить("**Объектов в этом файле: " + ЧислоВСтроку(ВсегоДоп) + "**");

    ПутьОсн = СохранитьРезультатВФайл(СтрСоединить(СтрокиОсн, Символы.ПС),
        "ОсновнаяКонфигурация");
    Если ПустаяСтрока(ПутьОсн) Тогда
        Сообщить("Сохранение отменено.");
        Возврат;
    КонецЕсли;

    ФОсн = Новый Файл(ПутьОсн);
    ПутьДоп = ФОсн.Путь + "ДополнительныеДанные_"
        + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd_HH-mm-ss") + ".md";
    Если ЗаписатьТекстВФайл(ПутьДоп, СтрСоединить(СтрокиДоп, Символы.ПС)) Тогда
        Сообщить("Файл сохранён: " + ПутьДоп);
    КонецЕсли;

    ПутьКэша = ПутьФайлаКэша();
    Если ЗаписатьТекстВФайл(ПутьКэша, СтрСоединить(СтрокиКэша, Символы.ПС)) Тогда
        Сообщить("Кэш шапок обновлён: " + ПутьКэша);
    КонецЕсли;

    Сообщить("Готово — " + ЧислоВСтроку(ВсегоОсн + ВсегоДоп) + " объектов ("
        + ЧислоВСтроку(ВсегоОсн) + " в основной карте, "
        + ЧислоВСтроку(ВсегоДоп) + " в дополнительной).");

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗапрос(Команда)
    Если ПустаяСтрока(КореньКаталога) Тогда
        Сообщить("Укажи путь к конфигурации");
        Возврат;
    КонецЕсли;

    Если ПустаяСтрока(СтрокаЗапроса) Тогда
        Сообщить("Вставь строку запроса: FETCH:, SCHEMA:, SEARCH:, DEPS:, PROC:, REGION:, LINES:, OUTLINE:, FORM:, EVENTS:, SUBSYS:, CALLERS: или QUERIES:");
        Возврат;
    КонецЕсли;

    ВыданныеФрагменты     = Новый Соответствие;
    КэшИменОбщихМодулей   = Неопределено;
    ЛегендаПоискаВыведена = Ложь;
    СброситьКэшиПакета();

    Строки = Новый Массив;
    Строки.Добавить("# Ответ на запрос");
    Строки.Добавить("> " + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy ЧЧ:мм:сс"));
    Строки.Добавить("");

    ВсеЧасти = Новый Массив;

    СтрокиЗапроса = СтрРазделить(СтрокаЗапроса, Символы.ПС, Ложь);

    Для Каждого СтрЗапр Из СтрокиЗапроса Цикл

        СтрЗапр = ОчиститьСтрокуЗапроса(СтрЗапр);
        Если ПустаяСтрока(СтрЗапр) Тогда Продолжить; КонецЕсли;

        // команда — без учёта регистра (fetch:, Fetch:); DEPENDENCIES: раньше DEPS:
        ТипЗапроса = "";
        Тело        = "";
        Для Каждого ОписКоманды Из ПрефиксыКоманд() Цикл
            Если ВРег(Лев(СтрЗапр, СтрДлина(ОписКоманды.Префикс))) = ОписКоманды.Префикс Тогда
                ТипЗапроса = ОписКоманды.Тип;
                Тело       = Сред(СтрЗапр, СтрДлина(ОписКоманды.Префикс) + 1);
                Прервать;
            КонецЕсли;
        КонецЦикла;

        Если ПустаяСтрока(ТипЗапроса) Тогда
            Строки.Добавить("❌ Не распознана строка: `" + СтрЗапр + "`");
            Строки.Добавить("Ожидается начало с FETCH:, SCHEMA:, SEARCH:, DEPENDENCIES:, PROC:, REGION:, LINES:, OUTLINE:, FORM:, EVENTS:, SUBSYS:, CALLERS: или QUERIES:");
            Строки.Добавить("");
            Продолжить;
        КонецЕсли;

        // SEARCH, DEPENDENCIES и CALLERS не режем по ";" — опции отделяются через "|"
        Если ТипЗапроса = "SEARCH" ИЛИ ТипЗапроса = "DEPENDENCIES" ИЛИ ТипЗапроса = "CALLERS" Тогда
            ЗапросЧасть = Новый Структура("ТипЗапроса,Часть", ТипЗапроса, СокрЛП(Тело));
            ВсеЧасти.Добавить(ЗапросЧасть);
            Продолжить;
        КонецЕсли;

        ЧастиСтроки = СтрРазделить(Тело, ";", Ложь);
        Для Каждого ЧастьСтр Из ЧастиСтроки Цикл
            ЗапросЧасть = Новый Структура("ТипЗапроса,Часть", ТипЗапроса, СокрЛП(ЧастьСтр));
            ВсеЧасти.Добавить(ЗапросЧасть);
        КонецЦикла;

    КонецЦикла;

    Части = ВсеЧасти;

    ОшибокЗапросов = 0;

    Для Каждого ЗапросЭл Из Части Цикл

        // Строка вплотную к «---» в Markdown становится заголовком —
        // перед каждым блоком нужна пустая строка.
        Если Строки.Количество() > 0 И Строки[Строки.Количество() - 1] <> "" Тогда
            Строки.Добавить("");
        КонецЕсли;

        // Каждый запрос изолирован: падение одного не отменяет остальные
        // и не съедает уже собранный результат.
        Попытка
            ВыполнитьОдинЗапрос(Строки, ЗапросЭл.ТипЗапроса, ЗапросЭл.Часть);
        Исключение
            ОшибокЗапросов = ОшибокЗапросов + 1;
            Строки.Добавить("---");
            Строки.Добавить("## ❌ Запрос не выполнен: `" + ЗапросЭл.ТипЗапроса
                + ":" + ЗапросЭл.Часть + "`");
            Строки.Добавить("");
            Строки.Добавить("```");
            Строки.Добавить(ОписаниеОшибки());
            Строки.Добавить("```");
            Строки.Добавить("");
        КонецПопытки;

    КонецЦикла;

    Если ОшибокЗапросов > 0 Тогда
        Строки.Добавить("---");
        Строки.Добавить("> ⚠ Запросов с ошибкой: " + ОшибокЗапросов
            + " из " + Части.Количество() + ". Остальные выполнены, результат ниже сохранён.");
        Строки.Добавить("");
    КонецЕсли;

    РезультатМД = СтрСоединить(Строки, Символы.ПС);
    Сообщить("Готово");

    БазовоеИмяФайла = СформироватьИмяПоЗапросу(ВсеЧасти);
    ПутьРезультата  = СохранитьРезультатВФайл(РезультатМД, БазовоеИмяФайла, Ложь);

    Если НЕ ПустаяСтрока(ПутьРезультата) Тогда
        СкопироватьРезультатВБуфер(ПутьРезультата);
    КонецЕсли;

КонецПроцедуры

// Префиксы команд: Префикс (в верхнем регистре) → Тип запроса.
// DEPENDENCIES: проверяется раньше DEPS:.
&НаКлиенте
Функция ПрефиксыКоманд()

    Рез = Новый Массив;
    Для Каждого Пара Из СтрРазделить("FETCH:FETCH,SCHEMA:SCHEMA,SEARCH:SEARCH,"
        + "DEPENDENCIES:DEPENDENCIES,DEPS:DEPENDENCIES,PROC:PROC,REGION:REGION,LINES:LINES,"
        + "OUTLINE:OUTLINE,FORM:FORM,EVENTS:EVENTS,SUBSYS:SUBSYS,CALLERS:CALLERS,QUERIES:QUERIES", ",", Ложь) Цикл
        ПозДвоеточия = СтрНайти(Пара, ":");
        Рез.Добавить(Новый Структура("Префикс, Тип",
            Лев(Пара, ПозДвоеточия), Сред(Пара, ПозДвоеточия + 1)));
    КонецЦикла;
    Возврат Рез;

КонецФункции

// Строка запроса, скопированная из ответа Claude, бывает обёрнута:
// `FETCH:…` в обратных кавычках, «- FETCH:…» пунктом списка, «1. FETCH:…».
&НаКлиенте
Функция ОчиститьСтрокуЗапроса(Знач Текст)

    Текст = СокрЛП(Текст);

    // маркер списка: «- », «* », «• », «1. », «1) »
    Если СтрНачинаетсяС(Текст, "- ") ИЛИ СтрНачинаетсяС(Текст, "* ") ИЛИ СтрНачинаетсяС(Текст, "• ") Тогда
        Текст = СокрЛП(Сред(Текст, 3));
    Иначе
        Поз = 1;
        Пока Поз <= СтрДлина(Текст) И СтрНайти("0123456789", Сред(Текст, Поз, 1)) > 0 Цикл
            Поз = Поз + 1;
        КонецЦикла;
        Если Поз > 1 И (Сред(Текст, Поз, 2) = ". " ИЛИ Сред(Текст, Поз, 2) = ") ") Тогда
            Текст = СокрЛП(Сред(Текст, Поз + 2));
        КонецЕсли;
    КонецЕсли;

    // обратные кавычки вокруг запроса
    Пока СтрНачинаетсяС(Текст, "`") Цикл
        Текст = Сред(Текст, 2);
    КонецЦикла;
    Пока СтрЗаканчиваетсяНа(Текст, "`") Цикл
        Текст = Лев(Текст, СтрДлина(Текст) - 1);
    КонецЦикла;

    Возврат СокрЛП(Текст);

КонецФункции

// Кладёт сохранённый результат в буфер обмена Windows — файлом (вставляется
// в чат как вложение), текстом или и тем и другим, по переключателю на форме.
// В платформе нет средств положить в буфер файл, поэтому через PowerShell.
&НаКлиенте
Процедура СкопироватьРезультатВБуфер(Знач ПутьФайла)

    Режим = ?(ПустаяСтрока(РежимБуфера), "Файл", РежимБуфера);
    Если Режим = "Не копировать" Тогда
        Возврат;
    КонецЕсли;

    КопироватьФайл  = (Режим = "Файл" ИЛИ Режим = "Файл и текст");
    КопироватьТекст = (Режим = "Текст" ИЛИ Режим = "Файл и текст");

    ПутьДляPS = СтрЗаменить(ПутьФайла, "'", "''");

    Скрипт = Новый Массив;
    Скрипт.Добавить("Add-Type -AssemblyName System.Windows.Forms");
    Скрипт.Добавить("$p = '" + ПутьДляPS + "'");
    Скрипт.Добавить("$d = New-Object System.Windows.Forms.DataObject");
    Если КопироватьФайл Тогда
        Скрипт.Добавить("$f = New-Object System.Collections.Specialized.StringCollection");
        Скрипт.Добавить("[void]$f.Add($p)");
        Скрипт.Добавить("$d.SetFileDropList($f)");
    КонецЕсли;
    Если КопироватьТекст Тогда
        Скрипт.Добавить("$d.SetText([System.IO.File]::ReadAllText($p, [System.Text.Encoding]::UTF8))");
    КонецЕсли;
    Скрипт.Добавить("[System.Windows.Forms.Clipboard]::SetDataObject($d, $true)");

    ПутьСкрипта = КаталогВременныхФайлов() + "Посредник_Буфер.ps1";
    Если НЕ ЗаписатьТекстВФайл(ПутьСкрипта, СтрСоединить(Скрипт, Символы.ВК + Символы.ПС)) Тогда
        Возврат;
    КонецЕсли;

    КодВозврата = 0;
    Попытка
        ЗапуститьПриложение("powershell.exe -NoProfile -STA -ExecutionPolicy Bypass -WindowStyle Hidden -File """
            + ПутьСкрипта + """", , Истина, КодВозврата);
    Исключение
        Сообщить("⚠ Не удалось скопировать результат в буфер: " + ОписаниеОшибки());
        Возврат;
    КонецПопытки;

    Если КодВозврата = 0 Тогда
        Сообщить("Результат скопирован в буфер обмена (" + НРег(Режим) + ") — вставляй в чат через Ctrl+V.");
    Иначе
        Сообщить("⚠ Копирование в буфер завершилось с кодом " + КодВозврата + ". Файл сохранён, приложи его вручную.");
    КонецЕсли;

КонецПроцедуры

// Дата построения кэша — первая строка файла кэша: #ROOT <корень> <дата>.
&НаКлиенте
Функция ДатаПоследнейВыгрузки()

    ПутьКэша = ПутьФайлаКэша();
    ФК = Новый Файл(ПутьКэша);
    Если НЕ ФК.Существует() Тогда
        Возврат "";
    КонецЕсли;

    ПерваяСтрока = "";
    Попытка
        ЧтениеТ = Новый ЧтениеТекста(ПутьКэша, КодировкаТекста.UTF8);
        ПерваяСтрока = ЧтениеТ.ПрочитатьСтроку();
        ЧтениеТ.Закрыть();
    Исключение
        Возврат "";
    КонецПопытки;

    Если ПерваяСтрока = Неопределено Тогда
        Возврат "";
    КонецЕсли;

    Поля = СтрРазделить(ПерваяСтрока, Символы.Таб, Истина);
    Если Поля.Количество() >= 3 И Поля[0] = "#ROOT" Тогда
        Возврат Поля[2];
    КонецЕсли;

    Возврат "";

