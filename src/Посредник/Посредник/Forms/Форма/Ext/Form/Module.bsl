Функция НормализоватьДляСравнения(Знач Текст)

    Текст = НРег(СокрЛП(Текст));
    Убрать = " -_.,:;""'()[]«»";

    Результат = "";
    Для Сч = 1 По СтрДлина(Текст) Цикл
        С = Сред(Текст, Сч, 1);
        Если СтрНайти(Убрать, С) > 0 Тогда
            Продолжить;
        КонецЕсли;
        Если С = "ё" Тогда
            С = "е";
        КонецЕсли;
        Результат = Результат + С;
    КонецЦикла;

    Возврат Результат;

КонецФункции

