&НаКлиенте
Функция СобратьТипДляВывода(ТекБлок)

    КвалСтр = "";
    Если НЕ ПустаяСтрока(ТекБлок.ДлинаСтроки) И ТекБлок.ДлинаСтроки <> "0" Тогда
        КвалСтр = "(" + ТекБлок.ДлинаСтроки;
        Если НРег(ТекБлок.ДопустимаяДлина) = "fixed" Тогда
            КвалСтр = КвалСтр + ", фикс";
        КонецЕсли;
        КвалСтр = КвалСтр + ")";
    КонецЕсли;

    КвалЧис = "";
    Если НЕ ПустаяСтрока(ТекБлок.ЦифрыЧисла) Тогда
        КвалЧис = "(" + ТекБлок.ЦифрыЧисла;
        Если НЕ ПустаяСтрока(ТекБлок.ДробьЧисла) И ТекБлок.ДробьЧисла <> "0" Тогда
            КвалЧис = КвалЧис + "," + ТекБлок.ДробьЧисла;
        КонецЕсли;
        КвалЧис = КвалЧис + ")";
    КонецЕсли;

    КвалДат = "";
    Если НЕ ПустаяСтрока(ТекБлок.ЧастиДаты) Тогда
        ЧД = НРег(ТекБлок.ЧастиДаты);
        Если ЧД = "date" Тогда
            КвалДат = "(дата)";
        ИначеЕсли ЧД = "time" Тогда
            КвалДат = "(время)";
        ИначеЕсли ЧД = "datetime" Тогда
            КвалДат = "(дата и время)";
        КонецЕсли;
    КонецЕсли;

    Если ТекБлок.ТипыЧасти.Количество() = 0 Тогда
        Возврат "";
    КонецЕсли;

    Части = Новый Массив;
    Для Каждого СыройТип Из ТекБлок.ТипыЧасти Цикл
        Имя1С = Тип1С(СыройТип);
        Доп = "";
        Если Имя1С = "Строка" Тогда
            Доп = КвалСтр;
        ИначеЕсли Имя1С = "Число" Тогда
            Доп = КвалЧис;
        ИначеЕсли Имя1С = "Дата" Тогда
            Доп = КвалДат;
        КонецЕсли;
        Части.Добавить(Имя1С + Доп);
    КонецЦикла;

    Возврат СтрСоединить(Части, ", ");

КонецФункции

