&НаКлиенте
Процедура ВыполнитьСхему(Строки, Знач ТипОбъекта, Знач ИмяОбъекта,
    Знач ПутьXML, Знач БазовыйПуть)

    // ── свойства объекта ──
    Свойства = СвойстваОбъектаДляВывода(ПутьXML);
    Если Свойства.Количество() > 0 Тогда
        Строки.Добавить("### Свойства объекта");
        Строки.Добавить("");
        Строки.Добавить("| Свойство | Значение |");
        Строки.Добавить("|---|---|");
        Для Каждого С Из Свойства Цикл
            Строки.Добавить("| " + С.Имя + " | " + ЭкранироватьЯчейку(С.Значение, 300) + " |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

    // ── подписка на событие: источник / событие / обработчик ──
    Если НРег(ТипОбъекта) = "eventsubscriptions" Тогда
        ВывестиПодпискуПодробно(Строки, ПутьXML);
    КонецЕсли;

    // ── состав ──
    Реквизиты = Неопределено;
    Попытка
        Реквизиты = ПрочитатьСхемуОбъекта(ПутьXML, ТипОбъекта, ИмяОбъекта);
    Исключение
        Строки.Добавить("❌ Ошибка парсинга XML: " + ОписаниеОшибки());
        Возврат;
    КонецПопытки;

    Если Реквизиты.Количество() > 0 Тогда

        Строки.Добавить("### Состав (" + Реквизиты.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Реквизит | Тип | Раздел | Синоним |");
        Строки.Добавить("|---|---|---|---|");

        ОпределяемыеТипы = Новый Соответствие;

        Для Каждого Р Из Реквизиты Цикл
            Строки.Добавить("| `" + Р.Путь + "` | " + ЭкранироватьЯчейку(Р.Тип, 200)
                + " | " + ОписаниеРаздела(Р.Раздел)
                + " | " + ЭкранироватьЯчейку(?(СинонимОтличается(Р.Путь, Р.Синоним), Р.Синоним, ""), 120)
                + " |");

            СобратьОпределяемыеТипы(Р.Тип, ОпределяемыеТипы);
        КонецЦикла;

        Строки.Добавить("");

        Если ОпределяемыеТипы.Количество() > 0 Тогда
            Строки.Добавить("### Определяемые типы, встреченные выше ("
                + ОпределяемыеТипы.Количество() + ")");
            Строки.Добавить("");
            Строки.Добавить("| Определяемый тип | Состав | Синоним |");
            Строки.Добавить("|---|---|---|");
            Для Каждого КП Из ОпределяемыеТипы Цикл
                Опис = СоставОпределяемогоТипа(КП.Ключ);
                Строки.Добавить("| `" + КП.Ключ + "` | "
                    + ЭкранироватьЯчейку(?(ПустаяСтрока(Опис.Состав), "—", Опис.Состав), 600)
                    + " | " + ЭкранироватьЯчейку(Опис.Синоним, 120) + " |");
            КонецЦикла;
            Строки.Добавить("");
        КонецЕсли;

    Иначе
        Строки.Добавить("ℹ️ Реквизиты не найдены (объект без явно описанных атрибутов).");
        Строки.Добавить("");
    КонецЕсли;

    // ── предопределённые элементы ──
    Предопределённые = ПрочитатьПредопределенные(БазовыйПуть);
    Если Предопределённые.Количество() > 0 Тогда

        Предел = 200;
        Показано = Мин(Предопределённые.Количество(), Предел);

        Строки.Добавить("### Предопределённые элементы (" + Предопределённые.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Имя | Код | Наименование | Папка | Доп. |");
        Строки.Добавить("|---|---|---|---|---|");
        Для Сч = 0 По Показано - 1 Цикл
            П = Предопределённые[Сч];
            Строки.Добавить("| `" + П.Имя + "` | " + ЭкранироватьЯчейку(П.Код, 40)
                + " | " + ЭкранироватьЯчейку(П.Наименование, 120)
                + " | " + П.Папка
                + " | " + ЭкранироватьЯчейку(П.Доп, 60) + " |");
        КонецЦикла;
        Если Предопределённые.Количество() > Показано Тогда
            Строки.Добавить("");
            Строки.Добавить("> ⚠ Показано " + Показано + " из "
                + Предопределённые.Количество() + " предопределённых элементов.");
        КонецЕсли;
        Строки.Добавить("");

    КонецЕсли;

    // ── общие реквизиты ──
    ОбщиеРекв = ОбщиеРеквизитыОбъекта(ТипОбъекта, ИмяОбъекта);
    Если ОбщиеРекв.Количество() > 0 Тогда
        Строки.Добавить("### Подключённые общие реквизиты (" + ОбщиеРекв.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Общий реквизит | Тип | Использование | Синоним |");
        Строки.Добавить("|---|---|---|---|");
        Для Каждого О Из ОбщиеРекв Цикл
            Строки.Добавить("| `" + О.Имя + "` | " + ЭкранироватьЯчейку(О.Тип, 150)
                + " | " + О.Использование
                + " | " + ЭкранироватьЯчейку(О.Синоним, 120) + " |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

    // ── регистраторы ──
    Регистраторы = РегистраторыРегистра(ТипОбъекта, ИмяОбъекта);
    Если Регистраторы.Количество() > 0 Тогда
        Строки.Добавить("### Регистраторы (" + Регистраторы.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Документ | Запрос |");
        Строки.Добавить("|---|---|");
        Для Каждого Д Из Регистраторы Цикл
            Строки.Добавить("| `Documents." + Д + "` | `FETCH:Documents." + Д + ".object` |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

    // ── формы: готовые запросы ──
    ФФормы = Новый Файл(БазовыйПуть + "\Forms");
    Если ФФормы.Существует() Тогда
        ИменаФорм = Новый Массив;
        Для Каждого ПФ Из НайтиФайлы(БазовыйПуть + "\Forms", "*.xml", Ложь) Цикл
            ИменаФорм.Добавить(ПФ.ИмяБезРасширения);
        КонецЦикла;
        Если ИменаФорм.Количество() > 0 Тогда
            Строки.Добавить("### Формы (" + ИменаФорм.Количество() + ")");
            Строки.Добавить("");
            Строки.Добавить("| Форма | Реквизиты формы | Модуль формы |");
            Строки.Добавить("|---|---|---|");
            Для Каждого ИФ Из ИменаФорм Цикл
                Строки.Добавить("| `" + ИФ + "` | `FORM:" + ТипОбъекта + "." + ИмяОбъекта
                    + "." + ИФ + "` | `FETCH:" + ТипОбъекта + "." + ИмяОбъекта
                    + ".form:" + ИФ + "` |");
            КонецЦикла;
            Строки.Добавить("");
        КонецЕсли;
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВывестиПодпискуПодробно(Строки, Знач ПутьXML)

    Ключи = Новый Соответствие;
    Ключи.Вставить("Source",  Истина);
    Ключи.Вставить("Event",   Истина);
    Ключи.Вставить("Handler", Истина);

    Шапка = ШапкаИзXML(ПутьXML, Ключи);

    Источники  = СписокШапки(Шапка, "Source");
    Обработчик = ЗначениеШапки(Шапка, "Handler");

    Если Источники.Количество() > 0 Тогда
        Строки.Добавить("### Источники подписки (" + Источники.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Тип источника | Объект | Запрос |");
        Строки.Добавить("|---|---|---|");
        Для Каждого ИсточникТип Из Источники Цикл
            Ссылка = СсылкаНаОбъектМетаданных(ОчиститьПрефиксТипа(ИсточникТип));
            Если ПустаяСтрока(Ссылка.Запрос) Тогда
                Строки.Добавить("| " + ЭкранироватьЯчейку(Тип1С(ИсточникТип), 150) + " | — | — |");
            Иначе
                Строки.Добавить("| " + ЭкранироватьЯчейку(Тип1С(ИсточникТип), 150)
                    + " | `" + Ссылка.Папка + "." + Ссылка.Имя + "`"
                    + " | `" + Ссылка.Запрос + "` |");
            КонецЕсли;
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

    Если НЕ ПустаяСтрока(Обработчик) Тогда
        Строки.Добавить("### Обработчик");
        Строки.Добавить("");
        Строки.Добавить(ЗапросКОбработчику(Обработчик));
        Строки.Добавить("");
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ОчиститьПрефиксТипа(Знач СыраяСсылка)

    // "cfg:DocumentObject.АвансовыйОтчет" → "DocumentObject.АвансовыйОтчет"
    ДвоеточиеПоз = СтрНайти(СыраяСсылка, ":");
    Если ДвоеточиеПоз > 0 Тогда
        Возврат Сред(СыраяСсылка, ДвоеточиеПоз + 1);
    КонецЕсли;
    Возврат СыраяСсылка;

КонецФункции

&НаКлиенте
Функция ЗапросКОбработчику(Знач Обработчик)

    // "CommonModule.УчетЗарплаты.ПриПроведении" → готовый PROC:
    Сегм = СтрРазделить(Обработчик, ".", Ложь);
    Если Сегм.Количество() >= 3 И НРег(Сегм[0]) = "commonmodule" Тогда
        Возврат "`" + Обработчик + "` → `PROC:CommonModules." + Сегм[1] + "." + Сегм[2] + "`";
    КонецЕсли;
    Возврат "`" + Обработчик + "`";

КонецФункции

&НаКлиенте
Процедура СобратьОпределяемыеТипы(Знач Текст, Накопитель)

    Маркер  = "ОпределяемыйТип.";
    Остаток = Текст;

    Поз = СтрНайти(Остаток, Маркер);
    Пока Поз > 0 Цикл
        Остаток = Сред(Остаток, Поз + СтрДлина(Маркер));
        ИмяОТ   = ИдентификаторСНачала(Остаток);
        Если НЕ ПустаяСтрока(ИмяОТ) Тогда
            Накопитель.Вставить(ИмяОТ, Истина);
        КонецЕсли;
        Поз = СтрНайти(Остаток, Маркер);
    КонецЦикла;

КонецПроцедуры

// ══════════════════════════════════════════════════════════════
// FORM: реквизиты, команды, параметры и обработчики формы
// ══════════════════════════════════════════════════════════════

&НаКлиенте
Функция ПутьФормыПоЗапросу(Знач Часть)

    Рез = Новый Структура("Путь, Заголовок, ОшибкаТекст, Объект, ИмяФормы, КлючМодуля");
    Рез.Путь        = "";
    Рез.Заголовок   = "";
    Рез.ОшибкаТекст = "";
    Рез.Объект      = "";
    Рез.ИмяФормы    = "";
    Рез.КлючМодуля  = "";

    Сегменты = СтрРазделить(Часть, ".", Ложь);

    Если Сегменты.Количество() = 2 Тогда
        // FORM:CommonForms.ИмяФормы — общая форма, её модуль лежит в Ext\Form
        ТипОб    = Сегменты[0];
        ИмяФормыИзЗапроса = Сегменты[1];
        Рез.Путь       = КореньКаталога + "\" + ТипОб + "\" + ИмяФормыИзЗапроса + "\Ext\Form.xml";
        Рез.Заголовок  = ТипОб + "." + ИмяФормыИзЗапроса;
        Рез.Объект     = ТипОб + "." + ИмяФормыИзЗапроса;
        Рез.ИмяФормы   = ИмяФормыИзЗапроса;
        Рез.КлючМодуля = "form";

    ИначеЕсли Сегменты.Количество() >= 3 Тогда
        ТипОб    = Сегменты[0];
        ИмяОб    = Сегменты[1];
        ИмяФормыИзЗапроса = Сегменты[2];
        Рез.Путь       = КореньКаталога + "\" + ТипОб + "\" + ИмяОб
            + "\Forms\" + ИмяФормыИзЗапроса + "\Ext\Form.xml";
        Рез.Заголовок  = ТипОб + "." + ИмяОб + "." + ИмяФормыИзЗапроса;
        Рез.Объект     = ТипОб + "." + ИмяОб;
        Рез.ИмяФормы   = ИмяФормыИзЗапроса;
        Рез.КлючМодуля = "form:" + ИмяФормыИзЗапроса;

    Иначе
        Рез.ОшибкаТекст = "Ожидается `FORM:Тип.Объект.ИмяФормы` или `FORM:CommonForms.ИмяФормы`.";
    КонецЕсли;

    Возврат Рез;

КонецФункции

&НаКлиенте
Процедура ВыполнитьОписаниеФормы(Строки, Знач ТелоЗапроса)

    Разбор = ПутьФормыПоЗапросу(СокрЛП(ТелоЗапроса));

    Строки.Добавить("---");
    Строки.Добавить("## FORM → **" + СокрЛП(ТелоЗапроса) + "**");
    Строки.Добавить("");

    Если НЕ ПустаяСтрока(Разбор.ОшибкаТекст) Тогда
        Строки.Добавить("❌ " + Разбор.ОшибкаТекст);
        Возврат;
    КонецЕсли;

    ФФ = Новый Файл(Разбор.Путь);
    Если НЕ ФФ.Существует() Тогда
        Строки.Добавить("❌ Не найдено описание формы: `" + Разбор.Путь + "`");
        Возврат;
    КонецЕсли;

    Описание = ПрочитатьОписаниеФормы(Разбор.Путь);

    Строки.Добавить("> Модуль формы: `FETCH:" + Разбор.Объект + "." + Разбор.КлючМодуля + "`");
    Строки.Добавить("> Оглавление модуля: `OUTLINE:" + Разбор.Объект + "." + Разбор.КлючМодуля + "`");
    Строки.Добавить("");

    Если Описание.Реквизиты.Количество() > 0 Тогда
        Строки.Добавить("### Реквизиты формы (" + Описание.Реквизиты.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Реквизит | Тип | Основной | Сохраняемые данные |");
        Строки.Добавить("|---|---|---|---|");
        Для Каждого Р Из Описание.Реквизиты Цикл
            Строки.Добавить("| `" + Р.Имя + "` | " + ЭкранироватьЯчейку(Р.Тип, 200)
                + " | " + ?(Р.Основной, "✅", "")
                + " | " + ?(Р.Сохраняемые, "✅", "") + " |");
        КонецЦикла;
        Строки.Добавить("");
    Иначе
        Строки.Добавить("ℹ️ У формы нет собственных реквизитов.");
        Строки.Добавить("");
    КонецЕсли;

    Если Описание.Параметры.Количество() > 0 Тогда
        Строки.Добавить("### Параметры формы (" + Описание.Параметры.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Параметр | Тип | Ключевой |");
        Строки.Добавить("|---|---|---|");
        Для Каждого П Из Описание.Параметры Цикл
            Строки.Добавить("| `" + П.Имя + "` | " + ЭкранироватьЯчейку(П.Тип, 200)
                + " | " + ?(П.Ключевой, "✅", "") + " |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

    Если Описание.Команды.Количество() > 0 Тогда
        Строки.Добавить("### Команды формы (" + Описание.Команды.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Команда | Действие (процедура) | Заголовок |");
        Строки.Добавить("|---|---|---|");
        Для Каждого К Из Описание.Команды Цикл
            Строки.Добавить("| `" + К.Имя + "` | `" + К.Действие + "` | "
                + ЭкранироватьЯчейку(К.Заголовок, 120) + " |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

    Если Описание.Обработчики.Количество() > 0 Тогда
        Строки.Добавить("### Обработчики событий формы (" + Описание.Обработчики.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Событие | Процедура | Запрос |");
        Строки.Добавить("|---|---|---|");
        Для Каждого О Из Описание.Обработчики Цикл
            // Имя процедуры отделяем "#", иначе PROC примет последний сегмент
            // адреса (имя формы) за имя процедуры.
            ЗапросПроц = "`PROC:" + Разбор.Объект + "." + Разбор.КлючМодуля
                + "#" + О.Процедура + "`";
            Строки.Добавить("| " + О.Событие + " | `" + О.Процедура + "` | " + ЗапросПроц + " |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

    Если Описание.ЭлементыСДанными.Количество() > 0 Тогда
        Строки.Добавить("### Элементы формы, связанные с данными ("
            + Описание.ЭлементыСДанными.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Элемент | Вид | Путь к данным |");
        Строки.Добавить("|---|---|---|");
        Для Каждого Э Из Описание.ЭлементыСДанными Цикл
            Строки.Добавить("| `" + Э.Имя + "` | " + Э.Вид + " | `" + Э.Данные + "` |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПрочитатьОписаниеФормы(Знач ПутьXML)

    Рез = Новый Структура("Реквизиты, Параметры, Команды, Обработчики, ЭлементыСДанными, ЭтоОбщаяФорма");
    Рез.Реквизиты        = Новый Массив;
    Рез.Параметры        = Новый Массив;
    Рез.Команды          = Новый Массив;
    Рез.Обработчики      = Новый Массив;
    Рез.ЭлементыСДанными = Новый Массив;
    Рез.ЭтоОбщаяФорма    = Ложь;

    ВидыЭлементовСДанными = Новый Соответствие;
    ВидыЭлементовСДанными.Вставить("InputField",     "Поле ввода");
    ВидыЭлементовСДанными.Вставить("LabelField",     "Поле надписи");
    ВидыЭлементовСДанными.Вставить("CheckBoxField",  "Флажок");
    ВидыЭлементовСДанными.Вставить("RadioButtonField", "Переключатель");
    ВидыЭлементовСДанными.Вставить("PictureField",   "Поле картинки");
    ВидыЭлементовСДанными.Вставить("TextDocumentField", "Поле текстового документа");
    ВидыЭлементовСДанными.Вставить("SpreadSheetDocumentField", "Поле табличного документа");
    ВидыЭлементовСДанными.Вставить("Table",          "Таблица");
    ВидыЭлементовСДанными.Вставить("HTMLDocumentField", "Поле HTML-документа");

    ЧтениеXML = Новый ЧтениеXML;
    Попытка
        ЧтениеXML.ОткрытьФайл(ПутьXML);
    Исключение
        Возврат Рез;
    КонецПопытки;

    Попытка

        Секция      = "";       // Attributes / Parameters / Commands / Events
        ТекБлок     = Неопределено;
        ТекПоле     = "";
        ВТипе       = Ложь;
        ВЗаголовке  = Ложь;
        ТекЭлемент  = Неопределено;

        Пока ЧтениеXML.Прочитать() Цикл

            Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда

                ЛокИмя = ЧтениеXML.ЛокальноеИмя;

                Если ЛокИмя = "Attributes" ИЛИ ЛокИмя = "Parameters"
                    ИЛИ ЛокИмя = "Commands" ИЛИ ЛокИмя = "Events" Тогда
                    Секция = ЛокИмя;
                    ТекПоле = "";
                    Продолжить;
                КонецЕсли;

                Если ЛокИмя = "Attribute" И Секция = "Attributes" Тогда
                    ТекБлок = Новый Структура("Имя, Тип, Основной, Сохраняемые, ЧастиТипа");
                    ТекБлок.Имя         = ИмяИзАтрибутов(ЧтениеXML);
                    ТекБлок.Тип         = "";
                    ТекБлок.Основной    = Ложь;
                    ТекБлок.Сохраняемые = Ложь;
                    ТекБлок.ЧастиТипа   = Новый Массив;

                ИначеЕсли ЛокИмя = "Parameter" И Секция = "Parameters" Тогда
                    ТекБлок = Новый Структура("Имя, Тип, Ключевой, ЧастиТипа");
                    ТекБлок.Имя       = ИмяИзАтрибутов(ЧтениеXML);
                    ТекБлок.Тип       = "";
                    ТекБлок.Ключевой  = Ложь;
                    ТекБлок.ЧастиТипа = Новый Массив;

                ИначеЕсли ЛокИмя = "Command" И Секция = "Commands" Тогда
                    ТекБлок = Новый Структура("Имя, Действие, Заголовок");
                    ТекБлок.Имя       = ИмяИзАтрибутов(ЧтениеXML);
                    ТекБлок.Действие  = "";
                    ТекБлок.Заголовок = "";

                ИначеЕсли ЛокИмя = "Event" И Секция = "Events" Тогда
                    ИмяСобытия  = ИмяИзАтрибутов(ЧтениеXML);
                    ИмяПроцОбр  = ТекстЭлементаЦеликом(ЧтениеXML);
                    Если НЕ ПустаяСтрока(ИмяПроцОбр) Тогда
                        Рез.Обработчики.Добавить(Новый Структура("Событие, Процедура",
                            ИмяСобытия, ИмяПроцОбр));
                    КонецЕсли;
                    Продолжить;

                ИначеЕсли ВидыЭлементовСДанными.Получить(ЛокИмя) <> Неопределено Тогда
                    ТекЭлемент = Новый Структура("Имя, Вид, Данные");
                    ТекЭлемент.Имя    = ИмяИзАтрибутов(ЧтениеXML);
                    ТекЭлемент.Вид    = ВидыЭлементовСДанными.Получить(ЛокИмя);
                    ТекЭлемент.Данные = "";

                ИначеЕсли ЛокИмя = "DataPath" И ТекЭлемент <> Неопределено Тогда
                    ТекЭлемент.Данные = ТекстЭлементаЦеликом(ЧтениеXML);
                    Если НЕ ПустаяСтрока(ТекЭлемент.Данные) Тогда
                        Рез.ЭлементыСДанными.Добавить(ТекЭлемент);
                    КонецЕсли;
                    ТекЭлемент = Неопределено;
                    Продолжить;

                ИначеЕсли ЛокИмя = "Type" И ТекБлок <> Неопределено Тогда
                    ВТипе = Истина;

                ИначеЕсли ЛокИмя = "Title" И ТекБлок <> Неопределено Тогда
                    ВЗаголовке = Истина;

                КонецЕсли;

                ТекПоле = ЛокИмя;

            ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда

                Знч = СокрЛП(ЧтениеXML.Значение);
                Если ПустаяСтрока(Знч) ИЛИ ТекБлок = Неопределено Тогда
                    Продолжить;
                КонецЕсли;

                Если ВТипе И ТекПоле = "Type" И ТекБлок.Свойство("ЧастиТипа") Тогда
                    ТекБлок.ЧастиТипа.Добавить(Тип1С(Знч));
                ИначеЕсли ВЗаголовке И ТекПоле = "content" И ТекБлок.Свойство("Заголовок") Тогда
                    Если ПустаяСтрока(ТекБлок.Заголовок) Тогда
                        ТекБлок.Заголовок = Знч;
                    КонецЕсли;
                ИначеЕсли ТекПоле = "MainAttribute" Тогда
                    Если ТекБлок.Свойство("Основной") Тогда
                        ТекБлок.Основной = (НРег(Знч) = "true");
                    КонецЕсли;
                ИначеЕсли ТекПоле = "SavedData" Тогда
                    Если ТекБлок.Свойство("Сохраняемые") Тогда
                        ТекБлок.Сохраняемые = (НРег(Знч) = "true");
                    КонецЕсли;
                ИначеЕсли ТекПоле = "KeyParameter" Тогда
                    Если ТекБлок.Свойство("Ключевой") Тогда
                        ТекБлок.Ключевой = (НРег(Знч) = "true");
                    КонецЕсли;
                ИначеЕсли ТекПоле = "Action" Тогда
                    Если ТекБлок.Свойство("Действие") Тогда
                        ТекБлок.Действие = Знч;
                    КонецЕсли;
                КонецЕсли;

            ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда

                ЛокИмя = ЧтениеXML.ЛокальноеИмя;

                Если ЛокИмя = "Type" Тогда
                    ВТипе = Ложь;
                ИначеЕсли ЛокИмя = "Title" Тогда
                    ВЗаголовке = Ложь;
                КонецЕсли;

                Если ЛокИмя = "Attribute" И Секция = "Attributes" И ТекБлок <> Неопределено Тогда
                    ТекБлок.Тип = СтрСоединить(ТекБлок.ЧастиТипа, ", ");
                    Рез.Реквизиты.Добавить(ТекБлок);
                    ТекБлок = Неопределено;

                ИначеЕсли ЛокИмя = "Parameter" И Секция = "Parameters" И ТекБлок <> Неопределено Тогда
                    ТекБлок.Тип = СтрСоединить(ТекБлок.ЧастиТипа, ", ");
                    Рез.Параметры.Добавить(ТекБлок);
                    ТекБлок = Неопределено;

                ИначеЕсли ЛокИмя = "Command" И Секция = "Commands" И ТекБлок <> Неопределено Тогда
                    Рез.Команды.Добавить(ТекБлок);
                    ТекБлок = Неопределено;

                ИначеЕсли ЛокИмя = "Attributes" ИЛИ ЛокИмя = "Parameters"
                    ИЛИ ЛокИмя = "Commands" ИЛИ ЛокИмя = "Events" Тогда
                    Секция = "";
                КонецЕсли;

                ТекПоле = "";

            КонецЕсли;

        КонецЦикла;

    Исключение
    КонецПопытки;

    Попытка
        ЧтениеXML.Закрыть();
    Исключение
    КонецПопытки;

    Возврат Рез;

КонецФункции

&НаКлиенте
Функция ИмяИзАтрибутов(ЧтениеXML)

    Если ЧтениеXML.КоличествоАтрибутов() > 0 Тогда
        Для Сч = 0 По ЧтениеXML.КоличествоАтрибутов() - 1 Цикл
            Если ЧтениеXML.ИмяАтрибута(Сч) = "name" Тогда
                Возврат ЧтениеXML.ЗначениеАтрибута(Сч);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    Возврат "";

КонецФункции

// ══════════════════════════════════════════════════════════════
// EVENTS: подписки на события, где объект — источник
// ══════════════════════════════════════════════════════════════

&НаКлиенте
Процедура ВыполнитьПодпискиОбъекта(Строки, Знач ТелоЗапроса)

    Часть = СокрЛП(ТелоЗапроса);

    Строки.Добавить("---");
    Строки.Добавить("## EVENTS → **" + Часть + "**");
    Строки.Добавить("");

    Сегменты = СтрРазделить(Часть, ".", Ложь);
    Если Сегменты.Количество() < 2 Тогда
        Строки.Добавить("❌ Ожидается `EVENTS:Тип.ИмяОбъекта`, например `EVENTS:Documents.АвансовыйОтчет`.");
        Возврат;
    КонецЕсли;

    ТипОбъекта = Сегменты[0];
    ИмяОбъекта = Сегменты[1];

    Класс = "";
    Для Каждого КП Из ПапкиВКлассыМетаданных() Цикл
        Если НРег(КП.Значение) = НРег(ТипОбъекта) Тогда
            Класс = КП.Ключ;
            Прервать;
        КонецЕсли;
    КонецЦикла;

    Если ПустаяСтрока(Класс) Тогда
        Строки.Добавить("❌ Для типа `" + ТипОбъекта + "` подписки на события невозможны.");
        Возврат;
    КонецЕсли;

    Образец = НРег(ТипОбъекта + "." + ИмяОбъекта);

    Состояние("Поиск подписок на события...");

    Кэш = ПрочитатьКэш();
    Если Кэш <> Неопределено И Кэш.Подписки.Количество() > 0 Тогда
        Подписки = Кэш.Подписки;
        ИзКэша   = Истина;
    Иначе
        Подписки = ВсеПодпискиНаСобытия();
        ИзКэша   = Ложь;
    КонецЕсли;

    Найденные = Новый Массив;
    Для Каждого П Из Подписки Цикл
        Для Каждого ИсточникТип Из П.Источники Цикл
            // "cfg:DocumentObject.АвансовыйОтчет" → папка Documents + имя объекта.
            // Сравниваем разобранную ссылку целиком, а не по вхождению подстроки,
            // иначе Documents.Авансовый нашёлся бы в АвансовыйОтчетДополнительный.
            Ссылка = СсылкаНаОбъектМетаданных(ОчиститьПрефиксТипа(ИсточникТип));
            Если ПустаяСтрока(Ссылка.Папка) Тогда
                Продолжить;
            КонецЕсли;
            Если НРег(Ссылка.Папка + "." + Ссылка.Имя) = Образец Тогда
                Найденные.Добавить(П);
                Прервать;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;

    Строки.Добавить("> Просмотрено подписок: " + ЧислоВСтроку(Подписки.Количество())
        + ?(ИзКэша, " (из кэша)", " (чтение XML — построй кэш кнопкой «Выгрузить объекты в MD»)"));
    Строки.Добавить("");

    Если Найденные.Количество() = 0 Тогда
        Строки.Добавить("Подписок с этим источником не найдено.");
        Возврат;
    КонецЕсли;

    Строки.Добавить("### Подписки, где объект — источник (" + Найденные.Количество() + ")");
    Строки.Добавить("");
    Строки.Добавить("| Подписка | Событие | Обработчик |");
    Строки.Добавить("|---|---|---|");
    Для Каждого П Из Найденные Цикл
        Строки.Добавить("| `" + П.Имя + "` | " + П.Событие
            + " | " + ЗапросКОбработчику(П.Обработчик) + " |");
    КонецЦикла;
    Строки.Добавить("");

КонецПроцедуры

// ══════════════════════════════════════════════════════════════
// SUBSYS: состав подсистемы
// ══════════════════════════════════════════════════════════════

&НаКлиенте
Процедура ВыполнитьСоставПодсистемы(Строки, Знач ТелоЗапроса)

    Часть = СокрЛП(ТелоЗапроса);

    Строки.Добавить("---");
    Строки.Добавить("## SUBSYS → **" + Часть + "**");
    Строки.Добавить("");

    Если ПустаяСтрока(Часть) Тогда
        Строки.Добавить("❌ Ожидается `SUBSYS:ИмяПодсистемы`.");
        Возврат;
    КонецЕсли;

    // Допускаем и "Subsystems.Имя", и просто "Имя", и вложенную "Родитель.Потомок"
    Сегменты = СтрРазделить(Часть, ".", Ложь);
    Если Сегменты.Количество() > 1 И НРег(Сегменты[0]) = "subsystems" Тогда
        Сегменты.Удалить(0);
    КонецЕсли;

    // Вложенные подсистемы лежат в <Родитель>\Subsystems\<Потомок>.xml,
    // поэтому путь собираем по всей цепочке сегментов.
    ПутьБезРасширения = КореньКаталога + "\Subsystems\" + Сегменты[0];
    Для Сч = 1 По Сегменты.Количество() - 1 Цикл
        ПутьБезРасширения = ПутьБезРасширения + "\Subsystems\" + Сегменты[Сч];
    КонецЦикла;
    ПутьXML = ПутьБезРасширения + ".xml";
    ПолноеИмяПодсистемы = СтрСоединить(Сегменты, ".");

    ФX = Новый Файл(ПутьXML);
    Если НЕ ФX.Существует() Тогда
        Строки.Добавить("❌ Подсистема не найдена: `" + ПутьXML + "`");
        Возврат;
    КонецЕсли;

    Ключи = Новый Соответствие;
    Ключи.Вставить("Name",    Истина);
    Ключи.Вставить("Synonym", Истина);
    Ключи.Вставить("Content", Истина);

    Шапка   = ШапкаИзXML(ПутьXML, Ключи);
    Синоним = ЗначениеШапки(Шапка, "Synonym");
    Состав  = СписокШапки(Шапка, "Content");

    Если НЕ ПустаяСтрока(Синоним) Тогда
        Строки.Добавить("> Синоним: " + Синоним);
        Строки.Добавить("");
    КонецЕсли;

    // вложенные подсистемы
    ПутьВложенных = ПутьБезРасширения + "\Subsystems";
    ФВ = Новый Файл(ПутьВложенных);
    Если ФВ.Существует() Тогда
        Вложенные = Новый Массив;
        Для Каждого Э Из НайтиФайлы(ПутьВложенных, "*.xml", Ложь) Цикл
            Вложенные.Добавить(Э.ИмяБезРасширения);
        КонецЦикла;
        Если Вложенные.Количество() > 0 Тогда
            Строки.Добавить("### Вложенные подсистемы (" + Вложенные.Количество() + ")");
            Строки.Добавить("");
            Строки.Добавить("| Подсистема | Запрос |");
            Строки.Добавить("|---|---|");
            Для Каждого В Из Вложенные Цикл
                Строки.Добавить("| `" + В + "` | `SUBSYS:" + ПолноеИмяПодсистемы + "." + В + "` |");
            КонецЦикла;
            Строки.Добавить("");
        КонецЕсли;
    КонецЕсли;

    Если Состав.Количество() = 0 Тогда
        Строки.Добавить("В составе подсистемы нет объектов.");
        Возврат;
    КонецЕсли;

    // группируем по типу
    ПоТипам = Новый Соответствие;
    Порядок = Новый Массив;

    Для Каждого С Из Состав Цикл
        Ссылка = СсылкаНаОбъектМетаданных(ОчиститьПрефиксТипа(С));
        Папка  = ?(ПустаяСтрока(Ссылка.Папка), "Прочее", Ссылка.Папка);
        Список = ПоТипам.Получить(Папка);
        Если Список = Неопределено Тогда
            Список = Новый Массив;
            ПоТипам.Вставить(Папка, Список);
            Порядок.Добавить(Папка);
        КонецЕсли;
        Список.Добавить(Ссылка);
    КонецЦикла;

    Строки.Добавить("### Состав подсистемы (" + Состав.Количество() + ")");
    Строки.Добавить("");

    Для Каждого Папка Из Порядок Цикл
        Список = ПоТипам.Получить(Папка);
        Строки.Добавить("#### " + РусскоеИмяТипа(Папка) + " · `" + Папка
            + "` (" + Список.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Объект | Запрос |");
        Строки.Добавить("|---|---|");
        Для Каждого Ссылка Из Список Цикл
            Если ПустаяСтрока(Ссылка.Запрос) Тогда
                Строки.Добавить("| `" + Ссылка.Исходная + "` | — |");
            Иначе
                Строки.Добавить("| `" + Ссылка.Папка + "." + Ссылка.Имя
                    + "` | `" + Ссылка.Запрос + "` |");
            КонецЕсли;
        КонецЦикла;
        Строки.Добавить("");
    КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОдинЗапрос(Строки, Знач ТипЗапроса, Знач Часть)


    Если ТипЗапроса = "SEARCH" Тогда
        ВыполнитьПоиск(Строки, Часть);
        Возврат;
    КонецЕсли;

    Если ТипЗапроса = "DEPENDENCIES" Тогда
        ВыполнитьАнализЗависимостей(Строки, Часть);
        Возврат;
    КонецЕсли;

    Если ТипЗапроса = "PROC" ИЛИ ТипЗапроса = "REGION" ИЛИ ТипЗапроса = "LINES" Тогда
        ВыполнитьИзвлечениеФрагмента(Строки, ТипЗапроса, Часть);
        Возврат;
    КонецЕсли;

    Если ТипЗапроса = "OUTLINE" Тогда
        ВыполнитьОглавлениеМодуля(Строки, Часть);
        Возврат;
    КонецЕсли;

    Если ТипЗапроса = "FORM" Тогда
        ВыполнитьОписаниеФормы(Строки, Часть);
        Возврат;
    КонецЕсли;

    Если ТипЗапроса = "EVENTS" Тогда
        ВыполнитьПодпискиОбъекта(Строки, Часть);
        Возврат;
    КонецЕсли;

    Если ТипЗапроса = "SUBSYS" Тогда
        ВыполнитьСоставПодсистемы(Строки, Часть);
        Возврат;
    КонецЕсли;

    Сегменты = СтрРазделить(Часть, ".", Ложь);

    // ── модули конфигурации: FETCH:Configuration.ManagedApplication ──
    Если Сегменты.Количество() >= 2 И НРег(Сегменты[0]) = "configuration" Тогда
        ВыполнитьЧтениеМодулейКонфигурации(Строки, Сегменты[1]);
        Возврат;
    КонецЕсли;

    Если Сегменты.Количество() < 2 Тогда
        Строки.Добавить("❌ Неверный формат: `" + Часть + "`");
        Строки.Добавить("Ожидается: `Тип.ИмяОбъекта.модули`");
        Возврат;
    КонецЕсли;

    ТипОбъекта   = Сегменты[0];
    ИмяОбъекта   = Сегменты[1];
    БазовыйПуть  = КореньКаталога + "\" + ТипОбъекта + "\" + ИмяОбъекта;
    ПутьXMLРядом = КореньКаталога + "\" + ТипОбъекта + "\" + ИмяОбъекта + ".xml";

    ФБ    = Новый Файл(БазовыйПуть);
    ФБxml = Новый Файл(ПутьXMLРядом);

    ЕстьПапка = ФБ.Существует() И НЕ ФБ.ЭтоФайл();
    ЕстьXML   = ФБxml.Существует();

    Если НЕ ЕстьПапка И НЕ ЕстьXML Тогда
        Строки.Добавить("❌ Не найден: `" + ТипОбъекта + "." + ИмяОбъекта + "`");
        Строки.Добавить("> Папка: `" + БазовыйПуть + "`");
        Строки.Добавить("> XML:   `" + ПутьXMLРядом + "`");
        Возврат;
    КонецЕсли;

    ТолькоXML = НЕ ЕстьПапка И ЕстьXML;

    ЗаголовокОбъекта = "## " + ТипОбъекта + " → **" + ИмяОбъекта + "**";
    Если ЕстьXML Тогда
        ШапкаОб = ПрочитатьШапкуОбъекта(ПутьXMLРядом);
        Если НЕ ПустаяСтрока(ШапкаОб.Синоним) Тогда
            ЗаголовокОбъекта = ЗаголовокОбъекта + " — " + ШапкаОб.Синоним;
        КонецЕсли;
    КонецЕсли;

    Строки.Добавить("---");
    Строки.Добавить(ЗаголовокОбъекта);
    Строки.Добавить("");

    // ══════════════════════════════════════════
    // FETCH — читаем BSL модули
    // ══════════════════════════════════════════
    Если ТипЗапроса = "FETCH" Тогда

        Если Сегменты.Количество() < 3 Тогда
            Строки.Добавить("❌ Не указаны модули.");
            Строки.Добавить("Пример: `FETCH:Catalogs.Контрагенты.manager`");
            ВывестиДоступныеМодули(Строки, ТипОбъекта, ИмяОбъекта, БазовыйПуть);
            Возврат;
        КонецЕсли;

        Если ТолькоXML Тогда
            Строки.Добавить("ℹ️ У объекта нет модулей (только XML-описание). Используй `SCHEMA:`.");
            Возврат;
        КонецЕсли;

        СписокМодулей = СтрРазделить(Сегменты[2], ",", Ложь);

        ЕстьAll = Ложь;
        Для Каждого М Из СписокМодулей Цикл
            Если НРег(СокрЛП(М)) = "all" Тогда
                ЕстьAll = Истина;
            КонецЕсли;
        КонецЦикла;

        Если ЕстьAll Тогда
            СписокМодулей = ВсеКлючиМодулейОбъекта(БазовыйПуть);
        КонецЕсли;

        НайденоМодулей = 0;

        Для Каждого МодСтр Из СписокМодулей Цикл

            МодТип    = НРег(СокрЛП(МодСтр));
            ПутьФайла = "";
            Метка     = "";

            Если МодТип = "manager" Тогда
                ПутьФайла = БазовыйПуть + "\Ext\ManagerModule.bsl";
                Метка     = "ManagerModule";
            ИначеЕсли МодТип = "object" Тогда
                ПутьФайла = БазовыйПуть + "\Ext\ObjectModule.bsl";
                Метка     = "ObjectModule";
            ИначеЕсли МодТип = "recordset" Тогда
                ПутьФайла = БазовыйПуть + "\Ext\RecordSetModule.bsl";
                Метка     = "RecordSetModule";
            ИначеЕсли МодТип = "module" Тогда
                ПутьФайла = БазовыйПуть + "\Ext\Module.bsl";
                Метка     = "Module";
            ИначеЕсли МодТип = "valuemanager" Тогда
                ПутьФайла = БазовыйПуть + "\Ext\ValueManagerModule.bsl";
                Метка     = "ValueManagerModule";
            ИначеЕсли МодТип = "command" Тогда
                ПутьФайла = БазовыйПуть + "\Ext\CommandModule.bsl";
                Метка     = "CommandModule";
            ИначеЕсли МодТип = "form" Тогда
                ПутьФайла = БазовыйПуть + "\Ext\Form\Module.bsl";
                Метка     = "Form.Module";
            ИначеЕсли СтрНачинаетсяС(МодТип, "form:") Тогда
                ИмяФормыМод = Сред(МодСтр, 6);
                ПутьФайла   = БазовыйПуть + "\Forms\" + ИмяФормыМод + "\Ext\Form\Module.bsl";
                Метка       = "Form." + ИмяФормыМод;
            ИначеЕсли СтрНачинаетсяС(МодТип, "command:") Тогда
                ИмяКоманды = Сред(МодСтр, 9);
                ПутьФайла  = БазовыйПуть + "\Commands\" + ИмяКоманды + "\Ext\CommandModule.bsl";
                Метка      = "Command." + ИмяКоманды;
            ИначеЕсли МодТип = "all" Тогда
                Возврат;
            Иначе
                Строки.Добавить("Неизвестный тип модуля: `" + МодСтр + "`");
                Возврат;
            КонецЕсли;

            Если ПутьФайла = "" Тогда Возврат; КонецЕсли;

            ФМод = Новый Файл(ПутьФайла);
            Если НЕ ФМод.Существует() Тогда
                Возврат;
            КонецЕсли;

            Попытка
                ЧтениеТекста = Новый ЧтениеТекста(ПутьФайла, КодировкаТекста.UTF8);
                КодМодуля    = ЧтениеТекста.Прочитать();
                ЧтениеТекста.Закрыть();
            Исключение
                Строки.Добавить("❌ Ошибка чтения `" + ПутьФайла + "`: " + ОписаниеОшибки());
                Возврат;
            КонецПопытки;

            НайденоМодулей = НайденоМодулей + 1;
            КолСтрок = СтрЧислоСтрок(КодМодуля);
            Строки.Добавить("###  " + Метка + " (" + КолСтрок + " строк)");
            Строки.Добавить("");
            Строки.Добавить("```bsl");
            Строки.Добавить(КодМодуля);
            Строки.Добавить("```");
            Строки.Добавить("");

        КонецЦикла;

        Если НайденоМодулей = 0 Тогда
            Строки.Добавить("ℹ️ Ни один из запрошенных модулей не найден.");
            ВывестиДоступныеМодули(Строки, ТипОбъекта, ИмяОбъекта, БазовыйПуть);
        КонецЕсли;

    // ══════════════════════════════════════════
    // SCHEMA — структура объекта из XML
    // ══════════════════════════════════════════
    ИначеЕсли ТипЗапроса = "SCHEMA" Тогда

        Если НЕ ЕстьXML Тогда
            Строки.Добавить("❌ XML не найден: `" + ПутьXMLРядом + "`");
            Возврат;
        КонецЕсли;

        ВыполнитьСхему(Строки, ТипОбъекта, ИмяОбъекта, ПутьXMLРядом, БазовыйПуть);

    КонецЕсли;

КонецПроцедуры
