&НаКлиенте
Функция ЭтоСимволИдентификатора(Знач С)

    Если С = "_" Тогда
        Возврат Истина;
    КонецЕсли;

    КодС = КодСимвола(С);

    Если КодС >= 48 И КодС <= 57 Тогда
        Возврат Истина;
    КонецЕсли;
    Если (КодС >= 65 И КодС <= 90) ИЛИ (КодС >= 97 И КодС <= 122) Тогда
        Возврат Истина;
    КонецЕсли;
    Если (КодС >= 1040 И КодС <= 1103) ИЛИ КодС = 1025 ИЛИ КодС = 1105 Тогда
        Возврат Истина;
    КонецЕсли;

    Возврат Ложь;

КонецФункции

&НаКлиенте
Функция ИдентификаторСКонца(Знач Текст)

    Поз = СтрДлина(Текст);
    Пока Поз > 0 Цикл
        Если НЕ ЭтоСимволИдентификатора(Сред(Текст, Поз, 1)) Тогда
            Прервать;
        КонецЕсли;
        Поз = Поз - 1;
    КонецЦикла;

    Возврат Сред(Текст, Поз + 1);

КонецФункции

&НаКлиенте
Функция ИдентификаторСНачала(Знач Текст)

    Длина = СтрДлина(Текст);
    Поз   = 1;
    Пока Поз <= Длина Цикл
        Если НЕ ЭтоСимволИдентификатора(Сред(Текст, Поз, 1)) Тогда
            Прервать;
        КонецЕсли;
        Поз = Поз + 1;
    КонецЦикла;

    Возврат Лев(Текст, Поз - 1);

КонецФункции

&НаКлиенте
Функция ОбрезатьКомментарийСтроки(Знач Л)

    Ном = 1;
    Пока Истина Цикл
        Поз = СтрНайти(Л, "//", НаправлениеПоиска.СНачала, 1, Ном);
        Если Поз = 0 Тогда
            Возврат Л;
        КонецЕсли;
        ДоКомментария = Лев(Л, Поз - 1);
        // нечётное число кавычек слева => "//" внутри строкового литерала
        Если СтрЧислоВхождений(ДоКомментария, """") % 2 = 0 Тогда
            Возврат ДоКомментария;
        КонецЕсли;
        Ном = Ном + 1;
    КонецЦикла;

    Возврат Л;

КонецФункции

&НаКлиенте
Функция КодБезКомментариев(Знач Текст)

    Если СтрНайти(Текст, "//") = 0 Тогда
        Возврат Текст;
    КонецЕсли;

    СтрокиКода = СтрРазделить(Текст, Символы.ПС, Истина);
    Очищенные  = Новый Массив;
    Для Каждого Л Из СтрокиКода Цикл
        Очищенные.Добавить(ОбрезатьКомментарийСтроки(Л));
    КонецЦикла;

    Возврат СтрСоединить(Очищенные, Символы.ПС);

