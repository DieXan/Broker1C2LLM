Функция СоставОбщегоРеквизита(Знач ПутьXML)

    Рез = Новый Структура("Синоним, Тип, АвтоИспользование, Элементы");
    Рез.Синоним           = "";
    Рез.Тип               = "";
    Рез.АвтоИспользование = "";
    Рез.Элементы          = Новый Массив;

    ЧтениеXML = Новый ЧтениеXML;
    Попытка
        ЧтениеXML.ОткрытьФайл(ПутьXML);
    Исключение
        Возврат Рез;
    КонецПопытки;

    Попытка

        ВСоставе  = Ложь;
        ТекПоле   = "";
        ТекОбъект = "";
        ТекИсп    = "";
        ВСиноним  = Ложь;
        ВТипе     = Ложь;

        Пока ЧтениеXML.Прочитать() Цикл

            Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда

                ЛокИмя = ЧтениеXML.ЛокальноеИмя;

                Если ЛокИмя = "Content" Тогда
                    ВСоставе = Истина;
                ИначеЕсли ЛокИмя = "Synonym" Тогда
                    ВСиноним = Истина;
                ИначеЕсли ЛокИмя = "Type" И НЕ ВСоставе Тогда
                    ВТипе = Истина;
                ИначеЕсли ЛокИмя = "Item" И ВСоставе Тогда
                    ТекОбъект = "";
                    ТекИсп    = "";
                КонецЕсли;
                ТекПоле = ЛокИмя;

            ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда

                Знч = СокрЛП(ЧтениеXML.Значение);
                Если ПустаяСтрока(Знч) Тогда
                    Продолжить;
                КонецЕсли;

                Если ВСиноним И ТекПоле = "content" И ПустаяСтрока(Рез.Синоним) Тогда
                    Рез.Синоним = Знч;
                ИначеЕсли ВТипе И ТекПоле = "Type" И ПустаяСтрока(Рез.Тип) Тогда
                    Рез.Тип = Тип1С(Знч);
                ИначеЕсли ТекПоле = "AutoUse" Тогда
                    Рез.АвтоИспользование = Знч;
                ИначеЕсли ВСоставе И ТекПоле = "Metadata" Тогда
                    ТекОбъект = Знч;
                ИначеЕсли ВСоставе И ТекПоле = "Use" Тогда
                    ТекИсп = Знч;
                КонецЕсли;

            ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда

                ЛокИмя = ЧтениеXML.ЛокальноеИмя;
                Если ЛокИмя = "Content" Тогда
                    ВСоставе = Ложь;
                ИначеЕсли ЛокИмя = "Synonym" Тогда
                    ВСиноним = Ложь;
                ИначеЕсли ЛокИмя = "Type" И ВТипе Тогда
                    ВТипе = Ложь;
                ИначеЕсли ЛокИмя = "Item" И ВСоставе Тогда
                    Если НЕ ПустаяСтрока(ТекОбъект) Тогда
                        Рез.Элементы.Добавить(Новый Структура("Объект, Использование",
                            ТекОбъект, ТекИсп));
                    КонецЕсли;
                    ТекОбъект = "";
                    ТекИсп    = "";
                КонецЕсли;
                ТекПоле = "";

            КонецЕсли;

        КонецЦикла;

    Исключение
    КонецПопытки;

    Попытка
        ЧтениеXML.Закрыть();
    Исключение
    КонецПопытки;

    Возврат Рез;

КонецФункции

&НаКлиенте
Функция РегистраторыРегистра(Знач ТипОбъекта, Знач ИмяОбъекта)

    Пусто = Новый Массив;

    Класс = "";
    Для Каждого КП Из ПапкиВКлассыМетаданных() Цикл
        Если НРег(КП.Значение) = НРег(ТипОбъекта) Тогда
            Класс = КП.Ключ;
            Прервать;
        КонецЕсли;
    КонецЦикла;

    Если ПустаяСтрока(Класс) Тогда
        Возврат Пусто;
    КонецЕсли;

    ПолноеИмя = НРег(Класс + "." + ИмяОбъекта);

    Кэш = ПрочитатьКэш();
    Если Кэш <> Неопределено И Кэш.Регистраторы.Количество() > 0 Тогда
        Найдено = Кэш.Регистраторы.Получить(ПолноеИмя);
        Возврат ?(Найдено = Неопределено, Пусто, Найдено);
    КонецЕсли;

    Для Каждого Р Из ВсеРегистраторы() Цикл
        Если НРег(Р.Ключ) = ПолноеИмя Тогда
            Возврат Р.Значение;
        КонецЕсли;
    КонецЦикла;

    Возврат Пусто;

КонецФункции

