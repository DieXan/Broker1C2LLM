Функция СоставОпределяемогоТипа(Знач ИмяТипа)

    ПутьXML = КореньКаталога + "\DefinedTypes\" + ИмяТипа + ".xml";

    Ключи = Новый Соответствие;
    Ключи.Вставить("Synonym", Истина);
    Ключи.Вставить("Type",    Истина);

    Шапка = ШапкаИзXML(ПутьXML, Ключи);

    Части = Новый Массив;
    Для Каждого Т Из СписокШапки(Шапка, "Type") Цикл
        Части.Добавить(Тип1С(Т));
    КонецЦикла;

    Рез = Новый Структура("Синоним, Состав");
    Рез.Синоним = ЗначениеШапки(Шапка, "Synonym");
    Рез.Состав  = СтрСоединить(Части, ", ");

    Возврат Рез;

КонецФункции

// Графа журнала: из каких реквизитов документов она берётся.
// «Document.Встреча.Attribute.Автор» → «Встреча.Автор».
&НаКлиенте
Функция ОписаниеГрафыЖурнала(Знач Ссылки)

    Если Ссылки.Количество() = 0 Тогда
        Возврат "Графа";
    КонецЕсли;

    Части = Новый Массив;
    Для Каждого С Из Ссылки Цикл
        Сегм = СтрРазделить(С, ".", Ложь);
        Если Сегм.Количество() >= 4 Тогда
            Части.Добавить(Сегм[1] + "." + Сегм[Сегм.Количество() - 1]);
        Иначе
            Части.Добавить(С);
        КонецЕсли;
    КонецЦикла;

    Возврат "Графа ← " + СтрСоединить(Части, ", ");

КонецФункции

// Флаги общего модуля: где выполняется его код и как вызывается.
// Глобальный — методы вызываются без имени модуля.
&НаКлиенте
Функция СвойстваОбщегоМодуля(Знач ПутьXML)

    Ключи = Новый Соответствие;
    Для Каждого Имя Из СтрРазделить("Global,ClientManagedApplication,ClientOrdinaryApplication,Server,"
        + "ServerCall,ExternalConnection,Privileged,ReturnValuesReuse", ",", Ложь) Цикл
        Ключи.Вставить(Имя, Истина);
    КонецЦикла;

    Шапка = ШапкаИзXML(ПутьXML, Ключи);

    Рез = Новый Структура("Глобальный, Контекст, ПовторноеИспользование", Ложь, "", "");

    Флаги = Новый Массив;
    Флаги.Добавить(Новый Структура("Ключ, Имя", "Server",                    "Сервер"));
    Флаги.Добавить(Новый Структура("Ключ, Имя", "ClientManagedApplication",  "Клиент (управляемое приложение)"));
    Флаги.Добавить(Новый Структура("Ключ, Имя", "ClientOrdinaryApplication", "Клиент (обычное приложение)"));
    Флаги.Добавить(Новый Структура("Ключ, Имя", "ExternalConnection",        "Внешнее соединение"));
    Флаги.Добавить(Новый Структура("Ключ, Имя", "ServerCall",                "Вызов сервера"));
    Флаги.Добавить(Новый Структура("Ключ, Имя", "Privileged",                "Привилегированный"));
    Флаги.Добавить(Новый Структура("Ключ, Имя", "Global",                    "Глобальный"));

    Включены = Новый Массив;
    Для Каждого Ф Из Флаги Цикл
        Если НРег(ЗначениеШапки(Шапка, Ф.Ключ)) = "true" Тогда
            Включены.Добавить(Ф.Имя);
        КонецЕсли;
    КонецЦикла;
    Рез.Контекст   = СтрСоединить(Включены, ", ");
    Рез.Глобальный = (НРег(ЗначениеШапки(Шапка, "Global")) = "true");

    Повт = НРег(ЗначениеШапки(Шапка, "ReturnValuesReuse"));
    Если Повт = "duringrequest" Тогда
        Рез.ПовторноеИспользование = "на время вызова";
    ИначеЕсли Повт = "duringsession" Тогда
        Рез.ПовторноеИспользование = "на время сеанса";
    КонецЕсли;

    Возврат Рез;

КонецФункции

// Таблица объектов метаданных из списочного свойства XML объекта
// (RegisterRecords документа, RegisteredDocuments журнала) с готовым SCHEMA:.
&НаКлиенте
Процедура ВывестиСписокОбъектовИзСвойства(Строки, Знач ПутьXML, Знач КлючСвойства, Знач Заголовок)

    Ключи = Новый Соответствие;
    Ключи.Вставить(КлючСвойства, Истина);
    Шапка  = ШапкаИзXML(ПутьXML, Ключи);
    Список = СписокШапки(Шапка, КлючСвойства);
    Если Список.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    Строки.Добавить("### " + Заголовок + " (" + Список.Количество() + ")");
    Строки.Добавить("");
    Строки.Добавить("| Объект | Запрос |");
    Строки.Добавить("|---|---|");
    Для Каждого Сырой Из Список Цикл
        Ссылка = СсылкаНаОбъектМетаданных(ОчиститьПрефиксТипа(Сырой));
        Если ПустаяСтрока(Ссылка.Запрос) Тогда
            Строки.Добавить("| `" + Сырой + "` | — |");
        Иначе
            Строки.Добавить("| `" + Ссылка.Папка + "." + Ссылка.Имя + "` | `" + Ссылка.Запрос + "` |");
        КонецЕсли;
    КонецЦикла;
    Строки.Добавить("");

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСхему(Строки, Знач ТипОбъекта, Знач ИмяОбъекта,
    Знач ПутьXML, Знач БазовыйПуть)

    // ── свойства объекта ──
    Свойства = СвойстваОбъектаДляВывода(ПутьXML);

    // общий модуль: где выполняется код — для архитектуры важнее синонима
    Если НРег(ТипОбъекта) = "commonmodules" Тогда
        ФлагиМодуля = СвойстваОбщегоМодуля(ПутьXML);
        Свойства.Добавить(Новый Структура("Имя, Значение", "Контекст",
            ?(ПустаяСтрока(ФлагиМодуля.Контекст), "—", ФлагиМодуля.Контекст)));
        Если НЕ ПустаяСтрока(ФлагиМодуля.ПовторноеИспользование) Тогда
            Свойства.Добавить(Новый Структура("Имя, Значение",
                "Повторное использование возвращаемых значений", ФлагиМодуля.ПовторноеИспользование));
        КонецЕсли;
        Если ФлагиМодуля.Глобальный Тогда
            Свойства.Добавить(Новый Структура("Имя, Значение", "Вызов методов",
                "без имени модуля (модуль глобальный)"));
        КонецЕсли;
    КонецЕсли;

    Если Свойства.Количество() > 0 Тогда
        Строки.Добавить("### Свойства объекта");
        Строки.Добавить("");
        Строки.Добавить("| Свойство | Значение |");
        Строки.Добавить("|---|---|");
        Для Каждого С Из Свойства Цикл
            Строки.Добавить("| " + С.Имя + " | " + ЭкранироватьЯчейку(С.Значение, 1500) + " |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

    // ── подписка на событие: источник / событие / обработчик ──
    Если НРег(ТипОбъекта) = "eventsubscriptions" Тогда
        ВывестиПодпискуПодробно(Строки, ПутьXML);
    КонецЕсли;

    // ── состав ──
    Реквизиты = Неопределено;
    Попытка
        Реквизиты = ПрочитатьСхемуОбъекта(ПутьXML, ТипОбъекта, ИмяОбъекта);
    Исключение
        Строки.Добавить("❌ Ошибка парсинга XML: " + ОписаниеОшибки());
        Возврат;
    КонецПопытки;

    Если Реквизиты.Количество() > 0 Тогда

        // колонка «Индекс» — только если у объекта что-то проиндексировано
        // или есть основной отбор, чтобы не раздувать остальные SCHEMA
        ЕстьИндексы = Ложь;
        Для Каждого Р Из Реквизиты Цикл
            Если НЕ ПустаяСтрока(Р.Индекс) Тогда
                ЕстьИндексы = Истина;
                Прервать;
            КонецЕсли;
        КонецЦикла;

        Строки.Добавить("### Состав (" + Реквизиты.Количество() + ")");
        Строки.Добавить("");
        Если ЕстьИндексы Тогда
            Строки.Добавить("> Индекс: ✓ — индексировать, ✓+доп — индексировать с доп. упорядочиванием,"
                + " отбор — основной отбор (MainFilter).");
            Строки.Добавить("");
            Строки.Добавить("| Реквизит | Тип | Раздел | Синоним | Индекс |");
            Строки.Добавить("|---|---|---|---|---|");
        Иначе
            Строки.Добавить("| Реквизит | Тип | Раздел | Синоним |");
            Строки.Добавить("|---|---|---|---|");
        КонецЕсли;

        ОпределяемыеТипы = Новый Соответствие;
        НомерЗначения    = 0;

        Для Каждого Р Из Реквизиты Цикл

            ТипТекст = Р.Тип;
            Если Р.Раздел = "EnumValue" Тогда
                // порядок значений перечисления = порядок в XML
                НомерЗначения = НомерЗначения + 1;
                ТипТекст = "Значение №" + ЧислоВСтроку(НомерЗначения);
            КонецЕсли;

            СтрокаТаблицы = "| `" + Р.Путь + "` | " + ЭкранироватьЯчейку(ТипТекст, 200)
                + " | " + ОписаниеРаздела(Р.Раздел)
                + " | " + ЭкранироватьЯчейку(?(СинонимОтличается(Р.Путь, Р.Синоним), Р.Синоним, ""), 120)
                + " |";
            Если ЕстьИндексы Тогда
                СтрокаТаблицы = СтрокаТаблицы + " " + Р.Индекс + " |";
            КонецЕсли;
            Строки.Добавить(СтрокаТаблицы);

            СобратьОпределяемыеТипы(Р.Тип, ОпределяемыеТипы);
        КонецЦикла;

        Строки.Добавить("");

        Если ОпределяемыеТипы.Количество() > 0 Тогда
            Строки.Добавить("### Определяемые типы, встреченные выше ("
                + ОпределяемыеТипы.Количество() + ")");
            Строки.Добавить("");
            Строки.Добавить("| Определяемый тип | Состав | Синоним |");
            Строки.Добавить("|---|---|---|");
            Для Каждого КП Из ОпределяемыеТипы Цикл
                Опис = СоставОпределяемогоТипа(КП.Ключ);
                Строки.Добавить("| `" + КП.Ключ + "` | "
                    + ЭкранироватьЯчейку(?(ПустаяСтрока(Опис.Состав), "—", Опис.Состав), 600)
                    + " | " + ЭкранироватьЯчейку(Опис.Синоним, 120) + " |");
            КонецЦикла;
            Строки.Добавить("");
        КонецЕсли;

    Иначе
        Строки.Добавить("ℹ️ Реквизитов и вложенных объектов нет — всё описание объекта в «Свойствах объекта» выше.");
        Строки.Добавить("");
    КонецЕсли;

    // ── обработчики HTTP- и веб-сервиса: готовые PROC: ──
    Обработчики = Новый Массив;
    Для Каждого Р Из Реквизиты Цикл
        Если НЕ ПустаяСтрока(Р.Обработчик) Тогда
            Обработчики.Добавить(Р);
        КонецЕсли;
    КонецЦикла;
    Если Обработчики.Количество() > 0 Тогда
        Строки.Добавить("### Обработчики (" + Обработчики.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Метод / операция | Процедура | Запрос |");
        Строки.Добавить("|---|---|---|");
        Для Каждого Р Из Обработчики Цикл
            Строки.Добавить("| `" + Р.Путь + "` | `" + Р.Обработчик + "` | `PROC:"
                + ТипОбъекта + "." + ИмяОбъекта + ".module#" + Р.Обработчик + "` |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

    // ── движения документа и документы журнала ──
    Если НРег(ТипОбъекта) = "documents" Тогда
        ВывестиСписокОбъектовИзСвойства(Строки, ПутьXML, "RegisterRecords", "Движения (регистры документа)");
    ИначеЕсли НРег(ТипОбъекта) = "documentjournals" Тогда
        ВывестиСписокОбъектовИзСвойства(Строки, ПутьXML, "RegisteredDocuments", "Документы журнала");
    КонецЕсли;

    // ── предопределённые элементы ──
    Предопределённые = ПрочитатьПредопределенные(БазовыйПуть);
    Если Предопределённые.Количество() > 0 Тогда

        Предел = 200;
        Показано = Мин(Предопределённые.Количество(), Предел);

        Строки.Добавить("### Предопределённые элементы (" + Предопределённые.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Имя | Код | Наименование | Папка | Доп. |");
        Строки.Добавить("|---|---|---|---|---|");
        Для Сч = 0 По Показано - 1 Цикл
            П = Предопределённые[Сч];
            Строки.Добавить("| `" + П.Имя + "` | " + ЭкранироватьЯчейку(П.Код, 40)
                + " | " + ЭкранироватьЯчейку(П.Наименование, 120)
                + " | " + П.Папка
                + " | " + ЭкранироватьЯчейку(П.Доп, 60) + " |");
        КонецЦикла;
        Если Предопределённые.Количество() > Показано Тогда
            Строки.Добавить("");
            Строки.Добавить("> ⚠ Показано " + Показано + " из "
                + Предопределённые.Количество() + " предопределённых элементов.");
        КонецЕсли;
        Строки.Добавить("");

    КонецЕсли;

    // ── общие реквизиты ──
    ОбщиеРекв = ОбщиеРеквизитыОбъекта(ТипОбъекта, ИмяОбъекта);
    Если ОбщиеРекв.Количество() > 0 Тогда
        Строки.Добавить("### Подключённые общие реквизиты (" + ОбщиеРекв.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Общий реквизит | Тип | Использование | Синоним |");
        Строки.Добавить("|---|---|---|---|");
        Для Каждого О Из ОбщиеРекв Цикл
            Строки.Добавить("| `" + О.Имя + "` | " + ЭкранироватьЯчейку(О.Тип, 150)
                + " | " + О.Использование
                + " | " + ЭкранироватьЯчейку(О.Синоним, 120) + " |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

    // ── регистраторы ──
    Регистраторы = РегистраторыРегистра(ТипОбъекта, ИмяОбъекта);
    Если Регистраторы.Количество() > 0 Тогда
        Строки.Добавить("### Регистраторы (" + Регистраторы.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Документ | Запрос |");
        Строки.Добавить("|---|---|");
        Для Каждого Д Из Регистраторы Цикл
            Строки.Добавить("| `Documents." + Д + "` | `FETCH:Documents." + Д + ".object` |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

    // ── формы: готовые запросы ──
    ФФормы = Новый Файл(БазовыйПуть + "\Forms");
    Если ФФормы.Существует() Тогда
        ИменаФорм = Новый Массив;
        Для Каждого ПФ Из НайтиФайлы(БазовыйПуть + "\Forms", "*.xml", Ложь) Цикл
            ИменаФорм.Добавить(ПФ.ИмяБезРасширения);
        КонецЦикла;
        Если ИменаФорм.Количество() > 0 Тогда
            Строки.Добавить("### Формы (" + ИменаФорм.Количество() + ")");
            Строки.Добавить("");
            Строки.Добавить("| Форма | Реквизиты формы | Модуль формы |");
            Строки.Добавить("|---|---|---|");
            Для Каждого ИФ Из ИменаФорм Цикл
                Строки.Добавить("| `" + ИФ + "` | `FORM:" + ТипОбъекта + "." + ИмяОбъекта
                    + "." + ИФ + "` | `FETCH:" + ТипОбъекта + "." + ИмяОбъекта
                    + ".form:" + ИФ + "` |");
            КонецЦикла;
            Строки.Добавить("");
        КонецЕсли;
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВывестиПодпискуПодробно(Строки, Знач ПутьXML)

    Ключи = Новый Соответствие;
    Ключи.Вставить("Source",  Истина);
    Ключи.Вставить("Event",   Истина);
    Ключи.Вставить("Handler", Истина);

    Шапка = ШапкаИзXML(ПутьXML, Ключи);

    Источники  = СписокШапки(Шапка, "Source");
    Обработчик = ЗначениеШапки(Шапка, "Handler");

    Если Источники.Количество() > 0 Тогда
        Строки.Добавить("### Источники подписки (" + Источники.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Тип источника | Объект | Запрос |");
        Строки.Добавить("|---|---|---|");
        Для Каждого ИсточникТип Из Источники Цикл
            Ссылка = СсылкаНаОбъектМетаданных(ОчиститьПрефиксТипа(ИсточникТип));
            Если ПустаяСтрока(Ссылка.Запрос) Тогда
                Общий = ОписаниеОбщегоИсточника(ОчиститьПрефиксТипа(ИсточникТип));
                Строки.Добавить("| " + ЭкранироватьЯчейку(Тип1С(ИсточникТип), 150)
                    + " | " + Общий.Объект + " | " + Общий.Запрос + " |");
            Иначе
                Строки.Добавить("| " + ЭкранироватьЯчейку(Тип1С(ИсточникТип), 150)
                    + " | `" + Ссылка.Папка + "." + Ссылка.Имя + "`"
                    + " | `" + Ссылка.Запрос + "` |");
            КонецЕсли;
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

    Если НЕ ПустаяСтрока(Обработчик) Тогда
        Строки.Добавить("### Обработчик");
        Строки.Добавить("");
        Строки.Добавить(ЗапросКОбработчику(Обработчик));
        Строки.Добавить("");
    КонецЕсли;

КонецПроцедуры

// Источник подписки без конкретного объекта: «DocumentObject» — все документы,
// «DefinedType.X» — состав определяемого типа. Для таблицы «Источники подписки».
&НаКлиенте
Функция ОписаниеОбщегоИсточника(Знач Сырой)

    Рез = Новый Структура("Объект, Запрос", "—", "—");

    Если СтрНачинаетсяС(НРег(Сырой), "definedtype.") Тогда
        ИмяОТ = Сред(Сырой, 13);
        Рез.Объект = "определяемый тип `" + ИмяОТ + "`";
        Рез.Запрос = "`SCHEMA:DefinedTypes." + ИмяОТ + "`";
        Возврат Рез;
    КонецЕсли;

    Если СтрНайти(Сырой, ".") > 0 Тогда
        Возврат Рез;
    КонецЕсли;

    Класс = Сырой;
    Для Каждого Суффикс Из СуффиксыКлассовМетаданных() Цикл
        Если СтрЗаканчиваетсяНа(НРег(Класс), НРег(Суффикс)) Тогда
            Класс = Лев(Класс, СтрДлина(Класс) - СтрДлина(Суффикс));
            Прервать;
        КонецЕсли;
    КонецЦикла;

    Папка = ПапкаПоКлассуМетаданных(Класс);
    Если НЕ ПустаяСтрока(Папка) Тогда
        Рез.Объект = "все " + РусскоеИмяТипа(Папка) + " (`" + Папка + "`)";
    КонецЕсли;

    Возврат Рез;

КонецФункции

&НаКлиенте
Функция ОчиститьПрефиксТипа(Знач СыраяСсылка)

    // "cfg:DocumentObject.АвансовыйОтчет" → "DocumentObject.АвансовыйОтчет"
    ДвоеточиеПоз = СтрНайти(СыраяСсылка, ":");
    Если ДвоеточиеПоз > 0 Тогда
        Возврат Сред(СыраяСсылка, ДвоеточиеПоз + 1);
    КонецЕсли;
    Возврат СыраяСсылка;

КонецФункции

&НаКлиенте
Функция ЗапросКОбработчику(Знач Обработчик)

    // "CommonModule.УчетЗарплаты.ПриПроведении" → готовый PROC:
    Сегм = СтрРазделить(Обработчик, ".", Ложь);
    Если Сегм.Количество() >= 3 И НРег(Сегм[0]) = "commonmodule" Тогда
        Возврат "`" + Обработчик + "` → `PROC:CommonModules." + Сегм[1] + "." + Сегм[2] + "`";
    КонецЕсли;
    Возврат "`" + Обработчик + "`";

КонецФункции

&НаКлиенте
Процедура СобратьОпределяемыеТипы(Знач Текст, Накопитель)

    Маркер  = "ОпределяемыйТип.";
    Остаток = Текст;

    Поз = СтрНайти(Остаток, Маркер);
    Пока Поз > 0 Цикл
        Остаток = Сред(Остаток, Поз + СтрДлина(Маркер));
        ИмяОТ   = ИдентификаторСНачала(Остаток);
        Если НЕ ПустаяСтрока(ИмяОТ) Тогда
            Накопитель.Вставить(ИмяОТ, Истина);
        КонецЕсли;
        Поз = СтрНайти(Остаток, Маркер);
    КонецЦикла;

КонецПроцедуры

// ══════════════════════════════════════════════════════════════
// FORM: реквизиты, команды, параметры и обработчики формы
// ══════════════════════════════════════════════════════════════

&НаКлиенте
Функция ПутьФормыПоЗапросу(Знач Часть)

    Рез = Новый Структура("Путь, Заголовок, ОшибкаТекст, Объект, ИмяФормы, КлючМодуля");
    Рез.Путь        = "";
    Рез.Заголовок   = "";
    Рез.ОшибкаТекст = "";
    Рез.Объект      = "";
    Рез.ИмяФормы    = "";
    Рез.КлючМодуля  = "";

    Сегменты = СтрРазделить(Часть, ".", Ложь);

    Если Сегменты.Количество() = 2 Тогда
        // FORM:CommonForms.ИмяФормы — общая форма, её модуль лежит в Ext\Form
        ТипОб    = Сегменты[0];
        ИмяФормыИзЗапроса = Сегменты[1];
        Рез.Путь       = КореньКаталога + "\" + ТипОб + "\" + ИмяФормыИзЗапроса + "\Ext\Form.xml";
        Рез.Заголовок  = ТипОб + "." + ИмяФормыИзЗапроса;
        Рез.Объект     = ТипОб + "." + ИмяФормыИзЗапроса;
        Рез.ИмяФормы   = ИмяФормыИзЗапроса;
        Рез.КлючМодуля = "form";

    ИначеЕсли Сегменты.Количество() >= 3 Тогда
        ТипОб    = Сегменты[0];
        ИмяОб    = Сегменты[1];
        ИмяФормыИзЗапроса = Сегменты[2];
        Рез.Путь       = КореньКаталога + "\" + ТипОб + "\" + ИмяОб
            + "\Forms\" + ИмяФормыИзЗапроса + "\Ext\Form.xml";
        Рез.Заголовок  = ТипОб + "." + ИмяОб + "." + ИмяФормыИзЗапроса;
        Рез.Объект     = ТипОб + "." + ИмяОб;
        Рез.ИмяФормы   = ИмяФормыИзЗапроса;
        Рез.КлючМодуля = "form:" + ИмяФормыИзЗапроса;

    Иначе
        Рез.ОшибкаТекст = "Ожидается `FORM:Тип.Объект.ИмяФормы` или `FORM:CommonForms.ИмяФормы`.";
    КонецЕсли;

    Возврат Рез;

КонецФункции

&НаКлиенте
Процедура ВыполнитьОписаниеФормы(Строки, Знач ТелоЗапроса)

    Разбор = ПутьФормыПоЗапросу(СокрЛП(ТелоЗапроса));

    Строки.Добавить("---");
    Строки.Добавить("## FORM → **" + СокрЛП(ТелоЗапроса) + "**");
    Строки.Добавить("");

    Если НЕ ПустаяСтрока(Разбор.ОшибкаТекст) Тогда
        Строки.Добавить("❌ " + Разбор.ОшибкаТекст);
        Возврат;
    КонецЕсли;

    ФФ = Новый Файл(Разбор.Путь);
    Если НЕ ФФ.Существует() Тогда
        Строки.Добавить("❌ Не найдено описание формы: `" + Разбор.Путь + "`");
        Возврат;
    КонецЕсли;

    Описание = ПрочитатьОписаниеФормы(Разбор.Путь);

    Строки.Добавить("> Модуль формы: `FETCH:" + Разбор.Объект + "." + Разбор.КлючМодуля + "`");
    Строки.Добавить("> Оглавление модуля: `OUTLINE:" + Разбор.Объект + "." + Разбор.КлючМодуля + "`");
    Строки.Добавить("");

    Если Описание.Реквизиты.Количество() > 0 Тогда
        ВсегоКолонок = 0;
        Для Каждого Р Из Описание.Реквизиты Цикл
            ВсегоКолонок = ВсегоКолонок + Р.Колонки.Количество();
        КонецЦикла;

        Строки.Добавить("### Реквизиты формы (" + Описание.Реквизиты.Количество()
            + ?(ВсегоКолонок = 0, "", ", колонок таблиц: " + ВсегоКолонок) + ")");
        Строки.Добавить("");
        Если ВсегоКолонок > 0 Тогда
            Строки.Добавить("> Колонки реквизита-таблицы — строками `Реквизит.Колонка` под ним.");
            Строки.Добавить("");
        КонецЕсли;
        Строки.Добавить("| Реквизит | Тип | Основной | Сохраняемые данные |");
        Строки.Добавить("|---|---|---|---|");
        Для Каждого Р Из Описание.Реквизиты Цикл
            Строки.Добавить("| `" + Р.Имя + "` | " + ЭкранироватьЯчейку(Р.Тип, 200)
                + " | " + ?(Р.Основной, "✅", "")
                + " | " + ?(Р.Сохраняемые, "✅", "") + " |");
            Для Каждого К Из Р.Колонки Цикл
                Строки.Добавить("| `" + Р.Имя + "." + К.Имя + "` | " + ЭкранироватьЯчейку(К.Тип, 200)
                    + " |  |  |");
            КонецЦикла;
        КонецЦикла;
        Строки.Добавить("");
    Иначе
        Строки.Добавить("ℹ️ У формы нет собственных реквизитов.");
        Строки.Добавить("");
    КонецЕсли;

    Если Описание.Параметры.Количество() > 0 Тогда
        Строки.Добавить("### Параметры формы (" + Описание.Параметры.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Параметр | Тип | Ключевой |");
        Строки.Добавить("|---|---|---|");
        Для Каждого П Из Описание.Параметры Цикл
            Строки.Добавить("| `" + П.Имя + "` | " + ЭкранироватьЯчейку(П.Тип, 200)
                + " | " + ?(П.Ключевой, "✅", "") + " |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

    Если Описание.Команды.Количество() > 0 Тогда
        Строки.Добавить("### Команды формы (" + Описание.Команды.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Команда | Действие (процедура) | Заголовок |");
        Строки.Добавить("|---|---|---|");
        Для Каждого К Из Описание.Команды Цикл
            Строки.Добавить("| `" + К.Имя + "` | `" + К.Действие + "` | "
                + ЭкранироватьЯчейку(К.Заголовок, 120) + " |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

    Если Описание.Обработчики.Количество() > 0 Тогда
        Строки.Добавить("### Обработчики событий формы (" + Описание.Обработчики.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Событие | Процедура | Запрос |");
        Строки.Добавить("|---|---|---|");
        Для Каждого О Из Описание.Обработчики Цикл
            // Имя процедуры отделяем "#", иначе PROC примет последний сегмент
            // адреса (имя формы) за имя процедуры.
            ЗапросПроц = "`PROC:" + Разбор.Объект + "." + Разбор.КлючМодуля
                + "#" + О.Процедура + "`";
            Строки.Добавить("| " + О.Событие + " | `" + О.Процедура + "` | " + ЗапросПроц + " |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

    Если Описание.ОбработчикиЭлементов.Количество() > 0 Тогда
        Строки.Добавить("### Обработчики событий элементов (" + Описание.ОбработчикиЭлементов.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Элемент | Событие | Процедура | Запрос |");
        Строки.Добавить("|---|---|---|---|");
        Для Каждого О Из Описание.ОбработчикиЭлементов Цикл
            ЗапросПроц = "`PROC:" + Разбор.Объект + "." + Разбор.КлючМодуля
                + "#" + О.Процедура + "`";
            Строки.Добавить("| `" + О.Элемент + "` | " + О.Событие + " | `" + О.Процедура + "` | "
                + ЗапросПроц + " |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

    Если Описание.ЭлементыСДанными.Количество() > 0 Тогда
        Строки.Добавить("### Элементы формы, связанные с данными ("
            + Описание.ЭлементыСДанными.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Элемент | Вид | Путь к данным |");
        Строки.Добавить("|---|---|---|");
        Для Каждого Э Из Описание.ЭлементыСДанными Цикл
            Строки.Добавить("| `" + Э.Имя + "` | " + Э.Вид + " | `" + Э.Данные + "` |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПрочитатьОписаниеФормы(Знач ПутьXML)

    Рез = Новый Структура("Реквизиты, Параметры, Команды, Обработчики, ОбработчикиЭлементов, ЭлементыСДанными, ЭтоОбщаяФорма");
    Рез.Реквизиты            = Новый Массив;
    Рез.Параметры            = Новый Массив;
    Рез.Команды              = Новый Массив;
    Рез.Обработчики          = Новый Массив;
    Рез.ОбработчикиЭлементов = Новый Массив;
    Рез.ЭлементыСДанными     = Новый Массив;
    Рез.ЭтоОбщаяФорма        = Ложь;

    ВидыЭлементовСДанными = Новый Соответствие;
    ВидыЭлементовСДанными.Вставить("InputField",     "Поле ввода");
    ВидыЭлементовСДанными.Вставить("LabelField",     "Поле надписи");
    ВидыЭлементовСДанными.Вставить("CheckBoxField",  "Флажок");
    ВидыЭлементовСДанными.Вставить("RadioButtonField", "Переключатель");
    ВидыЭлементовСДанными.Вставить("PictureField",   "Поле картинки");
    ВидыЭлементовСДанными.Вставить("TextDocumentField", "Поле текстового документа");
    ВидыЭлементовСДанными.Вставить("SpreadSheetDocumentField", "Поле табличного документа");
    ВидыЭлементовСДанными.Вставить("Table",          "Таблица");
    ВидыЭлементовСДанными.Вставить("HTMLDocumentField", "Поле HTML-документа");

    ЧтениеXML = Новый ЧтениеXML;
    Попытка
        ЧтениеXML.ОткрытьФайл(ПутьXML);
    Исключение
        Возврат Рез;
    КонецПопытки;

    Попытка

        Секция      = "";       // Attributes / Parameters / Commands / Events
        ТекБлок     = Неопределено;
        ТекКолонка  = Неопределено; // колонка реквизита-таблицы (ТаблицаЗначений, ДеревоЗначений)
        ТекПоле     = "";
        ГлубинаТипа = 0;        // <Type> составного типа содержит несколько <v8:Type>
        ВЗаголовке  = Ложь;
        ТекЭлемент  = Неопределено;

        // Открытые узлы XML (локальное имя и атрибут name): по ним узнаём,
        // чья секция <Events> — самой формы или элемента (поля, таблицы, кнопки).
        СтекУзлов       = Новый Массив;
        ВладелецСобытий = "";

        Пока ЧтениеXML.Прочитать() Цикл

            Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда

                ЛокИмя = ЧтениеXML.ЛокальноеИмя;
                ИмяАтр = ИмяИзАтрибутов(ЧтениеXML);

                // ── узлы, которые дочитываются целиком (в стек не попадают) ──
                Если ЛокИмя = "Event" И Секция = "Events" Тогда
                    ИмяПроцОбр = ТекстЭлементаЦеликом(ЧтениеXML);
                    Если НЕ ПустаяСтрока(ИмяПроцОбр) Тогда
                        Если ПустаяСтрока(ВладелецСобытий) Тогда
                            Рез.Обработчики.Добавить(Новый Структура("Событие, Процедура",
                                ИмяАтр, ИмяПроцОбр));
                        Иначе
                            Рез.ОбработчикиЭлементов.Добавить(Новый Структура("Элемент, Событие, Процедура",
                                ВладелецСобытий, ИмяАтр, ИмяПроцОбр));
                        КонецЕсли;
                    КонецЕсли;
                    Продолжить;
                КонецЕсли;

                Если ЛокИмя = "DataPath" И ТекЭлемент <> Неопределено Тогда
                    ТекЭлемент.Данные = ТекстЭлементаЦеликом(ЧтениеXML);
                    Если НЕ ПустаяСтрока(ТекЭлемент.Данные) Тогда
                        Рез.ЭлементыСДанными.Добавить(ТекЭлемент);
                    КонецЕсли;
                    ТекЭлемент = Неопределено;
                    Продолжить;
                КонецЕсли;

                // владелец секции событий — узел уровнем выше: у формы имени нет
                Если ЛокИмя = "Events" Тогда
                    ВладелецСобытий = "";
                    Если СтекУзлов.Количество() > 0 Тогда
                        ВладелецСобытий = СтекУзлов[СтекУзлов.Количество() - 1].Имя;
                    КонецЕсли;
                КонецЕсли;

                СтекУзлов.Добавить(Новый Структура("ЛокИмя, Имя", ЛокИмя, ИмяАтр));

                Если ЛокИмя = "Attributes" ИЛИ ЛокИмя = "Parameters"
                    ИЛИ ЛокИмя = "Commands" ИЛИ ЛокИмя = "Events" Тогда
                    Секция = ЛокИмя;
                    ТекПоле = "";
                    Продолжить;
                КонецЕсли;

                Если ЛокИмя = "Attribute" И Секция = "Attributes" Тогда
                    ТекБлок = Новый Структура("Имя, Тип, Основной, Сохраняемые, ЧастиТипа, Колонки");
                    ТекБлок.Имя         = ИмяАтр;
                    ТекБлок.Тип         = "";
                    ТекБлок.Основной    = Ложь;
                    ТекБлок.Сохраняемые = Ложь;
                    ТекБлок.ЧастиТипа   = Новый Массив;
                    ТекБлок.Колонки     = Новый Массив;

                ИначеЕсли ЛокИмя = "Column" И Секция = "Attributes" И ТекБлок <> Неопределено
                    И ТекБлок.Свойство("Колонки") И ТекКолонка = Неопределено Тогда
                    ТекКолонка = Новый Структура("Имя, ЧастиТипа", ИмяАтр, Новый Массив);

                ИначеЕсли ЛокИмя = "Parameter" И Секция = "Parameters" Тогда
                    ТекБлок = Новый Структура("Имя, Тип, Ключевой, ЧастиТипа");
                    ТекБлок.Имя       = ИмяАтр;
                    ТекБлок.Тип       = "";
                    ТекБлок.Ключевой  = Ложь;
                    ТекБлок.ЧастиТипа = Новый Массив;

                ИначеЕсли ЛокИмя = "Command" И Секция = "Commands" Тогда
                    ТекБлок = Новый Структура("Имя, Действие, Заголовок");
                    ТекБлок.Имя       = ИмяАтр;
                    ТекБлок.Действие  = "";
                    ТекБлок.Заголовок = "";

                ИначеЕсли ВидыЭлементовСДанными.Получить(ЛокИмя) <> Неопределено Тогда
                    ТекЭлемент = Новый Структура("Имя, Вид, Данные");
                    ТекЭлемент.Имя    = ИмяАтр;
                    ТекЭлемент.Вид    = ВидыЭлементовСДанными.Получить(ЛокИмя);
                    ТекЭлемент.Данные = "";

                ИначеЕсли ЛокИмя = "Type" И ТекБлок <> Неопределено Тогда
                    ГлубинаТипа = ГлубинаТипа + 1;

                ИначеЕсли ЛокИмя = "Title" И ТекБлок <> Неопределено Тогда
                    ВЗаголовке = Истина;

                КонецЕсли;

                ТекПоле = ЛокИмя;

            ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда

                Знч = СокрЛП(ЧтениеXML.Значение);
                Если ПустаяСтрока(Знч) ИЛИ ТекБлок = Неопределено Тогда
                    Продолжить;
                КонецЕсли;

                Если ГлубинаТипа > 0 И (ТекПоле = "Type" ИЛИ ТекПоле = "TypeSet") Тогда
                    // тип колонки — колонке, а не реквизиту-таблице
                    Если ТекКолонка <> Неопределено Тогда
                        ТекКолонка.ЧастиТипа.Добавить(Тип1С(Знч));
                    ИначеЕсли ТекБлок.Свойство("ЧастиТипа") Тогда
                        ТекБлок.ЧастиТипа.Добавить(Тип1С(Знч));
                    КонецЕсли;
                ИначеЕсли ВЗаголовке И ТекПоле = "content" И ТекБлок.Свойство("Заголовок") Тогда
                    Если ПустаяСтрока(ТекБлок.Заголовок) Тогда
                        ТекБлок.Заголовок = Знч;
                    КонецЕсли;
                ИначеЕсли ТекКолонка <> Неопределено Тогда
                    // прочие свойства колонки реквизиту не принадлежат
                ИначеЕсли ТекПоле = "MainAttribute" Тогда
                    Если ТекБлок.Свойство("Основной") Тогда
                        ТекБлок.Основной = (НРег(Знч) = "true");
                    КонецЕсли;
                ИначеЕсли ТекПоле = "SavedData" Тогда
                    Если ТекБлок.Свойство("Сохраняемые") Тогда
                        ТекБлок.Сохраняемые = (НРег(Знч) = "true");
                    КонецЕсли;
                ИначеЕсли ТекПоле = "KeyParameter" Тогда
                    Если ТекБлок.Свойство("Ключевой") Тогда
                        ТекБлок.Ключевой = (НРег(Знч) = "true");
                    КонецЕсли;
                ИначеЕсли ТекПоле = "Action" Тогда
                    Если ТекБлок.Свойство("Действие") Тогда
                        ТекБлок.Действие = Знч;
                    КонецЕсли;
                КонецЕсли;

            ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда

                ЛокИмя = ЧтениеXML.ЛокальноеИмя;

                // снимаем со стека узел с этим именем (и всё, что выше него)
                ПозУзла = СтекУзлов.Количество() - 1;
                Пока ПозУзла >= 0 И СтекУзлов[ПозУзла].ЛокИмя <> ЛокИмя Цикл
                    ПозУзла = ПозУзла - 1;
                КонецЦикла;
                Если ПозУзла >= 0 Тогда
                    Пока СтекУзлов.Количество() > ПозУзла Цикл
                        СтекУзлов.Удалить(СтекУзлов.Количество() - 1);
                    КонецЦикла;
                КонецЕсли;

                Если ЛокИмя = "Type" Тогда
                    Если ГлубинаТипа > 0 Тогда
                        ГлубинаТипа = ГлубинаТипа - 1;
                    КонецЕсли;
                ИначеЕсли ЛокИмя = "Title" Тогда
                    ВЗаголовке = Ложь;
                КонецЕсли;

                Если ЛокИмя = "Column" И ТекКолонка <> Неопределено Тогда
                    ТекБлок.Колонки.Добавить(Новый Структура("Имя, Тип",
                        ТекКолонка.Имя, СтрСоединить(ТекКолонка.ЧастиТипа, ", ")));
                    ТекКолонка = Неопределено;

                ИначеЕсли ЛокИмя = "Attribute" И Секция = "Attributes" И ТекБлок <> Неопределено Тогда
                    // пустой <Type/> — произвольный тип
                    ТекБлок.Тип = ?(ТекБлок.ЧастиТипа.Количество() = 0, "Произвольный",
                        СтрСоединить(ТекБлок.ЧастиТипа, ", "));
                    Рез.Реквизиты.Добавить(ТекБлок);
                    ТекБлок = Неопределено;
                    ГлубинаТипа = 0;

                ИначеЕсли ЛокИмя = "Parameter" И Секция = "Parameters" И ТекБлок <> Неопределено Тогда
                    ТекБлок.Тип = ?(ТекБлок.ЧастиТипа.Количество() = 0, "Произвольный",
                        СтрСоединить(ТекБлок.ЧастиТипа, ", "));
                    Рез.Параметры.Добавить(ТекБлок);
                    ТекБлок = Неопределено;
                    ГлубинаТипа = 0;

                ИначеЕсли ЛокИмя = "Command" И Секция = "Commands" И ТекБлок <> Неопределено Тогда
                    Рез.Команды.Добавить(ТекБлок);
                    ТекБлок = Неопределено;

                ИначеЕсли ЛокИмя = "Attributes" ИЛИ ЛокИмя = "Parameters"
                    ИЛИ ЛокИмя = "Commands" ИЛИ ЛокИмя = "Events" Тогда
                    Секция = "";
                КонецЕсли;

                ТекПоле = "";

            КонецЕсли;

        КонецЦикла;

    Исключение
    КонецПопытки;

    Попытка
        ЧтениеXML.Закрыть();
    Исключение
    КонецПопытки;

    Возврат Рез;

КонецФункции

&НаКлиенте
Функция ИмяИзАтрибутов(ЧтениеXML)

    Если ЧтениеXML.КоличествоАтрибутов() > 0 Тогда
        Для Сч = 0 По ЧтениеXML.КоличествоАтрибутов() - 1 Цикл
            Если ЧтениеXML.ИмяАтрибута(Сч) = "name" Тогда
                Возврат ЧтениеXML.ЗначениеАтрибута(Сч);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    Возврат "";

КонецФункции

// ══════════════════════════════════════════════════════════════
// EVENTS: подписки на события, где объект — источник
// ══════════════════════════════════════════════════════════════

&НаКлиенте
Процедура ВыполнитьПодпискиОбъекта(Строки, Знач ТелоЗапроса)

    ЧастиЗапроса = СтрРазделить(ТелоЗапроса, "|", Ложь);
    Часть = ?(ЧастиЗапроса.Количество() > 0, СокрЛП(ЧастиЗапроса[0]), "");

    Строки.Добавить("---");
    Строки.Добавить("## EVENTS → **" + Часть + "**");
    Строки.Добавить("");

    Событие = "";
    ПоказатьВсе = Ложь;
    Для Сч = 1 По ЧастиЗапроса.Количество() - 1 Цикл
        Опц = СокрЛП(ЧастиЗапроса[Сч]);
        Если НРег(Опц) = "all" Тогда
            ПоказатьВсе = Истина;
        ИначеЕсли СтрНачинаетсяС(НРег(Опц), "event=") Тогда
            Событие = СобытиеПодпискиПоИмени(Сред(Опц, 7));
            Если ПустаяСтрока(Событие) Тогда
                Строки.Добавить("Неизвестное событие: `" + Сред(Опц, 7) + "` — вывожу все события.");
            КонецЕсли;
        ИначеЕсли НЕ ПустаяСтрока(Опц) Тогда
            Строки.Добавить("Неизвестная опция: `" + Опц + "` — пропущена.");
        КонецЕсли;
    КонецЦикла;

    Сегменты = СтрРазделить(Часть, ".", Ложь);
    Если Сегменты.Количество() < 2 Тогда
        Строки.Добавить("❌ Ожидается `EVENTS:Тип.ИмяОбъекта`, например `EVENTS:Documents.АвансовыйОтчет`.");
        Возврат;
    КонецЕсли;

    ТипОбъекта = Сегменты[0];
    ИмяОбъекта = Сегменты[1];

    Класс = "";
    Для Каждого КП Из ПапкиВКлассыМетаданных() Цикл
        Если НРег(КП.Значение) = НРег(ТипОбъекта) Тогда
            Класс = КП.Ключ;
            Прервать;
        КонецЕсли;
    КонецЦикла;

    Если ПустаяСтрока(Класс) Тогда
        Строки.Добавить("❌ Для типа `" + ТипОбъекта + "` подписки на события невозможны.");
        Возврат;
    КонецЕсли;

    ВывестиТаблицуПодписок(Строки, ТипОбъекта, ИмяОбъекта, Событие, Ложь, ПоказатьВсе);

КонецПроцедуры

// PROC стандартного обработчика не нашёл его в модулях объекта —
// показываем подписки на соответствующее событие.
&НаКлиенте
Процедура ВывестиПодпискиДляОбработчика(Строки, Знач ТипОбъекта, Знач ИмяОбъекта, Знач ИмяОбработчика)

    Событие = СобытиеПодпискиПоИмени(ИмяОбработчика);
    Если ПустаяСтрока(Событие) Тогда
        Возврат;
    КонецЕсли;

    ФX = Новый Файл(КореньКаталога + "\" + ТипОбъекта + "\" + ИмяОбъекта + ".xml");
    Если НЕ ФX.Существует() Тогда
        Возврат;
    КонецЕсли;

    Строки.Добавить("#### Подписки на событие `" + РусскоеИмяСобытия(Событие) + "` для `"
        + ТипОбъекта + "." + ИмяОбъекта + "`");
    Строки.Добавить("");
    Строки.Добавить("> Обработчика в модулях объекта нет — логика события может быть на подписке:");
    Строки.Добавить("");
    ВывестиТаблицуПодписок(Строки, ТипОбъекта, ИмяОбъекта, Событие, Истина, Истина);

КонецПроцедуры

// PROC стандартного обработчика нашёл метод в модуле объекта — но то же
// событие могут обрабатывать и подписки. Одна строка со счётчиком и
// запросом EVENTS, чтобы логика на подписках не потерялась из виду.
&НаКлиенте
Процедура ВывестиПодпискиНаТоЖеСобытие(Строки, Знач ТипОбъекта, Знач ИмяОбъекта,
    Знач КлючМодуля, Знач ИмяМетода)

    КлючНРег = НРег(КлючМодуля);
    Если КлючНРег <> "object" И КлючНРег <> "recordset" И КлючНРег <> "manager"
        И КлючНРег <> "valuemanager" Тогда
        Возврат;
    КонецЕсли;

    Событие = СобытиеПодпискиПоИмени(ИмяМетода);
    Если ПустаяСтрока(Событие) Тогда
        Возврат;
    КонецЕсли;

    ЕстьКласс = Ложь;
    Для Каждого КП Из ПапкиВКлассыМетаданных() Цикл
        Если НРег(КП.Значение) = НРег(ТипОбъекта) Тогда
            ЕстьКласс = Истина;
            Прервать;
        КонецЕсли;
    КонецЦикла;
    Если НЕ ЕстьКласс Тогда
        Возврат;
    КонецЕсли;

    Сведения  = Новый Структура("Просмотрено, ИзКэша", 0, Ложь);
    Найденные = ПодпискиОбъекта(ТипОбъекта, ИмяОбъекта, Событие, Сведения);
    Если Найденные.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    Наши = Новый Массив;
    Для Каждого Н Из Найденные Цикл
        Если ЭтоНашаПодписка(Н.Подписка) Тогда
            Наши.Добавить("`" + Н.Подписка.Имя + "`");
        КонецЕсли;
    КонецЦикла;

    Строки.Добавить("> ⚡ Событие `" + РусскоеИмяСобытия(Событие) + "` обрабатывают ещё подписки: "
        + ЧислоВСтроку(Найденные.Количество())
        + ?(Наши.Количество() = 0, "", ", из них наших " + ЧислоВСтроку(Наши.Количество())
            + ": " + СтрСоединить(Наши, ", "))
        + " — `EVENTS:" + ТипОбъекта + "." + ИмяОбъекта + "|event=" + РусскоеИмяСобытия(Событие) + "`");
    Строки.Добавить("");

КонецПроцедуры

// Наша доработка — имя подписки или общего модуля обработчика начинается
// с префикса разработчика (арс, нм); остальное — типовые подписки.
&НаКлиенте
Функция ЭтоНашаПодписка(Подписка)

    Префиксы = Новый Массив;
    Префиксы.Добавить("арс");
    Префиксы.Добавить("нм");

    Сегм = СтрРазделить(Подписка.Обработчик, ".", Ложь);
    ИмяМодуля = ?(Сегм.Количество() >= 2, НРег(Сегм[1]), "");

    Для Каждого П Из Префиксы Цикл
        Если СтрНачинаетсяС(НРег(Подписка.Имя), П) ИЛИ СтрНачинаетсяС(ИмяМодуля, П) Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;

    Возврат Ложь;

КонецФункции

// Обработчик подписки для таблицы: готовый PROC: без повторения сырого имени.
&НаКлиенте
Функция ЗапросКОбработчикуКратко(Знач Обработчик)

    Сегм = СтрРазделить(Обработчик, ".", Ложь);
    Если Сегм.Количество() >= 3 И НРег(Сегм[0]) = "commonmodule" Тогда
        Возврат "`PROC:CommonModules." + Сегм[1] + "." + Сегм[2] + "`";
    КонецЕсли;
    Возврат "`" + Обработчик + "`";

КонецФункции

// Кратко — без шапки (для вывода под PROC). ПоказатьВсе — не сворачивать
// типовые подписки с общим источником; при отборе по событию их немного,
// поэтому тогда они выводятся всегда.
&НаКлиенте
Процедура ВывестиТаблицуПодписок(Строки, Знач ТипОбъекта, Знач ИмяОбъекта, Знач Событие,
    Знач Кратко, Знач ПоказатьВсе = Ложь)

    Состояние("Поиск подписок на события...");

    Сведения  = Новый Структура("Просмотрено, ИзКэша", 0, Ложь);
    Найденные = ПодпискиОбъекта(ТипОбъекта, ИмяОбъекта, Событие, Сведения);

    Если НЕ Кратко Тогда
        Строки.Добавить("> Просмотрено подписок: " + ЧислоВСтроку(Сведения.Просмотрено)
            + ?(Сведения.ИзКэша, " (из кэша)", " (чтение XML — построй кэш кнопкой «Выгрузить объекты в MD»)"));
        Если НЕ ПустаяСтрока(Событие) Тогда
            Строки.Добавить("> Отбор по событию: " + РусскоеИмяСобытия(Событие));
        КонецЕсли;
        Строки.Добавить("");
    КонецЕсли;

    Если Найденные.Количество() = 0 Тогда
        Строки.Добавить("Подписок с этим источником не найдено"
            + ?(ПустаяСтрока(Событие), "", " на событие " + РусскоеИмяСобытия(Событие))
            + " — ни напрямую, ни через общий источник, ни через определяемый тип.");
        Строки.Добавить("");
        Возврат;
    КонецЕсли;

    // Типовые подписки с общим источником («все документы» БСП и т.п.)
    // есть почти у каждого объекта — без |all сворачиваем их в сводку.
    СворачиватьТиповые = НЕ ПоказатьВсе И ПустаяСтрока(Событие);

    ДляТаблицы = Новый Массив;
    Свернутые  = Новый Массив;
    Для Каждого Н Из Найденные Цикл
        Если СворачиватьТиповые И НЕ ПустаяСтрока(Н.Как) И НЕ ЭтоНашаПодписка(Н.Подписка) Тогда
            Свернутые.Добавить(Н);
        Иначе
            ДляТаблицы.Добавить(Н);
        КонецЕсли;
    КонецЦикла;

    Если НЕ Кратко Тогда
        Строки.Добавить("### Подписки, где объект — источник (" + Найденные.Количество()
            + ?(Свернутые.Количество() = 0, "", ", в таблице — " + ДляТаблицы.Количество()
                + ": прямые и наши (арс, нм)") + ")");
        Строки.Добавить("");
    КонецЕсли;

    Если ДляТаблицы.Количество() > 0 Тогда
        Строки.Добавить("| Подписка | Событие | Обработчик | Источник |");
        Строки.Добавить("|---|---|---|---|");
        Для Каждого Н Из ДляТаблицы Цикл
            П = Н.Подписка;
            Строки.Добавить("| `" + П.Имя + "` | " + РусскоеИмяСобытия(П.Событие)
                + " | " + ЗапросКОбработчикуКратко(П.Обработчик)
                + " | " + ?(ПустаяСтрока(Н.Как), "напрямую", Н.Как) + " |");
        КонецЦикла;
        Строки.Добавить("");
    КонецЕсли;

    Если Свернутые.Количество() > 0 Тогда

        // счётчик по событиям в порядке первого появления
        ПорядокСобытий = Новый Массив;
        СчетчикСобытий = Новый Соответствие;
        Для Каждого Н Из Свернутые Цикл
            ИмяСоб = РусскоеИмяСобытия(Н.Подписка.Событие);
            Если СчетчикСобытий.Получить(ИмяСоб) = Неопределено Тогда
                СчетчикСобытий.Вставить(ИмяСоб, 0);
                ПорядокСобытий.Добавить(ИмяСоб);
            КонецЕсли;
            СчетчикСобытий.Вставить(ИмяСоб, СчетчикСобытий.Получить(ИмяСоб) + 1);
        КонецЦикла;

        Части = Новый Массив;
        Для Каждого ИмяСоб Из ПорядокСобытий Цикл
            Части.Добавить(ИмяСоб + " " + ЧислоВСтроку(СчетчикСобытий.Получить(ИмяСоб)));
        КонецЦикла;

        Строки.Добавить("> Ещё " + ЧислоВСтроку(Свернутые.Количество())
            + " типовых подписок через общий источник (" + СтрСоединить(Части, ", ") + ")."
            + " Все — `EVENTS:" + ТипОбъекта + "." + ИмяОбъекта + "|all`,"
            + " одно событие — `EVENTS:" + ТипОбъекта + "." + ИмяОбъекта + "|event=ИмяСобытия`.");
        Строки.Добавить("");

    КонецЕсли;

КонецПроцедуры

// Подписки, источник которых покрывает объект: напрямую (DocumentObject.X),
// через общий источник (DocumentObject — все документы) или через
// определяемый тип. Прямые — первыми. Элементы: Подписка, Как ("" — напрямую).
&НаКлиенте
Функция ПодпискиОбъекта(Знач ТипОбъекта, Знач ИмяОбъекта, Знач Событие, Сведения)

    Кэш = ПрочитатьКэш();
    Если Кэш <> Неопределено И Кэш.Подписки.Количество() > 0 Тогда
        Подписки = Кэш.Подписки;
        Сведения.ИзКэша = Истина;
    Иначе
        Подписки = ВсеПодпискиНаСобытия();
        Сведения.ИзКэша = Ложь;
    КонецЕсли;
    Сведения.Просмотрено = Подписки.Количество();

    Образец   = НРег(ТипОбъекта + "." + ИмяОбъекта);
    ТипНРег   = НРег(ТипОбъекта);
    СоставыОТ = Новый Соответствие; // определяемый тип → сырые типы, на время вызова

    Прямые = Новый Массив;
    Общие  = Новый Массив;

    Для Каждого П Из Подписки Цикл

        Если НЕ ПустаяСтрока(Событие) И НРег(П.Событие) <> НРег(Событие) Тогда
            Продолжить;
        КонецЕсли;

        Лучший = Неопределено;
        Для Каждого ИсточникТип Из П.Источники Цикл
            Как = КакИсточникПокрываетОбъект(ОчиститьПрефиксТипа(СокрЛП(ИсточникТип)),
                Образец, ТипНРег, СоставыОТ, 0);
            Если Как = Неопределено Тогда
                Продолжить;
            КонецЕсли;
            Если ПустаяСтрока(Как) ИЛИ Лучший = Неопределено Тогда
                Лучший = Как;
            КонецЕсли;
            Если ПустаяСтрока(Как) Тогда
                Прервать;
            КонецЕсли;
        КонецЦикла;

        Если Лучший = Неопределено Тогда
            Продолжить;
        КонецЕсли;

        Эл = Новый Структура("Подписка, Как", П, Лучший);
        Если ПустаяСтрока(Лучший) Тогда
            Прямые.Добавить(Эл);
        Иначе
            Общие.Добавить(Эл);
        КонецЕсли;

    КонецЦикла;

    Для Каждого Эл Из Общие Цикл
        Прямые.Добавить(Эл);
    КонецЦикла;

    Возврат Прямые;

КонецФункции

// "" — источник указывает на сам объект; текст — как именно покрывает
// (общий источник / определяемый тип); Неопределено — не покрывает.
&НаКлиенте
Функция КакИсточникПокрываетОбъект(Знач Сырой, Знач Образец, Знач ТипНРег, СоставыОТ, Знач Глубина)

    Если ПустаяСтрока(Сырой) Тогда
        Возврат Неопределено;
    КонецЕсли;

    // cfg:DefinedType.Имя — раскрываем состав определяемого типа
    Если СтрНачинаетсяС(НРег(Сырой), "definedtype.") Тогда

        Если Глубина > 0 Тогда
            Возврат Неопределено;
        КонецЕсли;

        ИмяОТ  = Сред(Сырой, 13);
        Состав = СоставыОТ.Получить(НРег(ИмяОТ));
        Если Состав = Неопределено Тогда
            Состав = СырыеТипыОпределяемогоТипа(ИмяОТ);
            СоставыОТ.Вставить(НРег(ИмяОТ), Состав);
        КонецЕсли;

        Для Каждого Т Из Состав Цикл
            Как = КакИсточникПокрываетОбъект(ОчиститьПрефиксТипа(СокрЛП(Т)), Образец, ТипНРег, СоставыОТ, 1);
            Если Как <> Неопределено Тогда
                Возврат "через определяемый тип `" + ИмяОТ + "`"
                    + ?(ПустаяСтрока(Как), "", " (" + Как + ")");
            КонецЕсли;
        КонецЦикла;

        Возврат Неопределено;

    КонецЕсли;

    // DocumentObject.Имя — конкретный объект
    Если СтрНайти(Сырой, ".") > 0 Тогда
        Ссылка = СсылкаНаОбъектМетаданных(Сырой);
        Если НЕ ПустаяСтрока(Ссылка.Папка) И НРег(Ссылка.Папка + "." + Ссылка.Имя) = Образец Тогда
            Возврат "";
        КонецЕсли;
        Возврат Неопределено;
    КонецЕсли;

    // DocumentObject без имени — все объекты этого вида
    Класс = Сырой;
    Для Каждого Суффикс Из СуффиксыКлассовМетаданных() Цикл
        Если СтрЗаканчиваетсяНа(НРег(Класс), НРег(Суффикс)) Тогда
            Класс = Лев(Класс, СтрДлина(Класс) - СтрДлина(Суффикс));
            Прервать;
        КонецЕсли;
    КонецЦикла;

    Папка = ПапкаПоКлассуМетаданных(Класс);
    Если НЕ ПустаяСтрока(Папка) И НРег(Папка) = ТипНРег Тогда
        Возврат "через общий источник: все " + РусскоеИмяТипа(Папка);
    КонецЕсли;

    Возврат Неопределено;

КонецФункции

&НаКлиенте
Функция СырыеТипыОпределяемогоТипа(Знач ИмяТипа)

    Ключи = Новый Соответствие;
    Ключи.Вставить("Type", Истина);

    Шапка = ШапкаИзXML(КореньКаталога + "\DefinedTypes\" + ИмяТипа + ".xml", Ключи);
    Возврат СписокШапки(Шапка, "Type");

КонецФункции

// Событие подписки (как в XML) → имя обработчика в модуле объекта.
&НаКлиенте
Функция ИменаСобытийПодписок()

    Соотв = Новый Соответствие;
    Соотв.Вставить("Posting",                         "ОбработкаПроведения");
    Соотв.Вставить("UndoPosting",                     "ОбработкаУдаленияПроведения");
    Соотв.Вставить("BeforeWrite",                     "ПередЗаписью");
    Соотв.Вставить("OnWrite",                         "ПриЗаписи");
    Соотв.Вставить("BeforeDelete",                    "ПередУдалением");
    Соотв.Вставить("Filling",                         "ОбработкаЗаполнения");
    Соотв.Вставить("FillCheckProcessing",             "ОбработкаПроверкиЗаполнения");
    Соотв.Вставить("OnCopy",                          "ПриКопировании");
    Соотв.Вставить("OnSetNewNumber",                  "ПриУстановкеНовогоНомера");
    Соотв.Вставить("OnSetNewCode",                    "ПриУстановкеНовогоКода");
    Соотв.Вставить("FormGetProcessing",               "ОбработкаПолученияФормы");
    Соотв.Вставить("PresentationGetProcessing",       "ОбработкаПолученияПредставления");
    Соотв.Вставить("PresentationFieldsGetProcessing", "ОбработкаПолученияПолейПредставления");
    Соотв.Вставить("ChoiceDataGetProcessing",         "ОбработкаПолученияДанныхВыбора");
    Соотв.Вставить("OnSendDataToSlave",               "ПриОтправкеДанныхПодчиненному");
    Соотв.Вставить("OnSendDataToMaster",              "ПриОтправкеДанныхГлавному");
    Соотв.Вставить("OnReceiveDataFromSlave",          "ПриПолученииДанныхОтПодчиненного");
    Соотв.Вставить("OnReceiveDataFromMaster",         "ПриПолученииДанныхОтГлавного");

    Возврат Соотв;

КонецФункции

&НаКлиенте
Функция РусскоеИмяСобытия(Знач Событие)

    Имя = ИменаСобытийПодписок().Получить(Событие);
    Возврат ?(Имя = Неопределено, Событие, Имя);

КонецФункции

// Имя события по-русски или по-английски → как в XML подписки; "" — не событие.
&НаКлиенте
Функция СобытиеПодпискиПоИмени(Знач Имя)

    ИмяНРег = НРег(СокрЛП(Имя));
    Для Каждого КП Из ИменаСобытийПодписок() Цикл
        Если НРег(КП.Ключ) = ИмяНРег ИЛИ НРег(КП.Значение) = ИмяНРег Тогда
            Возврат КП.Ключ;
        КонецЕсли;
    КонецЦикла;

    Возврат "";

КонецФункции

// ══════════════════════════════════════════════════════════════
// SUBSYS: состав подсистемы
// ══════════════════════════════════════════════════════════════

// Строка вида 9d6ef4fa-3add-458b-9a16-afc7a9b9a85a.
&НаКлиенте
Функция ЭтоUUID(Знач Текст)

    Текст = НРег(СокрЛП(Текст));
    Если СтрДлина(Текст) <> 36 Тогда
        Возврат Ложь;
    КонецЕсли;

    Для Сч = 1 По 36 Цикл
        С = Сред(Текст, Сч, 1);
        Если Сч = 9 ИЛИ Сч = 14 ИЛИ Сч = 19 ИЛИ Сч = 24 Тогда
            Если С <> "-" Тогда
                Возврат Ложь;
            КонецЕсли;
        ИначеЕсли СтрНайти("0123456789abcdef", С) = 0 Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;

    Возврат Истина;

КонецФункции

// Подсистемы с заданным именем на любом уровне вложенности:
// массив структур ПутьXML, ПолноеИмя («Родитель.Потомок»).
&НаКлиенте
Функция ВложенныеПодсистемыПоИмени(Знач Имя)

    Рез = Новый Массив;

    Корень = КореньКаталога;
    Пока СтрЗаканчиваетсяНа(Корень, "\") Цикл
        Корень = Лев(Корень, СтрДлина(Корень) - 1);
    КонецЦикла;
    ПапкаПодсистем = Корень + "\Subsystems";

    ФП = Новый Файл(ПапкаПодсистем);
    Если НЕ ФП.Существует() Тогда
        Возврат Рез;
    КонецЕсли;

    Для Каждого Ф Из НайтиФайлы(ПапкаПодсистем, СокрЛП(Имя) + ".xml", Истина) Цикл
        Если НЕ Ф.ЭтоФайл() Тогда
            Продолжить;
        КонецЕсли;
        // Родитель\Subsystems\Потомок.xml → Родитель.Потомок
        Отн = Сред(Ф.ПолноеИмя, СтрДлина(ПапкаПодсистем) + 2);
        Отн = Лев(Отн, СтрДлина(Отн) - 4);
        Части = Новый Массив;
        Для Каждого С Из СтрРазделить(Отн, "\", Ложь) Цикл
            Если НРег(С) <> "subsystems" Тогда
                Части.Добавить(С);
            КонецЕсли;
        КонецЦикла;
        Рез.Добавить(Новый Структура("ПутьXML, ПолноеИмя", Ф.ПолноеИмя, СтрСоединить(Части, ".")));
    КонецЦикла;

    Возврат Рез;

КонецФункции

&НаКлиенте
Процедура ВыполнитьСоставПодсистемы(Строки, Знач ТелоЗапроса)

    Часть = СокрЛП(ТелоЗапроса);

    Строки.Добавить("---");
    Строки.Добавить("## SUBSYS → **" + Часть + "**");
    Строки.Добавить("");

    Если ПустаяСтрока(Часть) Тогда
        Строки.Добавить("❌ Ожидается `SUBSYS:ИмяПодсистемы`.");
        Возврат;
    КонецЕсли;

    // Допускаем и "Subsystems.Имя", и просто "Имя", и вложенную "Родитель.Потомок"
    Сегменты = СтрРазделить(Часть, ".", Ложь);
    Если Сегменты.Количество() > 1 И НРег(Сегменты[0]) = "subsystems" Тогда
        Сегменты.Удалить(0);
    КонецЕсли;

    // Вложенные подсистемы лежат в <Родитель>\Subsystems\<Потомок>.xml,
    // поэтому путь собираем по всей цепочке сегментов.
    ПутьБезРасширения = КореньКаталога + "\Subsystems\" + Сегменты[0];
    Для Сч = 1 По Сегменты.Количество() - 1 Цикл
        ПутьБезРасширения = ПутьБезРасширения + "\Subsystems\" + Сегменты[Сч];
    КонецЦикла;
    ПутьXML = ПутьБезРасширения + ".xml";
    ПолноеИмяПодсистемы = СтрСоединить(Сегменты, ".");

    ФX = Новый Файл(ПутьXML);
    Если НЕ ФX.Существует() Тогда

        // вложенную подсистему могли назвать без родителя — ищем по всему дереву
        Варианты = ВложенныеПодсистемыПоИмени(Сегменты[Сегменты.Количество() - 1]);

        Если Варианты.Количество() = 0 Тогда
            Строки.Добавить("❌ Подсистема не найдена: `" + ПутьXML + "`");
            Строки.Добавить("> Ни на верхнем уровне, ни среди вложенных подсистем с именем `"
                + Сегменты[Сегменты.Количество() - 1] + "` нет. Имя по синониму — `SEARCH:Текст|syn|in=Subsystems`.");
            Возврат;
        ИначеЕсли Варианты.Количество() > 1 Тогда
            Строки.Добавить("⚠ Подсистем с именем `" + Сегменты[Сегменты.Количество() - 1]
                + "` несколько — выбери нужную:");
            Строки.Добавить("");
            Строки.Добавить("| Подсистема | Запрос |");
            Строки.Добавить("|---|---|");
            Для Каждого В Из Варианты Цикл
                Строки.Добавить("| `" + В.ПолноеИмя + "` | `SUBSYS:" + В.ПолноеИмя + "` |");
            КонецЦикла;
            Строки.Добавить("");
            Возврат;
        КонецЕсли;

        ПутьXML             = Варианты[0].ПутьXML;
        ПутьБезРасширения   = Лев(ПутьXML, СтрДлина(ПутьXML) - 4);
        ПолноеИмяПодсистемы = Варианты[0].ПолноеИмя;
        Строки.Добавить("> Вложенная подсистема: `" + ПолноеИмяПодсистемы + "`");
        Строки.Добавить("");

    КонецЕсли;

    Ключи = Новый Соответствие;
    Ключи.Вставить("Name",    Истина);
    Ключи.Вставить("Synonym", Истина);
    Ключи.Вставить("Content", Истина);

    Шапка   = ШапкаИзXML(ПутьXML, Ключи);
    Синоним = ЗначениеШапки(Шапка, "Synonym");
    Состав  = СписокШапки(Шапка, "Content");

    Если НЕ ПустаяСтрока(Синоним) Тогда
        Строки.Добавить("> Синоним: " + Синоним);
        Строки.Добавить("");
    КонецЕсли;

    // вложенные подсистемы
    ПутьВложенных = ПутьБезРасширения + "\Subsystems";
    ФВ = Новый Файл(ПутьВложенных);
    Если ФВ.Существует() Тогда
        Вложенные = Новый Массив;
        Для Каждого Э Из НайтиФайлы(ПутьВложенных, "*.xml", Ложь) Цикл
            Вложенные.Добавить(Э.ИмяБезРасширения);
        КонецЦикла;
        Если Вложенные.Количество() > 0 Тогда
            Строки.Добавить("### Вложенные подсистемы (" + Вложенные.Количество() + ")");
            Строки.Добавить("");
            Строки.Добавить("| Подсистема | Запрос |");
            Строки.Добавить("|---|---|");
            Для Каждого В Из Вложенные Цикл
                Строки.Добавить("| `" + В + "` | `SUBSYS:" + ПолноеИмяПодсистемы + "." + В + "` |");
            КонецЦикла;
            Строки.Добавить("");
        КонецЕсли;
    КонецЕсли;

    Если Состав.Количество() = 0 Тогда
        Строки.Добавить("В составе подсистемы нет объектов.");
        Возврат;
    КонецЕсли;

    // группируем по типу
    ПоТипам = Новый Соответствие;
    Порядок = Новый Массив;

    Для Каждого С Из Состав Цикл
        Ссылка = СсылкаНаОбъектМетаданных(ОчиститьПрефиксТипа(С));
        Если НЕ ПустаяСтрока(Ссылка.Папка) Тогда
            Папка = Ссылка.Папка;
        ИначеЕсли ЭтоUUID(С) Тогда
            // выгрузка хранит часть состава ссылкой по UUID; если объекта
            // с таким UUID в выгрузке нет — это удалённый объект или объект расширения
            Папка = "#UUID";
        Иначе
            Папка = "Прочее";
        КонецЕсли;
        Список = ПоТипам.Получить(Папка);
        Если Список = Неопределено Тогда
            Список = Новый Массив;
            ПоТипам.Вставить(Папка, Список);
            Порядок.Добавить(Папка);
        КонецЕсли;
        Список.Добавить(Ссылка);
    КонецЦикла;

    Строки.Добавить("### Состав подсистемы (" + Состав.Количество() + ")");
    Строки.Добавить("");

    Для Каждого Папка Из Порядок Цикл
        Список = ПоТипам.Получить(Папка);
        Если Папка = "#UUID" Тогда
            Строки.Добавить("#### Ссылки по UUID (" + Список.Количество() + ")");
            Строки.Добавить("");
            Строки.Добавить("> Выгрузка хранит эти элементы состава не именем, а UUID, и имя объекта"
                + " по ним не определить. Обычно так остаются ссылки на объекты, удалённые из"
                + " конфигурации или живущие в расширении.");
            Строки.Добавить("");
            Строки.Добавить("| UUID | Запрос |");
            Строки.Добавить("|---|---|");
            Для Каждого Ссылка Из Список Цикл
                Строки.Добавить("| `" + Ссылка.Исходная + "` | — |");
            КонецЦикла;
            Строки.Добавить("");
            Продолжить;
        КонецЕсли;
        Строки.Добавить("#### " + РусскоеИмяТипа(Папка) + " · `" + Папка
            + "` (" + Список.Количество() + ")");
        Строки.Добавить("");
        Строки.Добавить("| Объект | Запрос |");
        Строки.Добавить("|---|---|");
        Для Каждого Ссылка Из Список Цикл
            Если ПустаяСтрока(Ссылка.Запрос) Тогда
                Строки.Добавить("| `" + Ссылка.Исходная + "` | — |");
            Иначе
                Строки.Добавить("| `" + Ссылка.Папка + "." + Ссылка.Имя
                    + "` | `" + Ссылка.Запрос + "` |");
            КонецЕсли;
        КонецЦикла;
        Строки.Добавить("");
    КонецЦикла;

КонецПроцедуры

// ══════════════════════════════════════════════════════════════
// CALLERS: кто вызывает метод
// ══════════════════════════════════════════════════════════════

&НаКлиенте
Процедура ВыполнитьПоискВызовов(Строки, Знач ТелоЗапроса)

    ЧастиЗапроса = СтрРазделить(ТелоЗапроса, "|", Ложь);
    Основа = ?(ЧастиЗапроса.Количество() > 0, СокрЛП(ЧастиЗапроса[0]), "");

    Строки.Добавить("---");
    Строки.Добавить("## CALLERS: `" + Основа + "`");
    Строки.Добавить("");

    ФильтрТипов = Новый Соответствие;
    МаксФайлов  = 100;
    ПоказыватьТекст = Истина;
    ОпцииПовтора = Новый Массив;
    ЛимитПопаданий = 10;

    Для Сч = 1 По ЧастиЗапроса.Количество() - 1 Цикл
        Опц     = СокрЛП(ЧастиЗапроса[Сч]);
        ОпцНРег = НРег(Опц);
        Если СтрНачинаетсяС(ОпцНРег, "in=") Тогда
            ДобавитьВФильтрIn(ФильтрТипов, Сред(Опц, 4));
        ИначеЕсли СтрНачинаетсяС(ОпцНРег, "max=") Тогда
            МаксФайлов = ЧислоИзОпции(Сред(Опц, 5), 100, Строки, "max=");
        ИначеЕсли СтрНачинаетсяС(ОпцНРег, "hits=") Тогда
            ЛимитПопаданий = ЧислоИзОпции(Сред(Опц, 6), 10, Строки, "hits=");
        ИначеЕсли ОпцНРег = "noctx" Тогда
            ПоказыватьТекст = Ложь;
            ОпцииПовтора.Добавить(Опц);
        ИначеЕсли НЕ ПустаяСтрока(Опц) Тогда
            Строки.Добавить("Неизвестная опция: `" + Опц + "` — пропущена.");
        КонецЕсли;
    КонецЦикла;

    // ── адрес: Тип.Объект.Метод или Тип.Объект.модуль#Метод ──
    ПозМетки = СтрНайти(Основа, "#");
    Если ПозМетки > 0 Тогда
        АдресТекст = СокрЛП(Лев(Основа, ПозМетки - 1));
        ИмяМетода  = СокрЛП(Сред(Основа, ПозМетки + 1));
    Иначе
        Сегм = СтрРазделить(Основа, ".", Ложь);
        Если Сегм.Количество() < 3 Тогда
            Строки.Добавить("❌ Ожидается `CALLERS:CommonModules.Модуль.Метод` или `CALLERS:Documents.Имя.manager#Метод`.");
            Возврат;
        КонецЕсли;
        ИмяМетода = СокрЛП(Сегм[Сегм.Количество() - 1]);
        Сегм.Удалить(Сегм.Количество() - 1);
        АдресТекст = СтрСоединить(Сегм, ".");
    КонецЕсли;

    Адрес = РазобратьАдресОбъекта(АдресТекст);
    Если НЕ ПустаяСтрока(Адрес.Ошибка) ИЛИ ПустаяСтрока(ИмяМетода) Тогда
        Строки.Добавить("❌ Неверный формат: `" + Основа + "`");
        Возврат;
    КонецЕсли;

    // ── как метод вызывают снаружи ──
    // Общий модуль: Модуль.Метод(. Модуль менеджера: Документы.Имя.Метод(.
    // Модули объекта и форм снаружи так не вызываются — ищем только внутри.
    КлючЦели   = Адрес.КлючМодуля;
    Квалифицированный = "";
    ЭтоГлобальный     = Ложь;

    Если НРег(Адрес.ТипОбъекта) = "commonmodules" Тогда
        Если ПустаяСтрока(КлючЦели) Тогда
            КлючЦели = "module";
        КонецЕсли;
        Квалифицированный = Адрес.ИмяОбъекта + "." + ИмяМетода;
        // методы глобального модуля вызываются без имени модуля
        Флаги = СвойстваОбщегоМодуля(КореньКаталога + "\CommonModules\" + Адрес.ИмяОбъекта + ".xml");
        ЭтоГлобальный = Флаги.Глобальный;
    Иначе
        Если ПустаяСтрока(КлючЦели) Тогда
            КлючЦели = "manager";
        КонецЕсли;
        Если НРег(КлючЦели) = "manager" Тогда
            Для Каждого КП Из КоллекцииМенеджеров() Цикл
                Если НРег(КП.Значение) = НРег(Адрес.ТипОбъекта) Тогда
                    Квалифицированный = КП.Ключ + "." + Адрес.ИмяОбъекта + "." + ИмяМетода;
                    Прервать;
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
    КонецЕсли;

    АдресЦели = ПолноеИмяПоАдресу(Адрес) + "." + КлючЦели;

    Условия = НовыеУсловияПоискаКода(Квалифицированный);
    Условия.РежимВызова        = Истина;
    Условия.ЛокальныйМетодНРег = НРег(ИмяМетода);
    Условия.АдресЦелиНРег      = НРег(АдресЦели);
    Условия.Лимит              = ЛимитПопаданий;
    Условия.ГлобальныйМодуль   = ЭтоГлобальный;
    Если НРег(Адрес.ТипОбъекта) = "commonmodules" Тогда
        Условия.ИмяМодуляНРег = НРег(Адрес.ИмяОбъекта);
    КонецЕсли;

    Итог = НовыйИтогПоискаКода();

    Если ПустаяСтрока(Квалифицированный) Тогда
        // только вызовы внутри своего модуля
        ОписЦели = ОписаниеМодуляПоКлючу(БазовыйПутьПоАдресу(Адрес), КлючЦели);
        Если ПустаяСтрока(ОписЦели.Путь) Тогда
            Строки.Добавить("❌ Неизвестный ключ модуля: `" + КлючЦели + "`");
            Возврат;
        КонецЕсли;
        ПроверитьФайлКода(Условия, ПолноеИмяПоАдресу(Адрес), ОписЦели.Путь,
            ОписЦели.Ключ, ОписЦели.Ключ, МаксФайлов, Итог);
        Строки.Добавить("> Метод модуля `" + КлючЦели + "` снаружи по имени не вызывается —"
            + " ищу вызовы `" + ИмяМетода + "(` и колбэки `""" + ИмяМетода + """`"
            + " (ОписаниеОповещения, ПодключитьОбработчикОжидания) только внутри этого модуля.");
    Иначе
        ПоискПоКоду(Условия, ФильтрТипов, МаксФайлов, Итог);
        Если ЭтоГлобальный Тогда
            Строки.Добавить("> Модуль глобальный — его методы вызывают без имени модуля. Ищу `"
                + ИмяМетода + "(` и `" + Квалифицированный + "(` по всему коду, плюс колбэки `"""
                + ИмяМетода + """` (ПодключитьОбработчикОжидания, ОписаниеОповещения)."
                + " Метод с тем же именем в другом модуле тоже попадёт в список.");
        Иначе
            Строки.Добавить("> Ищу: `" + Квалифицированный + "(` по коду, плюс `" + ИмяМетода
                + "(` и колбэки `""" + ИмяМетода + """` внутри `" + АдресЦели + "`,"
                + " плюс колбэки `""" + ИмяМетода + """` с именем модуля в той же строке.");
        КонецЕсли;
        Строки.Добавить("> Типы объектов: " + ОписаниеОбластиТипов(ФильтрТипов)
            + ". Комментарии не учитываются, строковые литералы — только как колбэк.");
        Строки.Добавить("> Просмотрено файлов кода: " + ЧислоВСтроку(Итог.ПросмотреноФайлов));
    КонецЕсли;

    Если Итог.ДостигнутЛимит Тогда
        Строки.Добавить("> ⚠ Достигнут лимит " + ЧислоВСтроку(МаксФайлов) + " файлов — сузь `in=` или подними `max=`.");
    КонецЕсли;
    Строки.Добавить("");

    Если Итог.Файлы.Количество() = 0 Тогда
        Строки.Добавить("Вызовов не найдено.");
        Строки.Добавить("");
        Возврат;
    КонецЕсли;

    Строки.Добавить("### Вызовы (файлов: " + ЧислоВСтроку(Итог.Файлы.Количество())
        + ", вызовов: " + ЧислоВСтроку(Итог.ВсегоПопаданий) + ")");
    Строки.Добавить("");

    ХвостОпций = ?(ОпцииПовтора.Количество() = 0, "", "|" + СтрСоединить(ОпцииПовтора, "|"));
    ВывестиТаблицуПопаданий(Строки, Итог.Файлы, ПоказыватьТекст,
        "CALLERS:" + Основа + ХвостОпций);

КонецПроцедуры

// ══════════════════════════════════════════════════════════════
// QUERIES: тексты запросов модуля и таблицы, к которым они обращаются
// ══════════════════════════════════════════════════════════════

&НаКлиенте
Процедура ВыполнитьТекстыЗапросов(Строки, Знач ТелоЗапроса)

    ЧастиЗапроса = СтрРазделить(ТелоЗапроса, "|", Ложь);
    Основа = ?(ЧастиЗапроса.Количество() > 0, СокрЛП(ЧастиЗапроса[0]), "");

    Строки.Добавить("---");
    Строки.Добавить("## QUERIES: `" + Основа + "`");
    Строки.Добавить("");

    ПоказыватьТексты = Ложь;
    Для Сч = 1 По ЧастиЗапроса.Количество() - 1 Цикл
        Опц = НРег(СокрЛП(ЧастиЗапроса[Сч]));
        Если Опц = "text" Тогда
            ПоказыватьТексты = Истина;
        ИначеЕсли НЕ ПустаяСтрока(Опц) Тогда
            Строки.Добавить("Неизвестная опция: `" + СокрЛП(ЧастиЗапроса[Сч]) + "` — пропущена.");
        КонецЕсли;
    КонецЦикла;

    ИмяМетода = "";
    ПозМетки = СтрНайти(Основа, "#");
    Если ПозМетки > 0 Тогда
        ИмяМетода = СокрЛП(Сред(Основа, ПозМетки + 1));
        Основа    = СокрЛП(Лев(Основа, ПозМетки - 1));
        ПоказыватьТексты = Истина; // запросы одного метода — сразу с текстами
    КонецЕсли;

    Адрес = РазобратьАдресОбъекта(Основа);
    Если НЕ ПустаяСтрока(Адрес.Ошибка) Тогда
        Строки.Добавить("❌ Неверный формат: `" + Основа + "`");
        Строки.Добавить("Ожидается `QUERIES:Тип.Объект`, `QUERIES:Тип.Объект.модуль` или `QUERIES:Тип.Объект.модуль#Метод`.");
        Возврат;
    КонецЕсли;

    ПолноеИмяОбъекта = ПолноеИмяПоАдресу(Адрес);
    БазовыйПуть      = БазовыйПутьПоАдресу(Адрес);

    Кандидаты = Новый Массив;
    Если НЕ ПустаяСтрока(Адрес.КлючМодуля) Тогда
        Опис = ОписаниеМодуляПоКлючу(БазовыйПуть, Адрес.КлючМодуля);
        ФМод = Новый Файл(Опис.Путь);
        Если ПустаяСтрока(Опис.Путь) ИЛИ НЕ ФМод.Существует() Тогда
            Строки.Добавить("❌ У объекта `" + ПолноеИмяОбъекта + "` нет модуля `" + Адрес.КлючМодуля + "`.");
            ВывестиСписокМодулейОбъекта(Строки, ПолноеИмяОбъекта, МодулиОбъекта(БазовыйПуть), "OUTLINE", "");
            Возврат;
        КонецЕсли;
        Кандидаты.Добавить(Опис);
    Иначе
        Кандидаты = МодулиОбъекта(БазовыйПуть);
    КонецЕсли;

    Если Кандидаты.Количество() = 0 Тогда
        Строки.Добавить("ℹ У объекта `" + ПолноеИмяОбъекта + "` нет модулей с кодом.");
        Возврат;
    КонецЕсли;

    ВсегоЗапросов = 0;

    Для Каждого Опис Из Кандидаты Цикл

        Разбор = РазборФайлаМодуля(Опис.Путь);
        Если Разбор = Неопределено Тогда
            Продолжить;
        КонецЕсли;

        АдресМодуля = ПолноеИмяОбъекта + "." + Опис.Ключ;
        Запросы     = ЗапросыМодуля(Разбор, ИмяМетода);

        Если Запросы.Количество() = 0 Тогда
            Продолжить;
        КонецЕсли;
        ВсегоЗапросов = ВсегоЗапросов + Запросы.Количество();

        Строки.Добавить("### " + Опис.Метка + " — `" + АдресМодуля + "` (запросов: "
            + ЧислоВСтроку(Запросы.Количество()) + ")");
        Строки.Добавить("");

        Если НЕ ПоказыватьТексты Тогда

            Строки.Добавить("| Строки | Метод | Таблицы | Запрос |");
            Строки.Добавить("|---|---|---|---|");
            Для Каждого З Из Запросы Цикл
                Строки.Добавить("| " + ЧислоВСтроку(З.Начало) + "-" + ЧислоВСтроку(З.Конец)
                    + " | " + ?(ПустаяСтрока(З.Метод), "—", "`" + З.Метод + "`")
                    + " | " + ЭкранироватьЯчейку(СтрСоединить(З.Таблицы, ", "), 300)
                    + " | `LINES:" + АдресМодуля + ":" + ЧислоВСтроку(З.Начало) + "-" + ЧислоВСтроку(З.Конец) + "` |");
            КонецЦикла;
            Строки.Добавить("");
            Строки.Добавить("> Тексты запросов одного метода: `QUERIES:" + АдресМодуля + "#Метод`,"
                + " всех сразу — опция `|text`.");
            Строки.Добавить("");

        Иначе

            Номер = 0;
            Для Каждого З Из Запросы Цикл
                Номер = Номер + 1;
                Строки.Добавить("#### " + ЧислоВСтроку(Номер) + ". "
                    + ?(ПустаяСтрока(З.Метод), "вне методов", "`" + З.Метод + "`")
                    + " · строки " + ЧислоВСтроку(З.Начало) + "-" + ЧислоВСтроку(З.Конец));
                Строки.Добавить("> Таблицы: " + ?(З.Таблицы.Количество() = 0, "—",
                    СтрСоединить(З.Таблицы, ", ")));

                Покрытие = ПокрывающаяВыдача(АдресМодуля, З.Начало, З.Конец);
                Если Покрытие <> Неопределено Тогда
                    Строки.Добавить("> ↑ Текст уже выдан выше в этом файле: " + Покрытие.Описание + ".");
                    Строки.Добавить("");
                    Продолжить;
                КонецЕсли;

                Строки.Добавить("");
                Строки.Добавить("```bsl");
                Строки.Добавить(ФрагментМодуля(Разбор.Строки, З.Начало, З.Конец));
                Строки.Добавить("```");
                Строки.Добавить("");
                ЗарегистрироватьВыдачу(АдресМодуля, З.Начало, З.Конец, "QUERIES");
            КонецЦикла;

        КонецЕсли;

    КонецЦикла;

    Если ВсегоЗапросов = 0 Тогда
        Строки.Добавить("Текстов запросов не найдено"
            + ?(ПустаяСтрока(ИмяМетода), "", " в методе `" + ИмяМетода + "`") + ".");
        Строки.Добавить("");
    КонецЕсли;

КонецПроцедуры

// Литералы с текстом запроса: массив структур Начало, Конец, Метод, Таблицы.
// ИмяМетода — отбор по методу ("" — весь модуль).
&НаКлиенте
Функция ЗапросыМодуля(Разбор, Знач ИмяМетода)

    Результат = Новый Массив;
    СтрокиМод = Разбор.Строки;
    Состояния = СостоянияЛитералов(СтрокиМод);
    Всего     = СтрокиМод.Количество();

    Сч = 0;
    Пока Сч < Всего Цикл

        Л = СтрокиМод[Сч];

        // литерал открывается в этой строке (не продолжение предыдущего)
        Если Состояния.НаНачале[Сч] ИЛИ СтрНайти(Л, """") = 0 Тогда
            Сч = Сч + 1;
            Продолжить;
        КонецЕсли;

        Кон = Сч;
        Пока Кон < Всего - 1 И Состояния.НаКонце[Кон] Цикл
            Кон = Кон + 1;
        КонецЦикла;

        ТекстБлока = ФрагментМодуля(СтрокиМод, Сч + 1, Кон + 1);
        Если ЭтоТекстЗапроса(НРег(ТекстБлока)) Тогда

            Метод = МетодПоСтроке(Разбор, Сч + 1);
            ИмяНайденного = ?(Метод = Неопределено, "", Метод.Имя);

            Если ПустаяСтрока(ИмяМетода) ИЛИ НРег(ИмяНайденного) = НРег(ИмяМетода) Тогда
                Результат.Добавить(Новый Структура("Начало, Конец, Метод, Таблицы",
                    Сч + 1, Кон + 1, ИмяНайденного, ТаблицыЗапроса(ТекстБлока)));
            КонецЕсли;

        КонецЕсли;

        Сч = Кон + 1;

    КонецЦикла;

    Возврат Результат;

КонецФункции

// Таблицы после ИЗ / СОЕДИНЕНИЕ (FROM / JOIN) с точкой в имени:
// РегистрСведений.X, Документ.Y.Товары, РегистрНакопления.Z.Остатки.
// Временные таблицы (без точки) и параметры (&) не попадают.
&НаКлиенте
Функция ТаблицыЗапроса(Знач Текст)

    Таблицы = Новый Массив;
    Видеть  = Новый Соответствие;

    Для Каждого Разделитель Из СтрРазделить("|,(,),;,""", ",", Ложь) Цикл
        Текст = СтрЗаменить(Текст, Разделитель, " ");
    КонецЦикла;
    Текст = СтрЗаменить(Текст, ",", " ");
    Текст = СтрЗаменить(Текст, Символы.Таб, " ");
    Текст = СтрЗаменить(Текст, Символы.ВК, " ");
    Текст = СтрЗаменить(Текст, Символы.ПС, " ");

    Слова = СтрРазделить(Текст, " ", Ложь);
    Для Сч = 0 По Слова.Количество() - 2 Цикл
        Слово = НРег(Слова[Сч]);
        Если Слово <> "из" И Слово <> "from" И Слово <> "соединение" И Слово <> "join" Тогда
            Продолжить;
        КонецЕсли;
        Кандидат = Слова[Сч + 1];
        Если СтрНайти(Кандидат, ".") = 0 ИЛИ СтрНачинаетсяС(Кандидат, "&") Тогда
            Продолжить;
        КонецЕсли;
        Если Видеть.Получить(НРег(Кандидат)) = Неопределено Тогда
            Видеть.Вставить(НРег(Кандидат), Истина);
            Таблицы.Добавить(Кандидат);
        КонецЕсли;
    КонецЦикла;

    Возврат Таблицы;

КонецФункции

&НаКлиенте
Процедура ВыполнитьОдинЗапрос(Строки, Знач ТипЗапроса, Знач Часть)


    Если ТипЗапроса = "SEARCH" Тогда
        ВыполнитьПоиск(Строки, Часть);
        Возврат;
    КонецЕсли;

    Если ТипЗапроса = "DEPENDENCIES" Тогда
        ВыполнитьАнализЗависимостей(Строки, Часть);
        Возврат;
    КонецЕсли;

    Если ТипЗапроса = "PROC" ИЛИ ТипЗапроса = "REGION" ИЛИ ТипЗапроса = "LINES" Тогда
        ВыполнитьИзвлечениеФрагмента(Строки, ТипЗапроса, Часть);
        Возврат;
    КонецЕсли;

    Если ТипЗапроса = "OUTLINE" Тогда
        ВыполнитьОглавлениеМодуля(Строки, Часть);
        Возврат;
    КонецЕсли;

    Если ТипЗапроса = "FORM" Тогда
        ВыполнитьОписаниеФормы(Строки, Часть);
        Возврат;
    КонецЕсли;

    Если ТипЗапроса = "EVENTS" Тогда
        ВыполнитьПодпискиОбъекта(Строки, Часть);
        Возврат;
    КонецЕсли;

    Если ТипЗапроса = "SUBSYS" Тогда
        ВыполнитьСоставПодсистемы(Строки, Часть);
        Возврат;
    КонецЕсли;

    Если ТипЗапроса = "CALLERS" Тогда
        ВыполнитьПоискВызовов(Строки, Часть);
        Возврат;
    КонецЕсли;

    Если ТипЗапроса = "QUERIES" Тогда
        ВыполнитьТекстыЗапросов(Строки, Часть);
        Возврат;
    КонецЕсли;

    // опции FETCH / SCHEMA: пока только |full (FETCH крупного модуля целиком)
    // сообщения об опциях выводятся после заголовка блока, а не перед ним
    ПолныйТекст = Ложь;
    НеизвестныеОпции = Новый Массив;
    ЧастиОпций  = СтрРазделить(Часть, "|", Ложь);
    Если ЧастиОпций.Количество() > 1 Тогда
        Часть = СокрЛП(ЧастиОпций[0]);
        Для Сч = 1 По ЧастиОпций.Количество() - 1 Цикл
            Если НРег(СокрЛП(ЧастиОпций[Сч])) = "full" Тогда
                ПолныйТекст = Истина;
            Иначе
                НеизвестныеОпции.Добавить("Неизвестная опция: `" + СокрЛП(ЧастиОпций[Сч]) + "` — пропущена.");
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    Сегменты = СтрРазделить(Часть, ".", Ложь);

    // ── модули конфигурации: FETCH:Configuration.ManagedApplication ──
    Если Сегменты.Количество() >= 2 И НРег(Сегменты[0]) = "configuration" Тогда
        ВыполнитьЧтениеМодулейКонфигурации(Строки, Сегменты[1], НеизвестныеОпции);
        Возврат;
    КонецЕсли;

    Если Сегменты.Количество() < 2 Тогда
        Строки.Добавить("❌ Неверный формат: `" + Часть + "`");
        Строки.Добавить("Ожидается: `Тип.ИмяОбъекта.модули`");
        Для Каждого Сообщ Из НеизвестныеОпции Цикл
            Строки.Добавить("");
            Строки.Добавить(Сообщ);
        КонецЦикла;
        Возврат;
    КонецЕсли;

    ТипОбъекта   = Сегменты[0];
    ИмяОбъекта   = Сегменты[1];
    БазовыйПуть  = КореньКаталога + "\" + ТипОбъекта + "\" + ИмяОбъекта;
    ПутьXMLРядом = КореньКаталога + "\" + ТипОбъекта + "\" + ИмяОбъекта + ".xml";

    ФБ    = Новый Файл(БазовыйПуть);
    ФБxml = Новый Файл(ПутьXMLРядом);

    ЕстьПапка = ФБ.Существует() И НЕ ФБ.ЭтоФайл();
    ЕстьXML   = ФБxml.Существует();

    Если НЕ ЕстьПапка И НЕ ЕстьXML Тогда
        Строки.Добавить("❌ Не найден: `" + ТипОбъекта + "." + ИмяОбъекта + "`");
        Строки.Добавить("> Папка: `" + БазовыйПуть + "`");
        Строки.Добавить("> XML:   `" + ПутьXMLРядом + "`");
        Для Каждого Сообщ Из НеизвестныеОпции Цикл
            Строки.Добавить("");
            Строки.Добавить(Сообщ);
        КонецЦикла;
        Возврат;
    КонецЕсли;

    ТолькоXML = НЕ ЕстьПапка И ЕстьXML;

    ЗаголовокОбъекта = "## " + ТипОбъекта + " → **" + ИмяОбъекта + "**";
    Если ЕстьXML Тогда
        ШапкаОб = ПрочитатьШапкуОбъекта(ПутьXMLРядом);
        Если НЕ ПустаяСтрока(ШапкаОб.Синоним) Тогда
            ЗаголовокОбъекта = ЗаголовокОбъекта + " — " + ШапкаОб.Синоним;
        КонецЕсли;
    КонецЕсли;

    Строки.Добавить("---");
    Строки.Добавить(ЗаголовокОбъекта);
    Строки.Добавить("");
    Для Каждого Сообщ Из НеизвестныеОпции Цикл
        Строки.Добавить(Сообщ);
        Строки.Добавить("");
    КонецЦикла;

    // ══════════════════════════════════════════
    // FETCH — читаем BSL модули
    // ══════════════════════════════════════════
    Если ТипЗапроса = "FETCH" Тогда

        Если Сегменты.Количество() < 3 Тогда
            Строки.Добавить("❌ Не указаны модули.");
            Строки.Добавить("Пример: `FETCH:Catalogs.Контрагенты.manager`");
            ВывестиДоступныеМодули(Строки, ТипОбъекта, ИмяОбъекта, БазовыйПуть);
            Возврат;
        КонецЕсли;

        Если ТолькоXML Тогда
            Строки.Добавить("ℹ️ У объекта нет модулей (только XML-описание). Используй `SCHEMA:`.");
            Возврат;
        КонецЕсли;

        СписокМодулей = СтрРазделить(Сегменты[2], ",", Ложь);

        ЕстьAll = Ложь;
        Для Каждого М Из СписокМодулей Цикл
            Если НРег(СокрЛП(М)) = "all" Тогда
                ЕстьAll = Истина;
            КонецЕсли;
        КонецЦикла;

        Если ЕстьAll Тогда
            СписокМодулей = ВсеКлючиМодулейОбъекта(БазовыйПуть);
        КонецЕсли;

        НайденоМодулей = 0;

        Для Каждого МодСтр Из СписокМодулей Цикл

            МодТип    = НРег(СокрЛП(МодСтр));
            ПутьФайла = "";
            Метка     = "";

            Если МодТип = "manager" Тогда
                ПутьФайла = БазовыйПуть + "\Ext\ManagerModule.bsl";
                Метка     = "ManagerModule";
            ИначеЕсли МодТип = "object" Тогда
                ПутьФайла = БазовыйПуть + "\Ext\ObjectModule.bsl";
                Метка     = "ObjectModule";
            ИначеЕсли МодТип = "recordset" Тогда
                ПутьФайла = БазовыйПуть + "\Ext\RecordSetModule.bsl";
                Метка     = "RecordSetModule";
            ИначеЕсли МодТип = "module" Тогда
                ПутьФайла = БазовыйПуть + "\Ext\Module.bsl";
                Метка     = "Module";
            ИначеЕсли МодТип = "valuemanager" Тогда
                ПутьФайла = БазовыйПуть + "\Ext\ValueManagerModule.bsl";
                Метка     = "ValueManagerModule";
            ИначеЕсли МодТип = "command" Тогда
                ПутьФайла = БазовыйПуть + "\Ext\CommandModule.bsl";
                Метка     = "CommandModule";
            ИначеЕсли МодТип = "form" Тогда
                ПутьФайла = БазовыйПуть + "\Ext\Form\Module.bsl";
                Метка     = "Form.Module";
            ИначеЕсли СтрНачинаетсяС(МодТип, "form:") Тогда
                ИмяФормыМод = Сред(МодСтр, 6);
                ПутьФайла   = БазовыйПуть + "\Forms\" + ИмяФормыМод + "\Ext\Form\Module.bsl";
                Метка       = "Form." + ИмяФормыМод;
            ИначеЕсли СтрНачинаетсяС(МодТип, "command:") Тогда
                ИмяКоманды = Сред(МодСтр, 9);
                ПутьФайла  = БазовыйПуть + "\Commands\" + ИмяКоманды + "\Ext\CommandModule.bsl";
                Метка      = "Command." + ИмяКоманды;
            ИначеЕсли МодТип = "all" Тогда
                Возврат;
            Иначе
                Строки.Добавить("Неизвестный тип модуля: `" + МодСтр + "`");
                Возврат;
            КонецЕсли;

            Если ПутьФайла = "" Тогда Возврат; КонецЕсли;

            ФМод = Новый Файл(ПутьФайла);
            Если НЕ ФМод.Существует() Тогда
                // остальные модули из списка всё равно выводим, но об
                // отсутствующем говорим явно — иначе он просто «пропадает»
                Строки.Добавить("ℹ️ Модуля `" + СокрЛП(МодСтр) + "` (" + Метка + ") у объекта нет.");
                Строки.Добавить("");
                Продолжить;
            КонецЕсли;

            Попытка
                ЧтениеТекста = Новый ЧтениеТекста(ПутьФайла, КодировкаТекста.UTF8);
                КодМодуля    = ЧтениеТекста.Прочитать();
                ЧтениеТекста.Закрыть();
            Исключение
                Строки.Добавить("❌ Ошибка чтения `" + ПутьФайла + "`: " + ОписаниеОшибки());
                Возврат;
            КонецПопытки;

            НайденоМодулей = НайденоМодулей + 1;
            КолСтрок = СтрЧислоСтрок(КодМодуля);
            ОписМод  = ОписаниеМодуляПоКлючу(БазовыйПуть, МодСтр);

            // Крупный модуль целиком съедает контекст чата — вместо текста
            // отдаём оглавление; весь текст — только явно, опцией |full.
            Если КолСтрок > ПорогКрупногоМодуля() И НЕ ПолныйТекст Тогда
                Строки.Добавить("###  " + Метка + " (" + ЧислоВСтроку(КолСтрок) + " строк)");
                Строки.Добавить("");
                Строки.Добавить("⚠ Модуль больше " + ЧислоВСтроку(ПорогКрупногоМодуля())
                    + " строк — вместо текста оглавление. Нужный метод бери `PROC:` из таблицы,"
                    + " весь текст — `FETCH:" + ТипОбъекта + "." + ИмяОбъекта + "." + ОписМод.Ключ + "|full`.");
                Строки.Добавить("");
                ВывестиОглавлениеОдногоМодуля(Строки, ТипОбъекта + "." + ИмяОбъекта, ОписМод,
                    РазборФайлаМодуля(ПутьФайла), ОпцииОглавленияПоУмолчанию());
                Продолжить;
            КонецЕсли;

            // тот же модуль уже выдан целиком выше в этом пакете
            Покрытие = ПокрывающаяВыдача(ТипОбъекта + "." + ИмяОбъекта + "." + ОписМод.Ключ, 1, КолСтрок);
            Если Покрытие <> Неопределено Тогда
                Строки.Добавить("###  " + Метка + " (" + ЧислоВСтроку(КолСтрок) + " строк)");
                Строки.Добавить("");
                Строки.Добавить("> ↑ Модуль уже выдан выше в этом файле: " + Покрытие.Описание
                    + " — код не повторяю.");
                Строки.Добавить("");
                Продолжить;
            КонецЕсли;

            Строки.Добавить("###  " + Метка + " (" + ЧислоВСтроку(КолСтрок) + " строк)");
            Строки.Добавить("");
            Строки.Добавить("```bsl");
            Строки.Добавить(КодМодуля);
            Строки.Добавить("```");
            Строки.Добавить("");

            ЗарегистрироватьВыдачу(ТипОбъекта + "." + ИмяОбъекта + "." + ОписМод.Ключ,
                1, КолСтрок, "FETCH модуля целиком");

        КонецЦикла;

        Если НайденоМодулей = 0 Тогда
            Строки.Добавить("ℹ️ Ни один из запрошенных модулей не найден.");
            ВывестиДоступныеМодули(Строки, ТипОбъекта, ИмяОбъекта, БазовыйПуть);
        КонецЕсли;

    // ══════════════════════════════════════════
    // SCHEMA — структура объекта из XML
    // ══════════════════════════════════════════
    ИначеЕсли ТипЗапроса = "SCHEMA" Тогда

        Если НЕ ЕстьXML Тогда
            Строки.Добавить("❌ XML не найден: `" + ПутьXMLРядом + "`");
            Возврат;
        КонецЕсли;

        ВыполнитьСхему(Строки, ТипОбъекта, ИмяОбъекта, ПутьXMLРядом, БазовыйПуть);

    КонецЕсли;

КонецПроцедуры
