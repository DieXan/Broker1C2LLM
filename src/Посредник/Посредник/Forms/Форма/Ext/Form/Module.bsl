&НаКлиенте
Функция ОбъектыТипа(Знач ПутьПапки)

    // Объект выгрузки — это ИмяОбъекта.xml рядом с (необязательной) папкой ИмяОбъекта.
    // Объекты без модулей и форм лежат ОДНИМ файлом, папки у них нет —
    // поэтому обходить только папки нельзя.
    Результат = Новый Массив;

    ФП = Новый Файл(ПутьПапки);
    Если НЕ ФП.Существует() Тогда
        Возврат Результат;
    КонецЕсли;

    ЭлементыПапки = НайтиФайлы(ПутьПапки, "*", Ложь);

    ИменаПапок = Новый Соответствие;
    Для Каждого Э Из ЭлементыПапки Цикл
        Если НЕ Э.ЭтоФайл() Тогда
            ИменаПапок.Вставить(НРег(Э.Имя), Э.ПолноеИмя);
        КонецЕсли;
    КонецЦикла;

    УчтенныеИмена = Новый Соответствие;

    Для Каждого Э Из ЭлементыПапки Цикл

        Если НЕ Э.ЭтоФайл() Тогда
            Продолжить;
        КонецЕсли;
        Если НРег(Э.Расширение) <> ".xml" Тогда
            Продолжить;
        КонецЕсли;

        ИмяОб = Э.ИмяБезРасширения;
        Если ПропуститьОбъектПоИмени(ИмяОб) Тогда
            Продолжить;
        КонецЕсли;

        ПутьПапкиОб = ИменаПапок.Получить(НРег(ИмяОб));

        Эл = Новый Структура("Имя, ПутьXML, ПутьПапки, ЕстьXML, ЕстьПапка");
        Эл.Имя       = ИмяОб;
        Эл.ПутьXML   = Э.ПолноеИмя;
        Эл.ЕстьXML   = Истина;
        Эл.ЕстьПапка = (ПутьПапкиОб <> Неопределено);
        Эл.ПутьПапки = ?(Эл.ЕстьПапка, ПутьПапкиОб, ПутьПапки + "\" + ИмяОб);

        Результат.Добавить(Эл);
        УчтенныеИмена.Вставить(НРег(ИмяОб), Истина);

    КонецЦикла;

    // Папки без парного XML — нетипично, но терять их нельзя.
    Для Каждого Э Из ЭлементыПапки Цикл

        Если Э.ЭтоФайл() Тогда
            Продолжить;
        КонецЕсли;
        Если ПропуститьОбъектПоИмени(Э.Имя) Тогда
            Продолжить;
        КонецЕсли;
        Если УчтенныеИмена.Получить(НРег(Э.Имя)) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;

        Эл = Новый Структура("Имя, ПутьXML, ПутьПапки, ЕстьXML, ЕстьПапка");
        Эл.Имя       = Э.Имя;
        Эл.ПутьXML   = ПутьПапки + "\" + Э.Имя + ".xml";
        Эл.ЕстьXML   = Ложь;
        Эл.ЕстьПапка = Истина;
        Эл.ПутьПапки = Э.ПолноеИмя;

        Результат.Добавить(Эл);

    КонецЦикла;

    Возврат Результат;

КонецФункции

&НаКлиенте
Функция ТекстыПоддерева(ЧтениеXML)

    // Дочитывает ТЕКУЩИЙ элемент до его закрывающего тега включительно.
    //
    // ЧтениеXML выдаёт КонецЭлемента и для пустых элементов (<Comment/>),
    // поэтому отдельная обработка пустых не нужна: для них первый же
    // прочитанный узел и будет закрывающим тегом.
    Рез = Новый Структура;
    Рез.Вставить("Все",     Новый Массив);
    Рез.Вставить("Контент", Новый Массив);
    Рез.Вставить("Айтемы",  Новый Массив);

    МоеИмя       = ЧтениеXML.ЛокальноеИмя;
    ИменаУровней = Новый Массив;

    Пока ЧтениеXML.Прочитать() Цикл

        Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда

            ИменаУровней.Добавить(ЧтениеXML.ЛокальноеИмя);

        ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда

            ЛокИмя = ЧтениеXML.ЛокальноеИмя;
            Если ИменаУровней.Количество() = 0 Тогда
                Если ЛокИмя = МоеИмя Тогда
                    Прервать;
                КонецЕсли;
            ИначеЕсли ИменаУровней[ИменаУровней.Количество() - 1] = ЛокИмя Тогда
                ИменаУровней.Удалить(ИменаУровней.Количество() - 1);
            КонецЕсли;

        ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда

            Знч = СокрЛП(ЧтениеXML.Значение);
            Если ПустаяСтрока(Знч) Тогда
                Продолжить;
            КонецЕсли;
            Рез.Все.Добавить(Знч);
            Если ИменаУровней.Количество() > 0 Тогда
                ТекИмя = ИменаУровней[ИменаУровней.Количество() - 1];
                Если ТекИмя = "content" Тогда
                    Рез.Контент.Добавить(Знч);
                ИначеЕсли ТекИмя = "Item" ИЛИ ТекИмя = "Type" ИЛИ ТекИмя = "TypeSet"
                    ИЛИ ТекИмя = "Value" ИЛИ ТекИмя = "Metadata" Тогда
                    Рез.Айтемы.Добавить(Знч);
                КонецЕсли;
            КонецЕсли;

        КонецЕсли;

    КонецЦикла;

    Возврат Рез;

КонецФункции

&НаКлиенте
Функция ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен)

    // Читает текст текущего элемента и синхронизирует стек имён:
    // закрывающий тег элемента уже поглощён внутри ТекстыПоддерева.
    Значение = ТекстЭлементаЦеликом(ЧтениеXML);

    Если СтекИмен.Количество() > 0 Тогда
        СтекИмен.Удалить(СтекИмен.Количество() - 1);
    КонецЕсли;

    Возврат Значение;

КонецФункции

&НаКлиенте
Функция ТекстЭлементаЦеликом(ЧтениеXML)

    // Совместимая с ТекстыПоддерева версия для простых элементов:
    // возвращает текст, закрывающий тег уже прочитан.
    Тексты = ТекстыПоддерева(ЧтениеXML);
    Если Тексты.Контент.Количество() > 0 Тогда
        Возврат Тексты.Контент[0];
    КонецЕсли;
    Если Тексты.Все.Количество() > 0 Тогда
        Возврат СтрСоединить(Тексты.Все, " ");
    КонецЕсли;
    Возврат "";

КонецФункции

&НаКлиенте
Функция ШапкаИзXML(Знач ПутьXML, Ключи)

    // Читает свойства верхнего уровня (блок Properties) и останавливается,
    // не заходя в ChildObjects — поэтому дёшево даже на многомегабайтных XML.
    Рез = Новый Соответствие;

    ФX = Новый Файл(ПутьXML);
    Если НЕ ФX.Существует() Тогда
        Возврат Рез;
    КонецЕсли;

    ЧтениеXML = Новый ЧтениеXML;
    Попытка
        ЧтениеXML.ОткрытьФайл(ПутьXML);
    Исключение
        Возврат Рез;
    КонецПопытки;

    Попытка

        СтекИмен         = Новый Массив;
        ВПропертис       = Ложь;
        ГлубинаПропертис = 0;

        Пока ЧтениеXML.Прочитать() Цикл

            Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда

                ЛокИмя = ЧтениеXML.ЛокальноеИмя;

                Если ЛокИмя = "ChildObjects" Тогда
                    Прервать;
                КонецЕсли;

                СтекИмен.Добавить(ЛокИмя);
                Глубина = СтекИмен.Количество();

                Если НЕ ВПропертис Тогда
                    Если ЛокИмя = "Properties" Тогда
                        ВПропертис       = Истина;
                        ГлубинаПропертис = Глубина;
                    ИначеЕсли ЛокИмя = "InternalInfo" Тогда
                        ПрочитатьЗначениеЭлемента(ЧтениеXML, СтекИмен);
                    КонецЕсли;
                    Продолжить;
                КонецЕсли;

                Если Глубина = ГлубинаПропертис + 1
                    И Ключи.Получить(ЛокИмя) <> Неопределено Тогда

                    Тексты = ТекстыПоддерева(ЧтениеXML);
                    СтекИмен.Удалить(СтекИмен.Количество() - 1);
                    Рез.Вставить(ЛокИмя, Тексты);

                    Если Рез.Количество() >= Ключи.Количество() Тогда
                        Прервать;
                    КонецЕсли;
                КонецЕсли;

            ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда

                ЛокИмя = ЧтениеXML.ЛокальноеИмя;
                Если СтекИмен.Количество() > 0
                    И СтекИмен[СтекИмен.Количество() - 1] = ЛокИмя Тогда

                    Если ВПропертис И СтекИмен.Количество() = ГлубинаПропертис Тогда
                        Прервать;
                    КонецЕсли;
                    СтекИмен.Удалить(СтекИмен.Количество() - 1);
                КонецЕсли;

            КонецЕсли;

        КонецЦикла;

    Исключение
        // повреждённый или нестандартный XML — отдаём, что успели собрать
    КонецПопытки;

    Попытка
        ЧтениеXML.Закрыть();
    Исключение
    КонецПопытки;

    Возврат Рез;

КонецФункции

