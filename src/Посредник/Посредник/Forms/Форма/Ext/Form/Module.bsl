Функция ИдентификаторУзла(Знач Ключ, УзлыКарта)

    Существующий = УзлыКарта.Получить(Ключ);
    Если Существующий <> Неопределено Тогда
        Возврат Существующий;
    КонецЕсли;

    Новый_ = "n" + (УзлыКарта.Количество() + 1);
    УзлыКарта.Вставить(Ключ, Новый_);
    Возврат Новый_;

КонецФункции

// Имя таблицы объекта в языке запросов по папке выгрузки: InformationRegisters →
// РегистрСведений. "" — у вида объектов нет таблиц запроса.
&НаКлиенте
Функция ИмяТаблицыЗапросаПоПапке(Знач Папка)

    Соотв = Новый Соответствие;
    Соотв.Вставить("catalogs",                    "Справочник");
    Соотв.Вставить("documents",                   "Документ");
    Соотв.Вставить("documentjournals",            "ЖурналДокументов");
    Соотв.Вставить("enums",                       "Перечисление");
    Соотв.Вставить("constants",                   "Константа");
    Соотв.Вставить("informationregisters",        "РегистрСведений");
    Соотв.Вставить("accumulationregisters",       "РегистрНакопления");
    Соотв.Вставить("accountingregisters",         "РегистрБухгалтерии");
    Соотв.Вставить("calculationregisters",        "РегистрРасчета");
    Соотв.Вставить("chartsofaccounts",            "ПланСчетов");
    Соотв.Вставить("chartsofcharacteristictypes", "ПланВидовХарактеристик");
    Соотв.Вставить("chartsofcalculationtypes",    "ПланВидовРасчета");
    Соотв.Вставить("businessprocesses",           "БизнесПроцесс");
    Соотв.Вставить("tasks",                       "Задача");
