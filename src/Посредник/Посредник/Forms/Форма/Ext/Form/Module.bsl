Функция ЭкранироватьЯчейку(Знач Текст, Знач МаксДлина = 0)

    Если Текст = Неопределено Тогда
        Возврат "";
    КонецЕсли;

    Текст = СтрЗаменить(Текст, Символы.ВК, " ");
    Текст = СтрЗаменить(Текст, Символы.ПС, " ");
    Текст = СтрЗаменить(Текст, Символы.Таб, " ");
    Текст = СтрЗаменить(Текст, "|", "\|");
    Текст = СтрЗаменить(Текст, "`", "'");
    Текст = СокрЛП(Текст);

    Если МаксДлина > 0 И СтрДлина(Текст) > МаксДлина Тогда
        Текст = Лев(Текст, МаксДлина - 1) + "…";
    КонецЕсли;

    Возврат Текст;

КонецФункции

&НаКлиенте
Функция ПризнакиКодаОбъекта(Знач ПутьОбъекта)

    Рез = Новый Структура("Флаги, ЕстьКод, Формы, Команды");
    Рез.Флаги   = "";
    Рез.ЕстьКод = Ложь;
    Рез.Формы   = 0;
    Рез.Команды = 0;

    ФО = Новый Файл(ПутьОбъекта);
    Если НЕ ФО.Существует() Тогда
        Возврат Рез;
    КонецЕсли;

    Метки = Новый Массив;

    ФExt = Новый Файл(ПутьОбъекта + "\Ext");
    Если ФExt.Существует() Тогда

        ИменаExt = Новый Соответствие;
        Для Каждого Ф Из НайтиФайлы(ПутьОбъекта + "\Ext", "*", Ложь) Цикл
            ИменаExt.Вставить(НРег(Ф.Имя), Истина);
        КонецЦикла;

        Если ИменаExt.Получить("managermodule.bsl") <> Неопределено Тогда
            Метки.Добавить("Мнж");
        КонецЕсли;
        Если ИменаExt.Получить("objectmodule.bsl") <> Неопределено Тогда
            Метки.Добавить("Об");
        КонецЕсли;
        Если ИменаExt.Получить("recordsetmodule.bsl") <> Неопределено Тогда
            Метки.Добавить("Наб");
        КонецЕсли;
        Если ИменаExt.Получить("module.bsl") <> Неопределено Тогда
            Метки.Добавить("Мод");
        КонецЕсли;
        Если ИменаExt.Получить("valuemanagermodule.bsl") <> Неопределено Тогда
            Метки.Добавить("Знч");
        КонецЕсли;
        Если ИменаExt.Получить("commandmodule.bsl") <> Неопределено Тогда
            Метки.Добавить("Ком");
        КонецЕсли;

        ФФормаМод = Новый Файл(ПутьОбъекта + "\Ext\Form\Module.bsl");
        Если ФФормаМод.Существует() Тогда
            Метки.Добавить("Фрм");
        КонецЕсли;

    КонецЕсли;

    // Предопределённые — не код, поэтому считаем метку отдельно от признака "есть код".
    ЕстьПредопределённые = Ложь;
    ФПредопр = Новый Файл(ПутьОбъекта + "\Ext\Predefined.xml");
    Если ФПредопр.Существует() Тогда
        ЕстьПредопределённые = Истина;
    КонецЕсли;

    ФФ = Новый Файл(ПутьОбъекта + "\Forms");
    Если ФФ.Существует() Тогда
        Рез.Формы = НайтиФайлы(ПутьОбъекта + "\Forms", "*.xml", Ложь).Количество();
        Если Рез.Формы > 0 Тогда
            Метки.Добавить("Ф" + Рез.Формы);
        КонецЕсли;
    КонецЕсли;

    ФК = Новый Файл(ПутьОбъекта + "\Commands");
    Если ФК.Существует() Тогда
        Для Каждого ПК Из НайтиФайлы(ПутьОбъекта + "\Commands", "*", Ложь) Цикл
            Если НЕ ПК.ЭтоФайл() Тогда
                Рез.Команды = Рез.Команды + 1;
            КонецЕсли;
        КонецЦикла;
        Если Рез.Команды > 0 Тогда
            Метки.Добавить("К" + Рез.Команды);
        КонецЕсли;
    КонецЕсли;

    Рез.ЕстьКод = Метки.Количество() > 0;

    Если ЕстьПредопределённые Тогда
        Метки.Добавить("П");
    КонецЕсли;

    Рез.Флаги = СтрСоединить(Метки, " ");

    Возврат Рез;

КонецФункции

